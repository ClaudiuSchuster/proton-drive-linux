#!/usr/bin/env python3
# SPDX-License-Identifier: GPL-3.0-or-later
"""Guarded one-shot recovery for persistent Proton upload draft conflicts."""

from __future__ import annotations

import argparse
import base64
import datetime as dt
import fcntl
import hashlib
import json
import os
import pathlib
import re
import shutil
import subprocess
import sys
import tempfile
import time
from typing import Any


HOME = pathlib.Path.home()
STATE_DIR = pathlib.Path(os.environ.get("PDRIVE_STATE_DIR", HOME / ".local/state/rclone"))
CONFIG_DIR = pathlib.Path(os.environ.get("PDRIVE_CONFIG_DIR", HOME / ".config"))
CACHE_DIR = pathlib.Path(os.environ.get("PDRIVE_CACHE_DIR", HOME / ".cache/rclone"))
RC_SOCKET = pathlib.Path(os.environ.get("PDRIVE_RC_SOCKET", STATE_DIR / "pdrive-rc.sock"))
RCLONE_BIN = pathlib.Path(os.environ.get("PDRIVE_RCLONE_BIN", HOME / ".local/bin/rclone"))
MOUNT_LOG = pathlib.Path(os.environ.get("PDRIVE_MOUNT_LOG", STATE_DIR / "proton-mount.log"))
DRAFT_CONFIG = CONFIG_DIR / "pdrive-draft-recovery.conf"
METADATA_CONFIG = CONFIG_DIR / "pdrive-recovery.conf"
MONITOR_STATE = STATE_DIR / "pdrive-draft-recovery-state.json"
LATEST_STATE = STATE_DIR / "pdrive-draft-recovery-latest.json"
SERVICE_NAME = "rclone-proton-drive.service"
CONFIRMATIONS_REQUIRED = 2
ACTIVITY_PROBE_SECONDS = float(os.environ.get("PDRIVE_ACTIVITY_PROBE_SECONDS", "20"))
POST_RECOVERY_CONFIRMATIONS_REQUIRED = 2
POST_RECOVERY_MIN_PROGRESS_BYTES = 1024 * 1024
POST_RECOVERY_NEAR_PAUSE_BYTES = 64 * 1024
POST_RECOVERY_RESTART_LIMIT = 1
POST_RECOVERY_RESTART_COOLDOWN_SECONDS = 12 * 60 * 60
POST_RECOVERY_MIN_CONFIRMATION_SECONDS = int(os.environ.get("PDRIVE_POST_RECOVERY_MIN_CONFIRMATION_SECONDS", "120"))
POST_FINALIZATION_SETTLE_SECONDS = int(os.environ.get("PDRIVE_FINALIZATION_SETTLE_SECONDS", "600"))
POST_FINALIZATION_ERROR_LOOKBACK_SECONDS = 15 * 60
POST_FINALIZATION_RESTART_GAP_SECONDS = 30 * 60
POST_FINALIZATION_RESTART_LIMIT = 1
POST_RECOVERY_STATE_VERSION = 2
POST_RECOVERY_BASELINE_SOURCES = {
    "transition",
    "transfer-start",
    "process-start",
    "observed-progress",
}
FINALIZATION_ERROR_CATEGORIES = {
    "draft-conflict",
    "remote-file-removed",
    "remote-server",
}
MINIMUM_SAFE_RCLONE_VERSION = (1, 76, 0)
MINIMUM_SAFE_RCLONE_176_BETA_BUILD = 10204


class RecoveryError(RuntimeError):
    """A guarded recovery precondition or operation failed."""


def run(command: list[str], timeout: float = 15.0) -> subprocess.CompletedProcess[str]:
    try:
        return subprocess.run(command, check=False, capture_output=True, text=True, timeout=timeout)
    except (OSError, subprocess.TimeoutExpired) as error:
        raise RecoveryError(f"Could not run {command[0]}: {error}") from error


def atomic_text(path: pathlib.Path, content: str, mode: int = 0o600) -> None:
    path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    descriptor, temporary_name = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    temporary = pathlib.Path(temporary_name)
    try:
        with os.fdopen(descriptor, "w", encoding="utf-8") as stream:
            stream.write(content)
            stream.flush()
            os.fsync(stream.fileno())
        temporary.chmod(mode)
        os.replace(temporary, path)
    finally:
        temporary.unlink(missing_ok=True)


def atomic_json(path: pathlib.Path, payload: dict[str, Any]) -> None:
    atomic_text(path, json.dumps(payload, indent=2, sort_keys=True) + "\n")


def read_json(path: pathlib.Path) -> dict[str, Any]:
    try:
        payload = json.loads(path.read_text(encoding="utf-8"))
        return payload if isinstance(payload, dict) else {}
    except (OSError, json.JSONDecodeError):
        return {}


def exact_config(path: pathlib.Path, key: str, default: bool = False) -> bool:
    try:
        entries = [
            line.strip()
            for line in path.read_text(encoding="utf-8").splitlines()
            if line.strip() and not line.lstrip().startswith("#")
        ]
    except FileNotFoundError:
        return default
    except OSError as error:
        raise RecoveryError(f"Configuration is unreadable: {path}: {error}") from error
    expected = {f"{key}=true": True, f"{key}=false": False}
    if len(entries) != 1 or entries[0] not in expected:
        raise RecoveryError(f"Configuration contains no exact {key}=true/false value: {path}")
    return expected[entries[0]]


def write_draft_mode(enabled: bool) -> None:
    value = str(enabled).lower()
    atomic_text(
        DRAFT_CONFIG,
        "# Managed by pdrive-draft-recovery; never source as shell code.\n"
        "# true is temporary and only valid in the guarded recovery namespace.\n"
        f"replace_existing_draft={value}\n",
    )


def namespace_name(metadata_cache: bool, replace_draft: bool) -> str:
    extra = f"enable_caching='{str(metadata_cache).lower()}',replace_existing_draft='{str(replace_draft).lower()}'"
    digest = hashlib.md5(extra.encode("utf-8"), usedforsecurity=False).digest()
    suffix = base64.urlsafe_b64encode(digest).decode("ascii").rstrip("=")[:5]
    return f"proton{{{suffix}}}"


def rc(endpoint: str) -> dict[str, Any]:
    completed = run(
        [str(RCLONE_BIN), "rc", "--unix-socket", str(RC_SOCKET), endpoint],
        timeout=12,
    )
    if completed.returncode != 0:
        raise RecoveryError(completed.stderr.strip() or f"rclone RC failed for {endpoint}")
    try:
        payload = json.loads(completed.stdout)
    except json.JSONDecodeError as error:
        raise RecoveryError(f"rclone RC returned invalid JSON for {endpoint}") from error
    if not isinstance(payload, dict):
        raise RecoveryError(f"rclone RC returned an invalid object for {endpoint}")
    return payload


def service_pid_and_args() -> tuple[int, str]:
    completed = run(["systemctl", "--user", "show", SERVICE_NAME, "-p", "MainPID", "--value", "--no-pager"])
    try:
        pid = int(completed.stdout.strip())
    except ValueError:
        pid = 0
    if completed.returncode != 0 or pid <= 0:
        return 0, ""
    args = run(["ps", "-ww", "-p", str(pid), "-o", "args="], timeout=5)
    return pid, args.stdout.strip() if args.returncode == 0 else ""


def queue_snapshot() -> list[dict[str, Any]]:
    payload = rc("vfs/queue")
    queue = payload.get("queue", [])
    if not isinstance(queue, list):
        raise RecoveryError("The VFS queue is not an array")
    return [item for item in queue if isinstance(item, dict)]


def item_fingerprint(item: dict[str, Any], metadata_cache: bool, draft_mode: bool) -> str:
    name = str(item.get("name") or "")
    namespace = namespace_name(metadata_cache, draft_mode)
    meta_root = (CACHE_DIR / "vfsMeta" / namespace).resolve()
    meta_path = (meta_root / pathlib.PurePosixPath(name)).resolve()
    inode = 0
    device = 0
    if meta_path.is_relative_to(meta_root):
        try:
            metadata = meta_path.stat()
            inode = metadata.st_ino
            device = metadata.st_dev
        except OSError:
            pass
    identity = json.dumps(
        {
            "name": name,
            "size": int(item.get("size") or 0),
            # The VFS metadata inode follows an atomic namespace rename but
            # distinguishes a later, same-name/same-size cache generation.
            "meta_device": device,
            "meta_inode": inode,
        },
        sort_keys=True,
        separators=(",", ":"),
    )
    return hashlib.sha256(identity.encode("utf-8")).hexdigest()


def recent_draft_conflict(name: str) -> bool:
    try:
        with MOUNT_LOG.open("rb") as stream:
            stream.seek(0, os.SEEK_END)
            stream.seek(max(0, stream.tell() - 512 * 1024))
            payload = stream.read().decode("utf-8", errors="replace")
    except OSError:
        return False
    pattern = re.compile(r"^(\d{4}/\d{2}/\d{2})\s+(\d{2}:\d{2}:\d{2}).*a draft exist", re.IGNORECASE)
    for line in reversed(payload.replace("\x00", "").splitlines()):
        match = pattern.search(line)
        if match is None or name not in line:
            continue
        return True
    return False


def tcp_sent_bytes(pid: int) -> int:
    if pid <= 0 or shutil.which("ss") is None:
        return 0
    completed = run(["ss", "-Htinp", "state", "established"], timeout=5)
    if completed.returncode != 0:
        return 0
    lines = completed.stdout.splitlines()
    process_pattern = re.compile(rf"\bpid={pid}(?:,|\))")
    counter_pattern = re.compile(r"\bbytes_sent:(\d+)\b")
    total = 0
    for index, line in enumerate(lines):
        if process_pattern.search(line) is None:
            continue
        details = line + (" " + lines[index + 1] if index + 1 < len(lines) else "")
        total += sum(int(value) for value in counter_pattern.findall(details))
    return total


def process_io(pid: int) -> tuple[int, int]:
    values = {"rchar": 0, "read_bytes": 0}
    try:
        for line in pathlib.Path(f"/proc/{pid}/io").read_text(encoding="utf-8").splitlines():
            key, separator, value = line.partition(":")
            if separator and key in values:
                values[key] = max(0, int(value.strip()))
    except (OSError, ValueError):
        pass
    return values["rchar"], values["read_bytes"]


def rclone_transfer_bytes() -> int:
    try:
        stats = rc("core/stats")
    except RecoveryError:
        return 0
    active = stats.get("transferring", [])
    active_bytes = 0
    if isinstance(active, list):
        active_bytes = sum(max(0, int(item.get("bytes") or 0)) for item in active if isinstance(item, dict))
    return max(max(0, int(stats.get("bytes") or 0)), active_bytes)


def iso_epoch(value: Any, default: int = 0) -> int:
    try:
        return int(dt.datetime.fromisoformat(str(value).replace("Z", "+00:00")).timestamp())
    except (TypeError, ValueError):
        return default


def matching_transfer(item: dict[str, Any]) -> tuple[int, int]:
    """Return transferred bytes and start time for the exact queued object."""

    try:
        stats = rc("core/stats")
    except RecoveryError:
        return 0, 0
    active = stats.get("transferring", [])
    if not isinstance(active, list):
        return 0, 0
    expected_name = str(item.get("name") or "")
    expected_size = max(0, int(item.get("size") or 0))
    for transfer in active:
        if not isinstance(transfer, dict):
            continue
        name = str(transfer.get("name") or transfer.get("path") or "")
        size = max(0, int(transfer.get("size") or transfer.get("totalBytes") or 0))
        if name != expected_name or (expected_size and size and size != expected_size):
            continue
        return max(0, int(transfer.get("bytes") or transfer.get("transferred") or 0)), iso_epoch(
            transfer.get("startedAt")
        )
    return 0, 0


def process_started_epoch(pid: int) -> int:
    """Derive one process start epoch from procfs without invoking another client."""

    if pid <= 0:
        return 0
    try:
        stat = pathlib.Path(f"/proc/{pid}/stat").read_text(encoding="utf-8")
        fields = stat.rsplit(") ", 1)[1].split()
        start_ticks = int(fields[19])
        uptime = float(pathlib.Path("/proc/uptime").read_text(encoding="utf-8").split()[0])
        clock_ticks = int(os.sysconf("SC_CLK_TCK"))
        process_age = max(0.0, uptime - (start_ticks / clock_ticks))
        return max(0, int(time.time() - process_age))
    except (IndexError, OSError, TypeError, ValueError):
        return 0


def activity_snapshot(pid: int) -> tuple[int, int, int, int]:
    rchar, read_bytes = process_io(pid)
    return tcp_sent_bytes(pid), rclone_transfer_bytes(), rchar, read_bytes


def probe_payload_activity(pid: int) -> dict[str, Any]:
    before_tcp, before_transfer, before_rchar, before_read = activity_snapshot(pid)
    time.sleep(max(0.0, ACTIVITY_PROBE_SECONDS))
    current_pid, _args = service_pid_and_args()
    if current_pid != pid:
        return {
            "result": "process-changed",
            "tcp_delta": 0,
            "transfer_delta": 0,
            "rchar_delta": 0,
            "read_delta": 0,
        }
    after_tcp, after_transfer, after_rchar, after_read = activity_snapshot(pid)
    deltas = {
        "tcp_delta": max(0, after_tcp - before_tcp),
        "transfer_delta": max(0, after_transfer - before_transfer),
        "rchar_delta": max(0, after_rchar - before_rchar),
        "read_delta": max(0, after_read - before_read),
    }
    moving = any(
        (
            deltas["tcp_delta"] >= 256 * 1024,
            deltas["transfer_delta"] >= 1024 * 1024,
            deltas["rchar_delta"] >= 8 * 1024 * 1024,
            deltas["read_delta"] >= 1024 * 1024,
        )
    )
    return {"result": "moving" if moving else "idle", **deltas}


def payload_is_moving(pid: int) -> bool:
    return probe_payload_activity(pid)["result"] != "idle"


def parse_bandwidth_component(value: str) -> int | None:
    component = value.strip()
    if component.lower() in {"", "off", "0"}:
        return None
    match = re.fullmatch(r"([0-9]+(?:[.][0-9]+)?)([bBkKmMgGtTpP]?)(?:[iI]?[bB]?)?", component)
    if match is None:
        return None
    multipliers = {
        "": 1,
        "b": 1,
        "k": 1024,
        "m": 1024**2,
        "g": 1024**3,
        "t": 1024**4,
        "p": 1024**5,
    }
    return int(float(match.group(1)) * multipliers[match.group(2).lower()])


def configured_upload_limit() -> int | None:
    try:
        entries = [
            line.strip()
            for line in (CONFIG_DIR / "pdrive-bwlimit.conf").read_text(encoding="utf-8").splitlines()
            if line.strip() and not line.lstrip().startswith("#")
        ]
    except OSError:
        return None
    if len(entries) != 1 or not entries[0].startswith("bwlimit="):
        return None
    rate = entries[0].split("=", 1)[1]
    return parse_bandwidth_component(rate.split(":", 1)[0])


def effective_upload_limit() -> int | None:
    try:
        live = rc("core/bwlimit")
        live_limit = max(0, int(live.get("bytesPerSecondTx") or 0))
        if live_limit:
            return live_limit
    except (RecoveryError, TypeError, ValueError):
        pass
    return configured_upload_limit()


def connectivity_healthy() -> bool:
    completed = run(["getent", "ahostsv4", "drive-api.proton.me"], timeout=10)
    return completed.returncode == 0 and bool(completed.stdout.strip())


def upload_retry_safe_version(version: str) -> bool:
    """Accept only builds known to contain the fresh-stream Proton retry fix."""

    match = re.fullmatch(r"v(\d+)\.(\d+)\.(\d+)(?:-beta\.(\d+)\.[^\s]+)?", version)
    if match is None:
        return False
    base = tuple(int(part) for part in match.groups()[:3])
    beta_build = match.group(4)
    if base > MINIMUM_SAFE_RCLONE_VERSION:
        return True
    if base < MINIMUM_SAFE_RCLONE_VERSION:
        return False
    return beta_build is None or int(beta_build) >= MINIMUM_SAFE_RCLONE_176_BETA_BUILD


def installed_upload_retry_safe() -> bool:
    """Check whether the installed rclone is known to retry with a fresh stream."""

    completed = run([str(RCLONE_BIN), "version"], timeout=8)
    if completed.returncode != 0:
        return False
    first_line = completed.stdout.splitlines()[0].strip() if completed.stdout.splitlines() else ""
    match = re.fullmatch(r"rclone\s+(v\S+)", first_line)
    return bool(match and upload_retry_safe_version(match.group(1)))


def post_recovery_error(name: str, since_epoch: int, *, allow_backend_context: bool = False) -> dict[str, Any]:
    """Return the newest concrete upload error for one path without persisting it."""

    try:
        with MOUNT_LOG.open("rb") as stream:
            stream.seek(0, os.SEEK_END)
            stream.seek(max(0, stream.tell() - 2 * 1024 * 1024))
            lines = stream.read().decode("utf-8", errors="replace").replace("\x00", "").splitlines()
    except OSError:
        return {"epoch": 0, "category": "none", "signature": ""}
    timestamp_pattern = re.compile(r"^(\d{4}/\d{2}/\d{2})\s+(\d{2}:\d{2}:\d{2})")
    categories = (
        ("authentication", re.compile(r"(?:status(?:=|\s)401\b|\b401\s+(?:unauthorized|error))", re.I)),
        ("remote-file-removed", re.compile(r"(?:status(?:=|\s)404\b|this file has been removed)", re.I)),
        ("draft-conflict", re.compile(r"(?:status(?:=|\s)422\b|a draft exist)", re.I)),
        ("remote-server", re.compile(r"(?:status(?:=|\s)5\d\d\b|\b5\d\d\s+(?:error|server))", re.I)),
        ("upload-retry", re.compile(r"(?:failed to upload try|upload attempt.*failed|can't copy|cannot copy)", re.I)),
    )
    local_zone = dt.datetime.now().astimezone().tzinfo
    for line in reversed(lines):
        path_specific = name in line
        backend_context = allow_backend_context and "proton drive root link id" in line.lower()
        if not path_specific and not backend_context:
            continue
        timestamp = timestamp_pattern.match(line)
        if timestamp is None:
            continue
        try:
            moment = dt.datetime.strptime(" ".join(timestamp.groups()), "%Y/%m/%d %H:%M:%S").replace(tzinfo=local_zone)
        except ValueError:
            continue
        epoch = int(moment.timestamp())
        if epoch < since_epoch:
            continue
        for category, pattern in categories:
            if pattern.search(line):
                return {
                    "epoch": epoch,
                    "category": category,
                    "signature": hashlib.sha256(line.encode("utf-8", errors="replace")).hexdigest(),
                }
    return {"epoch": 0, "category": "none", "signature": ""}


def recovery_state_compatible(previous: dict[str, Any], fingerprint: str) -> bool:
    return (
        int(previous.get("state_version") or 0) == POST_RECOVERY_STATE_VERSION
        and previous.get("phase") == "recovery"
        and previous.get("fingerprint") == fingerprint
        and previous.get("baseline_source") in POST_RECOVERY_BASELINE_SOURCES
    )


def recovery_baseline_epoch(
    previous: dict[str, Any], fingerprint: str, transfer_started_epoch: int, now_epoch: int
) -> int:
    retained = (
        int(previous.get("recovery_started_epoch") or 0) if recovery_state_compatible(previous, fingerprint) else 0
    )
    return max(0, retained or transfer_started_epoch or now_epoch)


def post_recovery_decision(previous: dict[str, Any], observation: dict[str, Any]) -> dict[str, Any]:
    """Evaluate one secret-free, generation-bound recovery observation."""

    now_epoch = max(0, int(observation.get("now_epoch") or 0))
    fingerprint = str(observation.get("fingerprint") or "")
    compatible = recovery_state_compatible(previous, fingerprint)
    if compatible:
        state = dict(previous)
    else:
        state = {
            "state_version": POST_RECOVERY_STATE_VERSION,
            "phase": "recovery",
            "fingerprint": fingerprint,
            "recovery_started_epoch": max(0, int(observation.get("transfer_started_epoch") or now_epoch)),
            "progress_proven": False,
            "last_transfer_bytes": 0,
            "last_progress_epoch": 0,
            "last_error_epoch": 0,
            "last_error_category": "none",
            "last_error_signature": "",
            "zero_activity_confirmations": 0,
            "last_zero_activity_epoch": 0,
            "restart_attempts": 0,
            "last_restart_epoch": 0,
            "payload_complete_epoch": 0,
            "finalization_error_epoch": 0,
            "finalization_error_category": "none",
            "finalization_error_signature": "",
            "finalization_confirmations": 0,
            "last_finalization_confirmation_epoch": 0,
            "finalization_restart_attempts": 0,
            "last_pid": 0,
            "baseline_source": str(observation.get("baseline_source") or "observation"),
        }

    pid = max(0, int(observation.get("pid") or 0))
    previous_pid = max(0, int(state.get("last_pid") or 0))
    transfer_bytes = max(0, int(observation.get("transfer_bytes") or 0))
    previous_bytes = max(0, int(state.get("last_transfer_bytes") or 0))
    transfer_started_epoch = max(0, int(observation.get("transfer_started_epoch") or 0))
    progress_now = False
    if not compatible and transfer_bytes >= POST_RECOVERY_MIN_PROGRESS_BYTES:
        progress_now = True
        state["last_progress_epoch"] = transfer_started_epoch or now_epoch
    elif pid == previous_pid and transfer_bytes >= previous_bytes + POST_RECOVERY_MIN_PROGRESS_BYTES:
        progress_now = True
        state["last_progress_epoch"] = now_epoch
    if progress_now:
        state["progress_proven"] = True
        state["baseline_source"] = (
            str(observation.get("baseline_source") or "observed-progress") if not compatible else "observed-progress"
        )
        state["zero_activity_confirmations"] = 0
        state["last_zero_activity_epoch"] = 0

    state["last_pid"] = pid
    state["last_transfer_bytes"] = transfer_bytes
    state["queue_count"] = max(0, int(observation.get("queue_count") or 0))
    state["queue_bytes"] = max(0, int(observation.get("queue_bytes") or 0))
    state["tries"] = max(0, int(observation.get("tries") or 0))
    state["updated_epoch"] = now_epoch

    error_epoch = max(0, int(observation.get("error_epoch") or 0))
    last_progress_epoch = max(0, int(state.get("last_progress_epoch") or 0))
    if error_epoch > last_progress_epoch:
        state["last_error_epoch"] = error_epoch
        state["last_error_category"] = str(observation.get("error_category") or "upload-error")
        state["last_error_signature"] = str(observation.get("error_signature") or "")
    actionable_error = max(0, int(state.get("last_error_epoch") or 0)) > last_progress_epoch

    candidate_size = max(0, int(observation.get("candidate_size") or 0))
    payload_complete = candidate_size > 0 and transfer_bytes >= candidate_size
    if payload_complete:
        payload_complete_epoch = max(0, int(state.get("payload_complete_epoch") or 0))
        if not payload_complete_epoch:
            payload_complete_epoch = last_progress_epoch if compatible and last_progress_epoch else now_epoch
        state["payload_complete_epoch"] = payload_complete_epoch
        error_category = str(observation.get("error_category") or "none")
        completion_reference = max(0, int(state.get("payload_complete_epoch") or now_epoch))
        if (
            error_epoch
            and error_category in FINALIZATION_ERROR_CATEGORIES
            and error_epoch >= completion_reference - POST_FINALIZATION_ERROR_LOOKBACK_SECONDS
        ):
            state["finalization_error_epoch"] = error_epoch
            state["finalization_error_category"] = error_category
            state["finalization_error_signature"] = str(observation.get("error_signature") or "")
    else:
        state["payload_complete_epoch"] = 0
        state["finalization_error_epoch"] = 0
        state["finalization_error_category"] = "none"
        state["finalization_error_signature"] = ""
        state["finalization_confirmations"] = 0
        state["last_finalization_confirmation_epoch"] = 0
    finalization_actionable = payload_complete and max(0, int(state.get("finalization_error_epoch") or 0)) > 0

    def result(
        status: str,
        detail: str,
        *,
        probe: bool = False,
        restart: bool = False,
        restart_kind: str = "none",
    ) -> dict[str, Any]:
        return {
            "state": state,
            "status": status,
            "detail": detail,
            "probe": probe,
            "restart": restart,
            "restart_kind": restart_kind,
        }

    if previous_pid and pid != previous_pid:
        state["progress_proven"] = False
        state["last_progress_epoch"] = 0
        state["last_error_epoch"] = 0
        state["last_error_category"] = "none"
        state["last_error_signature"] = ""
        state["zero_activity_confirmations"] = 0
        state["last_zero_activity_epoch"] = 0
        state["payload_complete_epoch"] = 0
        state["finalization_error_epoch"] = 0
        state["finalization_error_category"] = "none"
        state["finalization_error_signature"] = ""
        state["finalization_confirmations"] = 0
        state["last_finalization_confirmation_epoch"] = 0
        return result(
            "process-changed",
            "The recovery process changed; fresh progress and error evidence are required.",
        )
    if not state.get("progress_proven"):
        return result(
            "observing", "Recovery is pending; no verified payload progress exists for this cache generation yet."
        )
    if payload_complete:
        if not finalization_actionable:
            return result(
                "finalizing",
                "The payload is fully transferred; Proton is still finalizing the remote file.",
            )
        if not observation.get("upload_retry_safe", False):
            return result(
                "upgrade-required",
                "The installed rclone release has an unsafe upload retry; update it before recovery restarts.",
            )
        upload_limit = observation.get("upload_limit")
        if upload_limit is not None and int(upload_limit) <= POST_RECOVERY_NEAR_PAUSE_BYTES:
            state["finalization_confirmations"] = 0
            state["last_finalization_confirmation_epoch"] = 0
            return result(
                "throttled",
                "Finalization restart checks are suspended while upload bandwidth is near pause.",
            )
        if not observation.get("connectivity_healthy", False):
            state["finalization_confirmations"] = 0
            state["last_finalization_confirmation_epoch"] = 0
            return result(
                "network-deferred",
                "Finalization restart checks are deferred until DNS connectivity is healthy.",
            )
        payload_complete_epoch = max(0, int(state.get("payload_complete_epoch") or 0))
        if now_epoch - payload_complete_epoch < POST_FINALIZATION_SETTLE_SECONDS:
            return result(
                "finalizing",
                "The complete payload is inside the bounded Proton finalization grace period.",
            )
        last_restart_epoch = max(0, int(state.get("last_restart_epoch") or 0))
        if last_restart_epoch and now_epoch - last_restart_epoch < POST_FINALIZATION_RESTART_GAP_SECONDS:
            return result(
                "finalization-cooldown",
                "The separate finalization restart is waiting for its minimum recovery gap.",
            )
        if int(state.get("finalization_restart_attempts") or 0) >= POST_FINALIZATION_RESTART_LIMIT:
            return result(
                "finalization-restart-limited",
                "The guarded finalization restart limit for this cache generation has been reached.",
            )
        activity = str(observation.get("activity") or "not-probed")
        if activity == "not-probed":
            return result(
                "probing-finalization",
                "A terminal finalization error is awaiting an independent payload-activity probe.",
                probe=True,
            )
        if activity == "process-changed":
            state["finalization_confirmations"] = 0
            state["last_finalization_confirmation_epoch"] = 0
            return result(
                "process-changed",
                "The process changed during the finalization probe; no restart was requested.",
            )
        if activity == "moving":
            state["finalization_confirmations"] = 0
            state["last_finalization_confirmation_epoch"] = 0
            return result(
                "finalizing",
                "Proton finalization traffic resumed; the terminal error remains observed until completion.",
            )
        if activity != "idle":
            return result("finalizing", "The finalization probe returned no actionable result.")

        confirmations = max(0, int(state.get("finalization_confirmations") or 0))
        last_confirmation = max(0, int(state.get("last_finalization_confirmation_epoch") or 0))
        if not last_confirmation or now_epoch - last_confirmation >= POST_RECOVERY_MIN_CONFIRMATION_SECONDS:
            confirmations = min(POST_RECOVERY_CONFIRMATIONS_REQUIRED, confirmations + 1)
            state["finalization_confirmations"] = confirmations
            state["last_finalization_confirmation_epoch"] = now_epoch
        if confirmations < POST_RECOVERY_CONFIRMATIONS_REQUIRED:
            return result(
                "confirming-finalization",
                "No finalization traffic was measured; one separated observation must confirm the stall.",
            )

        state["finalization_restart_attempts"] = max(0, int(state.get("finalization_restart_attempts") or 0)) + 1
        state["last_restart_epoch"] = now_epoch
        state["finalization_confirmations"] = 0
        state["last_finalization_confirmation_epoch"] = 0
        return result(
            "finalization-restart-requested",
            "A completed-payload finalization stall passed every guard; one controlled restart was requested.",
            restart=True,
            restart_kind="finalization",
        )
    if not actionable_error:
        return result(
            "recovering", "The guarded recovery upload remains protected; no unresolved post-progress error exists."
        )
    upload_limit = observation.get("upload_limit")
    if upload_limit is not None and int(upload_limit) <= POST_RECOVERY_NEAR_PAUSE_BYTES:
        state["zero_activity_confirmations"] = 0
        state["last_zero_activity_epoch"] = 0
        return result("throttled", "Recovery restart checks are suspended while upload bandwidth is near pause.")
    if not observation.get("connectivity_healthy", False):
        state["zero_activity_confirmations"] = 0
        state["last_zero_activity_epoch"] = 0
        return result("network-deferred", "Recovery restart checks are deferred until DNS connectivity is healthy.")
    last_restart_epoch = max(0, int(state.get("last_restart_epoch") or 0))
    if last_restart_epoch and now_epoch - last_restart_epoch < POST_RECOVERY_RESTART_COOLDOWN_SECONDS:
        return result("cooldown", "The guarded recovery restart is still cooling down.")
    if int(state.get("restart_attempts") or 0) >= POST_RECOVERY_RESTART_LIMIT:
        return result("restart-limited", "The guarded restart limit for this cache generation has been reached.")

    activity = str(observation.get("activity") or "not-probed")
    if activity == "not-probed":
        return result("probing", "A post-recovery error is awaiting an independent payload-activity probe.", probe=True)
    if activity == "process-changed":
        state["zero_activity_confirmations"] = 0
        state["last_zero_activity_epoch"] = 0
        return result("process-changed", "The process changed during the activity probe; no restart was requested.")
    if activity == "moving":
        state["progress_proven"] = True
        state["baseline_source"] = "observed-progress"
        state["last_progress_epoch"] = now_epoch
        state["last_error_epoch"] = 0
        state["last_error_category"] = "none"
        state["last_error_signature"] = ""
        state["zero_activity_confirmations"] = 0
        state["last_zero_activity_epoch"] = 0
        return result("recovering", "Verified payload traffic resumed; no restart was requested.")
    if activity != "idle":
        return result("observing", "The payload-activity probe returned no actionable result.")

    confirmations = max(0, int(state.get("zero_activity_confirmations") or 0))
    last_confirmation = max(0, int(state.get("last_zero_activity_epoch") or 0))
    if not last_confirmation or now_epoch - last_confirmation >= POST_RECOVERY_MIN_CONFIRMATION_SECONDS:
        confirmations = min(POST_RECOVERY_CONFIRMATIONS_REQUIRED, confirmations + 1)
        state["zero_activity_confirmations"] = confirmations
        state["last_zero_activity_epoch"] = now_epoch
    if confirmations < POST_RECOVERY_CONFIRMATIONS_REQUIRED:
        return result(
            "confirming-stall",
            "No payload traffic was measured; one separated observation must confirm the recovery stall.",
        )

    state["restart_attempts"] = max(0, int(state.get("restart_attempts") or 0)) + 1
    state["last_restart_epoch"] = now_epoch
    state["zero_activity_confirmations"] = 0
    state["last_zero_activity_epoch"] = 0
    return result(
        "restart-requested",
        "A generation-bound post-recovery stall passed every guard; one controlled restart was requested.",
        restart=True,
        restart_kind="payload",
    )


def dirty_stats(meta_root: pathlib.Path) -> tuple[int, int]:
    count = 0
    size = 0
    if not meta_root.is_dir():
        return count, size
    for path in meta_root.rglob("*"):
        if not path.is_file():
            continue
        try:
            payload = json.loads(path.read_text(encoding="utf-8"))
        except (OSError, json.JSONDecodeError):
            continue
        if isinstance(payload, dict) and payload.get("Dirty") is True:
            count += 1
            size += max(0, int(payload.get("Size") or 0))
    return count, size


def service_action(action: str) -> None:
    completed = run(["systemctl", "--user", action, "--no-block", SERVICE_NAME], timeout=10)
    if completed.returncode != 0:
        raise RecoveryError(completed.stderr.strip() or f"Could not {action} {SERVICE_NAME}")


def wait_inactive(timeout: int = 45) -> None:
    deadline = time.monotonic() + timeout
    while time.monotonic() < deadline:
        pid, _args = service_pid_and_args()
        if pid <= 0:
            return
        time.sleep(1)
    raise RecoveryError("The mount service did not stop within the safety timeout")


def wait_ready(
    expected_namespace: str,
    expected_queue: bool,
    timeout: int = 90,
    *,
    previous_pid: int = 0,
    expected_flag: str = "",
    expected_fingerprint: str = "",
    metadata_cache: bool = False,
    draft_mode: bool = False,
) -> tuple[int, list[dict[str, Any]]]:
    deadline = time.monotonic() + timeout
    last_error = "service not ready"
    while time.monotonic() < deadline:
        try:
            pid, args = service_pid_and_args()
            if pid <= 0:
                raise RecoveryError("service has no main process")
            if previous_pid and pid == previous_pid:
                raise RecoveryError("service still exposes the previous main process")
            if expected_flag and expected_flag not in args:
                raise RecoveryError("rclone is missing the expected recovery runtime flag")
            stats = rc("vfs/stats")
            disk_cache = stats.get("diskCache", {})
            if pathlib.Path(str(disk_cache.get("path") or "")).name != expected_namespace:
                raise RecoveryError("rclone selected an unexpected VFS namespace")
            queue = queue_snapshot()
            if expected_queue and not queue:
                raise RecoveryError("the preserved VFS queue has not appeared yet")
            if expected_fingerprint and not any(
                item_fingerprint(item, metadata_cache, draft_mode) == expected_fingerprint for item in queue
            ):
                raise RecoveryError("the exact protected cache generation has not returned to the VFS queue")
            return pid, queue
        except RecoveryError as error:
            last_error = str(error)
            time.sleep(2)
    raise RecoveryError(f"The restarted mount did not validate: {last_error}")


def restart_recovery_service(
    queue: list[dict[str, Any]],
    metadata_cache: bool,
    fingerprint: str,
) -> tuple[int, list[dict[str, Any]]]:
    """Restart only the current recovery namespace and validate its exact queue generation."""

    expected_namespace = namespace_name(metadata_cache, True)
    pid, args = service_pid_and_args()
    if pid <= 0 or "--protondrive-replace-existing-draft=true" not in args:
        raise RecoveryError("The running mount is not the expected guarded recovery process")
    stats = rc("vfs/stats")
    disk_cache = stats.get("diskCache", {}) if isinstance(stats.get("diskCache"), dict) else {}
    if pathlib.Path(str(disk_cache.get("path") or "")).name != expected_namespace:
        raise RecoveryError("The live VFS namespace changed before the guarded restart")
    before_count = len(queue)
    before_bytes = sum(max(0, int(item.get("size") or 0)) for item in queue)
    dirty_count, dirty_bytes = dirty_stats(CACHE_DIR / "vfsMeta" / expected_namespace)
    if dirty_count < before_count or dirty_bytes < before_bytes:
        raise RecoveryError("Dirty VFS metadata no longer contains the complete protected queue")
    if not any(item_fingerprint(item, metadata_cache, True) == fingerprint for item in queue):
        raise RecoveryError("The guarded restart candidate no longer matches the protected cache generation")

    service_action("restart")
    new_pid, restored_queue = wait_ready(
        expected_namespace,
        expected_queue=True,
        previous_pid=pid,
        expected_flag="--protondrive-replace-existing-draft=true",
        expected_fingerprint=fingerprint,
        metadata_cache=metadata_cache,
        draft_mode=True,
    )
    restored_bytes = sum(max(0, int(item.get("size") or 0)) for item in restored_queue)
    restored_dirty_count, restored_dirty_bytes = dirty_stats(CACHE_DIR / "vfsMeta" / expected_namespace)
    if (
        len(restored_queue) < before_count
        or restored_bytes < before_bytes
        or restored_dirty_count < before_count
        or restored_dirty_bytes < before_bytes
    ):
        raise RecoveryError("The complete protected VFS queue was not restored after restart")
    return new_pid, restored_queue


def move_namespace(source_name: str, target_name: str) -> None:
    moved: list[tuple[pathlib.Path, pathlib.Path]] = []
    pairs = [
        (CACHE_DIR / "vfs" / source_name, CACHE_DIR / "vfs" / target_name),
        (CACHE_DIR / "vfsMeta" / source_name, CACHE_DIR / "vfsMeta" / target_name),
    ]
    for source, target in pairs:
        if not source.is_dir():
            raise RecoveryError(f"Expected VFS namespace is missing: {source}")
        if target.exists():
            raise RecoveryError(f"Refusing to merge with an existing VFS namespace: {target}")
    try:
        for source, target in pairs:
            source.rename(target)
            moved.append((source, target))
    except OSError as error:
        for source, target in reversed(moved):
            if target.exists() and not source.exists():
                target.rename(source)
        raise RecoveryError(f"Could not atomically relocate the VFS namespace: {error}") from error


def recover_namespace(enable: bool, queue: list[dict[str, Any]], metadata_cache: bool) -> None:
    source_name = namespace_name(metadata_cache, not enable)
    target_name = namespace_name(metadata_cache, enable)
    pid, args = service_pid_and_args()
    expected_flag = f"--protondrive-replace-existing-draft={str(not enable).lower()}"
    if pid <= 0 or expected_flag not in args:
        raise RecoveryError("The running mount does not match the expected draft-recovery mode")
    stats = rc("vfs/stats")
    disk_cache = stats.get("diskCache", {}) if isinstance(stats.get("diskCache"), dict) else {}
    if pathlib.Path(str(disk_cache.get("path") or "")).name != source_name:
        raise RecoveryError("The live VFS namespace does not match the calculated safe source")
    before_count = len(queue)
    before_bytes = sum(max(0, int(item.get("size") or 0)) for item in queue)

    service_action("stop")
    wait_inactive()
    moved = False
    config_changed = False
    try:
        source_meta = CACHE_DIR / "vfsMeta" / source_name
        dirty_count, dirty_bytes = dirty_stats(source_meta)
        if enable and (dirty_count < before_count or dirty_bytes < before_bytes):
            raise RecoveryError("Dirty VFS metadata does not contain the complete queued payload")
        if not enable and (before_count or dirty_count):
            raise RecoveryError("Draft recovery cannot be disabled while pending writes remain")
        move_namespace(source_name, target_name)
        moved = True
        write_draft_mode(enable)
        config_changed = True
        service_action("start")
        wait_ready(
            target_name,
            expected_queue=enable and before_count > 0,
            expected_flag=f"--protondrive-replace-existing-draft={str(enable).lower()}",
        )
    except Exception as error:
        try:
            service_action("stop")
            wait_inactive()
        except RecoveryError:
            pass
        if config_changed:
            write_draft_mode(not enable)
        if moved:
            try:
                move_namespace(target_name, source_name)
            except RecoveryError as rollback_error:
                raise RecoveryError(f"{error}; namespace rollback also failed: {rollback_error}") from error
        try:
            service_action("start")
            wait_ready(
                source_name,
                expected_queue=bool(before_count),
                expected_flag=f"--protondrive-replace-existing-draft={str(not enable).lower()}",
            )
        except RecoveryError as rollback_error:
            raise RecoveryError(f"{error}; original mount recovery failed: {rollback_error}") from error
        raise RecoveryError(str(error)) from error


def save_latest(status: str, detail: str, **extra: Any) -> None:
    payload: dict[str, Any] = {
        "generated_at": dt.datetime.now().astimezone().isoformat(timespec="seconds"),
        "status": status,
        "detail": detail,
    }
    payload.update(extra)
    atomic_json(LATEST_STATE, payload)
    print(detail)


def recovery_candidate(
    queue: list[dict[str, Any]], previous: dict[str, Any], metadata_cache: bool
) -> tuple[dict[str, Any] | None, str]:
    previous_fingerprint = str(previous.get("fingerprint") or "")
    candidates: list[tuple[dict[str, Any], str]] = []
    for item in queue:
        if not str(item.get("name") or "") or int(item.get("size") or 0) <= 0:
            continue
        fingerprint = item_fingerprint(item, metadata_cache, True)
        if fingerprint == previous_fingerprint:
            return item, fingerprint
        candidates.append((item, fingerprint))
    if not candidates:
        return None, ""
    candidates.sort(key=lambda candidate: int(candidate[0].get("tries") or 0), reverse=True)
    return candidates[0]


def observe_recovery_queue(
    queue: list[dict[str, Any]], metadata_cache: bool, pid: int
) -> tuple[dict[str, Any], dict[str, Any]]:
    previous = read_json(MONITOR_STATE)
    candidate, fingerprint = recovery_candidate(queue, previous, metadata_cache)
    if candidate is None:
        return previous, {
            "status": "recovering",
            "detail": "The recovery queue is protected, but no exact candidate is currently observable.",
            "probe": False,
            "restart": False,
            "state": previous,
        }
    transfer_bytes, transfer_started_epoch = matching_transfer(candidate)
    baseline_source = "transfer-start"
    if not transfer_started_epoch:
        transfer_started_epoch = process_started_epoch(pid)
        baseline_source = "process-start" if transfer_started_epoch else "observation"
    recovery_started_epoch = recovery_baseline_epoch(
        previous,
        fingerprint,
        transfer_started_epoch,
        int(time.time()),
    )
    error = post_recovery_error(
        str(candidate.get("name") or ""),
        recovery_started_epoch,
        allow_backend_context=len(queue) == 1,
    )
    observation = {
        "now_epoch": int(time.time()),
        "fingerprint": fingerprint,
        "pid": pid,
        "tries": int(candidate.get("tries") or 0),
        "queue_count": len(queue),
        "queue_bytes": sum(max(0, int(item.get("size") or 0)) for item in queue),
        "transfer_bytes": transfer_bytes,
        "candidate_size": max(0, int(candidate.get("size") or 0)),
        "transfer_started_epoch": transfer_started_epoch,
        "baseline_source": baseline_source,
        "error_epoch": error["epoch"],
        "error_category": error["category"],
        "error_signature": error["signature"],
        "upload_limit": effective_upload_limit(),
        "connectivity_healthy": connectivity_healthy(),
        "upload_retry_safe": installed_upload_retry_safe(),
        "activity": "not-probed",
    }
    decision = post_recovery_decision(previous, observation)
    if decision["probe"]:
        activity = probe_payload_activity(pid)
        observation["activity"] = activity["result"]
        observation["now_epoch"] = int(time.time())
        decision = post_recovery_decision(decision["state"], observation)
        decision["activity"] = activity
    return observation, decision


def automatic_recovery(force: bool = False) -> int:
    STATE_DIR.mkdir(mode=0o700, parents=True, exist_ok=True)
    metadata_cache = exact_config(METADATA_CONFIG, "proton_metadata_cache")
    draft_mode = exact_config(DRAFT_CONFIG, "replace_existing_draft")
    pid, args = service_pid_and_args()
    if pid <= 0:
        save_latest("deferred", "Draft recovery deferred because the mount service is not running.")
        return 0
    if not metadata_cache:
        save_latest(
            "inactive",
            "Automatic draft recovery is inactive in parallel-client-compatible metadata mode.",
        )
        MONITOR_STATE.unlink(missing_ok=True)
        return 0
    queue = queue_snapshot()
    if draft_mode:
        if "--protondrive-replace-existing-draft=true" not in args:
            raise RecoveryError("Draft recovery is configured but not active in the running mount")
        if queue:
            _observation, decision = observe_recovery_queue(queue, metadata_cache, pid)
            state = decision["state"]
            atomic_json(MONITOR_STATE, state)
            if decision["restart"]:
                restart_kind = str(decision.get("restart_kind") or "payload")
                try:
                    new_pid, restored_queue = restart_recovery_service(
                        queue,
                        metadata_cache,
                        str(state.get("fingerprint") or ""),
                    )
                except RecoveryError:
                    save_latest(
                        "restart-failed",
                        "The guarded recovery restart failed validation; inspect the user-service journal before intervening.",
                        phase="recovery",
                        progress_proven=bool(state.get("progress_proven")),
                        error_category=state.get("last_error_category", "none"),
                        stall_confirmations=POST_RECOVERY_CONFIRMATIONS_REQUIRED,
                        restart_attempts=int(state.get("restart_attempts") or 0),
                    )
                    return 75
                state["last_pid"] = new_pid
                state["last_transfer_bytes"] = 0
                state["payload_complete_epoch"] = 0
                state["finalization_confirmations"] = 0
                state["last_finalization_confirmation_epoch"] = 0
                state["updated_epoch"] = int(time.time())
                atomic_json(MONITOR_STATE, state)
                finalization_restarts = int(state.get("finalization_restart_attempts") or 0)
                payload_restarts = int(state.get("restart_attempts") or 0)
                save_latest(
                    "finalization-restarted" if restart_kind == "finalization" else "restarted",
                    (
                        "One guarded finalization restart validated the new process and restored the exact protected queue."
                        if restart_kind == "finalization"
                        else "One guarded recovery restart validated the new process and restored the exact protected queue."
                    ),
                    phase="finalization" if restart_kind == "finalization" else "recovery",
                    queue_count=len(restored_queue),
                    progress_proven=True,
                    error_category=(
                        state.get("finalization_error_category", "none")
                        if restart_kind == "finalization"
                        else state.get("last_error_category", "none")
                    ),
                    stall_confirmations=POST_RECOVERY_CONFIRMATIONS_REQUIRED,
                    restart_attempts=payload_restarts + finalization_restarts,
                    finalization_restart_attempts=finalization_restarts,
                )
                return 0
            save_latest(
                decision["status"],
                decision["detail"],
                phase="finalization" if int(state.get("payload_complete_epoch") or 0) else "recovery",
                queue_count=len(queue),
                progress_proven=bool(state.get("progress_proven")),
                error_category=(
                    state.get("finalization_error_category", "none")
                    if int(state.get("payload_complete_epoch") or 0)
                    else state.get("last_error_category", "none")
                ),
                stall_confirmations=(
                    int(state.get("finalization_confirmations") or 0)
                    if int(state.get("payload_complete_epoch") or 0)
                    else int(state.get("zero_activity_confirmations") or 0)
                ),
                restart_attempts=int(state.get("restart_attempts") or 0)
                + int(state.get("finalization_restart_attempts") or 0),
                finalization_restart_attempts=int(state.get("finalization_restart_attempts") or 0),
            )
            return 0
        recover_namespace(False, queue, metadata_cache)
        MONITOR_STATE.unlink(missing_ok=True)
        save_latest("completed", "Draft recovery finished and conservative backend behavior was restored.")
        return 0

    previous = read_json(MONITOR_STATE)
    candidates = [item for item in queue if int(item.get("tries") or 0) >= 2]
    candidates.sort(key=lambda item: int(item.get("tries") or 0), reverse=True)
    candidate = None
    fingerprint = ""
    for item in candidates:
        item_hash = item_fingerprint(item, metadata_cache, draft_mode)
        has_exact_log = recent_draft_conflict(str(item.get("name") or ""))
        has_retained_evidence = previous.get("fingerprint") == item_hash and previous.get("draft_conflict") is True
        if has_exact_log or has_retained_evidence:
            candidate = item
            fingerprint = item_hash
            break
    if candidate is None:
        MONITOR_STATE.unlink(missing_ok=True)
        save_latest("healthy", "No persistent Proton upload draft conflict is awaiting recovery.")
        return 0
    if payload_is_moving(pid):
        atomic_json(
            MONITOR_STATE,
            {
                "fingerprint": fingerprint,
                "draft_conflict": True,
                "confirmations": max(1, int(previous.get("confirmations") or 1)),
                "tries": int(candidate.get("tries") or 0),
                "updated_at": dt.datetime.now().astimezone().isoformat(timespec="seconds"),
            },
        )
        save_latest("active", "Real upload traffic is moving; automatic draft recovery did not intervene.")
        return 0

    tries = int(candidate.get("tries") or 0)
    confirmations = 1
    if previous.get("fingerprint") == fingerprint:
        confirmations = max(1, int(previous.get("confirmations") or 1))
        if tries > int(previous.get("tries") or 0):
            confirmations += 1
    atomic_json(
        MONITOR_STATE,
        {
            "fingerprint": fingerprint,
            "draft_conflict": True,
            "confirmations": min(confirmations, CONFIRMATIONS_REQUIRED),
            "tries": tries,
            "updated_at": dt.datetime.now().astimezone().isoformat(timespec="seconds"),
        },
    )
    if not force and confirmations < CONFIRMATIONS_REQUIRED:
        save_latest(
            "confirming",
            "A draft conflict was observed without payload traffic; one later retry must confirm it.",
            confirmations=confirmations,
        )
        return 0

    recover_namespace(True, queue, metadata_cache)
    recovery_queue = queue_snapshot()
    recovery_item, recovery_fingerprint = recovery_candidate(recovery_queue, {}, metadata_cache)
    now_epoch = int(time.time())
    recovery_state = {
        "state_version": POST_RECOVERY_STATE_VERSION,
        "phase": "recovery",
        "fingerprint": recovery_fingerprint,
        "recovery_started_epoch": now_epoch,
        "progress_proven": False,
        "last_transfer_bytes": 0,
        "last_progress_epoch": 0,
        "last_error_epoch": 0,
        "last_error_category": "none",
        "last_error_signature": "",
        "zero_activity_confirmations": 0,
        "last_zero_activity_epoch": 0,
        "restart_attempts": 0,
        "last_restart_epoch": 0,
        "payload_complete_epoch": 0,
        "finalization_error_epoch": 0,
        "finalization_error_category": "none",
        "finalization_error_signature": "",
        "finalization_confirmations": 0,
        "last_finalization_confirmation_epoch": 0,
        "finalization_restart_attempts": 0,
        "last_pid": service_pid_and_args()[0],
        "baseline_source": "transition",
        "queue_count": len(recovery_queue),
        "queue_bytes": sum(max(0, int(item.get("size") or 0)) for item in recovery_queue),
        "tries": int(recovery_item.get("tries") or 0) if recovery_item else 0,
        "updated_epoch": now_epoch,
    }
    atomic_json(MONITOR_STATE, recovery_state)
    save_latest(
        "recovery-started",
        "A confirmed draft conflict entered the guarded one-shot recovery namespace.",
        phase="recovery",
        queue_count=len(queue),
        progress_proven=False,
        error_category="none",
        stall_confirmations=0,
        restart_attempts=0,
    )
    return 0


def parser() -> argparse.ArgumentParser:
    result = argparse.ArgumentParser(description=__doc__)
    mode = result.add_mutually_exclusive_group(required=True)
    mode.add_argument("--auto", action="store_true", help="run one guarded timer observation")
    mode.add_argument(
        "--recover-now", action="store_true", help="apply all guards but skip the second timer observation"
    )
    mode.add_argument("--namespace", choices=("normal", "recovery"), help=argparse.SUPPRESS)
    return result


def main() -> int:
    args = parser().parse_args()
    if args.namespace:
        metadata_cache = exact_config(METADATA_CONFIG, "proton_metadata_cache")
        print(namespace_name(metadata_cache, args.namespace == "recovery"))
        return 0
    lock_path = STATE_DIR / "pdrive-draft-recovery.lock"
    lock_path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    with lock_path.open("w", encoding="utf-8") as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            print("Another guarded draft-recovery check is already running.")
            return 0
        try:
            return automatic_recovery(force=args.recover_now)
        except RecoveryError as error:
            save_latest("error", str(error))
            return 75


if __name__ == "__main__":
    sys.exit(main())
