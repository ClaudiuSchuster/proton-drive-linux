#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-3.0-or-later

set -euo pipefail

script_path="$(readlink -f -- "${BASH_SOURCE[0]}")"
project_root="$(cd -- "$(dirname -- "${script_path}")/.." && pwd -P)"
readonly rclone_bin="${HOME}/.local/libexec/rclone-bin"
readonly prerequisite_bin="${PDRIVE_PREREQUISITES_BIN:-${project_root}/bin/pdrive-prerequisites}"
before="$(${rclone_bin} version | head -n 1)"
"${prerequisite_bin}" --install-rclone
after="$(${rclone_bin} version | head -n 1)"

if [[ "${before}" != "${after}" ]]; then
    printf '%s\n' \
        "Updated ${before} to ${after}." \
        'The running mount was deliberately left untouched; the new binary is used on its next natural start.'
fi
