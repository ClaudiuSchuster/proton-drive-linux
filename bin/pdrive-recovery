#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-3.0-or-later

set -euo pipefail
umask 077

readonly recovery_config="${HOME}/.config/pdrive-recovery.conf"
readonly service_name='rclone-proton-drive.service'
readonly vfs_meta_root="${HOME}/.cache/rclone/vfsMeta"

usage() {
    printf '%s\n' \
        'Usage: pdrive-recovery [OPTION]' \
        '' \
        'No option: show the configured and running Proton metadata-cache mode.' \
        '--enable:  enable fast exclusive mode for the next service instance.' \
        '--disable: use parallel-client-compatible mode for the next instance.' \
        '-h, --help: show only this action-free help.' \
        '' \
        "Configuration: ${recovery_config}" \
        'Changing the mode deliberately does not restart rclone.' \
        'With caching enabled, do not write through Web, mobile or another client' \
        'while rclone is running. A real stop discards the in-memory cache.'
}

read_configured_mode() {
    local entries

    if [[ ! -e "${recovery_config}" ]]; then
        printf 'false\n'
        return 0
    fi
    if [[ ! -r "${recovery_config}" ]]; then
        printf 'Configuration is not readable: %s\n' "${recovery_config}" >&2
        return 78
    fi
    entries="$(awk '
        /^[[:space:]]*($|#)/ { next }
        { print }
    ' "${recovery_config}")"
    if [[ "${entries}" =~ ^proton_metadata_cache=(true|false)$ ]]; then
        printf '%s\n' "${BASH_REMATCH[1]}"
        return 0
    fi
    printf 'Invalid metadata-cache configuration: %s\n' "${recovery_config}" >&2
    return 78
}

write_configured_mode() {
    local value="$1"
    local config_dir config_tmp

    config_dir="${recovery_config%/*}"
    mkdir -p -- "${config_dir}"
    config_tmp="$(mktemp "${config_dir}/pdrive-recovery.conf.XXXXXX")"
    printf '%s\n' \
        '# Managed by pdrive-recovery; never evaluate as shell code.' \
        '# Use true only for exclusive rclone access without parallel external writes.' \
        "proton_metadata_cache=${value}" > "${config_tmp}"
    mv -f -- "${config_tmp}" "${recovery_config}"
}

running_mode() {
    local pid args

    pid="$(systemctl --user show "${service_name}" -p MainPID --value --no-pager 2>/dev/null || printf '0')"
    if [[ ! "${pid}" =~ ^[1-9][0-9]*$ ]]; then
        printf 'service is not running'
        return 0
    fi
    args="$(ps -ww -p "${pid}" -o args= 2>/dev/null || true)"
    case "${args}" in
        *--protondrive-enable-caching=true*) printf 'enabled (PID %s)' "${pid}" ;;
        *--protondrive-enable-caching=false*) printf 'disabled (PID %s)' "${pid}" ;;
        *) printf 'unknown (PID %s)' "${pid}" ;;
    esac
}

dirty_file_count() {
    if [[ ! -d "${vfs_meta_root}" ]]; then
        printf '0\n'
        return 0
    fi
    find "${vfs_meta_root}" -mindepth 2 -type f -path '*/proton*/*' -print0 2>/dev/null \
        | xargs -0 -r jq -r 'select(.Dirty == true) | 1' 2>/dev/null \
        | awk '{ count += $1 } END { print count + 0 }'
}

show_status() {
    local configured configured_text running

    configured="$(read_configured_mode)"
    if [[ "${configured}" == 'true' ]]; then
        configured_text='ENABLED – fast exclusive mode'
    else
        configured_text='disabled – parallel-client-compatible mode'
    fi
    running="$(running_mode)"

    printf 'Proton Drive metadata cache\n\n'
    printf 'Configured: %s\n' "${configured_text}"
    printf 'Running:    %s\n' "${running}"
    printf 'File:       %s\n' "${recovery_config}"
    if [[ "${configured}" == 'true' ]]; then
        printf '%s\n' \
            'IMPORTANT: Do not write through Proton Web, the mobile app, the official' \
            'CLI or a second rclone client while this service runs. Stopping the' \
            'service discards the in-memory cache.'
    fi
    if { [[ "${configured}" == 'true' && "${running}" != enabled* ]] \
        || [[ "${configured}" == 'false' && "${running}" == enabled* ]]; }; then
        printf '%s\n' \
            'Note: The configuration applies after a controlled service restart.' \
            'Run interactively: pdrive-watch --restart-service'
    fi
}

case "${1:-}" in
    '')
        show_status
        ;;
    --enable)
        (( $# == 1 )) || { usage >&2; exit 2; }
        write_configured_mode true
        printf '%s\n' \
            'Fast Proton metadata caching was enabled atomically; the running service was left untouched.' \
            'Do not write through another Proton client while the service runs.'
        show_status
        ;;
    --disable)
        (( $# == 1 )) || { usage >&2; exit 2; }
        configured_before="$(read_configured_mode)"
        if [[ "${configured_before}" == 'true' ]]; then
            printf 'Checking all Proton VFS metadata for pending writes before disabling ...\n'
            dirty_before="$(dirty_file_count)"
            if [[ ! "${dirty_before}" =~ ^[0-9]+$ || "${dirty_before}" != '0' ]]; then
                printf '%s\n' \
                    "Refused: ${dirty_before:-unknown} Dirty file(s) remain in the local Proton VFS cache." \
                    'Metadata caching remains enabled so a new instance cannot miss this queue.' \
                    'Check status with: pdrive-watch' >&2
                exit 75
            fi
        fi
        write_configured_mode false
        printf '%s\n' \
            'Parallel-client-compatible mode was saved atomically; the running service was left untouched.'
        show_status
        ;;
    -h|--help)
        (( $# == 1 )) || { usage >&2; exit 2; }
        usage
        ;;
    *)
        printf 'Unknown option: %s\n\n' "$1" >&2
        usage >&2
        exit 2
        ;;
esac
