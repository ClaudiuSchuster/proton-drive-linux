#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-3.0-or-later

set -uo pipefail

readonly mount_dir='/pdrive'
readonly config_file="${HOME}/.config/rclone/rclone.conf"
readonly rclone_bin="${HOME}/.local/bin/rclone"
readonly rclone_real="${HOME}/.local/libexec/rclone-bin"
readonly mount_log="${HOME}/.local/state/rclone/proton-mount.log"

usage() {
    printf '%s\n' \
        'Usage: pdrive-doctor [--online]' \
        '' \
        'No option: detailed, entirely local Proton Drive diagnostics.' \
        '           Reads service, mount, Keyring availability, redacted rclone' \
        '           configuration, packages, timers, storage and logs.' \
        '           No Proton login, API call, restart or file/configuration change.' \
        '--online:  add exactly one directory check bounded to 60 seconds.' \
        '           Never use it during an HTTP 429 cooldown.' \
        '-h, --help: show only this guaranteed action-free help.'
}

online_mode=false
case "${1:-}" in
    '') ;;
    --online) online_mode=true ;;
    -h|--help)
        if (( $# != 1 )); then
            printf 'Too many arguments (help: pdrive-doctor --help).\n' >&2
            exit 2
        fi
        usage
        exit 0
        ;;
    *)
        printf 'Unknown option: %s (help: pdrive-doctor --help)\n' "$1" >&2
        exit 2
        ;;
esac
if (( $# > 1 )); then
    printf 'At most one option is allowed (help: pdrive-doctor --help).\n' >&2
    exit 2
fi

section() {
    printf '\n== %s ==\n' "$1"
}

section 'Basics'
date --iso-8601=seconds
printf 'User: %s (UID %s)\n' "${USER:-unknown}" "$(id -u)"
pretty_name="$(sed -n 's/^PRETTY_NAME=//p' /etc/os-release 2>/dev/null | tr -d '"')"
version_codename="$(sed -n 's/^VERSION_CODENAME=//p' /etc/os-release 2>/dev/null | tr -d '"')"
printf 'System: %s %s; Kernel %s\n' "${pretty_name:-unknown}" "${version_codename}" "$(uname -r)"
if [[ -x "${rclone_real}" ]]; then
    "${rclone_real}" version | sed -n '1,5p'
else
    echo 'MISSING: ~/.local/libexec/rclone-bin'
fi

section 'Mount and service'
printf 'enabled: %s\n' "$(systemctl --user is-enabled rclone-proton-drive.service 2>&1 || true)"
printf 'active:  %s\n' "$(systemctl --user is-active rclone-proton-drive.service 2>&1 || true)"
systemctl --user show rclone-proton-drive.service \
    -p SubState -p Result -p ExecMainStatus -p NRestarts --no-pager 2>/dev/null || true
if mountpoint -q -- "${mount_dir}"; then
    printf 'Mountpoint: OK (%s)\n' "${mount_dir}"
    findmnt -M "${mount_dir}" -o TARGET,SOURCE,FSTYPE,OPTIONS
else
    echo 'Mountpoint: NOT mounted'
fi

section 'Keyring and encrypted configuration'
if timeout --signal=TERM 5s secret-tool lookup service rclone account proton-drive >/dev/null 2>&1; then
    echo 'GNOME Keyring entry: OK'
else
    echo 'GNOME Keyring entry: unavailable or locked'
fi
if [[ -r "${config_file}" ]] && timeout --signal=TERM 10s "${rclone_bin}" \
    --config="${config_file}" listremotes 2>/dev/null | grep -qx 'proton:'; then
    echo 'rclone configuration: decryptable, proton: remote present'
    "${rclone_bin}" --config="${config_file}" config redacted 2>/dev/null \
        | awk '
            /^\[proton\]/ { in_remote=1; next }
            /^\[/ { in_remote=0 }
            in_remote && /^[[:space:]]*(client_uid|client_access_token|client_refresh_token|client_salted_key_pass|2fa)[[:space:]]*=/ {
                line=$0
                key=line
                sub(/=.*/, "", key)
                gsub(/[[:space:]]/, "", key)
                value=line
                sub(/^[^=]*=[[:space:]]*/, "", value)
                printf "%s: %s\n", key, (length(value) ? "present" : "empty")
            }
        '
else
    echo 'rclone configuration: MISSING or not decryptable'
fi

section 'Required packages'
for package in fuse3 libfuse3-3 libsecret-tools gnome-keyring libpam-gnome-keyring \
    jq curl openssl iproute2 libnotify-bin python3-gi python3-gi-cairo \
    gir1.2-gtk-3.0 gir1.2-ayatanaappindicator3-0.1 librsvg2-common; do
    status="$(dpkg-query -W -f='${db:Status-Abbrev} ${Version}' "${package}" 2>/dev/null || true)"
    printf '%-24s %s\n' "${package}" "${status:-MISSING}"
done

section 'Update timers'
systemctl --user list-timers --all --no-pager 2>/dev/null \
    | grep -E 'rclone-selfupdate|proton-drive-update|NEXT|^-' || true

section 'Storage and local caches'
df -h --output=target,size,used,avail,pcent "${HOME}" | sed -n '1,2p'
du -sh "${HOME}/.cache/rclone" 2>/dev/null || echo "${HOME}/.cache/rclone: not present"
if command -v pdrive-cache-age >/dev/null 2>&1; then
    pdrive-cache-age status || true
fi

section 'Latest service messages'
journalctl --user -u rclone-proton-drive.service -n 25 --no-pager -o short-iso 2>/dev/null || true

section 'Latest relevant rclone messages'
if [[ -r "${mount_log}" ]]; then
    tr -d '\000' < "${mount_log}" \
        | grep -E 'NOTICE|ERROR|CRITICAL|429|422|CAPTCHA|timeout|rate|password|credentials' \
        | tail -n 25 || true
else
    echo 'No mount log exists yet.'
fi

if [[ "${online_mode}" == true ]]; then
    section 'Explicit online check'
    echo 'Running one API check bounded to 60 seconds.'
    if timeout --signal=TERM 60s "${rclone_bin}" \
        --config="${config_file}" --low-level-retries=0 --retries=1 \
        lsd proton: --max-depth 1 >/dev/null; then
        echo 'Proton API and saved session: OK'
    else
        echo 'Online check: FAILED (do not repeat after HTTP 429)'
    fi
fi

printf '\nNote: Without --online this tool makes no Proton login attempt.\n'
