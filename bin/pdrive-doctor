#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-3.0-or-later

set -uo pipefail

readonly mount_dir='/pdrive'
readonly config_file="${HOME}/.config/rclone/rclone.conf"
readonly rclone_bin="${HOME}/.local/bin/rclone"
readonly rclone_real="${HOME}/.local/libexec/rclone-bin"
readonly mount_log="${HOME}/.local/state/rclone/proton-mount.log"

usage() {
    printf '%s\n' \
        'Aufruf: pdrive-doctor [--online]' \
        '' \
        'Ohne Option: ausführliche, rein lokale Proton-Drive-Diagnose.' \
        '             Liest Dienst, Mount, Keyring-Verfügbarkeit, redigierte' \
        '             rclone-Konfiguration, Pakete, Timer, Speicher und Logs.' \
        '             Kein Proton-Login, kein API-Aufruf, kein Neustart und' \
        '             keine Änderung an Mount, Konfiguration oder Dateien.' \
        '--online:    zusätzlich genau einen auf 60 Sekunden begrenzten' \
        '             Proton-API-Verzeichnistest ausführen.' \
        '             Während einer HTTP-429-Sperre niemals verwenden.' \
        '-h, --help:  nur diese Hilfe anzeigen; garantiert aktionsfrei.'
}

online_mode=false
case "${1:-}" in
    '') ;;
    --online) online_mode=true ;;
    -h|--help)
        if (( $# != 1 )); then
            printf 'Zu viele Argumente (Hilfe: pdrive-doctor --help).\n' >&2
            exit 2
        fi
        usage
        exit 0
        ;;
    *)
        printf 'Unbekannte Option: %s (Hilfe: pdrive-doctor --help)\n' "$1" >&2
        exit 2
        ;;
esac
if (( $# > 1 )); then
    printf 'Es ist höchstens eine Option erlaubt (Hilfe: pdrive-doctor --help).\n' >&2
    exit 2
fi

section() {
    printf '\n== %s ==\n' "$1"
}

section 'Basis'
date --iso-8601=seconds
printf 'Benutzer: %s (UID %s)\n' "${USER:-unknown}" "$(id -u)"
pretty_name="$(sed -n 's/^PRETTY_NAME=//p' /etc/os-release 2>/dev/null | tr -d '"')"
version_codename="$(sed -n 's/^VERSION_CODENAME=//p' /etc/os-release 2>/dev/null | tr -d '"')"
printf 'System: %s %s; Kernel %s\n' "${pretty_name:-unknown}" "${version_codename}" "$(uname -r)"
if [[ -x "${rclone_real}" ]]; then
    "${rclone_real}" version | sed -n '1,5p'
else
    echo 'FEHLT: ~/.local/libexec/rclone-bin'
fi

section 'Mount und Dienst'
printf 'enabled: %s\n' "$(systemctl --user is-enabled rclone-proton-drive.service 2>&1 || true)"
printf 'active:  %s\n' "$(systemctl --user is-active rclone-proton-drive.service 2>&1 || true)"
systemctl --user show rclone-proton-drive.service \
    -p SubState -p Result -p ExecMainStatus -p NRestarts --no-pager 2>/dev/null || true
if mountpoint -q -- "${mount_dir}"; then
    printf 'Mountpoint: OK (%s)\n' "${mount_dir}"
    findmnt -M "${mount_dir}" -o TARGET,SOURCE,FSTYPE,OPTIONS
else
    echo 'Mountpoint: NICHT gemountet'
fi

section 'Keyring und verschlüsselte Konfiguration'
if timeout --signal=TERM 5s secret-tool lookup service rclone account proton-drive >/dev/null 2>&1; then
    echo 'GNOME-Keyring-Eintrag: OK'
else
    echo 'GNOME-Keyring-Eintrag: NICHT verfügbar/gesperrt'
fi
if [[ -r "${config_file}" ]] && timeout --signal=TERM 10s "${rclone_bin}" \
    --config="${config_file}" listremotes 2>/dev/null | grep -qx 'proton:'; then
    echo 'rclone-Konfiguration: entschlüsselbar, Remote proton: vorhanden'
    "${rclone_bin}" --config="${config_file}" config redacted 2>/dev/null \
        | awk '
            /^\[proton\]/ { in_remote=1; next }
            /^\[/ { in_remote=0 }
            in_remote && /^[[:space:]]*(client_uid|client_access_token|client_refresh_token|client_salted_key_pass|2fa)[[:space:]]*=/ {
                line=$0
                key=line
                sub(/=.*/, "", key)
                gsub(/[[:space:]]/, "", key)
                value=line
                sub(/^[^=]*=[[:space:]]*/, "", value)
                printf "%s: %s\n", key, (length(value) ? "vorhanden" : "leer")
            }
        '
else
    echo 'rclone-Konfiguration: FEHLT oder nicht entschlüsselbar'
fi

section 'Benötigte Pakete'
for package in fuse3 libfuse3-3 libsecret-tools gnome-keyring libpam-gnome-keyring \
    jq curl openssl iproute2 libnotify-bin; do
    status="$(dpkg-query -W -f='${db:Status-Abbrev} ${Version}' "${package}" 2>/dev/null || true)"
    printf '%-24s %s\n' "${package}" "${status:-FEHLT}"
done

section 'Update-Timer'
systemctl --user list-timers --all --no-pager 2>/dev/null \
    | grep -E 'rclone-selfupdate|proton-drive-update|NEXT|^-' || true

section 'Speicher und lokale Caches'
df -h --output=target,size,used,avail,pcent "${HOME}" | sed -n '1,2p'
du -sh "${HOME}/.cache/rclone" 2>/dev/null || echo "${HOME}/.cache/rclone: nicht vorhanden"

section 'Letzte Dienstmeldungen'
journalctl --user -u rclone-proton-drive.service -n 25 --no-pager -o short-iso 2>/dev/null || true

section 'Letzte relevante rclone-Meldungen'
if [[ -r "${mount_log}" ]]; then
    tr -d '\000' < "${mount_log}" \
        | grep -E 'NOTICE|ERROR|CRITICAL|429|422|CAPTCHA|timeout|rate|password|credentials' \
        | tail -n 25 || true
else
    echo 'Noch kein Mount-Log vorhanden.'
fi

if [[ "${online_mode}" == true ]]; then
    section 'Expliziter Online-Test'
    echo 'Ein einzelner, auf 60 Sekunden begrenzter API-Test wird ausgeführt.'
    if timeout --signal=TERM 60s "${rclone_bin}" \
        --config="${config_file}" --low-level-retries=0 --retries=1 \
        lsd proton: --max-depth 1 >/dev/null; then
        echo 'Proton-API und gespeicherte Sitzung: OK'
    else
        echo 'Online-Test: FEHLGESCHLAGEN (bei HTTP 429 nicht wiederholen)'
    fi
fi

printf '\nHinweis: Ohne --online führt dieses Werkzeug keinen Proton-Loginversuch aus.\n'
