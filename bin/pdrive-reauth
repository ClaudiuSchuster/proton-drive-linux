#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-3.0-or-later

set -euo pipefail
umask 077

readonly state_dir="${HOME}/.local/state/rclone"
readonly reauth_backend="${PDRIVE_REAUTH_BACKEND:-${HOME}/.local/libexec/reauth-rclone-proton}"

usage() {
    printf '%s\n' \
        'Aufruf: pdrive-reauth' \
        '        pdrive-reauth --reauth' \
        '        pdrive-reauth --help' \
        '' \
        'Interaktive Notfall-Reautorisierung für den rclone-Proton-Drive-Mount.' \
        'Nur verwenden, wenn Sitzungstoken ungültig sind, sich das Proton-Passwort' \
        'geändert hat oder pdrive-doctor ausdrücklich auf Authentifizierung weist.' \
        '' \
        'Ohne Option wird nur diese aktionsfreie Orientierung angezeigt.' \
        '--reauth startet den interaktiven Notfallablauf.' \
        '-h und --help zeigen ebenfalls ausschließlich diese Hilfe.' \
        '' \
        'Der Lauf mit --reauth:' \
        '  1. verlangt zuerst die exakte Bestätigung JA;' \
        '  2. liest Benutzername, Passwort und optionalen 2FA-Code verdeckt ein;' \
        '  3. testet eine neue verschlüsselte Konfiguration isoliert und genau einmal;' \
        '  4. lässt bei Fehlschlag Dienst und vorhandene Konfiguration unangetastet;' \
        '  5. stoppt erst nach Erfolg, sichert rclone.conf und ersetzt sie atomar;' \
        '  6. entfernt den einmaligen 2FA-Code und validiert den neuen Mount.' \
        '' \
        'Nach HTTP 429 erst die vollständige Proton-Sperrzeit abwarten.' \
        'Ohne Option sowie mit --help: kein Prompt, kein Login, kein Dienststopp' \
        'und keine Dateiänderung.'
}

case "${1:-}" in
    '')
        if (( $# != 0 )); then
            printf 'Zu viele Argumente (Hilfe: pdrive-reauth --help).\n' >&2
            exit 2
        fi
        usage
        exit 0
        ;;
    --reauth)
        if (( $# != 1 )); then
            printf 'Zu viele Argumente (Hilfe: pdrive-reauth --help).\n' >&2
            exit 2
        fi
        ;;
    -h|--help)
        if (( $# != 1 )); then
            printf 'Zu viele Argumente (Hilfe: pdrive-reauth --help).\n' >&2
            exit 2
        fi
        usage
        exit 0
        ;;
    *)
        printf 'Unbekannte Option: %s (Hilfe: pdrive-reauth --help)\n' "$1" >&2
        exit 2
        ;;
esac

if [[ ! -t 0 || ! -t 1 ]]; then
    echo 'Bitte diesen Befehl in einem normalen Terminal ausführen.' >&2
    exit 64
fi

if [[ ! -x "${reauth_backend}" ]]; then
    printf 'Reauthentication backend is missing: %s\n' "${reauth_backend}" >&2
    exit 69
fi

echo 'Proton-Drive-rclone-Autorisierung'
echo
echo 'Wichtig: Nach HTTP 429 erst warten, bis Protons Login-Sperre abgelaufen ist.'
latest_rate_limit="$(tr -d '\000' < "${state_dir}/proton-mount.log" 2>/dev/null \
    | grep '429 POST .*auth/v4' | tail -n 1 || true)"
if [[ -n "${latest_rate_limit}" ]]; then
    printf 'Letzter protokollierter 429-Fehler: %.19s\n' "${latest_rate_limit}"
fi
echo 'Dieser Helfer testet genau einmal und stoppt den Mount erst nach erfolgreichem Login.'
echo
read -r -p 'Ist die Sperrzeit sicher abgelaufen? Zum Fortfahren REAUTH eingeben: ' answer
if [[ "${answer}" != 'REAUTH' ]]; then
    echo 'Abgebrochen; es wurde nichts geändert.'
    exit 0
fi

read -r -p 'Proton-Benutzername oder E-Mail-Adresse: ' proton_username
if [[ -z "${proton_username}" ]]; then
    echo 'Ein leerer Benutzername ist nicht zulässig.' >&2
    exit 65
fi
read -r -s -p 'Aktuelles Proton-Kontopasswort: ' proton_password
echo
if [[ -z "${proton_password}" ]]; then
    echo 'Ein leeres Passwort ist nicht zulässig.' >&2
    exit 65
fi
read -r -s -p 'Passwort wiederholen: ' proton_password_confirm
echo
if [[ "${proton_password}" != "${proton_password_confirm}" ]]; then
    unset proton_password proton_password_confirm
    echo 'Die Passwörter stimmen nicht überein.' >&2
    exit 65
fi
unset proton_password_confirm

read -r -s -p 'Aktueller 6-stelliger 2FA-Code (leer, falls 2FA aus ist): ' proton_2fa
echo
if [[ -n "${proton_2fa}" && ! "${proton_2fa}" =~ ^[0-9]{6}$ ]]; then
    unset proton_password proton_2fa
    echo 'Der 2FA-Code muss leer oder genau sechsstellig sein.' >&2
    exit 65
fi

set +e
printf '%s\0' "${proton_username}" "${proton_password}" "${proton_2fa}" \
    | "${reauth_backend}" --reauth-from-stdin
reauth_rc=$?
set -e
unset proton_username proton_password proton_2fa
exit "${reauth_rc}"
