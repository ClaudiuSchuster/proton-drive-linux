#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-3.0-or-later

set -euo pipefail
umask 077

readonly state_dir="${HOME}/.local/state/rclone"
readonly reauth_backend="${PDRIVE_REAUTH_BACKEND:-${HOME}/.local/libexec/reauth-rclone-proton}"

usage() {
    printf '%s\n' \
        'Usage: pdrive-reauth' \
        '        pdrive-reauth --reauth' \
        '        pdrive-reauth --help' \
        '' \
        'Interactive emergency reauthorization for the rclone Proton Drive mount.' \
        'Use only when session tokens are invalid, the Proton password changed,' \
        'or pdrive-doctor explicitly reports an authentication problem.' \
        '' \
        'No option shows only this action-free guidance.' \
        '--reauth starts the interactive emergency workflow.' \
        '-h and --help also show only this help.' \
        '' \
        'The --reauth workflow:' \
        '  1. first requires the exact confirmation REAUTH;' \
        '  2. keeps the existing account and reads password and 2FA privately;' \
        '  3. tests one new encrypted configuration in isolation;' \
        '  4. leaves the service and configuration unchanged on failure;' \
        '  5. stops only after success, backs up rclone.conf and replaces it atomically;' \
        '  6. removes the one-time 2FA code and validates the new mount.' \
        '' \
        'After HTTP 429, wait for the complete Proton cooldown.' \
        'No option and --help: no prompt, login, service stop or file change.'
}

case "${1:-}" in
    '')
        if (( $# != 0 )); then
            printf 'Too many arguments (help: pdrive-reauth --help).\n' >&2
            exit 2
        fi
        usage
        exit 0
        ;;
    --reauth)
        if (( $# != 1 )); then
            printf 'Too many arguments (help: pdrive-reauth --help).\n' >&2
            exit 2
        fi
        ;;
    -h|--help)
        if (( $# != 1 )); then
            printf 'Too many arguments (help: pdrive-reauth --help).\n' >&2
            exit 2
        fi
        usage
        exit 0
        ;;
    *)
        printf 'Unknown option: %s (help: pdrive-reauth --help)\n' "$1" >&2
        exit 2
        ;;
esac

if [[ ! -t 0 || ! -t 1 ]]; then
    echo 'Run this command in a normal interactive terminal.' >&2
    exit 64
fi

if [[ ! -x "${reauth_backend}" ]]; then
    printf 'Reauthentication backend is missing: %s\n' "${reauth_backend}" >&2
    exit 69
fi

echo 'Proton Drive rclone authorization'
echo
echo 'Important: After HTTP 429, wait until the complete Proton login cooldown has expired.'
latest_rate_limit="$(tr -d '\000' < "${state_dir}/proton-mount.log" 2>/dev/null \
    | grep '429 POST .*auth/v4' | tail -n 1 || true)"
if [[ -n "${latest_rate_limit}" ]]; then
    printf 'Latest recorded HTTP 429: %.19s\n' "${latest_rate_limit}"
fi
echo 'This helper makes one attempt and stops the mount only after a successful login.'
echo
read -r -p 'Has the cooldown definitely expired? Enter REAUTH to continue: ' answer
if [[ "${answer}" != 'REAUTH' ]]; then
    echo 'Cancelled; nothing was changed.'
    exit 0
fi

read -r -s -p 'Current Proton account password: ' proton_password
echo
if [[ -z "${proton_password}" ]]; then
    echo 'The password must not be empty.' >&2
    exit 65
fi
read -r -s -p 'Current 6-digit 2FA code (empty when 2FA is disabled): ' proton_2fa
echo
if [[ -n "${proton_2fa}" && ! "${proton_2fa}" =~ ^[0-9]{6}$ ]]; then
    unset proton_password proton_2fa
    echo 'The 2FA code must be empty or exactly six digits.' >&2
    exit 65
fi

set +e
printf '%s\0' '' "${proton_password}" "${proton_2fa}" \
    | "${reauth_backend}" --reauth-from-stdin
reauth_rc=$?
set -e
unset proton_password proton_2fa
exit "${reauth_rc}"
