#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-3.0-or-later

set -euo pipefail
umask 077

readonly draft_config="${HOME}/.config/pdrive-draft-recovery.conf"
readonly recovery_config="${HOME}/.config/pdrive-recovery.conf"
readonly service_name='rclone-proton-drive.service'
readonly vfs_meta_root="${HOME}/.cache/rclone/vfsMeta"

usage() {
    printf '%s\n' \
        'Aufruf: pdrive-draft-recovery [OPTION]' \
        '' \
        'Ohne Option: konfigurierten und laufenden Draft-Recovery-Modus anzeigen.' \
        '--enable:  unvollständige Proton-Upload-Drafts beim nächsten Upload ersetzen.' \
        '--disable: konservatives Verhalten wiederherstellen; nur bei leerer Dirty-Queue.' \
        '-h, --help: nur diese Hilfe anzeigen.' \
        '' \
        "Konfiguration: ${draft_config}" \
        'Die Umschaltung startet rclone absichtlich nicht selbst neu.' \
        'WARNUNG: Aktivieren verändert beim nächsten Upload serverseitige Drafts.'
}

read_configured_mode() {
    local entries

    if [[ ! -e "${draft_config}" ]]; then
        printf 'false\n'
        return 0
    fi
    if [[ ! -r "${draft_config}" ]]; then
        printf 'Konfiguration ist nicht lesbar: %s\n' "${draft_config}" >&2
        return 78
    fi
    entries="$(awk '
        /^[[:space:]]*($|#)/ { next }
        { print }
    ' "${draft_config}")"
    if [[ "${entries}" =~ ^replace_existing_draft=(true|false)$ ]]; then
        printf '%s\n' "${BASH_REMATCH[1]}"
        return 0
    fi
    printf 'Ungültige Draft-Recovery-Konfiguration: %s\n' "${draft_config}" >&2
    return 78
}

metadata_recovery_is_enabled() {
    local entries

    [[ -r "${recovery_config}" ]] || return 1
    entries="$(awk '
        /^[[:space:]]*($|#)/ { next }
        { print }
    ' "${recovery_config}")"
    [[ "${entries}" == 'proton_metadata_cache=true' ]]
}

write_configured_mode() {
    local value="$1"
    local config_dir config_tmp

    config_dir="${draft_config%/*}"
    mkdir -p -- "${config_dir}"
    config_tmp="$(mktemp "${config_dir}/pdrive-draft-recovery.conf.XXXXXX")"
    printf '%s\n' \
        '# Verwaltet mit pdrive-draft-recovery; niemals als Shellcode einlesen.' \
        '# true löscht beim Upload unvollständige serverseitige Drafts am Ziel.' \
        '# Nur ohne parallele Proton-Clients und vorübergehend verwenden.' \
        "replace_existing_draft=${value}" > "${config_tmp}"
    mv -f -- "${config_tmp}" "${draft_config}"
}

running_mode() {
    local pid args

    pid="$(systemctl --user show "${service_name}" -p MainPID --value --no-pager 2>/dev/null || printf '0')"
    if [[ ! "${pid}" =~ ^[1-9][0-9]*$ ]]; then
        printf 'Dienst läuft nicht'
        return 0
    fi
    args="$(ps -ww -p "${pid}" -o args= 2>/dev/null || true)"
    case "${args}" in
        *--protondrive-replace-existing-draft=true*) printf 'AKTIV (PID %s)' "${pid}" ;;
        *--protondrive-replace-existing-draft=false*) printf 'aus (PID %s)' "${pid}" ;;
        *) printf 'nicht ermittelbar (PID %s)' "${pid}" ;;
    esac
}

dirty_stats() {
    if [[ ! -d "${vfs_meta_root}" ]]; then
        printf '0 0\n'
        return 0
    fi
    find "${vfs_meta_root}" -mindepth 2 -type f -path '*/proton*/*' -print0 2>/dev/null \
        | xargs -0 -r jq -r 'select(.Dirty == true) | .Size' 2>/dev/null \
        | awk '{ count += 1; bytes += $1 } END { printf "%d %.0f\n", count, bytes }'
}

show_status() {
    local configured configured_text running count bytes

    configured="$(read_configured_mode)"
    if [[ "${configured}" == 'true' ]]; then
        configured_text='AKTIV – unvollständige Remote-Drafts werden ersetzt'
    else
        configured_text='aus – konservatives Backend-Verhalten'
    fi
    running="$(running_mode)"
    read -r count bytes < <(dirty_stats)

    printf 'Proton-Drive-Draft-Recovery\n\n'
    printf 'Konfiguriert: %s\n' "${configured_text}"
    printf 'Laufend:      %s\n' "${running}"
    printf 'Dirty-Queue:  %s Datei(en), %s Byte\n' "${count}" "${bytes}"
    printf 'Datei:        %s\n' "${draft_config}"
    if [[ "${configured}" == 'true' ]]; then
        printf '%s\n' \
            'ACHTUNG: Keine parallelen Änderungen über Proton Web, Mobil-App,' \
            'offizielle CLI oder einen zweiten rclone-Client durchführen.'
    fi
    if { [[ "${configured}" == 'true' && "${running}" != AKTIV* ]] \
        || [[ "${configured}" == 'false' && "${running}" == AKTIV* ]]; }; then
        printf '%s\n' \
            'Hinweis: Die Konfiguration gilt erst nach kontrollierter Cachezuordnung' \
            'und einem Dienstneustart; nicht blind nur rclone neu starten.'
    fi
}

case "${1:-}" in
    '')
        show_status
        ;;
    --enable)
        (( $# == 1 )) || { usage >&2; exit 2; }
        if ! metadata_recovery_is_enabled; then
            printf '%s\n' \
                'Abgelehnt: Der Proton-Metadatencache-Recovery-Modus ist nicht aktiv.' \
                'Draft-Recovery nur innerhalb des kontrollierten Recovery-Betriebs verwenden.' >&2
            exit 75
        fi
        write_configured_mode true
        printf '%s\n' \
            'Draft-Recovery wurde atomar aktiviert; der laufende Dienst blieb unangetastet.' \
            'Vor dem Neustart muss der VFS-Cache dem neuen Namensraum zugeordnet werden.'
        show_status
        ;;
    --disable)
        (( $# == 1 )) || { usage >&2; exit 2; }
        configured_before="$(read_configured_mode)"
        if [[ "${configured_before}" == 'true' ]]; then
            read -r dirty_count dirty_bytes < <(dirty_stats)
            if [[ "${dirty_count}" != '0' ]]; then
                printf '%s\n' \
                    "Abgelehnt: Noch ${dirty_count} Dirty-Datei(en) mit ${dirty_bytes} Byte im Proton-VFS-Cache." \
                    'Draft-Recovery bleibt aktiv, damit die lokale Restqueue nicht übersehen wird.' >&2
                exit 75
            fi
        fi
        write_configured_mode false
        printf '%s\n' \
            'Konservatives Draft-Verhalten wurde atomar konfiguriert; der Dienst blieb unangetastet.'
        show_status
        ;;
    -h|--help)
        (( $# == 1 )) || { usage >&2; exit 2; }
        usage
        ;;
    *)
        printf 'Unbekannte Option: %s\n\n' "$1" >&2
        usage >&2
        exit 2
        ;;
esac
