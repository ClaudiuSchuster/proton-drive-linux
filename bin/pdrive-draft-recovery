#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-3.0-or-later

set -euo pipefail
umask 077

script_path="$(readlink -f -- "${BASH_SOURCE[0]}")"
project_root="$(cd -- "$(dirname -- "${script_path}")/.." && pwd -P)"
readonly draft_config="${HOME}/.config/pdrive-draft-recovery.conf"
readonly recovery_config="${HOME}/.config/pdrive-recovery.conf"
readonly service_name='rclone-proton-drive.service'
readonly auto_helper="${project_root}/libexec/pdrive-draft-recovery-auto"
readonly account_cache_helper="${PDRIVE_ACCOUNT_CACHE_HELPER:-${project_root}/libexec/pdrive-account-cache}"

resolve_cache_dir() {
    local helper="${account_cache_helper}"
    if [[ ! -x "${helper}" ]]; then
        printf 'Account cache resolver is missing: %s\n' "${helper}" >&2
        return 69
    fi
    "${helper}" --path
}

cache_dir="$(resolve_cache_dir)"
readonly cache_dir
readonly vfs_meta_root="${cache_dir}/vfsMeta"

usage() {
    printf '%s\n' \
        'Usage: pdrive-draft-recovery [OPTION]' \
        '' \
        'No option: show the configured and running draft-recovery mode.' \
        '--enable: replace incomplete Proton upload drafts on the next upload.' \
        '--disable: restore conservative behavior; requires an empty Dirty queue.' \
        '--recover-now: handle a confirmed draft conflict through every cache guard.' \
        '-h, --help: show only this action-free help.' \
        '' \
        "Configuration: ${draft_config}" \
        'Changing the mode deliberately does not restart rclone.' \
        'WARNING: Enabling changes server-side drafts during the next upload.'
}

read_configured_mode() {
    local entries

    if [[ ! -e "${draft_config}" ]]; then
        printf 'false\n'
        return 0
    fi
    if [[ ! -r "${draft_config}" ]]; then
        printf 'Configuration is not readable: %s\n' "${draft_config}" >&2
        return 78
    fi
    entries="$(awk '
        /^[[:space:]]*($|#)/ { next }
        { print }
    ' "${draft_config}")"
    if [[ "${entries}" =~ ^replace_existing_draft=(true|false)$ ]]; then
        printf '%s\n' "${BASH_REMATCH[1]}"
        return 0
    fi
    printf 'Invalid draft-recovery configuration: %s\n' "${draft_config}" >&2
    return 78
}

metadata_recovery_is_enabled() {
    local entries

    [[ -r "${recovery_config}" ]] || return 1
    entries="$(awk '
        /^[[:space:]]*($|#)/ { next }
        { print }
    ' "${recovery_config}")"
    [[ "${entries}" == 'proton_metadata_cache=true' ]]
}

write_configured_mode() {
    local value="$1"
    local config_dir config_tmp

    config_dir="${draft_config%/*}"
    mkdir -p -- "${config_dir}"
    config_tmp="$(mktemp "${config_dir}/pdrive-draft-recovery.conf.XXXXXX")"
    printf '%s\n' \
        '# Managed by pdrive-draft-recovery; never evaluate as shell code.' \
        '# true replaces incomplete server-side drafts at the upload destination.' \
        '# Use temporarily and only without parallel Proton clients.' \
        "replace_existing_draft=${value}" > "${config_tmp}"
    mv -f -- "${config_tmp}" "${draft_config}"
}

running_mode() {
    local pid args

    pid="$(systemctl --user show "${service_name}" -p MainPID --value --no-pager 2>/dev/null || printf '0')"
    if [[ ! "${pid}" =~ ^[1-9][0-9]*$ ]]; then
        printf 'service is not running'
        return 0
    fi
    args="$(ps -ww -p "${pid}" -o args= 2>/dev/null || true)"
    case "${args}" in
        *--protondrive-replace-existing-draft=true*) printf 'ENABLED (PID %s)' "${pid}" ;;
        *--protondrive-replace-existing-draft=false*) printf 'disabled (PID %s)' "${pid}" ;;
        *) printf 'unknown (PID %s)' "${pid}" ;;
    esac
}

dirty_stats() {
    if [[ ! -d "${vfs_meta_root}" ]]; then
        printf '0 0\n'
        return 0
    fi
    find "${vfs_meta_root}" -mindepth 2 -type f -path '*/proton*/*' -print0 2>/dev/null \
        | xargs -0 -r jq -r 'select(.Dirty == true) | .Size' 2>/dev/null \
        | awk '{ count += 1; bytes += $1 } END { printf "%d %.0f\n", count, bytes }'
}

show_status() {
    local configured configured_text running count bytes

    configured="$(read_configured_mode)"
    if [[ "${configured}" == 'true' ]]; then
        configured_text='ENABLED – incomplete remote drafts are replaced'
    else
        configured_text='disabled – conservative backend behavior'
    fi
    running="$(running_mode)"
    read -r count bytes < <(dirty_stats)

    printf 'Proton Drive draft recovery\n\n'
    printf 'Configured: %s\n' "${configured_text}"
    printf 'Running:    %s\n' "${running}"
    printf 'Dirty queue: %s file(s), %s bytes\n' "${count}" "${bytes}"
    printf 'File:        %s\n' "${draft_config}"
    if [[ "${configured}" == 'true' ]]; then
        printf '%s\n' \
            'CAUTION: Do not write through Proton Web, the mobile app, the official' \
            'CLI or a second rclone client.'
    fi
    if { [[ "${configured}" == 'true' && "${running}" != ENABLED* ]] \
        || [[ "${configured}" == 'false' && "${running}" == ENABLED* ]]; }; then
        printf '%s\n' \
            'Note: The configuration applies only after guarded cache reassignment' \
            'and a service restart; do not blindly restart only rclone.'
    fi
}

case "${1:-}" in
    '')
        show_status
        ;;
    --enable)
        (( $# == 1 )) || { usage >&2; exit 2; }
        if ! metadata_recovery_is_enabled; then
            printf '%s\n' \
                'Refused: Proton metadata-cache recovery mode is not enabled.' \
                'Use draft recovery only inside the controlled recovery workflow.' >&2
            exit 75
        fi
        write_configured_mode true
        printf '%s\n' \
            'Draft recovery was enabled atomically; the running service was left untouched.' \
            'The VFS cache must be assigned to the new namespace before restart.'
        show_status
        ;;
    --disable)
        (( $# == 1 )) || { usage >&2; exit 2; }
        configured_before="$(read_configured_mode)"
        if [[ "${configured_before}" == 'true' ]]; then
            read -r dirty_count dirty_bytes < <(dirty_stats)
            if [[ "${dirty_count}" != '0' ]]; then
                printf '%s\n' \
                    "Refused: ${dirty_count} Dirty file(s) with ${dirty_bytes} bytes remain in the Proton VFS cache." \
                    'Draft recovery remains enabled so the local residual queue cannot be missed.' >&2
                exit 75
            fi
        fi
        write_configured_mode false
        printf '%s\n' \
            'Conservative draft behavior was saved atomically; the service was left untouched.'
        show_status
        ;;
    --recover-now)
        (( $# == 1 )) || { usage >&2; exit 2; }
        if [[ ! -x "${auto_helper}" ]]; then
            printf 'Recovery helper is missing or not executable: %s\n' "${auto_helper}" >&2
            exit 69
        fi
        exec "${auto_helper}" --recover-now
        ;;
    -h|--help)
        (( $# == 1 )) || { usage >&2; exit 2; }
        usage
        ;;
    *)
        printf 'Unknown option: %s\n\n' "$1" >&2
        usage >&2
        exit 2
        ;;
esac
