#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-3.0-or-later

set -euo pipefail
umask 077

readonly transfers_config="${HOME}/.config/pdrive-transfers.conf"
readonly service_name='rclone-proton-drive.service'
readonly default_transfers=4

usage() {
    printf '%s\n' \
        'Usage: pdrive-transfers [COUNT|default]' \
        '' \
        'No value: show the configured and currently running upload slots.' \
        'COUNT:    persistently configure 1 to 8 parallel file uploads.' \
        'default:  persistently configure the rclone default of 4 upload slots.' \
        '-h, --help: show only this action-free help.' \
        '' \
        "Configuration: ${transfers_config}" \
        'A change deliberately does not restart rclone and applies at the next start.' \
        'Use one slot only for targeted diagnosis or serial recovery.'
}

read_configured_transfers() {
    local entries

    if [[ ! -e "${transfers_config}" ]]; then
        printf '%s\n' "${default_transfers}"
        return 0
    fi
    if [[ ! -r "${transfers_config}" ]]; then
        printf 'Configuration is not readable: %s\n' "${transfers_config}" >&2
        return 78
    fi
    entries="$(awk '
        /^[[:space:]]*($|#)/ { next }
        { print }
    ' "${transfers_config}")"
    if [[ "${entries}" =~ ^transfers=([1-8])$ ]]; then
        printf '%s\n' "${BASH_REMATCH[1]}"
        return 0
    fi
    printf 'Invalid transfer configuration: %s\n' "${transfers_config}" >&2
    return 78
}

write_configured_transfers() {
    local value="$1"
    local config_dir config_tmp

    config_dir="${transfers_config%/*}"
    mkdir -p -- "${config_dir}"
    config_tmp="$(mktemp "${config_dir}/pdrive-transfers.conf.XXXXXX")"
    printf '%s\n' \
        '# Managed by pdrive-transfers; never evaluate as shell code.' \
        '# Number of concurrent file transfers; valid values are 1 through 8.' \
        "transfers=${value}" > "${config_tmp}"
    mv -f -- "${config_tmp}" "${transfers_config}"
}

running_transfers() {
    local pid args

    pid="$(systemctl --user show "${service_name}" -p MainPID --value --no-pager 2>/dev/null || printf '0')"
    if [[ ! "${pid}" =~ ^[1-9][0-9]*$ ]]; then
        printf 'service is not running'
        return 0
    fi
    args="$(ps -ww -p "${pid}" -o args= 2>/dev/null || true)"
    if [[ "${args}" =~ --transfers=([1-8])([[:space:]]|$) ]]; then
        printf '%s (PID %s)' "${BASH_REMATCH[1]}" "${pid}"
    else
        printf '%s – rclone default (PID %s)' "${default_transfers}" "${pid}"
    fi
}

show_status() {
    local configured running

    configured="$(read_configured_transfers)"
    running="$(running_transfers)"
    printf 'Proton Drive upload slots\n\n'
    printf 'Configured: %s concurrent\n' "${configured}"
    printf 'Running:    %s\n' "${running}"
    printf 'File:       %s\n' "${transfers_config}"
    if [[ ! "${running}" =~ ^${configured}[[:space:]] ]]; then
        printf '%s\n' \
            'Note: The new value applies after the next controlled service restart.'
    fi
}

case "${1:-}" in
    '')
        show_status
        ;;
    default)
        (( $# == 1 )) || { usage >&2; exit 2; }
        write_configured_transfers "${default_transfers}"
        printf 'Four upload slots were saved; the running service was left untouched.\n'
        show_status
        ;;
    [1-8])
        (( $# == 1 )) || { usage >&2; exit 2; }
        write_configured_transfers "$1"
        printf '%s upload slot(s) were saved; the running service was left untouched.\n' "$1"
        show_status
        ;;
    -h|--help)
        (( $# == 1 )) || { usage >&2; exit 2; }
        usage
        ;;
    *)
        printf 'Invalid count: %s. Use 1 through 8 or default.\n\n' "$1" >&2
        usage >&2
        exit 2
        ;;
esac
