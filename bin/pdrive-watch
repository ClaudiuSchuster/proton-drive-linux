#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-3.0-or-later

set -uo pipefail
umask 077

script_path="$(readlink -f -- "${BASH_SOURCE[0]}")"
project_root="$(cd -- "$(dirname -- "${script_path}")/.." && pwd -P)"

record_mode=false
clear_cooldown_mode=false
restart_service_mode=false
set_cooldown_mode=false
set_cooldown_argument=''
case "${1:-}" in
    '') ;;
    --record) record_mode=true ;;
    --clear-cooldown) clear_cooldown_mode=true ;;
    --restart-service) restart_service_mode=true ;;
    --set-cooldown)
        set_cooldown_mode=true
        set_cooldown_argument="${2:-}"
        ;;
    -h|--help)
        printf '%s\n' \
            'Usage: pdrive-watch [OPTION] [VALUE]' \
            '' \
            'No option: show a fresh, detailed diagnosis.' \
            '--set-cooldown TIME: persist the restart cooldown;' \
            '                     accepts 1h through 7d, for example 90m, 6h, 1d or default.' \
            '--clear-cooldown: atomically clear the active automatic-restart cooldown;' \
            '                  rclone and the timer comparison point remain unchanged.' \
            '--restart-service: after the exact confirmation RESTART, restart rclone in a' \
            '                   controlled way and validate it for up to 60 seconds.' \
            '--record: update history/comparison state and notify on state changes.' \
            '          This mode belongs to pdrive-watch.timer and may request one bounded' \
            '          restart only after strict stall confirmation. Files that fail across' \
            '          two timer runs are reported.' \
            'Configuration: ~/.config/pdrive-watch.conf' \
            'Metadata cache: ~/.config/pdrive-recovery.conf (help: pdrive-recovery --help)' \
            'Upload slots: ~/.config/pdrive-transfers.conf (help: pdrive-transfers --help)'
        exit 0
        ;;
    *)
        printf 'Unknown option: %s (help: pdrive-watch --help)\n' "$1" >&2
        exit 2
        ;;
esac
if [[ "${set_cooldown_mode}" == true ]] && (( $# != 2 )); then
    printf 'Usage: pdrive-watch --set-cooldown TIME (for example 90m, 6h, 1d or default)\n' >&2
    exit 2
elif [[ "${set_cooldown_mode}" != true ]] && (( $# > 1 )); then
    printf 'Exactly one option is allowed (help: pdrive-watch --help).\n' >&2
    exit 2
fi

readonly service_name='rclone-proton-drive.service'
readonly mount_dir='/pdrive'
readonly mount_log="${HOME}/.local/state/rclone/proton-mount.log"
readonly state_dir="${HOME}/.local/state/rclone"
readonly rc_socket="${state_dir}/pdrive-rc.sock"
readonly rclone_bin="${project_root}/bin/rclone"
readonly latest_file="${state_dir}/pdrive-watch-latest.txt"
readonly history_file="${state_dir}/pdrive-watch-history.log"
readonly history_max_entries=512
readonly monitor_state="${state_dir}/pdrive-watch-state"
readonly cooldown_config="${HOME}/.config/pdrive-watch.conf"
readonly recovery_config="${HOME}/.config/pdrive-recovery.conf"
readonly transfers_config="${HOME}/.config/pdrive-transfers.conf"
readonly ui_preferences="${HOME}/.config/pdrive-ui.json"
readonly low_space_bytes=59055800320
readonly stall_success_age_seconds=14400
readonly stall_queue_age_seconds=7200
readonly stall_confirmations_required=2
readonly failed_upload_minimum_tries=2
readonly failed_upload_confirmations_required=2
readonly default_auto_restart_cooldown_seconds=43200
readonly minimum_auto_restart_cooldown_seconds=3600
readonly maximum_auto_restart_cooldown_seconds=604800
readonly activity_probe_seconds=20
readonly activity_read_bytes=1048576
readonly activity_rchar_bytes=8388608
readonly activity_tcp_bytes=262144

notification_policy='important'
notification_language='en'
if [[ -r "${ui_preferences}" ]] && command -v jq >/dev/null 2>&1; then
    configured_notification_policy="$(jq -r '.notification_policy // empty' "${ui_preferences}" 2>/dev/null)"
    case "${configured_notification_policy}" in
        important|critical|all|off) notification_policy="${configured_notification_policy}" ;;
    esac
    configured_notification_language="$(jq -r '.language // empty' "${ui_preferences}" 2>/dev/null)"
    case "${configured_notification_language}" in
        en|de) notification_language="${configured_notification_language}" ;;
    esac
fi

notification_allowed() {
    local current_status="${1:-unknown}"
    local current_reason="${2:-unknown}"
    case "${notification_policy}" in
        off) return 1 ;;
        all) return 0 ;;
        critical) [[ "${current_status}" == 'critical' ]] ;;
        important)
            [[ "${current_status}" == 'warning' || "${current_status}" == 'critical' \
                || "${current_reason}" == 'auto-restart-issued' ]]
            ;;
    esac
}

notify_pdrive() {
    notify-send \
        --app-name='PDrive Control Center' \
        --icon='io.github.claudiuschuster.PDriveControl' \
        "$@"
}

trim_watch_history() {
    local entry_count history_tmp

    [[ -f "${history_file}" ]] || return 0
    entry_count="$(wc -l < "${history_file}")" || return 0
    (( entry_count > history_max_entries )) || return 0

    history_tmp="$(mktemp "${state_dir}/pdrive-watch-history.XXXXXX")" || return 0
    if tail -n "${history_max_entries}" -- "${history_file}" > "${history_tmp}"; then
        mv -f -- "${history_tmp}" "${history_file}"
    else
        rm -f -- "${history_tmp}"
    fi
}

auto_restart_cooldown_seconds="${default_auto_restart_cooldown_seconds}"
cooldown_config_source='default value'
cooldown_config_warning=''

human_duration() {
    local seconds="${1:-}"
    if [[ ! "${seconds}" =~ ^[0-9]+$ ]]; then
        printf 'unknown'
    elif (( seconds < 60 )); then
        printf '%ss' "${seconds}"
    elif (( seconds < 3600 )); then
        printf '%sm %ss' "$((seconds / 60))" "$((seconds % 60))"
    elif (( seconds < 86400 )); then
        printf '%sh %sm' "$((seconds / 3600))" "$(((seconds % 3600) / 60))"
    else
        printf '%sd %sh' "$((seconds / 86400))" "$(((seconds % 86400) / 3600))"
    fi
}

human_bytes() {
    local bytes="${1:-0}"
    if [[ "${bytes}" =~ ^[0-9]+$ ]] && command -v numfmt >/dev/null 2>&1; then
        numfmt --to=iec-i --suffix=B "${bytes}" 2>/dev/null || printf '%s B' "${bytes}"
    else
        printf '%s B' "${bytes}"
    fi
}

parse_cooldown_duration() {
    local duration="${1:-}"
    local amount unit seconds

    if [[ "${duration}" == 'default' ]]; then
        printf '%s\n' "${default_auto_restart_cooldown_seconds}"
        return 0
    fi
    if [[ ! "${duration}" =~ ^([1-9][0-9]{0,5})(m|h|d)$ ]]; then
        printf 'Invalid duration: %s. Use 90m, 6h, 1d or default.\n' \
            "${duration:-<empty>}" >&2
        return 2
    fi

    amount="${BASH_REMATCH[1]}"
    unit="${BASH_REMATCH[2]}"
    case "${unit}" in
        m) seconds=$((amount * 60)) ;;
        h) seconds=$((amount * 3600)) ;;
        d) seconds=$((amount * 86400)) ;;
    esac
    if (( seconds < minimum_auto_restart_cooldown_seconds \
        || seconds > maximum_auto_restart_cooldown_seconds )); then
        printf 'Invalid duration: %s. The allowed range is 1h through 7d.\n' \
            "${duration}" >&2
        return 2
    fi
    printf '%s\n' "${seconds}"
}

load_cooldown_config() {
    local configured=''

    if [[ ! -e "${cooldown_config}" ]]; then
        return 0
    fi
    if [[ ! -r "${cooldown_config}" ]]; then
        cooldown_config_warning="${cooldown_config} is not readable; using the default"
        return 0
    fi

    configured="$(awk -F= '$1 == "cooldown_seconds" { print $2; exit }' "${cooldown_config}")"
    if [[ "${configured}" =~ ^[0-9]+$ ]] \
        && (( configured >= minimum_auto_restart_cooldown_seconds \
            && configured <= maximum_auto_restart_cooldown_seconds )); then
        auto_restart_cooldown_seconds="${configured}"
        cooldown_config_source="${cooldown_config}"
    else
        cooldown_config_warning="${cooldown_config} has no valid value; using the default"
    fi
}

load_recovery_config() {
    local entries=''

    recovery_configured='false'
    recovery_config_warning=''
    if [[ ! -e "${recovery_config}" ]]; then
        return 0
    fi
    if [[ ! -r "${recovery_config}" ]]; then
        recovery_config_warning="${recovery_config} is not readable"
        return 0
    fi
    entries="$(awk '
        /^[[:space:]]*($|#)/ { next }
        { print }
    ' "${recovery_config}")"
    if [[ "${entries}" =~ ^proton_metadata_cache=(true|false)$ ]]; then
        recovery_configured="${BASH_REMATCH[1]}"
    else
        recovery_config_warning="${recovery_config} does not contain one valid value"
    fi
}

load_transfers_config() {
    local entries=''

    transfers_configured='4'
    transfers_config_warning=''
    if [[ ! -e "${transfers_config}" ]]; then
        return 0
    fi
    if [[ ! -r "${transfers_config}" ]]; then
        transfers_config_warning="${transfers_config} is not readable"
        return 0
    fi
    entries="$(awk '
        /^[[:space:]]*($|#)/ { next }
        { print }
    ' "${transfers_config}")"
    if [[ "${entries}" =~ ^transfers=([1-8])$ ]]; then
        transfers_configured="${BASH_REMATCH[1]}"
    else
        transfers_config_warning="${transfers_config} does not contain one valid value"
    fi
}

write_cooldown_config() {
    local seconds="${1:-}"
    local config_dir config_tmp

    if [[ ! "${seconds}" =~ ^[0-9]+$ ]]; then
        printf 'Invalid internal cooldown value: %s\n' "${seconds}" >&2
        return 2
    fi
    config_dir="${cooldown_config%/*}"
    mkdir -p -- "${config_dir}"
    config_tmp="$(mktemp "${config_dir}/pdrive-watch.conf.XXXXXX")"
    printf '%s\n' \
        '# Verwaltet mit: pdrive-watch --set-cooldown ZEIT' \
        "cooldown_seconds=${seconds}" > "${config_tmp}"
    mv -f -- "${config_tmp}" "${cooldown_config}"
}

counter_delta() {
    local current="${1:-0}"
    local previous="${2:-0}"
    if [[ ! "${current}" =~ ^[0-9]+$ || ! "${previous}" =~ ^[0-9]+$ ]]; then
        printf '?'
    elif (( current >= previous )); then
        printf '+%s' "$((current - previous))"
    else
        printf 'Log restarted'
    fi
}

set_cooldown_epoch() {
    local value="${1:-0}"
    local state_tmp

    if [[ ! "${value}" =~ ^[0-9]+$ ]]; then
        printf 'Invalid cooldown timestamp: %s\n' "${value}" >&2
        return 2
    fi

    state_tmp="$(mktemp "${state_dir}/pdrive-watch-state.XXXXXX")"
    if [[ -r "${monitor_state}" ]]; then
        awk -v value="${value}" '
            /^last_auto_restart_epoch=/ {
                print "last_auto_restart_epoch=" value
                found=1
                next
            }
            { print }
            END {
                if (!found) print "last_auto_restart_epoch=" value
            }
        ' "${monitor_state}" > "${state_tmp}"
    else
        printf 'state_version=4\nlast_auto_restart_epoch=%s\n' "${value}" > "${state_tmp}"
    fi
    mv -f -- "${state_tmp}" "${monitor_state}"
}

restart_service_and_validate() {
    local confirmation
    local old_pid="${main_pid}"
    local old_log_mtime="${log_mtime}"
    local restart_epoch restart_log_stamp deadline current_epoch
    local service_data new_active='unknown' new_sub='unknown' new_pid=0
    local new_result='unknown' new_exec_status='unknown'
    local new_log_mtime=0 post_restart_successes=0
    local validation_ok=false dns_after='failed' mount_after='not-mounted' mount_note=''

    if [[ ! -t 0 ]]; then
        printf '%s\n' \
            'Refused: --restart-service requires an interactive terminal.' \
            'This prevents scripts and timers from triggering a manual restart accidentally.' >&2
        return 2
    fi

    printf '\nManual controlled Proton Drive restart\n'
    printf 'Current service: %s/%s, PID %s, mount %s\n' \
        "${active_state}" "${sub_state}" "${old_pid}" "${mount_state}"
    printf '%s\n' \
        'Caution: A restart interrupts current file transfers and restarts the persistent' \
        'VFS cache inventory. Cache and queue data are not deleted.'
    printf 'Enter exactly RESTART to continue: '
    IFS= read -r confirmation
    if [[ "${confirmation}" != 'RESTART' ]]; then
        printf 'Cancelled; service, cooldown and cache remain unchanged.\n'
        return 0
    fi

    # Re-read immediately before the request so a naturally changed process
    # cannot be mistaken for the process created by this restart.
    old_pid="$(systemctl --user show "${service_name}" -p MainPID --value --no-pager 2>/dev/null || printf '0')"
    : "${old_pid:=0}"
    restart_epoch="$(date +%s)"
    restart_log_stamp="$(date '+%Y/%m/%d %H:%M:%S')"
    if ! systemctl --user restart --no-block "${service_name}"; then
        printf 'Error: systemd rejected the restart request.\n' >&2
        return 1
    fi

    # Also rate-limit follow-up recovery if the manually requested restart
    # itself encounters a broken network or API path.
    set_cooldown_epoch "${restart_epoch}"
    printf 'Restart requested; checking for a new live PID for up to 60 seconds ...\n'

    deadline=$((restart_epoch + 60))
    while :; do
        service_data="$(systemctl --user show "${service_name}" \
            -p ActiveState -p SubState -p MainPID -p Result -p ExecMainStatus --no-pager 2>/dev/null || true)"
        new_active="$(awk -F= '$1 == "ActiveState" { print $2; exit }' <<< "${service_data}")"
        new_sub="$(awk -F= '$1 == "SubState" { print $2; exit }' <<< "${service_data}")"
        new_pid="$(awk -F= '$1 == "MainPID" { print $2; exit }' <<< "${service_data}")"
        new_result="$(awk -F= '$1 == "Result" { print $2; exit }' <<< "${service_data}")"
        new_exec_status="$(awk -F= '$1 == "ExecMainStatus" { print $2; exit }' <<< "${service_data}")"
        : "${new_active:=unknown}" "${new_sub:=unknown}" "${new_pid:=0}"
        : "${new_result:=unknown}" "${new_exec_status:=unknown}"

        if [[ "${new_pid}" =~ ^[1-9][0-9]*$ && "${new_pid}" != "${old_pid}" \
            && -r "/proc/${new_pid}/status" \
            && ( "${new_active}" == 'active' || "${new_active}" == 'activating' ) ]]; then
            validation_ok=true
            break
        fi

        current_epoch="$(date +%s)"
        if (( current_epoch >= deadline )); then
            break
        fi
        sleep 2
    done

    if [[ "${validation_ok}" != true ]]; then
        printf 'Validation failed: service %s/%s, PID %s, result %s, exit %s.\n' \
            "${new_active}" "${new_sub}" "${new_pid}" "${new_result}" "${new_exec_status}" >&2
        printf '%s\n' \
            'The cooldown remains set for protection. Inspect with:' \
            'systemctl --user status rclone-proton-drive.service' \
            'journalctl --user -u rclone-proton-drive.service -n 100 --no-pager' >&2
        return 1
    fi

    sleep 3
    new_log_mtime="$(stat -c %Y -- "${mount_log}" 2>/dev/null || printf '0')"
    if timeout --signal=TERM 10s getent ahostsv4 drive-api.proton.me >/dev/null 2>&1; then
        dns_after='ok'
    fi
    if findmnt -rn -M "${mount_dir}" -o FSTYPE 2>/dev/null | awk '$1 ~ /^fuse(\.rclone)?$/ { found=1 } END { exit !found }'; then
        mount_after='ready'
    fi
    if [[ -r "${mount_log}" ]]; then
        post_restart_successes="$(tr -d '\000' < "${mount_log}" | awk -v cutoff="${restart_log_stamp}" '
            $1 " " $2 >= cutoff && /vfs cache: upload succeeded/ { successes++ }
            END { printf "%d\n", successes }
        ')"
    fi
    if [[ "${new_active}" == 'activating' ]]; then
        mount_note=' (still expected during a large cache inventory)'
    fi

    printf '\nValidation succeeded\n'
    printf 'Service:      %s/%s, new PID %s (previous %s), result %s, exit %s\n' \
        "${new_active}" "${new_sub}" "${new_pid}" "${old_pid}" "${new_result}" "${new_exec_status}"
    printf 'Process:      new PID is alive and belongs to the started user service\n'
    printf 'Network:      DNS %s\n' "${dns_after}"
    printf 'Mount:        %s%s\n' "${mount_after}" "${mount_note}"
    if [[ "${new_log_mtime}" =~ ^[0-9]+$ ]] && (( new_log_mtime > old_log_mtime )); then
        printf 'Log:          updated after the request\n'
    else
        printf 'Log:          no new timestamp yet; process state is still validated\n'
    fi
    printf 'Uploads:      %s success message(s) since the restart request\n' "${post_restart_successes}"
    printf 'Cooldown:     reset to %s to prevent restart loops\n' \
        "$(human_duration "${auto_restart_cooldown_seconds}")"

    # Refresh the normal diagnosis and latest-state file after releasing the
    # process lock.  The following invocation is read-only.
    flock -u 9
    exec "${BASH_SOURCE[0]}"
}

timestamp_age() {
    local timestamp="${1:-none}"
    local timestamp_epoch

    if [[ "${timestamp}" == 'none' || -z "${timestamp}" ]]; then
        printf '%s' '-1'
        return
    fi

    timestamp_epoch="$(date -d "${timestamp//\//-}" +%s 2>/dev/null || true)"
    if [[ "${timestamp_epoch}" =~ ^[0-9]+$ ]] && (( now_epoch >= timestamp_epoch )); then
        printf '%s' "$((now_epoch - timestamp_epoch))"
    else
        printf '%s' '-1'
    fi
}

process_io_snapshot() {
    local pid="${1:-0}"

    if [[ ! "${pid}" =~ ^[1-9][0-9]*$ || ! -r "/proc/${pid}/io" ]]; then
        printf '0 0\n'
        return
    fi

    awk '
        $1 == "rchar:" { rchar=$2 }
        $1 == "read_bytes:" { read_bytes=$2 }
        END { printf "%d %d\n", rchar, read_bytes }
    ' "/proc/${pid}/io" 2>/dev/null || printf '0 0\n'
}

tcp_bytes_sent() {
    local pid="${1:-0}"

    if [[ ! "${pid}" =~ ^[1-9][0-9]*$ ]] || ! command -v ss >/dev/null 2>&1; then
        printf '0\n'
        return
    fi

    ss -Htinp state established 2>/dev/null | awk -v needle="pid=${pid}," '
        index($0, needle) { inspect_next=1; next }
        inspect_next {
            for (i=1; i<=NF; i++) {
                if ($i ~ /^bytes_sent:[0-9]+$/) {
                    split($i, value, ":")
                    total += value[2]
                }
            }
            inspect_next=0
        }
        END { printf "%d\n", total }
    '
}

# Measure actual local reads and sent TCP bytes without contacting Proton.
# Return 0 for payload activity, 1 for no payload activity, and 2 if the
# observed rclone process changed during the probe.
probe_process_activity() {
    local pid="${1:-0}"
    local rchar_before=0 read_bytes_before=0 tcp_before=0
    local rchar_after=0 read_bytes_after=0 tcp_after=0 current_pid=0

    activity_probe='running'
    read -r rchar_before read_bytes_before < <(process_io_snapshot "${pid}")
    tcp_before="$(tcp_bytes_sent "${pid}")"
    sleep "${activity_probe_seconds}"

    current_pid="$(systemctl --user show "${service_name}" -p MainPID --value --no-pager 2>/dev/null || true)"
    if [[ "${current_pid}" != "${pid}" || ! -r "/proc/${pid}/io" ]]; then
        activity_probe='process changed during measurement'
        return 2
    fi

    read -r rchar_after read_bytes_after < <(process_io_snapshot "${pid}")
    tcp_after="$(tcp_bytes_sent "${pid}")"
    if [[ "${rchar_before}" =~ ^[0-9]+$ && "${rchar_after}" =~ ^[0-9]+$ ]] \
        && (( rchar_after >= rchar_before )); then
        activity_rchar_delta=$((rchar_after - rchar_before))
    fi
    if [[ "${read_bytes_before}" =~ ^[0-9]+$ && "${read_bytes_after}" =~ ^[0-9]+$ ]] \
        && (( read_bytes_after >= read_bytes_before )); then
        activity_read_delta=$((read_bytes_after - read_bytes_before))
    fi
    if [[ "${tcp_before}" =~ ^[0-9]+$ && "${tcp_after}" =~ ^[0-9]+$ ]] \
        && (( tcp_after >= tcp_before )); then
        activity_tcp_delta=$((tcp_after - tcp_before))
    fi

    if (( activity_read_delta >= activity_read_bytes \
        || activity_rchar_delta >= activity_rchar_bytes \
        || activity_tcp_delta >= activity_tcp_bytes )); then
        activity_probe='active file/upload traffic detected'
        return 0
    fi
    activity_probe='no payload traffic detected'
    return 1
}

mkdir -p -- "${state_dir}"
exec 9>"${state_dir}/pdrive-watch.lock"
if ! flock -w 30 9; then
    printf 'Another pdrive-watch run is active; please retry shortly.\n' >&2
    exit 75
fi

load_cooldown_config
load_recovery_config
load_transfers_config
cooldown_duration_changed=false
if [[ "${set_cooldown_mode}" == true ]]; then
    configured_cooldown_seconds="$(parse_cooldown_duration "${set_cooldown_argument}")" || exit $?
    if ! write_cooldown_config "${configured_cooldown_seconds}"; then
        printf 'Error: cooldown configuration could not be saved atomically.\n' >&2
        exit 1
    fi
    auto_restart_cooldown_seconds="${configured_cooldown_seconds}"
    cooldown_config_source="${cooldown_config}"
    cooldown_config_warning=''
    cooldown_duration_changed=true
fi

now_iso="$(date --iso-8601=seconds)"
now_epoch="$(date +%s)"

service_properties="$(systemctl --user show "${service_name}" \
    -p ActiveState -p SubState -p MainPID -p NRestarts --no-pager 2>/dev/null || true)"
active_state="$(awk -F= '$1 == "ActiveState" { print $2; exit }' <<< "${service_properties}")"
sub_state="$(awk -F= '$1 == "SubState" { print $2; exit }' <<< "${service_properties}")"
main_pid="$(awk -F= '$1 == "MainPID" { print $2; exit }' <<< "${service_properties}")"
restart_count="$(awk -F= '$1 == "NRestarts" { print $2; exit }' <<< "${service_properties}")"
: "${active_state:=unknown}" "${sub_state:=unknown}" "${main_pid:=0}" "${restart_count:=unknown}"

recovery_running='unknown'
transfers_running='unknown'
if [[ "${main_pid}" =~ ^[1-9][0-9]*$ ]]; then
    process_args="$(ps -ww -p "${main_pid}" -o args= 2>/dev/null || true)"
    case "${process_args}" in
        *--protondrive-enable-caching=true*) recovery_running='true' ;;
        *--protondrive-enable-caching=false*) recovery_running='false' ;;
    esac
    if [[ "${process_args}" =~ --transfers=([1-8])([[:space:]]|$) ]]; then
        transfers_running="${BASH_REMATCH[1]}"
    else
        transfers_running='4 (rclone default)'
    fi
fi

process_age=-1
process_cpu='unknown'
process_rss_kib=0
if [[ "${main_pid}" =~ ^[1-9][0-9]*$ && -r "/proc/${main_pid}/status" ]]; then
    process_line="$(ps -p "${main_pid}" -o etimes=,%cpu=,rss= 2>/dev/null || true)"
    read -r process_age process_cpu process_rss_kib <<< "${process_line}"
    : "${process_age:=-1}" "${process_cpu:=unknown}" "${process_rss_kib:=0}"
fi
process_rss_bytes=0
if [[ "${process_rss_kib}" =~ ^[0-9]+$ ]]; then
    process_rss_bytes=$((process_rss_kib * 1024))
fi

mount_fstype="$(findmnt -rn -M "${mount_dir}" -o FSTYPE 2>/dev/null || true)"
if [[ "${mount_fstype}" == 'fuse.rclone' || "${mount_fstype}" == 'fuse' ]]; then
    mount_state='ready'
else
    mount_state='not-mounted'
fi

success_count=0
queued_count=0
error_count=0
notice_count=0
last_success='none'
last_queue='none'
last_problem='none'
last_problem_kind='none'
log_mtime=0
log_age=-1
if [[ -r "${mount_log}" ]]; then
    IFS='|' read -r success_count queued_count error_count notice_count \
        last_success last_queue last_problem last_problem_kind < <(
        tr -d '\000' < "${mount_log}" | awk '
            /vfs cache: upload succeeded/ {
                successes++
                last_success=$1 " " $2
            }
            /vfs cache: queuing for upload/ {
                queued++
                last_queue=$1 " " $2
            }
            /(ERROR|CRITICAL)/ {
                errors++
                last_problem=$1 " " $2
                problem_kind="other error"
                if (tolower($0) ~ /(dial tcp: lookup|server misbehaving|no such host|temporary failure in name resolution|name or service not known)/) problem_kind="DNS"
                else if ($0 ~ /(^|[^0-9])429([^0-9]|$)/) problem_kind="HTTP 429"
                else if ($0 ~ /(^|[^0-9])422([^0-9]|$)/) problem_kind="HTTP 422"
                else if ($0 ~ /(^|[^0-9])5[0-9][0-9]([^0-9]|$)/) problem_kind="HTTP 5xx"
            }
            /NOTICE/ {
                notices++
                last_problem=$1 " " $2
                problem_kind="notice"
                if (tolower($0) ~ /(dial tcp: lookup|server misbehaving|no such host|temporary failure in name resolution|name or service not known)/) problem_kind="DNS"
                else if ($0 ~ /(^|[^0-9])429([^0-9]|$)/) problem_kind="HTTP 429"
                else if ($0 ~ /(^|[^0-9])422([^0-9]|$)/) problem_kind="HTTP 422"
                else if ($0 ~ /(^|[^0-9])5[0-9][0-9]([^0-9]|$)/) problem_kind="HTTP 5xx"
            }
            END {
                printf "%d|%d|%d|%d|%s|%s|%s|%s\n", successes, queued, errors, notices,
                    (last_success ? last_success : "none"),
                    (last_queue ? last_queue : "none"),
                    (last_problem ? last_problem : "none"),
                    (problem_kind ? problem_kind : "none")
            }
        '
    )
    log_mtime="$(stat -c %Y -- "${mount_log}" 2>/dev/null || printf '0')"
    if [[ "${log_mtime}" =~ ^[0-9]+$ ]] && (( log_mtime > 0 && now_epoch >= log_mtime )); then
        log_age=$((now_epoch - log_mtime))
    fi
fi

last_success_age="$(timestamp_age "${last_success}")"
last_queue_age="$(timestamp_age "${last_queue}")"

cache_bytes="$(du -s -B1 "${HOME}/.cache/rclone" 2>/dev/null | awk 'NR == 1 { print $1 }')"
free_bytes="$(df -B1 --output=avail "${HOME}" 2>/dev/null | awk 'NR == 2 { gsub(/[[:space:]]/, ""); print }')"
: "${cache_bytes:=0}" "${free_bytes:=0}"

# vfs/queue is a local Unix-socket query.  It neither lists the remote nor
# performs a Proton login.  File identities are reduced to a SHA-256 digest;
# names never enter the status/history files or desktop notifications.
queue_state='unavailable'
queue_count=0
queue_bytes=0
queue_uploading_count=0
failed_queue_count=0
failed_queue_max_tries=0
failed_item_hash='none'
failed_item_tries=0
failed_item_uploading='false'
queue_json=''
failed_item_json=''
if ! command -v jq >/dev/null 2>&1; then
    queue_state='jq-missing'
elif [[ ! -S "${rc_socket}" || ! -x "${rclone_bin}" ]]; then
    queue_state='socket-missing'
elif queue_json="$(timeout --signal=TERM 10s "${rclone_bin}" rc \
        --unix-socket "${rc_socket}" vfs/queue 2>/dev/null)" \
    && jq -e '.queue | type == "array"' >/dev/null 2>&1 <<< "${queue_json}"; then
    queue_state='ok'
    IFS=$'\t' read -r queue_count queue_bytes queue_uploading_count \
        failed_queue_count failed_queue_max_tries < <(
        jq -r --argjson minimum_tries "${failed_upload_minimum_tries}" '
            [
                (.queue | length),
                ([.queue[] | (.size // 0)] | add // 0),
                ([.queue[] | select(.uploading == true)] | length),
                ([.queue[] | select((.tries // 0) >= $minimum_tries)] | length),
                ([.queue[] | (.tries // 0)] | max // 0)
            ] | @tsv
        ' <<< "${queue_json}"
    )
    failed_item_json="$(jq -c --argjson minimum_tries "${failed_upload_minimum_tries}" '
        [
            .queue[]
            | select((.tries // 0) >= $minimum_tries)
        ]
        | sort_by((.uploading // false), -(.tries // 0), (.expiry // 0))
        | .[0] // empty
    ' <<< "${queue_json}")"
    if [[ -n "${failed_item_json}" ]]; then
        failed_item_hash="$(jq -cS '{name: .name, size: (.size // 0)}' \
            <<< "${failed_item_json}" | sha256sum | awk '{ print $1 }')"
        failed_item_tries="$(jq -r '.tries // 0' <<< "${failed_item_json}")"
        failed_item_uploading="$(jq -r '.uploading // false' <<< "${failed_item_json}")"
    fi
else
    queue_state='query-failed'
fi
: "${queue_count:=0}" "${queue_bytes:=0}" "${queue_uploading_count:=0}"
: "${failed_queue_count:=0}" "${failed_queue_max_tries:=0}"

if timeout --signal=TERM 10s getent ahostsv4 drive-api.proton.me >/dev/null 2>&1; then
    dns_state='ok'
else
    dns_state='failed'
fi

tcp_state='none'
if [[ "${main_pid}" =~ ^[1-9][0-9]*$ ]] && command -v ss >/dev/null 2>&1; then
    if ss -H -tpn state established 2>/dev/null \
        | awk -v needle="pid=${main_pid}," 'index($0, needle) { found=1 } END { exit !found }'; then
        tcp_state='established'
    fi
fi

previous_status='none'
previous_reason_code='none'
previous_state_version=0
previous_check_epoch=0
previous_log_mtime=0
previous_success_count=0
previous_queued_count=0
previous_error_count=0
previous_notice_count=0
previous_stall_confirmations=0
previous_auto_restart_epoch=0
previous_failed_item_hash='none'
previous_failed_upload_confirmations=0
if [[ -r "${monitor_state}" ]]; then
    previous_state_version="$(awk -F= '$1 == "state_version" { print $2; exit }' "${monitor_state}")"
    previous_status="$(awk -F= '$1 == "status" { print $2; exit }' "${monitor_state}")"
    previous_reason_code="$(awk -F= '$1 == "reason_code" { print $2; exit }' "${monitor_state}")"
    previous_check_epoch="$(awk -F= '$1 == "check_epoch" { print $2; exit }' "${monitor_state}")"
    previous_log_mtime="$(awk -F= '$1 == "log_mtime" { print $2; exit }' "${monitor_state}")"
    previous_success_count="$(awk -F= '$1 == "success_count" { print $2; exit }' "${monitor_state}")"
    previous_queued_count="$(awk -F= '$1 == "queued_count" { print $2; exit }' "${monitor_state}")"
    previous_error_count="$(awk -F= '$1 == "error_count" { print $2; exit }' "${monitor_state}")"
    previous_notice_count="$(awk -F= '$1 == "notice_count" { print $2; exit }' "${monitor_state}")"
    previous_stall_confirmations="$(awk -F= '$1 == "stall_confirmations" { print $2; exit }' "${monitor_state}")"
    previous_auto_restart_epoch="$(awk -F= '$1 == "last_auto_restart_epoch" { print $2; exit }' "${monitor_state}")"
    previous_failed_item_hash="$(awk -F= '$1 == "failed_item_hash" { print $2; exit }' "${monitor_state}")"
    previous_failed_upload_confirmations="$(awk -F= '$1 == "failed_upload_confirmations" { print $2; exit }' "${monitor_state}")"
    : "${previous_status:=none}" "${previous_reason_code:=none}" "${previous_state_version:=0}" "${previous_check_epoch:=0}"
    : "${previous_log_mtime:=0}" "${previous_success_count:=0}" "${previous_queued_count:=0}"
    : "${previous_error_count:=0}" "${previous_notice_count:=0}"
    : "${previous_stall_confirmations:=0}" "${previous_auto_restart_epoch:=0}"
    : "${previous_failed_item_hash:=none}" "${previous_failed_upload_confirmations:=0}"
fi

baseline_compatible=false
if [[ "${previous_state_version}" =~ ^(2|3|4)$ && "${previous_check_epoch}" =~ ^[1-9][0-9]*$ ]]; then
    baseline_compatible=true
fi

if [[ ! "${previous_stall_confirmations}" =~ ^[0-9]+$ ]]; then
    previous_stall_confirmations=0
fi
if [[ ! "${previous_auto_restart_epoch}" =~ ^[0-9]+$ ]]; then
    previous_auto_restart_epoch=0
fi
if [[ ! "${previous_failed_item_hash}" =~ ^(none|[0-9a-f]{64})$ ]]; then
    previous_failed_item_hash='none'
fi
if [[ ! "${previous_failed_upload_confirmations}" =~ ^[0-9]+$ ]]; then
    previous_failed_upload_confirmations=0
fi

auto_restart_age=-1
if (( previous_auto_restart_epoch > 0 && now_epoch >= previous_auto_restart_epoch )); then
    auto_restart_age=$((now_epoch - previous_auto_restart_epoch))
fi

cooldown_cleared=false
if [[ "${clear_cooldown_mode}" == true ]]; then
    set_cooldown_epoch 0
    previous_auto_restart_epoch=0
    auto_restart_age=-1
    cooldown_cleared=true
fi

comparison_age=-1
if [[ "${previous_check_epoch}" =~ ^[0-9]+$ ]] && (( previous_check_epoch > 0 && now_epoch >= previous_check_epoch )); then
    comparison_age=$((now_epoch - previous_check_epoch))
fi

progress_state='baseline'
if [[ "${previous_status}" != 'none' ]]; then
    if [[ "${log_mtime}" != "${previous_log_mtime}" \
        || "${success_count}" != "${previous_success_count}" \
        || "${queued_count}" != "${previous_queued_count}" ]]; then
        progress_state='yes'
    else
        progress_state='no'
    fi
fi

if [[ "${baseline_compatible}" == true ]]; then
    success_delta="$(counter_delta "${success_count}" "${previous_success_count}")"
    queued_delta="$(counter_delta "${queued_count}" "${previous_queued_count}")"
    error_delta="$(counter_delta "${error_count}" "${previous_error_count}")"
    notice_delta="$(counter_delta "${notice_count}" "${previous_notice_count}")"
else
    success_delta='No baseline'
    queued_delta='No baseline'
    error_delta='No baseline'
    notice_delta='No baseline'
fi

stall_candidate=false
stall_confirmations=0
activity_probe='not required'
activity_rchar_delta=0
activity_read_delta=0
activity_tcp_delta=0
restart_requested=false
restart_issued=false
restart_suppressed='none'
failed_upload_confirmations=0
failed_upload_observation='no repeatedly attempted problem file'

# A queue item only becomes a candidate after at least two upload attempts.
# The same privacy-preserving item digest must then survive two
# recorded timer observations.  If that item is currently uploading, a live
# I/O probe prevents a healthy very large transfer from being called stuck.
if [[ "${queue_state}" != 'ok' ]]; then
    failed_item_hash="${previous_failed_item_hash}"
    failed_upload_confirmations="${previous_failed_upload_confirmations}"
    failed_upload_observation='queue inspection unavailable; retaining the last confirmed state'
elif [[ "${failed_item_hash}" == 'none' ]]; then
    failed_upload_confirmations=0
elif [[ "${record_mode}" != true ]]; then
    if [[ "${failed_item_hash}" == "${previous_failed_item_hash}" ]]; then
        failed_upload_confirmations="${previous_failed_upload_confirmations}"
    fi
    failed_upload_observation='candidate detected; only timer runs increase confirmation'
elif [[ "${failed_item_hash}" != "${previous_failed_item_hash}" ]]; then
    failed_upload_confirmations=1
    failed_upload_observation='first timer observation of the same repeatedly attempted file'
elif [[ "${failed_item_uploading}" == 'true' \
    && "${main_pid}" =~ ^[1-9][0-9]*$ ]]; then
    if probe_process_activity "${main_pid}"; then
        failed_upload_confirmations=0
        failed_upload_observation='active payload traffic protects the running large upload'
    else
        probe_result=$?
        if (( probe_result == 2 )); then
            failed_upload_confirmations=0
            failed_upload_observation='rclone changed during inspection; a new comparison is required'
        else
            failed_upload_confirmations=$((previous_failed_upload_confirmations + 1))
            failed_upload_observation='repeated candidate without measurable payload traffic'
        fi
    fi
else
    failed_upload_confirmations=$((previous_failed_upload_confirmations + 1))
    failed_upload_observation='repeated candidate still waits after multiple failed attempts'
fi
if (( failed_upload_confirmations > failed_upload_confirmations_required )); then
    failed_upload_confirmations="${failed_upload_confirmations_required}"
fi

# A stale success timestamp alone is deliberately insufficient: a single very
# large file only logs success after it has completely uploaded.  A candidate
# therefore needs a growing queue, no completed upload over a full timer
# interval, a live network path, and an unmounted rclone that is still in its
# synchronous cache-reload/start phase.
if [[ "${baseline_compatible}" == true \
    && "${active_state}" == 'activating' \
    && "${mount_state}" == 'not-mounted' \
    && "${main_pid}" =~ ^[1-9][0-9]*$ \
    && "${dns_state}" == 'ok' \
    && "${last_success_age}" =~ ^[0-9]+$ \
    && "${last_queue_age}" =~ ^[0-9]+$ \
    && "${comparison_age}" =~ ^[0-9]+$ ]] \
    && (( last_success_age >= stall_success_age_seconds \
        && last_queue_age <= stall_queue_age_seconds \
        && comparison_age >= 3600 \
        && success_count == previous_success_count \
        && queued_count > previous_queued_count )); then
    stall_candidate=true
    if probe_process_activity "${main_pid}"; then
        stall_candidate=false
        restart_suppressed='active-transfer'
    else
        probe_result=$?
        if (( probe_result == 2 )); then
            stall_candidate=false
            restart_suppressed='process-changed'
        fi
    fi
fi

if [[ "${stall_candidate}" == true ]]; then
    stall_confirmations=$((previous_stall_confirmations + 1))
elif [[ "${restart_suppressed}" == 'active-transfer' ]]; then
    stall_confirmations=0
else
    stall_confirmations=0
fi

status='working'
reason_code='startup-progress'
reason='The rclone service is being evaluated against the saved comparison point.'
hint='The final classification uses upload, queue and live I/O evidence.'
if [[ "${active_state}" != 'active' && "${active_state}" != 'activating' ]]; then
    status='critical'
    reason_code='service-down'
    reason="Service state is ${active_state}/${sub_state}."
    hint='Inspect with pdrive-doctor and the service journal; do not restart repeatedly.'
elif [[ -n "${recovery_config_warning}" ]]; then
    status='warning'
    reason_code='invalid-metadata-cache-config'
    reason='The metadata-cache configuration is invalid; a later mount start would stop safely.'
    hint='Reset to the parallel-client-compatible value with pdrive-recovery --disable.'
elif [[ -n "${transfers_config_warning}" ]]; then
    status='warning'
    reason_code='invalid-transfers-config'
    reason='The upload-slot configuration is invalid; a later mount start would stop safely.'
    hint='Reset to the safe serial-recovery value with pdrive-transfers 1.'
elif [[ "${dns_state}" == 'failed' ]]; then
    status='warning'
    reason_code='dns-failed'
    reason='DNS resolution for the Proton Drive API failed.'
    hint='Inspect network and DNS. The monitor does not restart rclone or initiate login.'
elif [[ "${free_bytes}" =~ ^[0-9]+$ ]] && (( free_bytes < low_space_bytes )); then
    status='warning'
    reason_code='low-disk'
    reason='Free disk space is below 55 GiB.'
    hint='Do not delete rclone cache data while uploads are pending; inspect cause and queue first.'
elif [[ "${active_state}" == 'active' && "${mount_state}" == 'ready' \
    && "${queue_state}" != 'ok' ]]; then
    status='warning'
    reason_code='queue-monitor-unavailable'
    reason="The local VFS queue could not be inspected (${queue_state})."
    hint='The mount remains unchanged. Inspect the RC socket, jq and pdrive-doctor; stuck files cannot be classified safely without queue evidence.'
elif [[ "${active_state}" == 'active' && "${mount_state}" == 'ready' \
    && "${failed_upload_confirmations}" =~ ^[0-9]+$ ]] \
    && (( failed_upload_confirmations >= failed_upload_confirmations_required )); then
    status='warning'
    reason_code='persistent-upload-failure'
    reason="At least one file remains queued after multiple upload attempts (${failed_item_tries} attempts)."
    hint='No automatic restart or cache deletion. Inspect pdrive-watch and the mount log, and retain the local cache copy until resolved.'
elif [[ "${stall_candidate}" == true ]]; then
    if [[ "${recovery_configured}" == 'true' ]]; then
        status='warning'
        reason_code='upload-stall-cache-protected'
        reason='A possible upload stall was detected; automatic restart is blocked to protect the warm Proton metadata cache.'
        hint='No automatic restart: preserve the warm metadata cache and diagnose manually first.'
        restart_suppressed='metadata-cache'
        stall_confirmations=0
    elif (( auto_restart_age >= 0 && auto_restart_age < auto_restart_cooldown_seconds )); then
        status='warning'
        reason_code='upload-stall-cooldown'
        reason='An upload stall was detected, but automatic restart is still in its configured cooldown.'
        hint='The monitor does not force another restart. Inspect pdrive-watch and the service journal.'
        restart_suppressed='cooldown'
        stall_confirmations=0
    elif (( stall_confirmations < stall_confirmations_required )); then
        status='warning'
        reason_code='upload-stall-confirming'
        reason="Possible upload stall without measurable payload traffic; confirmation ${stall_confirmations}/${stall_confirmations_required}."
        hint='No intervention yet. Only a second independent 90-minute check may trigger a restart.'
    elif [[ "${record_mode}" == true ]]; then
        status='warning'
        reason_code='upload-stall-restart-requested'
        reason='Upload stall confirmed by two timer runs and live I/O measurement.'
        hint='The monitor requests exactly one controlled, non-blocking service restart.'
        restart_requested=true
    else
        status='warning'
        reason_code='upload-stall-confirmed'
        reason='Upload stall confirmed; a timer run would now trigger the controlled restart.'
        hint='This manual diagnosis changes neither the comparison point nor the service.'
    fi
elif [[ "${restart_suppressed}" == 'active-transfer' ]]; then
    status='working'
    reason_code='large-upload-active'
    reason='A long upload has no completion message yet, but current file/network traffic is measurable.'
    hint='No restart: this protects very large files whose success is recorded only at the end.'
elif [[ "${active_state}" == 'active' && "${mount_state}" == 'ready' ]]; then
    status='ready'
    reason_code='mounted'
    reason='Proton Drive is mounted and ready.'
    hint='The mount is directly available at /pdrive.'
elif [[ "${active_state}" == 'active' ]]; then
    status='warning'
    reason_code='active-without-mount'
    reason='rclone is active, but the /pdrive FUSE mount is missing.'
    hint='Run pdrive-doctor and inspect the service journal; do not start a second mount.'
elif [[ "${previous_status}" != 'none' && "${progress_state}" == 'no' \
    && "${log_age}" =~ ^[0-9]+$ ]] && (( log_age > 7200 )); then
    status='warning'
    reason_code='startup-stalled'
    reason='No local progress since the previous timer run and for more than two hours.'
    hint='Inspect process, DNS, TCP and the service journal. Consider restart only after diagnosis.'
elif [[ "${log_age}" =~ ^[0-9]+$ ]] && (( log_age > 7200 )); then
    status='warning'
    reason_code='stale-log'
    reason='The rclone log has not changed for more than two hours.'
    hint='Inspect process, DNS, TCP and the service journal. Consider restart only after diagnosis.'
fi

if [[ "${reason_code}" == 'startup-progress' ]]; then
    if [[ "${baseline_compatible}" != true ]]; then
        reason='rclone is running while the first 90-minute comparison point is built.'
        hint='No intervention: the watchdog does not restart without reliable comparison evidence.'
    elif (( success_count > previous_success_count )); then
        reason_code='upload-progress'
        reason="$((success_count - previous_success_count)) upload(s) completed since the previous timer run."
        hint='Real upload progress confirmed; stall confirmation remains zero and no restart is planned.'
    elif (( queued_count > previous_queued_count )); then
        reason_code='inventory-progress'
        reason="$((queued_count - previous_queued_count)) additional cache object(s) inventoried; no new upload completed yet."
        hint='Observation only: intervention requires two checks 90 minutes apart without upload or live I/O progress.'
    else
        reason_code='quiet-observation'
        reason='No queue entries or completed uploads were added since the previous timer run.'
        hint='Idle is healthy: without a growing queue the watchdog assumes no upload stall and does not restart rclone.'
    fi
fi

if [[ "${restart_requested}" == true ]]; then
    if systemctl --user restart --no-block "${service_name}"; then
        restart_issued=true
        previous_auto_restart_epoch="${now_epoch}"
        auto_restart_age=0
        stall_confirmations=0
        status='working'
        reason_code='auto-restart-issued'
        reason='A controlled restart was requested after a confirmed upload stall.'
        hint="No further automatic restart occurs for $(human_duration "${auto_restart_cooldown_seconds}"). The persistent VFS queue is preserved."
    else
        status='critical'
        reason_code='auto-restart-failed'
        reason='Upload stall confirmed, but the controlled service restart could not be requested.'
        hint='Inspect systemctl and journalctl for pdrive-watch and rclone-proton-drive.'
    fi
fi

process_age_human="$(human_duration "${process_age}")"
log_age_human="$(human_duration "${log_age}")"
comparison_age_human="$(human_duration "${comparison_age}")"
cache_human="$(human_bytes "${cache_bytes}")"
free_human="$(human_bytes "${free_bytes}")"
rss_human="$(human_bytes "${process_rss_bytes}")"
queue_bytes_human="$(human_bytes "${queue_bytes}")"

cooldown_duration_human="$(human_duration "${auto_restart_cooldown_seconds}")"
automation_summary="active; no cooldown (configured: ${cooldown_duration_human}). Intervention requires two fully confirmed stall checks."
if [[ "${recovery_configured}" == 'true' ]]; then
    automation_summary='automatic restart protects the warm metadata cache; a manually confirmed restart remains available.'
elif (( auto_restart_age >= 0 && auto_restart_age < auto_restart_cooldown_seconds )); then
    automation_remaining=$((auto_restart_cooldown_seconds - auto_restart_age))
    automation_summary="active; restart cooldown has $(human_duration "${automation_remaining}") remaining (configured: ${cooldown_duration_human})."
fi
if [[ ! -e "${cooldown_config}" ]]; then
    cooldown_config_summary="${cooldown_config} (not created; default ${cooldown_duration_human})"
elif [[ -n "${cooldown_config_warning}" ]]; then
    cooldown_config_summary="${cooldown_config} (present but invalid; default ${cooldown_duration_human})"
else
    cooldown_config_summary="${cooldown_config} (active)"
fi
if [[ -n "${recovery_config_warning}" ]]; then
    recovery_summary="WARNING: ${recovery_config_warning}"
elif [[ "${recovery_configured}" == 'true' ]]; then
    recovery_summary="ENABLED (fast exclusive mode; running process: ${recovery_running}); no parallel Proton clients"
else
    recovery_summary="disabled (parallel-client compatible; running process: ${recovery_running})"
fi
if [[ -n "${transfers_config_warning}" ]]; then
    transfers_summary="WARNING: ${transfers_config_warning}"
else
    transfers_summary="configured ${transfers_configured}; running ${transfers_running}"
fi

latest_tmp="$(mktemp "${state_dir}/pdrive-watch-latest.XXXXXX")"
{
    printf 'generated_at=%s\n' "${now_iso}"
    printf 'mode=%s\n' "$([[ "${record_mode}" == true ]] && printf 'timer-record' || printf 'manual')"
    printf 'status=%s\n' "${status}"
    printf 'reason_code=%s\n' "${reason_code}"
    printf 'reason=%s\n' "${reason}"
    printf 'hint=%s\n' "${hint}"
    printf 'service=%s/%s\n' "${active_state}" "${sub_state}"
    printf 'pid=%s\n' "${main_pid}"
    printf 'process_age_seconds=%s\n' "${process_age}"
    printf 'cpu_percent=%s\n' "${process_cpu}"
    printf 'memory_bytes=%s\n' "${process_rss_bytes}"
    printf 'restarts=%s\n' "${restart_count}"
    printf 'mount=%s\n' "${mount_state}"
    printf 'dns=%s\n' "${dns_state}"
    printf 'tcp=%s\n' "${tcp_state}"
    printf 'progress_since_timer=%s\n' "${progress_state}"
    printf 'seconds_since_timer=%s\n' "${comparison_age}"
    printf 'log_age_seconds=%s\n' "${log_age}"
    printf 'last_upload_success_age_seconds=%s\n' "${last_success_age}"
    printf 'last_queue_entry_age_seconds=%s\n' "${last_queue_age}"
    printf 'successful_uploads_in_log=%s\n' "${success_count}"
    printf 'queued_cache_entries_in_log=%s\n' "${queued_count}"
    printf 'errors_in_log=%s\n' "${error_count}"
    printf 'notices_in_log=%s\n' "${notice_count}"
    printf 'delta_uploads=%s\n' "${success_delta}"
    printf 'delta_queued=%s\n' "${queued_delta}"
    printf 'delta_errors=%s\n' "${error_delta}"
    printf 'delta_notices=%s\n' "${notice_delta}"
    printf 'last_upload_success=%s\n' "${last_success}"
    printf 'last_queue_entry=%s\n' "${last_queue}"
    printf 'last_problem=%s\n' "${last_problem}"
    printf 'last_problem_category=%s\n' "${last_problem_kind}"
    printf 'queue_check=%s\n' "${queue_state}"
    printf 'queue_files=%s\n' "${queue_count}"
    printf 'queue_bytes=%s\n' "${queue_bytes}"
    printf 'queue_active_uploads=%s\n' "${queue_uploading_count}"
    printf 'queue_retried=%s\n' "${failed_queue_count}"
    printf 'queue_max_tries=%s\n' "${failed_queue_max_tries}"
    printf 'failed_upload_confirmations=%s\n' "${failed_upload_confirmations}"
    printf 'failed_upload_observation=%s\n' "${failed_upload_observation}"
    printf 'cache_bytes=%s\n' "${cache_bytes}"
    printf 'free_space_bytes=%s\n' "${free_bytes}"
    printf 'stall_confirmations=%s\n' "${stall_confirmations}"
    printf 'activity_measurement=%s\n' "${activity_probe}"
    printf 'activity_rchar_bytes=%s\n' "${activity_rchar_delta}"
    printf 'activity_disk_read_bytes=%s\n' "${activity_read_delta}"
    printf 'activity_tcp_sent_bytes=%s\n' "${activity_tcp_delta}"
    printf 'last_auto_restart_epoch=%s\n' "${previous_auto_restart_epoch}"
    printf 'cooldown_seconds=%s\n' "${auto_restart_cooldown_seconds}"
    printf 'cooldown_config_file=%s\n' "${cooldown_config}"
    printf 'cooldown_config=%s\n' "${cooldown_config_source}"
    printf 'cooldown_config_warning=%s\n' "${cooldown_config_warning:-none}"
    printf 'metadata_cache_config_file=%s\n' "${recovery_config}"
    printf 'metadata_cache_configured=%s\n' "${recovery_configured}"
    printf 'metadata_cache_running=%s\n' "${recovery_running}"
    printf 'metadata_cache_config_warning=%s\n' "${recovery_config_warning:-none}"
    printf 'upload_slots_config_file=%s\n' "${transfers_config}"
    printf 'upload_slots_configured=%s\n' "${transfers_configured}"
    printf 'upload_slots_running=%s\n' "${transfers_running}"
    printf 'upload_slots_config_warning=%s\n' "${transfers_config_warning:-none}"
    printf 'auto_restart_requested=%s\n' "${restart_issued}"
    printf 'automation=%s\n' "${automation_summary}"
} > "${latest_tmp}"
mv -f -- "${latest_tmp}" "${latest_file}"

if [[ "${record_mode}" == true ]]; then
    printf '%s\tstatus=%s\treason=%s\tservice=%s/%s\tpid=%s\tmount=%s\tdns=%s\ttcp=%s\tprogress=%s\tsuccess=%s\tqueued=%s\terrors=%s\tnotices=%s\tlog_age=%s\tstall_confirmations=%s\tvfs_queue=%s\tvfs_queue_bytes=%s\tvfs_uploading=%s\tvfs_failed=%s\tfailed_confirmations=%s\tactivity_read=%s\tactivity_rchar=%s\tactivity_tcp_sent=%s\tauto_restart=%s\tcache=%s\tfree=%s\n' \
        "${now_iso}" "${status}" "${reason_code}" "${active_state}" "${sub_state}" "${main_pid}" \
        "${mount_state}" "${dns_state}" "${tcp_state}" "${progress_state}" "${success_count}" \
        "${queued_count}" "${error_count}" "${notice_count}" "${log_age}" "${stall_confirmations}" \
        "${queue_count}" "${queue_bytes}" "${queue_uploading_count}" "${failed_queue_count}" \
        "${failed_upload_confirmations}" \
        "${activity_read_delta}" "${activity_rchar_delta}" "${activity_tcp_delta}" "${restart_issued}" \
        "${cache_bytes}" "${free_bytes}" \
        >> "${history_file}"
    trim_watch_history

    monitor_tmp="$(mktemp "${state_dir}/pdrive-watch-state.XXXXXX")"
    {
        printf 'state_version=4\n'
        printf 'status=%s\n' "${status}"
        printf 'reason_code=%s\n' "${reason_code}"
        printf 'check_epoch=%s\n' "${now_epoch}"
        printf 'log_mtime=%s\n' "${log_mtime}"
        printf 'success_count=%s\n' "${success_count}"
        printf 'queued_count=%s\n' "${queued_count}"
        printf 'error_count=%s\n' "${error_count}"
        printf 'notice_count=%s\n' "${notice_count}"
        printf 'stall_confirmations=%s\n' "${stall_confirmations}"
        printf 'last_auto_restart_epoch=%s\n' "${previous_auto_restart_epoch}"
        printf 'failed_item_hash=%s\n' "${failed_item_hash}"
        printf 'failed_upload_confirmations=%s\n' "${failed_upload_confirmations}"
    } > "${monitor_tmp}"
    mv -f -- "${monitor_tmp}" "${monitor_state}"

    if [[ "${status}" != "${previous_status}" || "${reason_code}" != "${previous_reason_code}" ]] \
        && notification_allowed "${status}" "${reason_code}" \
        && command -v notify-send >/dev/null 2>&1; then
        case "${status}" in
            ready)
                if [[ "${notification_language}" == 'de' ]]; then
                    notify_pdrive 'Proton Drive ist bereit' \
                        'Der Mount ist direkt unter /pdrive verfügbar.' || true
                else
                    notify_pdrive 'Proton Drive is ready' \
                        'The mount is directly available at /pdrive.' || true
                fi
                ;;
            warning|critical)
                if [[ "${notification_language}" == 'de' ]]; then
                    notify_pdrive --urgency=critical \
                        'Proton-Drive-Monitor benötigt Aufmerksamkeit' "${reason}" || true
                else
                    notify_pdrive --urgency=critical \
                        'Proton Drive monitor needs attention' "${reason}" || true
                fi
                ;;
            working)
                if [[ "${reason_code}" == 'auto-restart-issued' ]]; then
                    if [[ "${notification_language}" == 'de' ]]; then
                        notify_pdrive --urgency=normal \
                            'Proton Drive wird vorsichtig neu gestartet' \
                            'Zwei Prüfungen bestätigten einen Uploadstillstand ohne laufende Nutzdatenübertragung.' || true
                    else
                        notify_pdrive --urgency=normal \
                            'Proton Drive is restarting carefully' \
                            'Two checks confirmed an upload stall without active payload traffic.' || true
                    fi
                fi
                ;;
        esac
    fi
fi

printf '\nProton Drive status — %s\n' "${now_iso}"
printf 'Overall:      %-8s %s\n' "${status}" "${reason}"
printf 'Service:      %s/%s, PID %s, uptime %s, restarts %s\n' \
    "${active_state}" "${sub_state}" "${main_pid}" "${process_age_human}" "${restart_count}"
printf 'Process:      CPU %s%%, RAM %s\n' "${process_cpu}" "${rss_human}"
printf 'Access:       mount %s, DNS %s, TCP %s\n' "${mount_state}" "${dns_state}" "${tcp_state}"
printf 'Log:          last updated %s ago\n' "${log_age_human}"
printf 'Totals:       uploads %s, queued %s, errors %s, notices %s\n' \
    "${success_count}" "${queued_count}" "${error_count}" "${notice_count}"
if [[ "${baseline_compatible}" != true ]]; then
    printf 'Comparison:   will be established by the next timer run\n'
else
    printf 'Since timer:  %s ago; progress %s; uploads %s, queued %s, errors %s, notices %s\n' \
        "${comparison_age_human}" "${progress_state}" "${success_delta}" "${queued_delta}" \
        "${error_delta}" "${notice_delta}"
fi
printf 'Latest success: %s\n' "${last_success}"
printf 'Latest queue:   %s\n' "${last_queue}"
printf 'Latest problem: %s (%s)\n' "${last_problem}" "${last_problem_kind}"
printf 'VFS queue:     check %s; %s file(s), %s, %s active\n' \
    "${queue_state}" "${queue_count}" "${queue_bytes_human}" "${queue_uploading_count}"
printf 'Upload errors: %s retried; confirmation %s/%s; %s\n' \
    "${failed_queue_count}" "${failed_upload_confirmations}" \
    "${failed_upload_confirmations_required}" "${failed_upload_observation}"
printf 'Stall:         confirmation %s/%s; live measurement: %s\n' \
    "${stall_confirmations}" "${stall_confirmations_required}" "${activity_probe}"
printf 'Automation:    %s\n' "${automation_summary}"
printf 'Configuration: %s\n' "${cooldown_config_summary}"
printf 'Metadata cache: %s\n' "${recovery_summary}"
printf 'Cache file:     %s\n' "${recovery_config}"
printf 'Upload slots:  %s\n' "${transfers_summary}"
printf 'Slot file:     %s\n' "${transfers_config}"
if [[ -n "${cooldown_config_warning}" ]]; then
    printf 'Configuration: WARNING: %s.\n' "${cooldown_config_warning}"
fi
if [[ "${activity_probe}" != 'not required' ]]; then
    printf 'Live I/O:      disk read %s, process read %s, TCP sent %s in %ss\n' \
        "$(human_bytes "${activity_read_delta}")" "$(human_bytes "${activity_rchar_delta}")" \
        "$(human_bytes "${activity_tcp_delta}")" "${activity_probe_seconds}"
fi
printf 'Storage:      cache %s, free %s\n' "${cache_human}" "${free_human}"
printf 'Guidance:     %s\n' "${hint}"
if [[ "${record_mode}" == true ]]; then
    printf 'Recording:    history and the 90-minute comparison point were updated.\n'
else
    printf 'Recording:    current diagnosis only; the timer comparison point remains unchanged.\n'
fi
if [[ "${cooldown_cleared}" == true ]]; then
    printf 'Action:       active restart cooldown cleared atomically; configured duration %s remains and rclone was untouched.\n' \
        "${cooldown_duration_human}"
fi
if [[ "${cooldown_duration_changed}" == true ]]; then
    printf 'Action:       cooldown duration atomically set to %s; it applies immediately to an active cooldown. rclone was untouched.\n' \
        "${cooldown_duration_human}"
fi
if [[ "${restart_service_mode}" == true ]]; then
    restart_service_and_validate
fi
