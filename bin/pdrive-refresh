#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-3.0-or-later

set -euo pipefail
umask 077

script_path="$(readlink -f -- "${BASH_SOURCE[0]}")"
project_root="$(cd -- "$(dirname -- "${script_path}")/.." && pwd -P)"
readonly service_name='rclone-proton-drive.service'
readonly rc_socket="${HOME}/.local/state/rclone/pdrive-rc.sock"
readonly rclone_bin="${project_root}/bin/rclone"
readonly watch_bin="${project_root}/bin/pdrive-watch"
readonly recovery_config="${HOME}/.config/pdrive-recovery.conf"
readonly account_cache_helper="${PDRIVE_ACCOUNT_CACHE_HELPER:-${project_root}/libexec/pdrive-account-cache}"

resolve_cache_dir() {
    local helper="${account_cache_helper}"
    if [[ ! -x "${helper}" ]]; then
        printf 'Account cache resolver is missing: %s\n' "${helper}" >&2
        return 69
    fi
    "${helper}" --path
}

cache_dir="$(resolve_cache_dir)"
readonly cache_dir
readonly vfs_meta_root="${cache_dir}/vfsMeta"

usage() {
    printf '%s\n' \
        'Usage: pdrive-refresh [OPTION]' \
        '' \
        'No option: show local cache/service state; guaranteed action-free.' \
        '--refresh: rebuild Proton and VFS metadata with a controlled restart.' \
        '           Checks the queue and Dirty files before delegating to the' \
        '           interactively confirmed and validated rclone restart.' \
        '-h, --help: show only this guaranteed action-free help.' \
        '' \
        'Why a restart: vfs/forget clears only the upper directory cache, not' \
        'the process-local Proton link/key cache. A controlled restart is the only' \
        'guaranteed refresh after external changes.'
}

configured_cache_mode() {
    local entries=''

    if [[ ! -r "${recovery_config}" ]]; then
        printf 'unknown'
        return
    fi
    entries="$(awk '
        /^[[:space:]]*($|#)/ { next }
        { print }
    ' "${recovery_config}")"
    case "${entries}" in
        proton_metadata_cache=true) printf 'enabled (fast exclusive mode)' ;;
        proton_metadata_cache=false) printf 'disabled (parallel-client compatible)' ;;
        *) printf 'invalid' ;;
    esac
}

dirty_stats() {
    if [[ ! -d "${vfs_meta_root}" ]]; then
        printf '0 0\n'
        return
    fi
    find "${vfs_meta_root}" -mindepth 2 -type f -path '*/proton*/*' -print0 2>/dev/null \
        | xargs -0 -r jq -r 'select(.Dirty == true) | (.Size // 0)' 2>/dev/null \
        | awk '{ count++; bytes += $1 } END { printf "%d %.0f\n", count + 0, bytes + 0 }'
}

read_queue() {
    if [[ ! -x "${rclone_bin}" || ! -S "${rc_socket}" ]]; then
        return 1
    fi
    timeout --signal=TERM 10s "${rclone_bin}" rc \
        --unix-socket "${rc_socket}" vfs/queue 2>/dev/null
}

show_status() {
    local properties active sub pid queue_json=''
    local queue_count='unknown' uploading_count='unknown'
    local dirty_count dirty_bytes

    properties="$(systemctl --user show "${service_name}" \
        -p ActiveState -p SubState -p MainPID --no-pager 2>/dev/null || true)"
    active="$(awk -F= '$1 == "ActiveState" { print $2; exit }' <<< "${properties}")"
    sub="$(awk -F= '$1 == "SubState" { print $2; exit }' <<< "${properties}")"
    pid="$(awk -F= '$1 == "MainPID" { print $2; exit }' <<< "${properties}")"
    : "${active:=unknown}" "${sub:=unknown}" "${pid:=0}"

    if queue_json="$(read_queue)" \
        && jq -e '.queue | type == "array"' >/dev/null 2>&1 <<< "${queue_json}"; then
        queue_count="$(jq -r '.queue | length' <<< "${queue_json}")"
        uploading_count="$(jq -r '[.queue[] | select(.uploading == true)] | length' <<< "${queue_json}")"
    fi
    read -r dirty_count dirty_bytes < <(dirty_stats)

    printf 'Proton Drive cache refresh\n\n'
    printf 'Service:        %s/%s, PID %s\n' "${active}" "${sub}" "${pid}"
    printf 'Metadata cache: %s\n' "$(configured_cache_mode)"
    printf 'VFS queue:      %s file(s), %s active\n' "${queue_count}" "${uploading_count}"
    printf 'Local Dirty:    %s file(s), %s bytes\n' "${dirty_count}" "${dirty_bytes}"
    printf 'RC socket:      %s\n' "${rc_socket}"
    printf '%s\n' \
        'Note: Without --refresh nothing was changed.' \
        'After external changes while this laptop remained on or suspended: pdrive-refresh --refresh'
}

case "${1:-}" in
    '')
        (( $# == 0 )) || { usage >&2; exit 2; }
        show_status
        ;;
    -h|--help)
        (( $# == 1 )) || { printf 'Too many arguments.\n' >&2; exit 2; }
        usage
        ;;
    --refresh)
        (( $# == 1 )) || { printf 'Too many arguments.\n' >&2; exit 2; }
        properties="$(systemctl --user show "${service_name}" \
            -p ActiveState -p SubState --no-pager 2>/dev/null || true)"
        active="$(awk -F= '$1 == "ActiveState" { print $2; exit }' <<< "${properties}")"
        if [[ "${active}" != 'active' ]]; then
            printf '%s\n' \
                'No refresh is needed: the rclone service is not running, so no warm in-memory metadata cache exists.' \
                'The next normal start reads fresh Proton metadata.'
            exit 0
        fi
        if ! queue_json="$(read_queue)" \
            || ! jq -e '.queue | type == "array"' >/dev/null 2>&1 <<< "${queue_json}"; then
            printf 'Refused: the local VFS queue could not be checked safely.\n' >&2
            exit 75
        fi
        queue_count="$(jq -r '.queue | length' <<< "${queue_json}")"
        uploading_count="$(jq -r '[.queue[] | select(.uploading == true)] | length' <<< "${queue_json}")"
        read -r dirty_count dirty_bytes < <(dirty_stats)
        if (( queue_count != 0 || uploading_count != 0 || dirty_count != 0 )); then
            printf '%s\n' \
                "Refused: VFS queue ${queue_count}, active uploads ${uploading_count}, Dirty files ${dirty_count} (${dirty_bytes} bytes)." \
                'The service remains unchanged; wait for pending writes to finish first.' >&2
            exit 75
        fi
        if [[ ! -x "${watch_bin}" ]]; then
            printf 'Refused: %s is missing or not executable.\n' "${watch_bin}" >&2
            exit 78
        fi
        printf '%s\n' \
            'Preflight passed: no queue, active uploads or Dirty files.' \
            'The existing guarded path now requires the exact confirmation RESTART,' \
            'starts exactly one service instance and then validates its PID and mount.'
        exec "${watch_bin}" --restart-service
        ;;
    *)
        printf 'Unknown option: %s\n\n' "$1" >&2
        usage >&2
        exit 2
        ;;
esac
