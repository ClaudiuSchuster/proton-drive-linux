    "auto-restart-failed": "The controlled service restart could not be requested.",
}


def normalize_delta(value: str) -> str:
    if value == "Basis fehlt":
        return "No baseline"
    if value == "Log neu begonnen":
        return "Log restarted"
    return value


def normalize_latest(raw: dict[str, str], now_epoch: int) -> dict[str, Any]:
    generated_epoch = 0
    try:
        generated_epoch = int(dt.datetime.fromisoformat(raw.get("Zeit", "")).timestamp())
    except (ValueError, TypeError):
        pass
    reason_code = raw.get("Grundcode", "unknown")
    mode = "timer-record" if "Timer" in raw.get("Modus", "") else "manual"
    problem_category = raw.get("LetzteProblemkategorie", "none")
    if problem_category == "sonstiger Fehler":
        problem_category = "other error"
    elif problem_category == "keine":
        problem_category = "none"
    return {
        "available": bool(raw),
        "generated_at": raw.get("Zeit", ""),
        "age_seconds": max(0, now_epoch - generated_epoch) if generated_epoch else -1,
        "mode": mode,
        "status": raw.get("Status", "unknown"),
        "reason_code": reason_code,
        "summary": WATCHDOG_SUMMARIES.get(reason_code, "No watchdog details are available."),
        "hint": "Run pdrive-watch for a detailed local diagnosis.",
        "dns": raw.get("DNS", "unknown"),
        "tcp": raw.get("TCP", "unknown"),
        "log_age_seconds": integer(raw.get("LogAlterSekunden"), -1),
        "last_success": raw.get("LetzterUploadErfolg", "none"),
        "last_problem": raw.get("LetztesProblem", "none"),
        "last_problem_category": problem_category,
        "successes": integer(raw.get("UploadsErfolgreichImLog")),
        "queued_log_entries": integer(raw.get("CacheeintraegeEingereihtImLog")),
        "errors": integer(raw.get("FehlerImLog")),
        "notices": integer(raw.get("HinweiseImLog")),
        "delta_successes": normalize_delta(raw.get("DeltaUploads", "No baseline")),
        "delta_errors": normalize_delta(raw.get("DeltaFehler", "No baseline")),
        "delta_notices": normalize_delta(raw.get("DeltaHinweise", "No baseline")),
        "failed_confirmations": integer(raw.get("UploadfehlerBestaetigungen")),
        "stall_confirmations": integer(raw.get("Stillstandsbestaetigungen")),
        "metadata_cache_running": boolean(raw.get("MetadatenCacheLaufend")),
        "metadata_cache_configured": boolean(raw.get("MetadatenCacheKonfiguriert")),
        "configured_transfers": integer(raw.get("UploadslotsKonfiguriert"), 4),
        "running_transfers": integer(raw.get("UploadslotsLaufend"), 4),
        "cooldown_seconds": integer(raw.get("CooldownDauerSekunden"), 43200),
        "last_auto_restart_epoch": integer(raw.get("LetzterAutoneustartEpoch")),
        "automation": "enabled" if raw.get("Automatik") else "unknown",
        "cache_bytes": integer(raw.get("CacheBytes")),
        "free_bytes": integer(raw.get("FreierSpeicherBytes")),
    }


def normalize_draft_recovery(raw: dict[str, Any], now_epoch: int) -> dict[str, Any]:
    generated_epoch = iso_epoch(raw.get("generated_at"))
    allowed_statuses = {
        "active",
        "completed",
        "confirming",
        "confirming-stall",
        "cooldown",
        "deferred",
        "error",
        "healthy",
        "inactive",
        "network-deferred",
        "observing",
        "probing",
        "process-changed",
        "recovering",
        "recovery-started",
        "restart-failed",
        "restart-limited",
        "restart-requested",
        "restarted",
        "throttled",
    }
    status = str(raw.get("status") or "unavailable")
    if status not in allowed_statuses:
        status = "unavailable"
    return {
        "available": bool(raw),
        "generated_at": str(raw.get("generated_at") or ""),
        "age_seconds": max(0, now_epoch - generated_epoch) if generated_epoch else -1,
        "status": status,
        "detail": str(raw.get("detail") or "")[:500],
        "phase": "recovery" if raw.get("phase") == "recovery" else "normal",
        "queue_count": max(0, integer(raw.get("queue_count"))),
        "progress_proven": boolean(raw.get("progress_proven")),
        "error_category": str(raw.get("error_category") or "none")[:80],
        "stall_confirmations": max(0, integer(raw.get("stall_confirmations"))),
        "restart_attempts": max(0, integer(raw.get("restart_attempts"))),
    }


def build_state(include_capacity: bool = False) -> dict[str, Any]:
    now = dt.datetime.now().astimezone()
    now_epoch = int(now.timestamp())
    latest = normalize_latest(read_key_values(LATEST_FILE), now_epoch)
    draft_recovery = normalize_draft_recovery(read_json_object(DRAFT_RECOVERY_LATEST), now_epoch)
    service = service_state()
    mount = mount_state()
    # vfs/* returns an error and writes an ERROR line to rclone's own log while
    # the RC socket is up but the mount has not registered its VFS yet. Avoid
    # manufacturing user-visible issues during this normal startup window.
    rc_payloads, rc_errors = collect_rc(include_vfs=mount["ready"])
    stats = rc_payloads.get("core/stats", {})
    transferred = rc_payloads.get("core/transferred", {}).get("transferred", [])
    if not isinstance(transferred, list):
        transferred = []
    recent_transfers = [
        normalize_transfer(item, completed=True) for item in transferred[-24:] if isinstance(item, dict)
    ]
    active_raw = stats.get("transferring", [])
    if not isinstance(active_raw, list):
        active_raw = []
    active = [normalize_transfer(item) for item in active_raw if isinstance(item, dict)]
    queue = normalize_queue(rc_payloads.get("vfs/queue"))
    queue["remaining_bytes"] = queue_remaining_bytes(queue, active)
    vfs = rc_payloads.get("vfs/stats", {})
    disk_cache = vfs.get("diskCache", {}) if isinstance(vfs.get("diskCache"), dict) else {}
    vfs_options = vfs.get("opt", {}) if isinstance(vfs.get("opt"), dict) else {}
    bandwidth = rc_payloads.get("core/bwlimit", {})

    components = []
    if not service["available"]:
        components.append(
            {
                "component": "systemd",
                "message": service["error"] or "Service status is unavailable",
            }
        )
    for endpoint, message in rc_errors.items():
        components.append({"component": endpoint, "message": message})

    if not service["active"]:
        health_status = "critical"
        health_summary = f"The Proton Drive service is {service['active_state']}/{service['sub_state']}."
        health_reason = "service-inactive"
    elif not mount["ready"]:
        health_status = "warning"
        health_summary = "The service is running, but /pdrive is not ready yet."
        health_reason = "mount-not-ready"
    elif "core/stats" in rc_errors or "vfs/queue" in rc_errors:
        health_status = "warning"
        health_summary = "The mount is ready, but some live values are temporarily unavailable."
        health_reason = "rc-unavailable"
    elif latest["status"] in {"warning", "critical"} and 0 <= latest["age_seconds"] <= 10800:
        health_status = latest["status"]
        health_summary = latest["summary"]
        health_reason = latest["reason_code"]
    else:
        health_status = "ready"
        if queue["active"]:
            health_summary = f"{queue['active']} upload(s) are running through the existing Proton Drive service."
        elif queue["count"]:
            health_summary = f"{queue['count']} file(s) are safely waiting in the VFS queue."
        else:
            health_summary = "Proton Drive is mounted and ready."
        health_reason = "mounted"

    configured_bwlimit = read_config_value(CONFIG_DIR / "pdrive-bwlimit.conf", "bwlimit", "off")
    configured_transfers = integer(read_config_value(CONFIG_DIR / "pdrive-transfers.conf", "transfers", "4"), 4)
    metadata_cache = boolean(read_config_value(CONFIG_DIR / "pdrive-recovery.conf", "proton_metadata_cache", "false"))
    cache_max_age_raw = read_config_value(CONFIG_DIR / "pdrive-cache.conf", "cache_max_age_hours", "24")
    cache_max_age_hours = integer(cache_max_age_raw, 24)
    cache_max_age_valid = cache_max_age_raw.isdigit() and 1 <= cache_max_age_hours <= 8760
    if not cache_max_age_valid:
        cache_max_age_hours = 24
    cache_bytes = integer(disk_cache.get("bytesUsed"), latest["cache_bytes"])
    cache_files = integer(disk_cache.get("files"))
    pending_files = max(
        integer(disk_cache.get("uploadsQueued"), queue["count"]),
        queue["count"],
    )
    pending_bytes = max(0, queue["bytes"])
    clean_files = max(0, cache_files - pending_files)
    clean_bytes = max(0, cache_bytes - pending_bytes)
    errored_files = integer(disk_cache.get("erroredFiles"))
    if "vfs/stats" in rc_errors:
        cache_state = "unavailable"
    elif errored_files:
        cache_state = "error"
    elif pending_files:
        cache_state = "pending"
    elif cache_files:
        cache_state = "clean"
    else:
        cache_state = "empty"
    running_cache_age_ns = integer(vfs_options.get("CacheMaxAge"), -1)
    running_cache_age_seconds = running_cache_age_ns // 1_000_000_000 if running_cache_age_ns >= 0 else -1
    free_bytes = disk_free(STATE_DIR)

    return {
        "schema_version": SCHEMA_VERSION,
        "tool_version": TOOL_VERSION,
        "generated_at": now.isoformat(timespec="seconds"),
        "generated_epoch": now_epoch,
        "health": {
            "status": health_status,
            "reason_code": health_reason,
            "summary": health_summary,
            "hint": latest["hint"],
            "components": components,
        },
        "service": service,
        "mount": mount,
        "remote_capacity": remote_capacity(include_capacity, mount["ready"]),
        "network": {"dns": latest["dns"], "tcp": latest["tcp"]},
        "network_io": process_tcp_counters(service["pid"]),
        "stats": {
            "available": "core/stats" in rc_payloads,
            "bytes": integer(stats.get("bytes")),
            "speed": number(stats.get("speed")),
            "eta_seconds": integer(stats.get("eta"), -1),
            "errors": integer(stats.get("errors")),
            "fatal_error": boolean(stats.get("fatalError")),
            "retry_error": boolean(stats.get("retryError")),
            "checks": integer(stats.get("checks")),
            "transfers": integer(stats.get("transfers")),
            "total_bytes": integer(stats.get("totalBytes")),
            "total_transfers": integer(stats.get("totalTransfers")),
            "elapsed_seconds": number(stats.get("elapsedTime")),
        },
        "transfers": {
            "active": active,
            "recent": recent_transfers,
        },
        "queue": queue,
        "vfs": {
            "available": "vfs/stats" in rc_payloads,
            "cache_bytes": cache_bytes,
            "cache_files": cache_files,
            "cache_state": cache_state,
            "clean_files": clean_files,
            "clean_bytes": clean_bytes,
            "pending_files": pending_files,
            "pending_bytes": pending_bytes,
            "uploads_queued": pending_files,
            "uploads_in_progress": integer(disk_cache.get("uploadsInProgress"), queue["active"]),
            "errored_files": errored_files,
            "out_of_space": boolean(disk_cache.get("outOfSpace")),
            "free_bytes": free_bytes or latest["free_bytes"],
        },
        "bandwidth": {
            "configured": configured_bwlimit,
            "live": str(bandwidth.get("rate") or "unavailable"),
            "bytes_per_second": number(bandwidth.get("bytesPerSecond"), -1),
            "upload_bytes_per_second": number(bandwidth.get("bytesPerSecondTx"), -1),
        },
        "configuration": {
            "transfers": configured_transfers,
            "running_transfers": latest["running_transfers"],
            "metadata_cache": metadata_cache,
            "cache_max_age_seconds": cache_max_age_hours * 3600,
            "running_cache_max_age_seconds": running_cache_age_seconds,
            "cache_max_age_valid": cache_max_age_valid,
            "cooldown_seconds": latest["cooldown_seconds"],
        },
        "issues": enrich_issue_lifecycles(recent_issues(), queue, recent_transfers, latest),
        "watchdog": latest,
        "draft_recovery": draft_recovery,
        "history": history_entries(),
    }


def parser() -> argparse.ArgumentParser:
    result = argparse.ArgumentParser(
        prog="pdrive-state",
        description=(
            "Emit a fast, read-only JSON snapshot of the existing "
            "proton-drive-linux service. No second rclone process is started."
        ),
    )
    result.add_argument("--compact", action="store_true", help="emit JSON without indentation")
    result.add_argument(
        "--include-capacity",
        action="store_true",
        help="include one on-demand capacity reading from the mounted remote",
    )
    result.add_argument("--version", action="version", version=f"%(prog)s {TOOL_VERSION}")
    return result


def main() -> int:
    args = parser().parse_args()
    payload = build_state(include_capacity=args.include_capacity)
    json.dump(
        payload,
        sys.stdout,
        ensure_ascii=False,
        indent=None if args.compact else 2,
        separators=(",", ":") if args.compact else None,
    )
    sys.stdout.write("\n")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
