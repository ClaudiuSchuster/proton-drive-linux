"""Fast, read-only JSON state for the proton-drive-linux desktop UI."""

from __future__ import annotations

import argparse
import concurrent.futures
import datetime as dt
import http.client
import json
import os
import pathlib
import re
import shutil
import socket
import subprocess
import sys
import time
from typing import Any


SCHEMA_VERSION = 1
TOOL_VERSION = "0.6.3"


def env_path(name: str, default: pathlib.Path) -> pathlib.Path:
    return pathlib.Path(os.environ.get(name, str(default))).expanduser()


HOME = pathlib.Path.home()
STATE_DIR = env_path("PDRIVE_STATE_DIR", HOME / ".local/state/rclone")
CONFIG_DIR = env_path("PDRIVE_CONFIG_DIR", HOME / ".config")
MOUNT_DIR = env_path("PDRIVE_MOUNT_DIR", pathlib.Path("/pdrive"))
RC_SOCKET = env_path("PDRIVE_RC_SOCKET", STATE_DIR / "pdrive-rc.sock")
RCLONE_BIN = env_path("PDRIVE_RCLONE_BIN", HOME / ".local/libexec/rclone-bin")
LATEST_FILE = env_path("PDRIVE_WATCH_LATEST", STATE_DIR / "pdrive-watch-latest.txt")
HISTORY_FILE = env_path("PDRIVE_WATCH_HISTORY", STATE_DIR / "pdrive-watch-history.log")
MOUNT_LOG = env_path("PDRIVE_MOUNT_LOG", STATE_DIR / "proton-mount.log")
DRAFT_RECOVERY_LATEST = env_path(
    "PDRIVE_DRAFT_RECOVERY_LATEST",
    STATE_DIR / "pdrive-draft-recovery-latest.json",
)


def run(command: list[str], timeout: float = 3.0) -> tuple[int, str, str]:
    try:
        completed = subprocess.run(
            command,
            check=False,
            capture_output=True,
            text=True,
            timeout=timeout,
        )
        return completed.returncode, completed.stdout, completed.stderr
    except (OSError, subprocess.TimeoutExpired) as error:
        return 124, "", str(error)


def integer(value: Any, default: int = 0) -> int:
    try:
        return int(value)
    except (TypeError, ValueError):
        return default


def number(value: Any, default: float = 0.0) -> float:
    try:
        return float(value)
    except (TypeError, ValueError):
        return default


def boolean(value: Any, default: bool = False) -> bool:
    if isinstance(value, bool):
        return value
    if str(value).lower() in {"true", "yes", "1", "on", "ready", "ok"}:
        return True
    if str(value).lower() in {"false", "no", "0", "off"}:
        return False
    return default


def iso_epoch(value: Any, default: int = 0) -> int:
    try:
        return int(dt.datetime.fromisoformat(str(value).replace("Z", "+00:00")).timestamp())
    except (TypeError, ValueError):
        return default


def read_key_values(path: pathlib.Path) -> dict[str, str]:
    values: dict[str, str] = {}
    try:
        for line in path.read_text(encoding="utf-8", errors="replace").splitlines():
            if "=" not in line:
                continue
            key, value = line.split("=", 1)
            values[key.strip()] = value.strip()
    except OSError:
        pass
    return values


def read_json_object(path: pathlib.Path) -> dict[str, Any]:
    try:
        payload = json.loads(path.read_text(encoding="utf-8", errors="replace"))
    except (OSError, json.JSONDecodeError):
        return {}
    return payload if isinstance(payload, dict) else {}


def read_config_value(path: pathlib.Path, key: str, default: str) -> str:
    value = read_key_values(path).get(key, default)
    return value if value else default


def service_state() -> dict[str, Any]:
    properties = [
        "ActiveState",
        "SubState",
        "MainPID",
        "Result",
        "ExecMainStatus",
        "NRestarts",
        "ActiveEnterTimestamp",
        "ActiveEnterTimestampMonotonic",
    ]
    command = ["systemctl", "--user", "show", "rclone-proton-drive.service"]
    for prop in properties:
        command.extend(["-p", prop])
    command.append("--no-pager")
    code, stdout, stderr = run(command)
    raw = {}
    for line in stdout.splitlines():
        if "=" in line:
            key, value = line.split("=", 1)
            raw[key] = value
    active = raw.get("ActiveState", "unknown")
    sub = raw.get("SubState", "unknown")
    active_since_monotonic = integer(raw.get("ActiveEnterTimestampMonotonic"), -1)
    uptime_seconds = (
        max(0, int(time.monotonic() - (active_since_monotonic / 1_000_000))) if active_since_monotonic > 0 else -1
    )
    return {
        "available": code == 0,
        "active_state": active,
        "sub_state": sub,
        "active": active in {"active", "activating"},
        "pid": integer(raw.get("MainPID")),
        "result": raw.get("Result", "unknown"),
        "exit_status": integer(raw.get("ExecMainStatus"), -1),
        "restarts": integer(raw.get("NRestarts")),
        "since": raw.get("ActiveEnterTimestamp", ""),
        "uptime_seconds": uptime_seconds,
        "error": stderr.strip() if code else "",
    }


def process_tcp_counters(pid: int) -> dict[str, Any]:
    """Return cumulative TCP payload counters owned by one process.

    rclone's aggregate transfer statistics describe copy operations but do not
    expose VFS read traffic separately. Linux TCP_INFO counters let the UI
    derive an honest receive rate without observing any other application.
    """

    empty = {
        "available": False,
        "connections": 0,
        "sent_bytes": 0,
        "received_bytes": 0,
    }
    if pid <= 0 or shutil.which("ss") is None:
        return empty
    code, stdout, _stderr = run(["ss", "-Htinp", "state", "established"], timeout=2.0)
    if code != 0:
        return empty
    lines = stdout.splitlines()
    sent_bytes = 0
    received_bytes = 0
    connections = 0
    process_pattern = re.compile(rf"\bpid={pid}(?:,|\))")
    counter_pattern = re.compile(r"\b(bytes_sent|bytes_received):(\d+)\b")
    for index, line in enumerate(lines):
        if process_pattern.search(line) is None:
            continue
        details = line
        if index + 1 < len(lines) and "bytes_" in lines[index + 1]:
            details += " " + lines[index + 1]
        counters = {name: integer(value) for name, value in counter_pattern.findall(details)}
        sent_bytes += counters.get("bytes_sent", 0)
        received_bytes += counters.get("bytes_received", 0)
        connections += 1
    return {
        "available": True,
        "connections": connections,
        "sent_bytes": sent_bytes,
        "received_bytes": received_bytes,
    }


def mount_state() -> dict[str, Any]:
    code, stdout, stderr = run(["findmnt", "-rn", "-M", str(MOUNT_DIR), "-o", "TARGET,SOURCE,FSTYPE,OPTIONS"])
    fields = stdout.strip().split(maxsplit=3)
    fstype = fields[2] if len(fields) >= 3 else ""
    options = fields[3] if len(fields) >= 4 else ""
    ready = code == 0 and fstype in {"fuse", "fuse.rclone"}
    return {
        "ready": ready,
        "target": fields[0] if fields else str(MOUNT_DIR),
        "source": fields[1] if len(fields) >= 2 else "",
        "fstype": fstype,
        "writable": ready and "rw" in options.split(","),
        "options": options,
        "error": stderr.strip() if code else "",
    }


class UnixHTTPConnection(http.client.HTTPConnection):
    def __init__(self, socket_path: pathlib.Path, timeout: float = 3.0) -> None:
        super().__init__("localhost", timeout=timeout)
        self.socket_path = socket_path

    def connect(self) -> None:
        connection = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        connection.settimeout(self.timeout)
        connection.connect(str(self.socket_path))
        self.sock = connection


def rc_call_cli(endpoint: str) -> tuple[str, dict[str, Any] | None, str]:
    if not RCLONE_BIN.is_file() or not os.access(RCLONE_BIN, os.X_OK):
        return endpoint, None, f"rclone is missing: {RCLONE_BIN}"
    if not RC_SOCKET.exists():
        return endpoint, None, f"RC socket is missing: {RC_SOCKET}"
    code, stdout, stderr = run(
        [str(RCLONE_BIN), "rc", "--unix-socket", str(RC_SOCKET), endpoint],
        timeout=4.0,
    )
    if code != 0:
        return endpoint, None, stderr.strip() or f"RC call exited with {code}"
    try:
        payload = json.loads(stdout)
    except json.JSONDecodeError as error:
        return endpoint, None, f"Invalid RC JSON: {error}"
    if not isinstance(payload, dict):
        return endpoint, None, "Unexpected RC response"
    return endpoint, payload, ""


def rc_call(endpoint: str) -> tuple[str, dict[str, Any] | None, str]:
    # The CLI fallback exists for isolated fixture tests and unusual debugging.
    # Production polling talks HTTP directly over the already owner-only Unix
    # socket. This avoids starting five large Go processes on every UI refresh.
    if os.environ.get("PDRIVE_RC_TRANSPORT") == "cli":
        return rc_call_cli(endpoint)
    if not RC_SOCKET.exists():
        return endpoint, None, f"RC socket is missing: {RC_SOCKET}"
    connection = UnixHTTPConnection(RC_SOCKET, timeout=3.0)
    try:
        connection.request(
            "POST",
            f"/{endpoint}",
            body=b"{}",
            headers={"Content-Type": "application/json", "Accept": "application/json"},
        )
        response = connection.getresponse()
        body = response.read().decode("utf-8", errors="replace")
        if response.status < 200 or response.status >= 300:
            return endpoint, None, f"RC HTTP {response.status}: {body[:300]}"
        payload = json.loads(body)
        if not isinstance(payload, dict):
            return endpoint, None, "Unexpected RC response"
        return endpoint, payload, ""
    except (
        OSError,
        TimeoutError,
        json.JSONDecodeError,
        http.client.HTTPException,
    ) as error:
        return endpoint, None, str(error)
    finally:
        connection.close()


def collect_rc(*, include_vfs: bool) -> tuple[dict[str, dict[str, Any]], dict[str, str]]:
    endpoints = ["core/stats", "core/transferred", "core/bwlimit"]
    if include_vfs:
        endpoints.extend(["vfs/queue", "vfs/stats"])
    payloads: dict[str, dict[str, Any]] = {}
    errors: dict[str, str] = {}
    with concurrent.futures.ThreadPoolExecutor(max_workers=len(endpoints)) as pool:
        for endpoint, payload, error in pool.map(rc_call, endpoints):
            if payload is not None:
                payloads[endpoint] = payload
            else:
                errors[endpoint] = error
    return payloads, errors


def transfer_name(item: dict[str, Any]) -> str:
    return str(item.get("name") or item.get("path") or item.get("remote") or "Unknown file")


def normalize_transfer(item: dict[str, Any], *, completed: bool = False) -> dict[str, Any]:
    size = integer(item.get("size") or item.get("totalBytes"))
    done = integer(item.get("bytes") or item.get("transferred"))
    percentage = number(item.get("percentage"), -1.0)
    if percentage < 0 and size > 0:
        percentage = min(100.0, done * 100.0 / size)
    speed = number(item.get("speed") or item.get("speedAvg"))
    error = str(item.get("error") or "")
    return {
        "name": transfer_name(item),
        "size": size,
        "bytes": done,
        "percentage": max(0.0, percentage),
        "speed": speed,
        "eta_seconds": integer(item.get("eta"), -1),
        "started_at": str(item.get("startedAt") or ""),
        "completed_at": str(item.get("completedAt") or ""),
        "checked": boolean(item.get("checked")),
        "completed": completed and not error,
        "error": error,
        "group": str(item.get("group") or ""),
    }


def normalize_queue(payload: dict[str, Any] | None) -> dict[str, Any]:
    raw_items = payload.get("queue", []) if payload else []
    if not isinstance(raw_items, list):
        raw_items = []
    items = []
    for raw in raw_items:
        if not isinstance(raw, dict):
            continue
        items.append(
            {
                "name": transfer_name(raw),
                "size": integer(raw.get("size")),
                "tries": integer(raw.get("tries")),
                "uploading": boolean(raw.get("uploading")),
                "queued_at": str(raw.get("queued") or raw.get("queuedAt") or ""),
                "delay_seconds": number(raw.get("delay")),
                "id": integer(raw.get("id"), -1),
            }
        )
    return {
        "available": payload is not None,
        "count": len(items),
        "bytes": sum(item["size"] for item in items),
        "active": sum(1 for item in items if item["uploading"]),
        "failed": sum(1 for item in items if item["tries"] >= 2),
        "max_tries": max((item["tries"] for item in items), default=0),
        "items": items,
    }


def queue_remaining_bytes(queue: dict[str, Any], active: list[dict[str, Any]]) -> int:
    """Estimate bytes still pending across the complete VFS upload queue.

    vfs/queue reports each queued file's full size while core/stats reports the
    bytes already sent for an active copy. Match each active copy to at most one
    queue item so the UI can estimate the complete backlog without understating
    it when filenames repeat.
    """

    remaining = max(0, integer(queue.get("bytes")))
    unmatched = list(queue.get("items", []))
    for transfer in active:
        name = str(transfer.get("name") or "")
        for index, item in enumerate(unmatched):
            if str(item.get("name") or "") != name:
                continue
            size = max(0, integer(item.get("size")))
            completed = min(size, max(0, integer(transfer.get("bytes"))))
            remaining = max(0, remaining - completed)
            unmatched.pop(index)
            break
    return remaining


def sanitize_issue_text(value: str) -> str:
    """Remove API identifiers and credential-shaped values from a log message."""

    cleaned = value.replace("\x00", " ")
    cleaned = re.sub(r"https?://\S+", "<Proton API URL>", cleaned, flags=re.IGNORECASE)
    cleaned = re.sub(
        r"(?i)(\b(?:link|share) ID\s*['\"])[^'\"]*(['\"])",
        r"\1<redacted>\2",
        cleaned,
    )
    cleaned = re.sub(
        r"(?i)\b(password|pass|token|secret|authorization|cookie|session|client_secret)\s*[=:]\s*\S+",
        r"\1=<redacted>",
        cleaned,
    )
    cleaned = re.sub(r"(?i)\bBearer\s+\S+", "Bearer <redacted>", cleaned)
    return " ".join(cleaned.split())[:1200]


def classify_issue(message: str, level: str) -> tuple[str, str, str]:
    lowered = message.lower()
    if "no vfs active" in lowered:
        return (
            "vfs-startup",
            "VFS endpoint queried before mount readiness",
            "No action is needed when the service is active and /pdrive is writable. Refresh the view to confirm.",
        )
    if "a draft exist" in lowered or "existing draft" in lowered:
        return (
            "draft-conflict",
            "Remote upload draft conflict",
            "The guarded recovery timer will intervene only in exclusive metadata-cache mode after a later retry confirms the conflict.",
        )
    if any(
        marker in lowered
        for marker in (
            "dial tcp: lookup",
            "server misbehaving",
            "no such host",
            "temporary failure in name resolution",
            "name or service not known",
        )
    ):
        return (
            "dns",
            "Network name resolution failed",
            "Restore the network or DNS route and let rclone retry. Never clear pending VFS cache data.",
        )
    if re.search(r"(^|[^0-9])429([^0-9]|$)", message):
        return (
            "http-429",
            "Proton temporarily rate-limited the request",
            "Wait for Proton's backoff to expire before another login or recovery attempt.",
        )
    if re.search(r"(^|[^0-9])422([^0-9]|$)", message):
        return (
            "http-422",
            "Proton rejected a metadata change",
            "Inspect same-name files or draft conflicts before retrying a destructive recovery action.",
        )
    if re.search(r"(^|[^0-9])5[0-9][0-9]([^0-9]|$)", message):
        return (
            "http-5xx",
            "Proton service request failed",
            "Allow rclone to retry. Investigate only if the same operation keeps failing after connectivity recovers.",
        )
    if "failed to upload try #" in lowered or "failed to copy" in lowered:
        return (
            "upload-retry",
            "Upload attempt failed",
            "rclone will retry automatically. Review the queue if the attempt count continues to rise.",
        )
    if level == "NOTICE":
        return (
            "notice",
            "rclone reported a notice",
            "Review the context below; no action is required when the current service health is ready.",
        )
    return (
        "rclone-error",
        "rclone reported an error",
        "Review the current mount, queue and network health before choosing a recovery action.",
    )


ISSUE_PRIORITY = {
    "draft-conflict": 100,
    "http-429": 90,
    "dns": 80,
    "http-5xx": 70,
    "http-422": 60,
    "upload-retry": 50,
    "rclone-error": 40,
    "notice": 30,
    "vfs-startup": 0,
}

UPLOAD_INCIDENT_CATEGORIES = {
    "draft-conflict",
    "http-422",
    "http-5xx",
    "upload-retry",
    "rclone-error",
}


def issue_timestamp(value: str) -> dt.datetime | None:
    try:
        return dt.datetime.fromisoformat(value)
    except (TypeError, ValueError):
        return None


def issues_are_related(left: dict[str, Any], right: dict[str, Any]) -> bool:
    """Return whether two adjacent log lines describe one backend attempt."""

    left_time = issue_timestamp(str(left.get("timestamp") or ""))
    right_time = issue_timestamp(str(right.get("timestamp") or ""))
    if left_time is None or right_time is None:
        return False
    if abs((right_time - left_time).total_seconds()) > 30:
        return False
    left_subject = str(left.get("subject") or "")
    right_subject = str(right.get("subject") or "")
    if left_subject and left_subject == right_subject:
        return True
    if str(left.get("message") or "") == str(right.get("message") or ""):
        return True

    # Proton may emit a share-level API line immediately before the path-level
    # upload failure it explains. Correlate only in that direction: a new
    # share-level line starts a new attempt and must never bridge two files that
    # happen to fail close together during parallel uploads.
    left_category = str(left.get("category") or "")
    right_category = str(right.get("category") or "")
    backend_context = left_subject.lower().startswith("proton drive root link id ")
    return (
        backend_context
        and left_category in {"http-422", "http-5xx", "rclone-error"}
        and right_category in {"draft-conflict", "upload-retry"}
    )


def merge_issue_attempt(events: list[dict[str, Any]]) -> dict[str, Any]:
    """Collapse the log lines emitted for one rclone attempt into one event."""

    chosen = max(
        events,
        key=lambda event: (
            ISSUE_PRIORITY.get(str(event.get("category") or ""), 10),
            str(event.get("level") or "") in {"error", "critical"},
        ),
    )
    merged = dict(chosen)
    merged["level"] = (
        "error" if any(str(event.get("level") or "") in {"error", "critical"} for event in events) else "notice"
    )
    merged["first_seen"] = str(events[0].get("timestamp") or "")
    merged["last_seen"] = str(events[-1].get("timestamp") or "")
    merged["timestamp"] = merged["last_seen"]
    merged["occurrences"] = 1
    merged["raw_events"] = len(events)
    return merged


def consolidate_issues(events: list[dict[str, Any]]) -> list[dict[str, Any]]:
    """Expose one ongoing incident per root cause and affected subject."""

    attempts: list[list[dict[str, Any]]] = []
    ordered_events = sorted(
        events,
        key=lambda event: issue_timestamp(str(event.get("timestamp") or "")) or dt.datetime.min.astimezone(),
    )
    for event in ordered_events:
        # A missing VFS during the mount's normal startup window is operational
        # noise, not something a user can or should review.
        if event.get("category") == "vfs-startup":
            continue
        if attempts and issues_are_related(attempts[-1][-1], event):
            attempts[-1].append(event)
        else:
            attempts.append([event])

    incidents: dict[tuple[str, str], dict[str, Any]] = {}
    order: list[tuple[str, str]] = []
    for attempt in attempts:
        event = merge_issue_attempt(attempt)
        subject = str(event.get("subject") or "")
        category = str(event.get("category") or "")
        key = (
            "upload" if subject and category in UPLOAD_INCIDENT_CATEGORIES else category,
            subject or str(event.get("title") or ""),
        )
        previous = incidents.get(key)
        if previous is None:
            incidents[key] = event
            order.append(key)
            continue
        previous["last_seen"] = event["last_seen"]
        previous["timestamp"] = event["last_seen"]
        previous["occurrences"] = int(previous.get("occurrences") or 1) + 1
        previous["raw_events"] = int(previous.get("raw_events") or 1) + int(event.get("raw_events") or 1)
        if event["level"] == "error":
            previous["level"] = "error"
        # Keep the latest actionable backend wording while retaining the first
        # observation time and stable incident identity.
        previous["message"] = event["message"]
        previous["guidance"] = event["guidance"]
    consolidated = [incidents[key] for key in order]
    return sorted(
        consolidated,
        key=lambda event: (
            issue_timestamp(str(event.get("last_seen") or event.get("timestamp") or "")) or dt.datetime.min.astimezone()
        ),
        reverse=True,
    )


def issue_path(value: str) -> str:
    return value.strip().lstrip("/")


def completed_after_issue(event: dict[str, Any], transfers: list[dict[str, Any]]) -> str:
    subject = issue_path(str(event.get("subject") or ""))
    observed = issue_timestamp(str(event.get("last_seen") or event.get("timestamp") or ""))
    if not subject or observed is None:
        return ""
    completed_at = ""
    completed_time: dt.datetime | None = None
    for transfer in transfers:
        if issue_path(str(transfer.get("name") or "")) != subject or transfer.get("error"):
            continue
        candidate = str(transfer.get("completed_at") or "")
        candidate_time = issue_timestamp(candidate)
        if candidate_time is None or candidate_time < observed:
            continue
        if completed_time is None or candidate_time > completed_time:
            completed_at = candidate
            completed_time = candidate_time
    return completed_at


def enrich_issue_lifecycles(
    issues: dict[str, Any],
    queue: dict[str, Any],
    transfers: list[dict[str, Any]],
    latest: dict[str, Any],
) -> dict[str, Any]:
    """Resolve log incidents only when current runtime evidence proves recovery."""

    queue_items = {
        issue_path(str(item.get("name") or "")): item for item in queue.get("items", []) if isinstance(item, dict)
    }
    events = []
    for raw_event in issues.get("events", []):
        event = dict(raw_event)
        category = str(event.get("category") or "")
        subject = issue_path(str(event.get("subject") or ""))
        lifecycle = "active"
        resolution = ""
        resolved_at = ""
        queue_item = queue_items.get(subject)
        completed_at = completed_after_issue(event, transfers)
        if completed_at and category in UPLOAD_INCIDENT_CATEGORIES:
            lifecycle = "resolved"
            resolved_at = completed_at
            resolution = "The affected upload completed successfully after rclone recovered."
            event["level"] = "notice"
            event["title"] = "Upload recovered automatically"
            event["guidance"] = "No action is required. Keep the recovery record for context."
        elif queue_item is not None and category in UPLOAD_INCIDENT_CATEGORIES:
            if bool(queue_item.get("uploading")) or int(queue_item.get("tries") or 0) >= 2:
                lifecycle = "recovering"
        elif (
            category == "dns"
            and str(latest.get("dns") or "").lower() == "ok"
            and (issue_timestamp(str(latest.get("generated_at") or "")) or dt.datetime.min.astimezone())
            >= (issue_timestamp(str(event.get("last_seen") or "")) or dt.datetime.max.replace(tzinfo=dt.timezone.utc))
        ):
            lifecycle = "resolved"
            resolved_at = str(latest.get("generated_at") or "")
            resolution = "DNS connectivity is healthy again."
            event["level"] = "notice"
            event["title"] = "Network resolution recovered"
            event["guidance"] = "No action is required while current DNS and mount health remain ready."
        event["lifecycle"] = lifecycle
        event["resolution"] = resolution
        event["resolved_at"] = resolved_at
        events.append(event)

    active_events = [event for event in events if event["lifecycle"] != "resolved"]
    enriched = dict(issues)
    enriched["events"] = events
    enriched["errors"] = sum(1 for event in active_events if event["level"] in {"error", "critical"})
    enriched["notices"] = sum(1 for event in active_events if event["level"] == "notice")
    enriched["active"] = sum(1 for event in events if event["lifecycle"] == "active")
    enriched["recovering"] = sum(1 for event in events if event["lifecycle"] == "recovering")
    enriched["resolved"] = sum(1 for event in events if event["lifecycle"] == "resolved")
    return enriched


def recent_issues(limit: int = 200, maximum_bytes: int = 512 * 1024) -> dict[str, Any]:
    """Return recent sanitized ERROR/NOTICE/CRITICAL events without remote I/O."""

    try:
        with MOUNT_LOG.open("rb") as stream:
            stream.seek(0, os.SEEK_END)
            size = stream.tell()
            start = max(0, size - maximum_bytes)
            stream.seek(start)
            payload = stream.read(maximum_bytes)
    except OSError as error:
        return {"available": False, "events": [], "error": str(error)[:300]}
    if start:
        _discarded, _separator, payload = payload.partition(b"\n")
    events: list[dict[str, Any]] = []
    pattern = re.compile(r"^(\d{4}/\d{2}/\d{2})\s+(\d{2}:\d{2}:\d{2})\s+(NOTICE|ERROR|CRITICAL)\s*:\s*(.*)$")
    for raw_line in payload.decode("utf-8", errors="replace").replace("\x00", "").splitlines():
        match = pattern.match(raw_line)
        if match is None:
            continue
        level = match.group(3)
        message = sanitize_issue_text(match.group(4))
        if message.lower().startswith("bandwidth limit set to"):
            continue
        subject = ""
        subject_match = re.match(r"^([^:]{1,240}):\s+(.+)$", message)
        if subject_match:
            subject = subject_match.group(1).strip()
            message = subject_match.group(2).strip()
        category, title, guidance = classify_issue(f"{subject}: {message}", level)
        try:
            timestamp = (
                dt.datetime.strptime(
                    f"{match.group(1)} {match.group(2)}",
                    "%Y/%m/%d %H:%M:%S",
                )
                .astimezone()
                .isoformat(timespec="seconds")
            )
        except ValueError:
            timestamp = f"{match.group(1)} {match.group(2)}"
        events.append(
            {
                "timestamp": timestamp,
                "level": level.lower(),
                "category": category,
                "title": title,
                "subject": subject,
                "message": message,
                "guidance": guidance,
            }
        )
    incidents = consolidate_issues(events)
    retained = incidents[:limit]
    return {
        "available": True,
        "events": retained,
        "error": "",
        "errors": sum(1 for event in retained if event["level"] == "error"),
        "notices": sum(1 for event in retained if event["level"] == "notice"),
        "raw_events": len(events),
    }


HISTORY_NUMBERS = {
    "pid",
    "success",
    "queued",
    "errors",
    "notices",
    "log_age",
    "stall_confirmations",
    "vfs_queue",
    "vfs_queue_bytes",
    "vfs_uploading",
    "vfs_failed",
    "failed_confirmations",
    "activity_read",
    "activity_rchar",
    "activity_tcp_sent",
    "cache",
    "free",
}


def history_entries(limit: int = 48) -> list[dict[str, Any]]:
    try:
        lines = HISTORY_FILE.read_text(encoding="utf-8", errors="replace").splitlines()[-limit:]
    except OSError:
        return []
    entries = []
    for line in lines:
        pieces = line.split("\t")
        if not pieces:
            continue
        entry: dict[str, Any] = {"time": pieces[0]}
        for piece in pieces[1:]:
            if "=" not in piece:
                continue
            key, value = piece.split("=", 1)
            if key in HISTORY_NUMBERS:
                entry[key] = integer(value)
            elif key == "auto_restart":
                entry[key] = boolean(value)
            else:
                entry[key] = value
        entries.append(entry)
    return entries


def disk_free(path: pathlib.Path) -> int:
    candidate = path
    while not candidate.exists() and candidate != candidate.parent:
        candidate = candidate.parent
    try:
        return shutil.disk_usage(candidate).free
    except OSError:
        return 0


def remote_capacity(enabled: bool, mount_ready: bool) -> dict[str, Any]:
    """Read the capacity exposed by the mounted remote only when requested."""

    unavailable = {
        "available": False,
        "total_bytes": 0,
        "used_bytes": 0,
        "free_bytes": 0,
        "error": "",
    }
    if not enabled or not mount_ready:
        return unavailable
    code, stdout, stderr = run(
        ["df", "--block-size=1", "--output=size,used,avail", str(MOUNT_DIR)],
        timeout=5.0,
    )
    fields = stdout.splitlines()[-1].split() if stdout.splitlines() else []
    if code != 0 or len(fields) != 3 or not all(field.isdigit() for field in fields):
        return {
            **unavailable,
            "error": (stderr.strip() or "Capacity data is unavailable")[:300],
        }
    total_bytes, used_bytes, free_bytes = (integer(field) for field in fields)
    return {
        "available": True,
        "total_bytes": total_bytes,
        "used_bytes": used_bytes,
        "free_bytes": free_bytes,
        "error": "",
    }


