#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-3.0-or-later

set -uo pipefail
umask 077

readonly config_file="${HOME}/.config/pdrive-bwlimit.conf"
readonly state_dir="${HOME}/.local/state/rclone"
readonly rc_socket="${state_dir}/pdrive-rc.sock"
readonly rclone_bin="${HOME}/.local/libexec/rclone-bin"

usage() {
    printf '%s\n' \
        'Usage: pdrive-bwlimit [LIMIT|off|status]' \
        '' \
        'No argument or status: show the saved and live limits.' \
        'LIMIT: Limit uploads only; downloads remain unlimited.' \
        '       Example: 4.2 = 4.2 MiB/s upload, unlimited download.' \
        'UP:DOWN: upload is on the left and download is on the right.' \
        '         Example: 4:1 = 4 MiB/s upload and 1 MiB/s download.' \
        'Unitless numbers are always interpreted as MiB/s.' \
        'Explicit units remain available, for example 800K or 0.625M.' \
        'off: remove the live and saved limit completely.' \
        '0: same as off; rclone treats zero as unlimited, not paused.' \
        '' \
        'Units are bytes per second, not bits per second.'
}

# Help must be completely action-free, including in a fresh HOME. In
# particular, do not create the state directory or lock file before this exit.
case "${1:-}" in
    -h|--help|help)
        if (( $# != 1 )); then
            printf 'Too many arguments.\n' >&2
            exit 2
        fi
        usage
        exit 0
        ;;
esac

rate_is_safe() {
    local rate="${1:-}"
    local component='(off|[0-9]+([.][0-9]+)?([bBkKmMgGtTpP]([iI][bB]?)?)?)'

    [[ "${rate}" =~ ^${component}(:${component})?$ ]]
}

component_human() {
    local component="${1:-off}"

    if [[ "${component}" == 'off' ]]; then
        printf 'unlimited'
    elif [[ "${component}" == *B ]]; then
        printf '%s/s' "${component}"
    else
        printf '%sB/s' "${component}"
    fi
}

describe_rate() {
    local rate="${1:-off}"
    local upload download

    if [[ "${rate}" == 'off' ]]; then
        printf 'no limit (upload and download unlimited)'
    elif [[ "${rate}" == *:* ]]; then
        upload="${rate%%:*}"
        download="${rate#*:}"
        printf 'upload %s, download %s' \
            "$(component_human "${upload}")" "$(component_human "${download}")"
    else
        printf 'upload and download both %s' "$(component_human "${rate}")"
    fi
}

load_configured_rate() {
    configured_rate='off'
    configured_source='default (no configuration file)'
    config_warning=''

    if [[ ! -e "${config_file}" ]]; then
        return 0
    fi
    if [[ ! -r "${config_file}" ]]; then
        config_warning="${config_file} is not readable"
        return 78
    fi

    configured_rate="$(awk -F= '$1 == "bwlimit" { print $2; exit }' "${config_file}")"
    configured_source="${config_file}"
    if ! rate_is_safe "${configured_rate}"; then
        config_warning="${config_file} does not contain one valid value"
        return 78
    fi
}

normalize_numeric_component() {
    local component="${1:-}"

    if [[ "${component}" =~ ^[0-9]+([.][0-9]+)?$ ]]; then
        printf '%sM' "${component}"
    else
        printf '%s' "${component}"
    fi
}

normalize_requested_rate() {
    local requested="${1:-}"
    local upload download

    if [[ "${requested}" == *:* ]]; then
        upload="${requested%%:*}"
        download="${requested#*:}"
        printf '%s:%s' \
            "$(normalize_numeric_component "${upload}")" \
            "$(normalize_numeric_component "${download}")"
    else
        normalize_numeric_component "${requested}"
    fi
}

canonicalize_requested_rate() {
    local requested="${1:-}"
    local runtime_rate response canonical

    case "${requested}" in
        off|aus|unlimited|0)
            runtime_rate='off'
            ;;
        *:*)
            requested="$(normalize_requested_rate "${requested}")"
            runtime_rate="${requested}"
            ;;
        *)
            # The common one-value form deliberately limits only upload.
            requested="$(normalize_requested_rate "${requested}")"
            runtime_rate="${requested}:off"
            ;;
    esac

    if [[ ! -x "${rclone_bin}" ]]; then
        printf 'Error: rclone binary is missing: %s\n' "${rclone_bin}" >&2
        return 69
    fi
    response="$(timeout --signal=TERM 10s "${rclone_bin}" rc --loopback \
        core/bwlimit "rate=${runtime_rate}" 2>/dev/null)" || {
        printf 'Invalid limit: %s\n' "${requested:-<empty>}" >&2
        printf 'Examples: 4.2, 800K, 2M, 5M, 0.625M, 5M:1M or off.\n' >&2
        return 2
    }
    canonical="$(jq -r '.rate // empty' <<< "${response}" 2>/dev/null || true)"
    if ! rate_is_safe "${canonical}"; then
        printf 'Error: rclone returned an unexpected bandwidth value.\n' >&2
        return 70
    fi
    printf '%s\n' "${canonical}"
}

write_configured_rate() {
    local rate="${1:-}"
    local config_dir config_tmp

    if ! rate_is_safe "${rate}"; then
        printf 'Error: unsafe internal bandwidth value: %s\n' "${rate}" >&2
        return 2
    fi
    config_dir="${config_file%/*}"
    mkdir -p -- "${config_dir}" || return 1
    config_tmp="$(mktemp "${config_dir}/pdrive-bwlimit.conf.XXXXXX")" || return 1
    if ! printf '%s\n' \
        '# Managed by: pdrive-bwlimit LIMIT|off' \
        '# One value limits upload while download remains unlimited.' \
        '# The helper always interprets unitless numbers as MiB/s.' \
        "bwlimit=${rate}" > "${config_tmp}"; then
        rm -f -- "${config_tmp}"
        return 1
    fi
    if ! mv -f -- "${config_tmp}" "${config_file}"; then
        rm -f -- "${config_tmp}"
        return 1
    fi
}

rc_call() {
    timeout --signal=TERM 10s "${rclone_bin}" rc --unix-socket "${rc_socket}" "$@"
}

query_live_rate() {
    local response

    [[ -S "${rc_socket}" ]] || return 1
    response="$(rc_call core/bwlimit 2>/dev/null)" || return 1
    live_rate="$(jq -r '.rate // empty' <<< "${response}" 2>/dev/null || true)"
    rate_is_safe "${live_rate}"
}

mkdir -p -- "${state_dir}"
exec 9>"${state_dir}/pdrive-bwlimit.lock"
if ! flock -w 15 9; then
    printf 'Another pdrive-bwlimit run is active; please retry shortly.\n' >&2
    exit 75
fi

case "${1:-status}" in
    -h|--help|help)
        if (( $# != 1 )); then
            printf 'Too many arguments.\n' >&2
            exit 2
        fi
        usage
        exit 0
        ;;
    status)
        if (( $# > 1 )); then
            printf 'Too many arguments (help: pdrive-bwlimit --help).\n' >&2
            exit 2
        fi
        config_valid=true
        if ! load_configured_rate; then
            config_valid=false
        fi
        printf 'Saved:         %s\n' "$(describe_rate "${configured_rate}")"
        printf 'Configuration: %s\n' "${configured_source}"
        if [[ "${config_valid}" != true ]]; then
            printf 'WARNING:       %s; the next mount start would stop safely.\n' \
                "${config_warning}"
        fi
        if query_live_rate; then
            printf 'Running rclone: %s\n' "$(describe_rate "${live_rate}")"
            printf 'Runtime:        active; changes need no restart and do not interrupt transfers.\n'
        else
            printf 'Running rclone: runtime control is not available yet.\n'
            printf '%s\n' \
                'Runtime:       The current process predates this feature and remains untouched.' \
                '               Runtime control becomes active at the next service start.'
        fi
        ;;
    *)
        if (( $# != 1 )); then
            printf 'Provide exactly one limit (help: pdrive-bwlimit --help).\n' >&2
            exit 2
        fi
        requested_rate="${1}"
        canonical_rate="$(canonicalize_requested_rate "${requested_rate}")" || exit $?
        if ! write_configured_rate "${canonical_rate}"; then
            printf 'Error: bandwidth configuration could not be saved atomically.\n' >&2
            exit 1
        fi

        if query_live_rate; then
            if ! response="$(rc_call core/bwlimit "rate=${canonical_rate}" 2>/dev/null)"; then
                printf 'Saved: %s\n' "$(describe_rate "${canonical_rate}")"
                printf '%s\n' \
                    'Error: the running rclone process rejected the change.' \
                    'The saved value applies at the next service start at the latest.' >&2
                exit 1
            fi
            applied_rate="$(jq -r '.rate // empty' <<< "${response}" 2>/dev/null || true)"
            if ! rate_is_safe "${applied_rate}"; then
                printf 'Error: rclone returned an unexpected runtime response.\n' >&2
                exit 70
            fi
            printf 'Active:        %s\n' "$(describe_rate "${applied_rate}")"
            printf 'Saved:         yes; the running transfer was not interrupted.\n'
        else
            printf 'Saved:         %s\n' "$(describe_rate "${canonical_rate}")"
            printf '%s\n' \
                'Current rclone: unchanged; this older process has no RC socket.' \
                'Effective:      automatically at the next service start, without an extra restart.'
        fi
        ;;
esac
