        add_css(open_web_button, "secondary-web-action")
        set_pointer_on_hover(open_web_button)
        self.open_web_button = open_web_button
        navigation_left = Gtk.Box()
        navigation_left.set_hexpand(True)
        navigation_left.pack_start(open_web_button, False, False, 0)
        navigation.attach(navigation_left, 0, 0, 1, 1)
        navigation.attach(switcher, 1, 0, 1, 1)
        open_folder_button = Gtk.Button()
