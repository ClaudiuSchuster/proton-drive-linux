        self.pack_start(detail_label, False, False, 0)


def markdown_blocks(markdown: str) -> list[tuple[str, str]]:
    """Parse the deliberately small Markdown subset used by the manuals."""

    blocks: list[tuple[str, str]] = []
    paragraph: list[str] = []
    code: list[str] = []
    in_code = False

    def flush_paragraph() -> None:
        if paragraph:
            blocks.append(("paragraph", " ".join(paragraph)))
            paragraph.clear()

    for raw_line in markdown.splitlines():
        line = raw_line.rstrip()
        if line.lstrip().startswith("```"):
            flush_paragraph()
            if in_code:
                blocks.append(("code", "\n".join(code)))
                code.clear()
            in_code = not in_code
            continue
        if in_code:
            code.append(line)
            continue

        html_heading = re.match(r"^<h([1-6])[^>]*>(.*?)</h\1>$", line.strip())
        if html_heading:
            flush_paragraph()
            heading_text = html.unescape(re.sub(r"<[^>]+>", "", html_heading.group(2))).strip()
            if heading_text:
                blocks.append((f"heading-{html_heading.group(1)}", heading_text))
            continue
        cleaned = html.unescape(re.sub(r"<[^>]+>", "", line)).strip()
        if not cleaned:
            flush_paragraph()
            continue
        heading = re.match(r"^(#{1,6})\s+(.+)$", cleaned)
        if heading:
            flush_paragraph()
            blocks.append((f"heading-{len(heading.group(1))}", heading.group(2)))
            continue
        if re.match(r"^\|?\s*:?-{3,}", cleaned):
            continue
        if cleaned.startswith("|") and cleaned.endswith("|"):
            flush_paragraph()
            cells = [cell.strip() for cell in cleaned.strip("|").split("|")]
            blocks.append(("table", "  │  ".join(cells)))
            continue
        quoted = re.match(r"^>\s?(.*)$", cleaned)
        if quoted:
            flush_paragraph()
            blocks.append(("quote", quoted.group(1)))
            continue
        bullet = re.match(r"^[-*]\s+(.+)$", cleaned)
        if bullet:
            flush_paragraph()
            blocks.append(("bullet", bullet.group(1)))
            continue
        numbered = re.match(r"^(\d+)\.\s+(.+)$", cleaned)
        if numbered:
            flush_paragraph()
            blocks.append(("numbered", f"{numbered.group(1)}.\t{numbered.group(2)}"))
            continue
        paragraph.append(cleaned)

    flush_paragraph()
    if code:
        blocks.append(("code", "\n".join(code)))
    return blocks


class MarkdownView(Gtk.ScrolledWindow):
    INLINE_PATTERN = re.compile(r"(`[^`]+`|\*\*[^*]+\*\*|\[[^]]+\]\([^)]+\))")

    def __init__(self, markdown: str, activate_link: Any) -> None:
        super().__init__()
        self.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        self.set_shadow_type(Gtk.ShadowType.NONE)
        self.activate_link = activate_link
        self.link_tags: list[tuple[Gtk.TextTag, str]] = []
        self.text_view = Gtk.TextView()
        self.text_view.set_editable(False)
        self.text_view.set_cursor_visible(False)
        self.text_view.set_wrap_mode(Gtk.WrapMode.WORD_CHAR)
        self.text_view.set_left_margin(28)
        self.text_view.set_right_margin(28)
        self.text_view.set_top_margin(22)
        self.text_view.set_bottom_margin(28)
        self.text_view.connect("button-release-event", self.on_button_release)
        self.add(self.text_view)
        self.buffer = self.text_view.get_buffer()
        self.tags = {
            "heading-1": self.buffer.create_tag(None, weight=Pango.Weight.BOLD, scale=1.65, foreground="#ffffff", pixels_above_lines=16, pixels_below_lines=8),
            "heading-2": self.buffer.create_tag(None, weight=Pango.Weight.BOLD, scale=1.35, foreground="#f7f9fc", pixels_above_lines=14, pixels_below_lines=6),
            "heading-3": self.buffer.create_tag(None, weight=Pango.Weight.BOLD, scale=1.15, foreground="#eef2f7", pixels_above_lines=10, pixels_below_lines=4),
            "body": self.buffer.create_tag(None, foreground="#c9d2df", pixels_below_lines=4),
            "bullet": self.buffer.create_tag(None, foreground="#c9d2df", left_margin=14, indent=-12, pixels_below_lines=3),
            "quote": self.buffer.create_tag(None, foreground="#a9bed2", style=Pango.Style.ITALIC, left_margin=16, pixels_below_lines=5),
            "code": self.buffer.create_tag(None, family="monospace", foreground="#d8e8f5", background="#202631", left_margin=14, right_margin=14, pixels_above_lines=5, pixels_below_lines=7),
            "table": self.buffer.create_tag(None, family="monospace", foreground="#cbd8e6", pixels_below_lines=3),
            "bold": self.buffer.create_tag(None, weight=Pango.Weight.BOLD, foreground="#ffffff"),
            "inline-code": self.buffer.create_tag(None, family="monospace", foreground="#8fe1ff", background="#202631"),
        }
        self.render(markdown)

    def insert_inline(self, text: str, base_tag: Gtk.TextTag) -> None:
        position = 0
        for match in self.INLINE_PATTERN.finditer(text):
            if match.start() > position:
                self.buffer.insert_with_tags(
                    self.buffer.get_end_iter(),
                    text[position : match.start()],
                    base_tag,
                )
            token = match.group(0)
            if token.startswith("**"):
                self.buffer.insert_with_tags(
                    self.buffer.get_end_iter(), token[2:-2], base_tag, self.tags["bold"]
                )
            elif token.startswith("`"):
                self.buffer.insert_with_tags(
                    self.buffer.get_end_iter(), token[1:-1], base_tag, self.tags["inline-code"]
                )
            else:
                link = re.match(r"^\[([^]]+)\]\(([^)]+)\)$", token)
                if link:
                    tag = self.buffer.create_tag(
                        None,
                        foreground="#69d7ff",
                        underline=Pango.Underline.SINGLE,
                    )
                    self.link_tags.append((tag, link.group(2)))
                    self.buffer.insert_with_tags(
                        self.buffer.get_end_iter(), link.group(1), base_tag, tag
                    )
            position = match.end()
        if position < len(text):
            self.buffer.insert_with_tags(self.buffer.get_end_iter(), text[position:], base_tag)

    def render(self, markdown: str) -> None:
        for kind, text in markdown_blocks(markdown):
            if kind.startswith("heading-"):
                self.insert_inline(text, self.tags.get(kind, self.tags["heading-3"]))
                self.buffer.insert(self.buffer.get_end_iter(), "\n")
            elif kind == "code":
                self.buffer.insert_with_tags(
                    self.buffer.get_end_iter(), f"{text}\n", self.tags["code"]
                )
            elif kind == "table":
                self.insert_inline(text, self.tags["table"])
                self.buffer.insert(self.buffer.get_end_iter(), "\n")
            elif kind == "quote":
                self.buffer.insert_with_tags(self.buffer.get_end_iter(), "▌ ", self.tags["quote"])
                self.insert_inline(text, self.tags["quote"])
                self.buffer.insert(self.buffer.get_end_iter(), "\n")
            elif kind == "bullet":
                self.buffer.insert_with_tags(self.buffer.get_end_iter(), "• ", self.tags["bullet"])
                self.insert_inline(text, self.tags["bullet"])
                self.buffer.insert(self.buffer.get_end_iter(), "\n")
            elif kind == "numbered":
                self.insert_inline(text, self.tags["bullet"])
                self.buffer.insert(self.buffer.get_end_iter(), "\n")
            else:
                self.insert_inline(text, self.tags["body"])
                self.buffer.insert(self.buffer.get_end_iter(), "\n\n")

    def on_button_release(self, _widget: Gtk.Widget, event: Gdk.EventButton) -> bool:
        if event.button != 1:
            return False
        x, y = self.text_view.window_to_buffer_coords(
            Gtk.TextWindowType.WIDGET,
            int(event.x),
            int(event.y),
        )
        located = self.text_view.get_iter_at_location(x, y)
        iterator = located[-1] if isinstance(located, tuple) else located
        for active_tag in iterator.get_tags():
            for link_tag, target in self.link_tags:
                if active_tag == link_tag:
                    self.activate_link(target)
                    return True
        return False


class DocumentationWindow(Gtk.Window):
    def __init__(self, application: Gtk.Application, parent: Gtk.Window) -> None:
        super().__init__(application=application, title=translate("Documentation"))
        self.set_transient_for(parent)
        self.parent_window = parent
        self.set_destroy_with_parent(True)
        self.set_default_size(820, 720)
        self.set_size_request(620, 480)
        add_css(self, "documentation-window")

        header = Gtk.HeaderBar()
        header.set_show_close_button(True)
        header.set_title(translate("Documentation"))
        header.set_subtitle("proton-drive-linux")
        self.set_titlebar(header)

        root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        self.add(root)
        self.stack = Gtk.Stack()
        self.stack.set_transition_type(Gtk.StackTransitionType.CROSSFADE)
        self.stack.set_transition_duration(160)
        switcher_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL)
        add_css(switcher_box, "documentation-switcher")
        switcher = Gtk.StackSwitcher(stack=self.stack)
        switcher.set_halign(Gtk.Align.CENTER)
        switcher_box.pack_start(switcher, True, True, 0)
        root.pack_start(switcher_box, False, False, 0)
        root.pack_start(self.stack, True, True, 0)

        self.page_names: dict[str, str] = {}
        for page_name, title, installed_name, repository_relative in DOCUMENTATION_PAGES:
            path = documentation_path(installed_name, repository_relative)
            if path is None:
                markdown = (
                    f"# {translate('Documentation unavailable')}\n\n"
                    f"{translate('The local documentation files could not be found.')}\n\n"
                    f"[{translate('Open the project documentation online')}]({DOCUMENTATION_URL})"
                )
            else:
                try:
                    markdown = path.read_text(encoding="utf-8")
                except OSError:
                    markdown = (
                        f"# {translate('Documentation unavailable')}\n\n"
                        f"[{translate('Open the project documentation online')}]({DOCUMENTATION_URL})"
                    )
            view = MarkdownView(
                markdown,
                lambda target, current=repository_relative: self.on_link(target, current),
            )
            self.stack.add_titled(view, page_name, translate(title))
            self.page_names[pathlib.PurePosixPath(repository_relative).name.lower()] = page_name

    def on_link(self, target: str, current_relative: str) -> None:
        if target.startswith(("https://", "http://")):
            self.open_external_uri(target)
            return
        path_part = target.split("#", 1)[0]
        if not path_part:
            return
        normalized = posixpath.normpath(
            posixpath.join(posixpath.dirname(current_relative), path_part)
        )
        page_name = self.page_names.get(pathlib.PurePosixPath(normalized).name.lower())
        if page_name:
            self.stack.set_visible_child_name(page_name)
            return
        online = f"https://github.com/ClaudiuSchuster/proton-drive-linux/blob/main/{normalized}"
        self.open_external_uri(online)

    def open_external_uri(self, uri: str) -> None:
        try:
            Gio.AppInfo.launch_default_for_uri(uri, None)
        except GLib.Error as error:
            if isinstance(self.parent_window, PDriveWindow):
                self.parent_window.message(
                    "Could not open documentation",
                    str(error),
                    Gtk.MessageType.ERROR,
                )


class PDriveWindow(Gtk.ApplicationWindow):
    def __init__(self, application: Gtk.Application, demo: bool = False) -> None:
        super().__init__(application=application)
        self.demo = demo
        self.refreshing = False
        self.closed = False
        self.window_size_save_source = 0
        self.pending_window_size: tuple[int, int] | None = None
        self.documentation_window: DocumentationWindow | None = None
        self.speed_samples: collections.deque[float] = collections.deque(maxlen=150)
        self.current_state: dict[str, Any] = {}
        self.history_signature: tuple[Any, ...] = ()
        self.set_title("PDrive Control Center")
        self.set_icon_name(APP_ID)
        preferences = getattr(application, "preferences", DEFAULT_PREFERENCES)
        self.set_default_size(
            DEFAULT_WINDOW_WIDTH if demo else int(preferences["window_width"]),
            900 if demo else int(preferences["window_height"]),
        )
        self.set_size_request(820, 620)
        add_css(self, "pdrive-window")
        self.connect("destroy", self.on_destroy)
        self.connect("delete-event", application.on_window_delete)
        self.state_command = self.find_state_command()
        self.build_ui()
        self.set_empty_lists()
        self.request_refresh()
        GLib.timeout_add_seconds(REFRESH_INTERVAL_SECONDS, self.on_refresh_timer)

    @staticmethod
    def find_state_command() -> str:
        configured = os.environ.get("PDRIVE_STATE_BIN")
        if configured:
            return configured
        installed = shutil.which("pdrive-state")
        if installed:
            return installed
        sibling = pathlib.Path(__file__).with_name("pdrive-state")
        return str(sibling)

    def build_ui(self) -> None:
        header = Gtk.HeaderBar()
        header.set_show_close_button(True)
        header.set_title("PDrive Control Center")
        header.set_subtitle(translate("A local live view of your existing rclone service"))

        open_button = Gtk.Button.new_from_icon_name(
            "folder-open-symbolic",
            Gtk.IconSize.BUTTON,
        )
        open_button.set_tooltip_text(translate("Open /pdrive in Nemo"))
        open_button.connect("clicked", self.on_open_mount)
        header.pack_start(open_button)

        refresh_button = Gtk.Button.new_from_icon_name("view-refresh-symbolic", Gtk.IconSize.BUTTON)
        refresh_button.set_tooltip_text(translate("Refresh now"))
        refresh_button.connect("clicked", lambda _button: self.request_refresh())
        header.pack_end(refresh_button)

        menu_button = Gtk.MenuButton()
        menu_button.set_image(Gtk.Image.new_from_icon_name("open-menu-symbolic", Gtk.IconSize.BUTTON))
        menu_button.set_tooltip_text(translate("Controls"))
        menu_button.set_popover(self.build_actions_popover())
        header.pack_end(menu_button)
        self.set_titlebar(header)

        root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        self.root = root
        root.connect("size-allocate", self.on_root_size_allocate)
        self.add(root)

        navigation = Gtk.Grid()
        navigation.set_column_homogeneous(True)
        navigation.set_hexpand(True)
        navigation.set_margin_top(11)
        navigation.set_margin_bottom(2)
        self.stack = Gtk.Stack()
        self.stack.set_transition_type(Gtk.StackTransitionType.CROSSFADE)
        self.stack.set_transition_duration(180)
        switcher = Gtk.StackSwitcher(stack=self.stack)
        switcher.set_halign(Gtk.Align.CENTER)
        navigation.attach(Gtk.Box(), 0, 0, 1, 1)
        navigation.attach(switcher, 1, 0, 1, 1)
        open_folder_button = Gtk.Button()
        open_folder_row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=7)
        open_folder_row.pack_start(
            Gtk.Image.new_from_icon_name("folder-open-symbolic", Gtk.IconSize.BUTTON),
            False,
            False,
            0,
        )
        open_folder_row.pack_start(label("Open PDrive folder"), False, False, 0)
        open_folder_button.add(open_folder_row)
        open_folder_button.set_halign(Gtk.Align.END)
        open_folder_button.set_margin_end(22)
        open_folder_button.set_tooltip_text(translate("Open /pdrive in Nemo"))
        open_folder_button.connect("clicked", self.on_open_mount)
        add_css(open_folder_button, "suggested-action")
        navigation.attach(open_folder_button, 2, 0, 1, 1)
        root.pack_start(navigation, False, False, 0)
        root.pack_start(self.stack, True, True, 0)

        self.stack.add_titled(self.build_overview(), "overview", translate("Overview"))
        self.stack.add_titled(self.build_transfers_page(), "transfers", "Transfers")
        self.stack.add_titled(self.build_history_page(), "history", translate("History"))

    def build_actions_popover(self) -> Gtk.Popover:
        popover = Gtk.Popover()
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=7)
        box.set_margin_top(12)
        box.set_margin_bottom(12)
        box.set_margin_start(12)
        box.set_margin_end(12)
        box.set_size_request(250, -1)
        box.pack_start(label("CONTROLS", "card-title"), False, False, 2)
        actions = [
            ("speedometer-symbolic", "Bandwidth limit …", self.on_bandwidth),
            ("view-list-symbolic", "Upload slots …", self.on_transfers),
            ("edit-clear-all-symbolic", "Reset restart cooldown", self.on_clear_cooldown),
            ("view-refresh-symbolic", "Refresh metadata …", self.on_metadata_refresh),
            ("system-reboot-symbolic", "Safely restart service …", self.on_restart),
        ]
        for icon_name, text, callback in actions:
            button = Gtk.Button()
            add_css(button, "flat-action")
            row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=9)
            row.pack_start(Gtk.Image.new_from_icon_name(icon_name, Gtk.IconSize.BUTTON), False, False, 0)
            row.pack_start(label(text), True, True, 0)
            button.add(row)
            button.connect("clicked", callback)
            button.set_sensitive(not self.demo)
            box.pack_start(button, False, False, 0)
        separator = Gtk.Separator(orientation=Gtk.Orientation.HORIZONTAL)
        separator.set_margin_top(3)
        separator.set_margin_bottom(3)
        box.pack_start(separator, False, False, 0)
        documentation_button = Gtk.Button()
        add_css(documentation_button, "flat-action")
        documentation_row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=9)
        documentation_row.pack_start(
            Gtk.Image.new_from_icon_name("help-browser-symbolic", Gtk.IconSize.BUTTON),
            False,
            False,
            0,
        )
        documentation_row.pack_start(label("Documentation …"), True, True, 0)
        documentation_button.add(documentation_row)
        documentation_button.connect("clicked", self.on_documentation)
        box.pack_start(documentation_button, False, False, 0)
        preferences_button = Gtk.Button()
        add_css(preferences_button, "flat-action")
        preferences_row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=9)
        preferences_row.pack_start(
            Gtk.Image.new_from_icon_name("preferences-system-symbolic", Gtk.IconSize.BUTTON),
            False,
            False,
            0,
        )
        preferences_row.pack_start(label("Preferences …"), True, True, 0)
        preferences_button.add(preferences_row)
        preferences_button.connect("clicked", self.on_preferences)
        preferences_button.set_sensitive(not self.demo)
        box.pack_start(preferences_button, False, False, 0)
        popover.add(box)
        box.show_all()
        popover.hide()
        return popover

    def build_status_banner(self) -> Gtk.Widget:
        self.status_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=16)
        self.status_icon = Gtk.Image.new_from_icon_name("dialog-question-symbolic", Gtk.IconSize.DIALOG)
        self.status_box.pack_start(self.status_icon, False, False, 0)
        text_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=3)
        self.status_title = label("Loading status …", "status-title")
        self.status_summary = label("Connecting to the local RC socket.", "status-detail")
        self.status_summary.set_line_wrap(True)
        text_box.pack_start(self.status_title, False, False, 0)
        text_box.pack_start(self.status_summary, False, False, 0)
        self.status_box.pack_start(text_box, True, True, 0)
        right = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=3)
        right.set_halign(Gtk.Align.END)
        live_row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=5)
        live_row.pack_start(label("●", "live-dot"), False, False, 0)
        live_row.pack_start(label("LIVE", "card-title"), False, False, 0)
        self.updated_label = label("–", "status-detail", 1.0)
        right.pack_start(live_row, False, False, 0)
        right.pack_start(self.updated_label, False, False, 0)
        self.status_box.pack_end(right, False, False, 0)
        self.status_frame = card(self.status_box, "status-card", "status-unknown")
        return self.status_frame

    def build_overview(self) -> Gtk.Widget:
        scroller = Gtk.ScrolledWindow()
        scroller.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        page = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=16)
        add_css(page, "page")
        page.pack_start(self.build_status_banner(), False, False, 0)

        grid = Gtk.Grid(column_spacing=14, row_spacing=14)
        self.speed_card = StatCard("Upload speed", "network-transmit-symbolic")
        self.active_card = StatCard("Active", "media-playback-start-symbolic")
        self.queue_card = StatCard("Queue", "view-list-symbolic")
        self.problem_card = StatCard("Unreviewed issues", "dialog-warning-symbolic")
        self.issue_review_button = self.problem_card.add_action(
            "emblem-ok-symbolic",
            "Mark issues reviewed",
            self.on_mark_issues_reviewed,
        )
        self.issue_review_button.set_sensitive(False)
        self.cache_card = StatCard("VFS-Cache", "drive-harddisk-symbolic")
        self.free_card = StatCard("Free space", "folder-symbolic")
        cards = [self.speed_card, self.active_card, self.queue_card, self.problem_card, self.cache_card, self.free_card]
        for index, widget in enumerate(cards):
            widget.set_hexpand(True)
            grid.attach(widget, index % 3, index // 3, 1, 1)
        page.pack_start(grid, False, False, 0)

        graph_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        graph_header = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        graph_header.pack_start(label("Live upload", "section-title"), True, True, 0)
        self.graph_peak = label("Peak –", "section-subtitle", 1.0)
        graph_header.pack_end(self.graph_peak, False, False, 0)
        graph_box.pack_start(graph_header, False, False, 0)
        self.speed_graph = SpeedGraph()
        graph_box.pack_start(self.speed_graph, True, True, 0)
        graph_box.pack_start(label("Last five minutes · refreshed every two seconds", "section-subtitle"), False, False, 0)
        page.pack_start(card(graph_box), True, True, 0)

        bottom = Gtk.Grid(column_spacing=14, row_spacing=14)
        self.live_summary_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        self.live_summary_box.pack_start(label("What’s happening", "section-title"), False, False, 0)
        self.live_summary = label("No live data yet.", "section-subtitle")
        self.live_summary.set_line_wrap(True)
        self.live_summary_box.pack_start(self.live_summary, False, False, 0)
        live_card = card(self.live_summary_box)
        live_card.set_hexpand(True)
        bottom.attach(live_card, 0, 0, 1, 1)

        config_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=9)
        config_box.pack_start(label("Configuration", "section-title"), False, False, 0)
        self.config_labels: dict[str, Gtk.Label] = {}
        for key, title in (("bandwidth", "Bandwidth"), ("slots", "Upload slots"), ("metadata", "Metadata cache"), ("cooldown", "Cooldown")):
            row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
            row.pack_start(label(title, "section-subtitle"), True, True, 0)
            value = label("–", "pill", 1.0)
            self.config_labels[key] = value
            row.pack_end(value, False, False, 0)
            config_box.pack_start(row, False, False, 0)
        config_card = card(config_box)
        config_card.set_hexpand(True)
        bottom.attach(config_card, 1, 0, 1, 1)
        page.pack_start(bottom, False, False, 0)

        scroller.add(page)
        return scroller

    def build_list_section(self, title: str, subtitle: str) -> tuple[Gtk.Frame, Gtk.ListBox]:
