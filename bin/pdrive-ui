        grid.attach(self.download_speed_card, 1, 0, 1, 1)
        grid.attach(activity_grid, 2, 0, 1, 1)
        self.problem_card.set_hexpand(True)
        self.cache_card.set_hexpand(True)
        self.capacity_card.set_hexpand(True)
        grid.attach(self.problem_card, 0, 1, 1, 1)
        grid.attach(self.cache_card, 1, 1, 1, 1)
        grid.attach(self.capacity_card, 2, 1, 1, 1)
        self.overview_grid = grid
        page.pack_start(grid, False, False, 0)

        graph_grid = Gtk.Grid(column_spacing=14, row_spacing=0)
        graph_grid.set_column_homogeneous(True)

        upload_graph_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        upload_graph_header = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        upload_graph_header.pack_start(label("Upload traffic", "section-title"), True, True, 0)
        self.upload_graph_peak = label("Peak –", "section-subtitle", 1.0)
        upload_graph_header.pack_end(self.upload_graph_peak, False, False, 0)
        upload_graph_box.pack_start(upload_graph_header, False, False, 0)
        self.speed_graph = SpeedGraph()
        upload_graph_box.pack_start(self.graph_with_axes(self.speed_graph), True, True, 0)
        self.upload_graph_detail = label("", "section-subtitle")
        self.upload_graph_detail.set_tooltip_text(
            translate("Upload speed is reported by rclone transfer statistics.")
        )
        upload_graph_box.pack_start(self.upload_graph_detail, False, False, 0)
        graph_grid.attach(card(upload_graph_box), 0, 0, 1, 1)

        download_graph_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        download_graph_header = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        download_graph_header.pack_start(label("Download traffic", "section-title"), True, True, 0)
        self.download_graph_peak = label("Peak –", "section-subtitle", 1.0)
        download_graph_header.pack_end(self.download_graph_peak, False, False, 0)
        download_graph_box.pack_start(download_graph_header, False, False, 0)
        self.download_graph = SpeedGraph((0.54, 0.45, 0.96))
        download_graph_box.pack_start(self.graph_with_axes(self.download_graph), True, True, 0)
        self.download_graph_detail = label("", "section-subtitle")
        self.download_graph_detail.set_tooltip_text(
            translate("Only TCP traffic owned by the running PDrive rclone process is counted.")
        )
        download_graph_box.pack_start(self.download_graph_detail, False, False, 0)
        graph_grid.attach(card(download_graph_box), 1, 0, 1, 1)
        page.pack_start(graph_grid, False, False, 0)

        bottom = Gtk.Grid(column_spacing=14, row_spacing=14)
