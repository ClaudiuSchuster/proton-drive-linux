    def show_issue_review(self) -> None:
        self.stack.set_visible_child_name("history")
        GLib.timeout_add(180, self.scroll_to_issue_review)

    def scroll_to_issue_review(self) -> bool:
        adjustment = self.history_scroller.get_vadjustment()
        adjustment.set_value(adjustment.get_lower())
        self.issue_section.grab_focus()
        return GLib.SOURCE_REMOVE

    @staticmethod
    def clear_list(listing: Gtk.ListBox) -> None:
        for child in listing.get_children():
            listing.remove(child)

    def set_empty_lists(self) -> None:
        self.clear_list(self.active_list)
        self.clear_list(self.queue_list)
        self.clear_list(self.recent_list)
        self.active_list.add(
            EmptyState(
                "media-playback-pause-symbolic",
                "No active transfers",
                "rclone is not using the connection right now.",
            )
        )
        self.queue_list.add(
            EmptyState(
                "emblem-ok-symbolic",
                "Queue is empty",
                "All local changes have been uploaded.",
            )
        )
        self.recent_list.add(
            EmptyState(
                "document-open-recent-symbolic",
                "No transfers yet",
                "No completed transfers were found in the last 24 hours.",
            )
        )
        self.clear_list(self.issue_list)
        self.issue_list.add(
            EmptyState(
                "emblem-ok-symbolic",
                "No unreviewed issues",
                "There are no new rclone errors or notices since your last review.",
            )
        )

    def on_destroy(self, _widget: Gtk.Widget) -> None:
        if self.content_fit_source:
            GLib.source_remove(self.content_fit_source)
            self.content_fit_source = 0
        if self.dashboard_timer_id:
            GLib.source_remove(self.dashboard_timer_id)
            self.dashboard_timer_id = 0
        self.closed = True

    def refresh_interval_seconds(self) -> int:
        application = self.get_application()
        if isinstance(application, PDriveApplication):
            interval = application.preferences.get(
                "refresh_interval_seconds",
                REFRESH_INTERVAL_SECONDS,
            )
            if interval in REFRESH_INTERVAL_OPTIONS:
                return int(interval)
        return REFRESH_INTERVAL_SECONDS

    def schedule_dashboard_timer(self) -> None:
        if self.dashboard_timer_id:
            GLib.source_remove(self.dashboard_timer_id)
        self.dashboard_timer_id = GLib.timeout_add_seconds(
            self.refresh_interval_seconds(),
            self.on_refresh_timer,
        )
        self.update_graph_refresh_details()

    def update_graph_refresh_details(self) -> None:
        if not hasattr(self, "upload_graph_detail"):
            return
        detail = translate_format(
            "rclone process traffic · refreshed every {seconds}s",
            seconds=self.refresh_interval_seconds(),
        )
        self.upload_graph_detail.set_text(detail)
        self.download_graph_detail.set_text(detail)
        self.update_graph_axis(self.speed_graph)
        self.update_graph_axis(self.download_graph)

    def schedule_content_fit(self) -> None:
        if self.closed or self.content_fit_source:
            return
        self.content_fit_source = GLib.timeout_add(80, self.fit_content_height)

    def fit_content_height(self) -> bool:
        if self.closed:
            self.content_fit_source = 0
            return GLib.SOURCE_REMOVE
        if not self.get_visible() or not self.get_mapped():
            self.content_fit_source = 0
            return GLib.SOURCE_REMOVE
        if self.content_fit_completed:
            self.content_fit_source = 0
            return GLib.SOURCE_REMOVE
        if not self.setup_required and not self.current_state:
            self.content_fit_source = 0
            return GLib.SOURCE_REMOVE
        overflow = 0.0
        if not self.setup_required and hasattr(self, "overview_scroller"):
            adjustment = self.overview_scroller.get_vadjustment()
            overflow = max(0.0, adjustment.get_upper() - adjustment.get_page_size())
        elif self.root is not None:
            _minimum, natural = self.root.get_preferred_height()
            overflow = max(0.0, natural - self.root.get_allocated_height())
        if overflow > 0.5:
            width, height = self.get_size()
            maximum_height = MAX_WINDOW_DIMENSION
            gdk_window = self.get_window()
            display = Gdk.Display.get_default()
            if gdk_window is not None and display is not None:
                monitor = display.get_monitor_at_window(gdk_window)
                if monitor is not None:
                    maximum_height = max(MIN_WINDOW_HEIGHT, monitor.get_workarea().height - 8)
            target_height = min(maximum_height, height + math.ceil(overflow) + 4)
            if target_height > height:
                self.resize(width, target_height)
        self.content_fit_completed = True
        self.content_fit_source = 0
        return GLib.SOURCE_REMOVE

    def queue_eta_detail(
        self,
        queue: dict[str, Any],
        speed: float,
        pid: int,
        sample_time: float,
    ) -> str:
        count = max(0, int(queue.get("count") or 0))
        remaining = max(
            0,
            int(queue.get("remaining_bytes", queue.get("bytes", 0)) or 0),
        )
        queue_items = queue.get("items", [])
        signature = tuple(
            (str(item.get("name") or ""), int(item.get("size") or 0)) for item in queue_items if isinstance(item, dict)
        )
        if count == 0:
            self.upload_eta_pid = pid
            self.upload_eta_rate = 0.0
            self.upload_eta_samples = 0
            self.upload_eta_last_progress = 0.0
            self.upload_eta_signature = ()
            self.upload_eta_seconds = -1
            return translate("Queue is empty · ETA complete")
        if int(queue.get("finalizing") or 0) > 0:
            self.upload_eta_pid = pid
            self.upload_eta_rate = 0.0
            self.upload_eta_samples = 0
            self.upload_eta_last_progress = 0.0
            self.upload_eta_signature = signature
            self.upload_eta_seconds = -1
            return translate("Payload transferred · Proton is finalizing the file")
        if pid != self.upload_eta_pid or signature != self.upload_eta_signature:
            self.upload_eta_pid = pid
            self.upload_eta_rate = 0.0
            self.upload_eta_samples = 0
            self.upload_eta_last_progress = 0.0
            self.upload_eta_signature = signature
            self.upload_eta_seconds = -1
        if int(queue.get("active") or 0) > 0 and speed >= 1024:
            if self.upload_eta_samples == 0:
                self.upload_eta_rate = speed
            else:
                self.upload_eta_rate = (self.upload_eta_rate * 0.8) + (speed * 0.2)
            self.upload_eta_samples += 1
            self.upload_eta_last_progress = sample_time
        estimate_ready = upload_eta_ready(
            self.upload_eta_samples,
            self.upload_eta_rate,
            self.upload_eta_last_progress,
            sample_time,
            self.refresh_interval_seconds(),
        )
        if not estimate_ready:
            self.upload_eta_seconds = -1
            if speed < 1024:
                return translate_format(
                    "{bytes} · ⏸ ETA waiting",
                    bytes=human_bytes(remaining),
                )
            return translate_format(
                "{bytes} · ETA calculating",
                bytes=human_bytes(remaining),
            )
        self.upload_eta_seconds = int(remaining / self.upload_eta_rate)
        return translate_format(
            "{bytes} · ≈{eta}",
            bytes=human_bytes(remaining),
            eta=compact_eta_duration(self.upload_eta_seconds),
        )

    def on_refresh_timer(self) -> bool:
        if self.closed:
            self.dashboard_timer_id = 0
            return GLib.SOURCE_REMOVE
        application = self.get_application()
        poll_in_background = isinstance(application, PDriveApplication) and bool(
            application.preferences.get("poll_in_background", False)
        )
        if self.demo or self.get_visible() or poll_in_background:
            self.request_refresh()
        return GLib.SOURCE_CONTINUE

    def request_refresh(self, force_capacity: bool = False) -> None:
        if self.setup_required or self.refreshing or self.closed:
            return
        self.refreshing = True
        include_capacity = force_capacity or time.monotonic() >= self.capacity_refresh_due
        if include_capacity and not self.demo:
            self.capacity_refresh_due = time.monotonic() + 15 * 60
        thread = threading.Thread(target=self.load_state, args=(include_capacity,), daemon=True)
        thread.start()

    def load_state(self, include_capacity: bool = False) -> None:
        if self.demo:
            GLib.usleep(120000)
            elapsed = GRAPH_WINDOW_SECONDS + time.monotonic() - self.demo_started_at
            GLib.idle_add(self.apply_state, demo_state(elapsed))
            return
        try:
            command = [self.state_command, "--compact"]
            if include_capacity:
                command.append("--include-capacity")
            completed = subprocess.run(
                command,
                check=False,
                capture_output=True,
                text=True,
                timeout=8,
            )
            if completed.returncode != 0:
                raise RuntimeError(completed.stderr.strip() or f"pdrive-state exited with {completed.returncode}")
            payload = json.loads(completed.stdout)
            GLib.idle_add(self.apply_state, payload)
        except (
            OSError,
            subprocess.TimeoutExpired,
            json.JSONDecodeError,
            RuntimeError,
        ) as error:
            if include_capacity:
                self.capacity_refresh_due = min(self.capacity_refresh_due, time.monotonic() + 30)
            GLib.idle_add(self.apply_error, str(error))

    def apply_error(self, message: str) -> bool:
        self.refreshing = False
        self.update_status("critical", "Status unavailable", message)
        return GLib.SOURCE_REMOVE

    def apply_state(self, state: dict[str, Any]) -> bool:
        self.refreshing = False
        self.current_state = state
        health = state.get("health", {})
        authentication = state.get("authentication", {})
        queue = state.get("queue", {})
        transfers = state.get("transfers", {})
        watchdog = state.get("watchdog", {})
        vfs = state.get("vfs", {})
        service = state.get("service", {})
        config = state.get("configuration", {})
        bandwidth = state.get("bandwidth", {})
        network_io = state.get("network_io", {})
        remote_capacity = state.get("remote_capacity", {})
        if isinstance(remote_capacity, dict) and remote_capacity.get("available"):
            self.remote_capacity = remote_capacity

        status = str(health.get("status", "unknown"))
        self.updated_label.set_text(dt.datetime.now().strftime("%H:%M:%S"))

        sample_time = time.monotonic()
        speed, self.network_send_baseline = network_send_rate(
            self.network_send_baseline,
            network_io if isinstance(network_io, dict) else {},
            int(service.get("pid") or 0),
            sample_time,
        )
        self.speed_graph.push(speed, sample_time)
        self.update_graph_axis(self.speed_graph)
        download_speed, self.network_receive_baseline = network_receive_rate(
            self.network_receive_baseline,
            network_io if isinstance(network_io, dict) else {},
            int(service.get("pid") or 0),
            sample_time,
        )
        self.download_graph.push(download_speed, sample_time)
        self.update_graph_axis(self.download_graph)
        self.speed_card.update(human_rate(speed), f"Limit {bandwidth.get('live', '–')}")
        self.download_speed_card.update(
            human_rate(download_speed),
            translate("Includes Proton API replies"),
        )
        active = len(transfers.get("active", [])) or int(queue.get("active") or 0)
        slots = int(config.get("running_transfers") or config.get("transfers") or 0)
        self.active_card.update(str(active), translate_format("of {slots} upload slots in use", slots=slots))
        authentication_status = str(authentication.get("status") or "unknown")
        reauthorization_required = authentication_status == "reauthorization-required"
        authentication_blocked = authentication_status in {
            "rate-limited",
            "reauthorization-required",
        }
        rate_limited = authentication_status == "rate-limited"
        if authentication_blocked:
            queue_detail = translate("Reauthorization needed")
            queue_tooltip = translate(
                "The stopped mount cannot report its live queue. Local VFS-cache data remains protected."
            )
            queue_value = "–"
        else:
            queue_detail = self.queue_eta_detail(
                queue,
                speed,
                int(service.get("pid") or 0),
                sample_time,
            )
            queue_tooltip = queue_detail
            if self.upload_eta_seconds >= 0:
                queue_tooltip = translate_format(
                    "{bytes} remaining · ETA ≈ {eta}",
                    bytes=human_bytes(queue.get("remaining_bytes", queue.get("bytes", 0))),
                    eta=clock_duration(self.upload_eta_seconds),
                )
            queue_value = str(queue.get("count", 0))
        self.queue_card.update(queue_value, queue_detail, queue_tooltip)
        live_status = status
        live_summary = self.localized_health_summary(state)
        if (
            status == "warning"
            and str(health.get("reason_code") or "") == "persistent-upload-failure"
            and int(queue.get("active") or 0) > 0
            and int(queue.get("max_tries") or 0) >= 2
            and upload_eta_ready(
                self.upload_eta_samples,
                self.upload_eta_rate,
                self.upload_eta_last_progress,
                sample_time,
                self.refresh_interval_seconds(),
            )
        ):
            live_status = "working"
            live_summary = translate("The retried upload is transferring again with verified process traffic.")
        if rate_limited:
            status_title = "Login temporarily paused"
            live_summary = translate_format(
                "Try again after {time}. Local cache data remains protected.",
                time=local_time(str(authentication.get("retry_after") or "")),
            )
        elif reauthorization_required:
            status_title = "Reauthorization required"
        else:
            status_title = STATUS_META.get(live_status, STATUS_META["unknown"])[1]
        self.update_status(live_status, translate(status_title), live_summary)
        self.status_action.set_visible(reauthorization_required)
        self.reauthorize_menu_button.set_visible(reauthorization_required)
        issues = state.get("issues", {})
        application = self.get_application()
        if (
            isinstance(application, PDriveApplication)
            and not self.demo
            and not application.preferences.get("issues_reviewed_at")
        ):
            application.mark_issues_reviewed(state)
        self.update_issue_card(issues)
        self.update_issues(issues)
        if authentication_blocked:
            cache_card_detail = translate("Protected locally · state unavailable")
        else:
            cache_card_detail = translate_format(
                "{pending} pending upload · {files} cache file(s)",
                pending=human_bytes(vfs.get("pending_bytes", 0)),
                files=vfs.get("cache_files", 0),
            )
        self.cache_card.update(human_bytes(vfs.get("cache_bytes", 0)), cache_card_detail)
        self.capacity_card.update(
            self.remote_capacity,
            int(vfs.get("free_bytes") or 0),
            int(vfs.get("cache_bytes") or 0),
        )
        self.upload_graph_peak.set_text(
            translate_format(
                "Peak {speed}",
                speed=human_rate(max(self.speed_graph.values(), default=0)),
            )
        )
        self.download_graph_peak.set_text(
            translate_format(
                "Peak {speed}",
                speed=human_rate(max(self.download_graph.values(), default=0)),
            )
        )

        if rate_limited:
            summary = translate_format(
                "Try again after {time}. Local cache data remains protected.",
                time=local_time(str(authentication.get("retry_after") or "")),
            )
        elif reauthorization_required:
            summary = translate(
                "Reauthorize Proton to resume the mount. Automatic login retries are paused and local cache data remains protected."
            )
        elif active:
            summary = translate_format(
                "{active} active transfer(s) · {count} file(s) queued · {speed}",
                active=active,
                count=queue.get("count", 0),
                speed=human_rate(speed),
            )
        elif queue.get("count", 0):
            summary = translate_format(
                "{count} file(s) are queued; rclone is preparing the next upload.",
                count=queue.get("count"),
            )
        else:
            summary = translate(
                "Everything is in sync. The service keeps its fast metadata cache warm and waits for changes."
            )
        self.live_summary.set_text(summary)
        if live_status in {"warning", "critical", "working"}:
            summary_icon, _summary_title, summary_color = STATUS_META[live_status]
        elif active or queue.get("count", 0):
            summary_icon, summary_color = "emblem-synchronizing-symbolic", "accent"
        else:
            summary_icon, _summary_title, summary_color = STATUS_META.get(
                status,
                STATUS_META["unknown"],
            )
        self.live_summary_icon.set_from_icon_name(summary_icon, Gtk.IconSize.MENU)
        summary_context = self.live_summary_icon.get_style_context()
        for color_class in ("good", "warning", "danger", "muted", "accent"):
            summary_context.remove_class(color_class)
        summary_context.add_class(summary_color)
        if authentication_blocked:
            self.live_detail_labels["upload"].set_text(
                translate("Upload · paused for reauthorization · live queue unavailable")
            )
        else:
            self.live_detail_labels["upload"].set_text(
                translate_format(
                    "Upload · {active} active · {count} queued ({bytes}) · {speed}",
                    active=active,
                    count=queue.get("count", 0),
                    bytes=human_bytes(queue.get("bytes", 0)),
                    speed=human_rate(speed),
                )
            )
        self.live_detail_labels["download"].set_text(
            translate_format(
                "Download · {speed} · rclone process receive traffic",
                speed=human_rate(download_speed),
            )
        )
        if authentication_blocked:
            self.live_detail_labels["cache"].set_text(
                translate_format(
                    "Cache · {cache} stored locally · upload state resumes after reauthorization",
                    cache=human_bytes(vfs.get("cache_bytes", 0)),
                )
            )
        else:
            self.live_detail_labels["cache"].set_text(
                translate_format(
                    "Cache · {pending} pending upload · {clean} synced read cache",
                    pending=human_bytes(vfs.get("pending_bytes", 0)),
                    clean=human_bytes(vfs.get("clean_bytes", 0)),
                )
            )
        if self.remote_capacity.get("available"):
            cloud_detail = translate_format(
                "Proton cloud · {free} free of {total}",
                free=human_bytes(self.remote_capacity.get("free_bytes", 0)),
                total=human_bytes(self.remote_capacity.get("total_bytes", 0)),
            )
        else:
            cloud_detail = translate("Proton cloud capacity unavailable")
        self.live_detail_labels["cloud"].set_text(cloud_detail)
        service_state = f"{service.get('active_state', '–')}/{service.get('sub_state', '–')}"
        self.live_detail_labels["service"].set_text(
            translate_format(
                "Service · {state} · {uptime} uptime · {restarts} restart(s)",
                state=service_state,
                uptime=human_duration(service.get("uptime_seconds", -1)),
                restarts=int(service.get("restarts") or 0),
            )
        )
        self.live_detail_labels["network"].set_text(
            translate_format(
                "Network · DNS {dns} · TCP {tcp} · watchdog {time}",
                dns=state.get("network", {}).get("dns", "–"),
                tcp=state.get("network", {}).get("tcp", "–"),
                time=local_time(str(watchdog.get("generated_at") or "")),
            )
        )
        mount = state.get("mount", {})
        self.service_detail_values["state"].set_text(service_state)
        self.service_detail_values["process"].set_text(
            translate_format(
                "PID {pid} · result {result} · exit {exit_status}",
                pid=int(service.get("pid") or 0),
                result=service.get("result", "–"),
                exit_status=service.get("exit_status", "–"),
            )
        )
        self.service_detail_values["uptime"].set_text(human_duration(service.get("uptime_seconds", -1)))
        self.service_detail_values["restarts"].set_text(str(int(service.get("restarts") or 0)))
        self.service_detail_values["mount"].set_text(
            translate_format(
                "{state} · {filesystem}",
                state="ready" if mount.get("ready") else "not ready",
                filesystem=mount.get("filesystem", "–"),
            )
        )
        self.service_detail_values["watchdog"].set_text(
            translate_format(
                "{status} · {confirmations} stall confirmation(s)\nchecked {time}",
                status=watchdog.get("status", "–"),
                confirmations=int(watchdog.get("stall_confirmations") or 0),
                time=local_time(str(watchdog.get("generated_at") or "")),
            )
        )
        draft_recovery = state.get("draft_recovery", {})
        draft_recovery_status = str(draft_recovery.get("status") or "unavailable")
        self.service_detail_values["draft_recovery"].set_text(
            translate_format(
                "{status} · {confirmations}/2 stall confirmations\n{payload}/1 payload · {finalization}/1 finalization · {bridge}/6 bridge restart(s)\n{cycles}/3 bridge failure cycles · checked {time}",
                status=translate(DRAFT_RECOVERY_STATUS_LABELS.get(draft_recovery_status, "Unavailable")),
                confirmations=int(draft_recovery.get("stall_confirmations") or 0),
                payload=max(
                    0,
                    int(draft_recovery.get("restart_attempts") or 0)
                    - int(draft_recovery.get("finalization_restart_attempts") or 0)
                    - int(draft_recovery.get("bridge_unwedge_restart_attempts") or 0),
                ),
                finalization=int(draft_recovery.get("finalization_restart_attempts") or 0),
                bridge=int(draft_recovery.get("bridge_unwedge_restart_attempts") or 0),
                cycles=int(draft_recovery.get("bridge_failure_cycles") or 0),
                time=local_time(str(draft_recovery.get("generated_at") or "")),
            )
        )
        self.service_detail_values["draft_recovery"].set_tooltip_text(
            str(draft_recovery.get("detail") or translate("No details available."))
        )
        self.config_labels["bandwidth"].set_text(str(bandwidth.get("live", "–")))
        self.config_labels["slots"].set_text(f"{slots} parallel")
        self.config_labels["metadata"].set_text(translate("enabled" if config.get("metadata_cache") else "disabled"))
        self.config_labels["cooldown"].set_text(human_duration(config.get("cooldown_seconds", -1)))
        self.short_status_text = "\n".join(
            (
                f"PDrive Control Center — {self.status_title.get_text()}",
                self.live_detail_labels["upload"].get_text(),
                self.live_detail_labels["download"].get_text(),
                self.live_detail_labels["cache"].get_text(),
                self.live_detail_labels["cloud"].get_text(),
                self.live_detail_labels["service"].get_text(),
                self.live_detail_labels["network"].get_text(),
                (
                    f"{translate('Configuration')}: "
                    f"{translate('Bandwidth')} {self.config_labels['bandwidth'].get_text()} · "
                    f"{translate('Upload slots')} {self.config_labels['slots'].get_text()} · "
                    f"{translate('Metadata cache')} {self.config_labels['metadata'].get_text()}"
                ),
                translate_format("Updated {time}", time=self.updated_label.get_text()),
            )
        )

        self.update_transfers(transfers, queue, speed, sample_time)
        self.update_cache_details(vfs, config)
        self.update_history(state.get("history", []))
        self.status_title.set_tooltip_text(
            translate_format(
                "Service {active}/{sub} · PID {pid}",
                active=service.get("active_state", "–"),
                sub=service.get("sub_state", "–"),
                pid=service.get("pid", 0),
            )
        )
        application = self.get_application()
        if isinstance(application, PDriveApplication):
            indicator_state = state
            if live_status != status:
                indicator_state = {
                    **state,
                    "health": {
                        **health,
                        "status": live_status,
                        "summary": live_summary,
                    },
                }
            application.update_indicator(indicator_state, speed)
        if not self.content_fit_completed:
            self.schedule_content_fit()
        return GLib.SOURCE_REMOVE

    def update_issue_card(self, issues: dict[str, Any]) -> None:
        application = self.get_application()
        preferences = application.preferences if isinstance(application, PDriveApplication) else DEFAULT_PREFERENCES
        errors, notices = issues_since_review(preferences, issues)
        total = errors + notices
        recoveries = unreviewed_recovery_events(preferences, issues)
        self.problem_card.update(
            str(total),
            translate_format(
                "{errors} errors · {notices} notices · since reviewed",
                errors=errors,
                notices=notices,
            ),
        )
        self.mark_issues_reviewed_button.set_sensitive(bool(total or recoveries) and not self.demo)

    def issue_row(self, event: dict[str, Any]) -> Gtk.ListBoxRow:
        row = Gtk.ListBoxRow()
        add_css(row, "transfer-row")
        outer = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=11)
        level = str(event.get("level", "error")).lower()
        lifecycle = str(event.get("lifecycle") or "active")
        if lifecycle == "resolved":
            icon_name = "emblem-ok-symbolic"
            icon_class = "accent"
        elif lifecycle == "recovering":
            icon_name = "emblem-synchronizing-symbolic"
            icon_class = "accent"
        elif level == "notice":
            icon_name = "dialog-warning-symbolic"
            icon_class = "warning"
        else:
            icon_name = "dialog-error-symbolic"
            icon_class = "danger"
        icon = Gtk.Image.new_from_icon_name(icon_name, Gtk.IconSize.BUTTON)
        add_css(icon, icon_class)
        icon.set_valign(Gtk.Align.START)
        outer.pack_start(icon, False, False, 2)

        content = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=5)
        top = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        title = label(
            translate(str(event.get("title") or "rclone reported an error")),
            "transfer-name",
        )
        title.set_line_wrap(True)
        top.pack_start(title, True, True, 0)
        display_time = str(event.get("resolved_at") or event.get("timestamp") or "")
        top.pack_end(
            label(local_time(display_time), "pill", 1.0),
            False,
            False,
            0,
        )
        content.pack_start(top, False, False, 0)

        subject = str(event.get("subject") or "")
        if subject:
            subject_label = label(short_name(subject, 110), "transfer-meta")
            subject_label.set_tooltip_text(subject)
            subject_label.set_selectable(True)
            subject_label.set_line_wrap(True)
            content.pack_start(subject_label, False, False, 0)
        occurrences = max(1, int(event.get("occurrences") or 1))
        if occurrences > 1:
            occurrence_label = label(
                translate_format(
                    "Recent log contains {count} related records · oldest retained {time}",
                    count=occurrences,
                    time=local_time(str(event.get("first_seen") or "")),
                ),
                "transfer-meta",
            )
            occurrence_label.set_line_wrap(True)
            content.pack_start(
                occurrence_label,
                False,
                False,
                0,
            )
        message = label(str(event.get("message") or ""), "issue-message")
        message.set_line_wrap(True)
        message.set_selectable(True)
        content.pack_start(message, False, False, 0)
        resolution = str(event.get("resolution") or "")
        if resolution:
            resolution_label = label(translate(resolution), "issue-guidance")
            resolution_label.set_line_wrap(True)
            content.pack_start(resolution_label, False, False, 0)
        guidance = label(
            translate_format(
                "{label}: {guidance}",
                label=translate("Suggested next step"),
                guidance=translate(str(event.get("guidance") or "")),
            ),
            "issue-guidance",
        )
        guidance.set_line_wrap(True)
        content.pack_start(guidance, False, False, 0)
        outer.pack_start(content, True, True, 0)
        row.add(outer)
        return row

    def update_issues(self, issues: dict[str, Any]) -> None:
        application = self.get_application()
        preferences = application.preferences if isinstance(application, PDriveApplication) else DEFAULT_PREFERENCES
        events, missing = unreviewed_issue_events(preferences, issues)
        recoveries = unreviewed_recovery_events(preferences, issues)
        errors, notices = issues_since_review(preferences, issues)
        signature = (
            errors,
            notices,
            missing,
            tuple(
                (
                    event.get("timestamp"),
                    event.get("level"),
                    event.get("category"),
                    event.get("subject"),
                    event.get("message"),
                )
                for event in events
            ),
            tuple((event.get("resolved_at"), event.get("category"), event.get("subject")) for event in recoveries),
        )
        if signature == self.issue_signature:
            return
        self.issue_signature = signature
        self.clear_list(self.issue_list)
        total = errors + notices
        if not total:
            if recoveries:
                self.issue_summary.set_text(
                    translate_format(
                        "No unreviewed issues remain; {count} recent recovery record(s) are shown below.",
                        count=len(recoveries),
                    )
                )
                for event in recoveries:
                    self.issue_list.add(self.issue_row(event))
            else:
                self.issue_summary.set_text(
                    translate("There are no new rclone errors or notices since your last review.")
                )
                self.issue_list.add(
                    EmptyState(
                        "emblem-ok-symbolic",
                        "No unreviewed issues",
                        "There are no new rclone errors or notices since your last review.",
                    )
                )
        else:
            if missing:
                self.issue_summary.set_text(
                    translate_format(
                        "Showing {shown} of {total} unreviewed event(s); "
                        "{missing} older detail(s) are outside the retained log tail.",
                        shown=len(events),
                        total=total,
                        missing=missing,
                    )
                )
            else:
                self.issue_summary.set_text(
                    translate_format(
                        "{errors} error(s) and {notices} notice(s) await review.",
                        errors=errors,
                        notices=notices,
                    )
                )
            for event in sort_issue_events(events + recoveries):
                self.issue_list.add(self.issue_row(event))
            if not events:
                self.issue_list.add(
                    EmptyState(
                        "dialog-warning-symbolic",
                        "Issue details unavailable",
                        "The counters report new events, but their sanitized log details are no longer available.",
                    )
                )
        self.issue_list.show_all()

    @staticmethod
    def localized_health_summary(state: dict[str, Any]) -> str:
        health = state.get("health", {})
        summary = str(health.get("summary", ""))
        if CURRENT_LANGUAGE != "de":
            return summary
        reason = str(health.get("reason_code", "unknown"))
        if reason == "mounted":
            queue = state.get("queue", {})
            finalizing = int(queue.get("finalizing") or 0)
            active = int(queue.get("active") or 0)
            count = int(queue.get("count") or 0)
            if finalizing:
                return translate_format(
                    "Proton is finalizing {count} fully transferred upload(s).",
                    count=finalizing,
                )
            if active:
                return GERMAN_HEALTH_SUMMARIES["mounted-active"].format(active=active)
            if count:
                return GERMAN_HEALTH_SUMMARIES["mounted-queued"].format(count=count)
            return GERMAN_HEALTH_SUMMARIES["mounted"]
        return GERMAN_HEALTH_SUMMARIES.get(reason, summary)

    def update_status(self, status: str, title_text: str, summary: str) -> None:
        for css_class in (
            "status-ready",
            "status-working",
            "status-warning",
            "status-critical",
            "status-unknown",
        ):
            self.status_frame.get_style_context().remove_class(css_class)
        selected = status if status in STATUS_META else "unknown"
        self.status_frame.get_style_context().add_class(f"status-{selected}")
        icon_name, fallback_title, _color = STATUS_META[selected]
        self.status_icon.set_from_icon_name(icon_name, Gtk.IconSize.DIALOG)
        self.status_title.set_text(translate(title_text or fallback_title))
        self.status_summary.set_text(summary or translate("No details available."))

    def transfer_direction_badge(self, direction: str) -> Gtk.Widget:
        normalized = direction if direction in {"upload", "download"} else "unknown"
        icon_name, text = {
            "upload": ("network-transmit-symbolic", "Upload"),
            "download": ("network-receive-symbolic", "Download"),
            "unknown": ("dialog-question-symbolic", "Direction unknown"),
        }[normalized]
        badge = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=4)
        badge.set_name(f"transfer-direction-{normalized}")
        add_css(badge, "pill", "direction-pill")
        badge.pack_start(Gtk.Image.new_from_icon_name(icon_name, Gtk.IconSize.MENU), False, False, 0)
        badge.pack_start(label(text), False, False, 0)
        badge.set_tooltip_text(translate(text))
        return badge

    def transfer_row(self, item: dict[str, Any], queue: bool = False, recent: bool = False) -> Gtk.ListBoxRow:
        row = Gtk.ListBoxRow()
        add_css(row, "transfer-row")
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        top = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        name = label(short_name(str(item.get("name", "Unknown file"))), "transfer-name")
        name.set_ellipsize(3)
        name.set_tooltip_text(str(item.get("name", "")))
        top.pack_start(name, True, True, 0)
        if queue:
            status = (
                "Finalizing"
                if item.get("stage") == "finalizing"
                else ("Uploading" if item.get("uploading") else "Waiting")
            )
            if item.get("stage") != "finalizing" and int(item.get("tries") or 0) >= 2:
                status = translate_format("Attempt {tries}", tries=item.get("tries"))
            top.pack_end(label(status, "pill"), False, False, 0)
        elif recent:
            text = "Failed" if item.get("error") else "Completed"
            top.pack_end(label(text, "pill"), False, False, 0)
            top.pack_end(
                self.transfer_direction_badge(str(item.get("direction") or "unknown")),
                False,
                False,
                0,
            )
        else:
            if item.get("stage") == "finalizing":
                speed_text = translate("Finalizing")
                speed_source = translate(
                    "The payload is complete; success is confirmed only after Proton commits the remote file."
                )
            elif "display_speed" in item:
                display_speed = max(0.0, float(item.get("display_speed") or 0))
                speed_text = human_rate(display_speed)
                speed_source = translate("Verified process traffic")
            else:
                display_speed, _backend_eta = backend_transfer_metrics(item)
                speed_text = human_rate(display_speed) if display_speed > 0 else translate("Rate unavailable")
                speed_source = translate("rclone estimate")
            speed_pill = label(speed_text, "pill")
            speed_pill.set_tooltip_text(speed_source)
            top.pack_end(speed_pill, False, False, 0)
        box.pack_start(top, False, False, 0)

        detail_tooltip: str | None = None
        if not queue and not recent:
            size = int(item.get("size") or 0)
            done = int(item.get("bytes") or 0)
            fraction = min(1.0, done / size) if size > 0 else 0.0
            progress = Gtk.ProgressBar(fraction=fraction)
            box.pack_start(progress, False, False, 0)
            detail = f"{human_bytes(done)} / {human_bytes(size)}"
            eta_seconds = item.get("display_eta_seconds", item.get("eta_seconds", -1))
            if "display_eta_seconds" not in item:
                _backend_speed, eta_seconds = backend_transfer_metrics(item)
            eta = (
                compact_eta_duration(eta_seconds)
                if item.get("display_eta_approximate") and int(eta_seconds or -1) >= 0
                else human_duration(eta_seconds)
            )
            if item.get("stage") == "finalizing":
                detail = translate("Payload transferred · Proton is finalizing the file")
                detail_tooltip = translate(
                    "The payload is complete; success is confirmed only after Proton commits the remote file."
                )
            elif eta != "–":
                prefix = "≈" if item.get("display_eta_approximate") else "ETA "
                detail += f" · {prefix}{eta}"
                if item.get("display_eta_approximate"):
                    detail_tooltip = f"{human_bytes(done)} / {human_bytes(size)} · ETA ≈ {clock_duration(eta_seconds)}"
            elif item.get("display_eta_calculating"):
                detail += f" · {translate('ETA calculating')}"
            elif item.get("display_eta_waiting"):
                detail += f" · {translate('⏸ ETA waiting')}"
                detail_tooltip = translate("No upload traffic is currently available for an estimate.")
        elif queue:
            detail = (
                translate("Payload transferred · Proton is finalizing the file")
                if item.get("stage") == "finalizing"
                else f"{human_bytes(item.get('size', 0))} · "
                + translate_format("{tries} attempt(s)", tries=item.get("tries", 0))
            )
        else:
            completed_size = int(item.get("bytes") or item.get("size") or 0)
            completed_time = local_time(str(item.get("completed_at", "")))
            detail = f"{human_bytes(completed_size)} · {completed_time}" if completed_size > 0 else completed_time
        detail_label = label(detail, "transfer-meta")
        detail_label.set_tooltip_text(detail_tooltip)
        box.pack_start(detail_label, False, False, 0)
        row.add(box)
        return row

    def update_transfers(
        self,
        transfers: dict[str, Any],
        queue: dict[str, Any],
        current_speed: float = 0.0,
        sample_time: float | None = None,
    ) -> None:
        self.clear_list(self.active_list)
        self.clear_list(self.queue_list)
        self.clear_list(self.recent_list)
        active_items = transfers.get("active", [])
        queue_items = queue.get("items", [])
        recent_items = transfers.get("recent", [])
        estimate_ready = upload_eta_ready(
            self.upload_eta_samples,
            self.upload_eta_rate,
            self.upload_eta_last_progress,
            sample_time if sample_time is not None else time.monotonic(),
            self.refresh_interval_seconds(),
        )
        verified_metrics = verified_single_transfer_metrics(
            transfers,
            queue,
            current_speed,
            self.upload_eta_rate,
            estimate_ready,
        )
        if active_items:
            for item in active_items:
                display_item = item
                if verified_metrics is not None:
                    display_item = {
                        **item,
                        "display_speed": verified_metrics["speed"],
                        "display_eta_seconds": verified_metrics["eta_seconds"],
                        "display_eta_approximate": verified_metrics["estimate_ready"],
                        "display_eta_calculating": (
                            not verified_metrics["estimate_ready"] and verified_metrics["speed"] >= 1024
                        ),
                        "display_eta_waiting": (
                            not verified_metrics["estimate_ready"] and verified_metrics["speed"] < 1024
                        ),
                    }
                self.active_list.add(self.transfer_row(display_item))
        else:
            uploading = [item for item in queue_items if item.get("uploading")]
            if uploading:
                for item in uploading:
                    self.active_list.add(self.transfer_row(item, queue=True))
            else:
                self.active_list.add(
                    EmptyState(
                        "media-playback-pause-symbolic",
                        "No active transfers",
                        "rclone is not using the connection right now.",
                    )
                )
        if queue_items:
            for item in queue_items:
                self.queue_list.add(self.transfer_row(item, queue=True))
        else:
            self.queue_list.add(
                EmptyState(
                    "emblem-ok-symbolic",
                    "Queue is empty",
                    "All local changes have been uploaded.",
                )
            )
        if recent_items:
            for item in reversed(recent_items[-12:]):
                self.recent_list.add(self.transfer_row(item, recent=True))
        else:
            self.recent_list.add(
                EmptyState(
                    "document-open-recent-symbolic",
                    "No transfers yet",
                    "No completed transfers were found in the last 24 hours.",
                )
            )
        self.active_list.show_all()
        self.queue_list.show_all()
        self.recent_list.show_all()

    def update_cache_details(self, vfs: dict[str, Any], config: dict[str, Any]) -> None:
        cache_state = str(vfs.get("cache_state", "unavailable"))
        clean_files = int(vfs.get("clean_files") or 0)
        pending_files = int(vfs.get("pending_files") or 0)
        errored_files = int(vfs.get("errored_files") or 0)
        if cache_state == "clean":
            title = "Cache is fully synced"
            detail = translate_format(
                "{files} local file(s) are already uploaded and kept only to speed up future reads.",
                files=clean_files,
            )
        elif cache_state == "pending":
            title = "Uploads are still pending"
            detail = translate_format(
                "{files} file(s) remain in the protected upload cache.",
                files=pending_files,
            )
        elif cache_state == "error":
            title = "Cache needs attention"
            detail = translate_format(
                "{files} cached file(s) currently report errors.",
                files=errored_files,
            )
        elif cache_state == "empty":
            title = "Local cache is empty"
            detail = translate("The local VFS cache is empty.")
        else:
            title = "Cache details unavailable"
            detail = translate("rclone’s VFS statistics are temporarily unavailable.")
        self.cache_status_title.set_text(translate(title))
        self.cache_status_detail.set_text(detail)
        self.cache_detail_values["clean"].set_text(
            translate_format(
                "{files} clean file(s) · {size}",
                files=clean_files,
                size=human_bytes(vfs.get("clean_bytes", 0)),
            )
        )
        self.cache_detail_values["pending"].set_text(
            translate_format(
                "{files} pending file(s) · {size}",
                files=pending_files,
                size=human_bytes(vfs.get("pending_bytes", 0)),
            )
        )
        configured_age = int(config.get("cache_max_age_seconds") or 0)
        running_age = int(config.get("running_cache_max_age_seconds") or -1)
        self.cache_detail_values["retention"].set_text(
            translate_format(
                "Running {running} · saved {saved}",
                running=human_duration(running_age),
                saved=human_duration(configured_age),
            )
        )

    def update_history(self, entries: list[dict[str, Any]]) -> None:
        signature = tuple(
            (
                entry.get("time"),
                entry.get("status"),
                entry.get("reason"),
                entry.get("errors"),
                entry.get("notices"),
            )
            for entry in entries[-24:]
        )
        if signature == self.history_signature:
            return
        self.history_signature = signature
        self.clear_list(self.history_list)
        if not entries:
            self.history_list.add(
                EmptyState(
                    "document-open-recent-symbolic",
                    "No history yet",
                    "The pdrive-watch timer has not recorded a sample yet.",
                )
            )
            self.history_list.show_all()
            return
        for entry in reversed(entries[-24:]):
            row = Gtk.ListBoxRow()
            add_css(row, "history-row")
            box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
            status = str(entry.get("status", "unknown"))
            icon_name, _title, color = STATUS_META.get(status, STATUS_META["unknown"])
            icon = Gtk.Image.new_from_icon_name(icon_name, Gtk.IconSize.BUTTON)
            add_css(icon, color)
            box.pack_start(icon, False, False, 0)
            text_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
            reason = str(entry.get("reason", "unknown"))
            text_box.pack_start(
                label(
                    REASON_LABELS.get(reason, reason.replace("-", " ").capitalize()),
                    "transfer-name",
                ),
                False,
                False,
                0,
            )
            detail = translate_format(
                "Queue {queue} · active {active} · error counter {errors} · notices {notices}",
                queue=entry.get("vfs_queue", 0),
                active=entry.get("vfs_uploading", 0),
                errors=entry.get("errors", 0),
                notices=entry.get("notices", 0),
            )
            text_box.pack_start(label(detail, "transfer-meta"), False, False, 0)
            box.pack_start(text_box, True, True, 0)
            box.pack_end(
                label(local_time(str(entry.get("time", ""))), "pill", 1.0),
                False,
                False,
                0,
            )
            row.add(box)
            self.history_list.add(row)
        self.history_list.show_all()

    def on_open_mount(self, _button: Gtk.Button) -> None:
        try:
            Gio.AppInfo.launch_default_for_uri(pathlib.Path("/pdrive").as_uri(), None)
        except GLib.Error as error:
            self.message("Could not open mount", str(error), Gtk.MessageType.ERROR)

    def on_reauthorize(self, _button: Gtk.Button) -> None:
        if self.demo:
            self.message(
                "Proton account reauthorization",
                "Reauthorization is available in the installed application when the account requires it.",
                Gtk.MessageType.INFO,
            )
            return
        authentication = self.current_state.get("authentication", {})
        if isinstance(authentication, dict) and authentication.get("status") == "rate-limited":
            self.message(
                "Login temporarily paused",
                translate_format(
                    "Try again after {time}. Local cache data remains protected.",
                    time=local_time(str(authentication.get("retry_after") or "")),
                ),
                Gtk.MessageType.WARNING,
            )
            return
        if self.reauthorization_dialog is not None:
            self.reauthorization_dialog.present()
            return
        dialog = ReauthorizationDialog(self)
        self.reauthorization_dialog = dialog
        dialog.connect(
            "destroy",
            lambda _dialog: setattr(self, "reauthorization_dialog", None),
        )
        dialog.present()

    def on_account_switch(self, _button: Gtk.Button | None) -> None:
        if self.account_switch_dialog is not None:
            self.account_switch_dialog.present()
            return
        dialog = AccountSwitchDialog(self, demo=self.demo)
        self.account_switch_dialog = dialog
        dialog.connect(
            "destroy",
            lambda _dialog: setattr(self, "account_switch_dialog", None),
        )
        dialog.present()
        application = self.get_application()
        if self.demo and isinstance(application, PDriveApplication) and application.demo_dialog == "account-switch":
            self.hide()

    def on_copy_short_status(self, _button: Gtk.Button) -> None:
        status = getattr(self, "short_status_text", "")
        if not status:
            return
        clipboard = Gtk.Clipboard.get(Gdk.SELECTION_CLIPBOARD)
        clipboard.set_text(status, -1)
        clipboard.store()
        self.copy_short_status_button.set_tooltip_text(translate("Short status copied"))
        GLib.timeout_add(1800, self.restore_copy_status_tooltip)

    def restore_copy_status_tooltip(self) -> bool:
        self.copy_short_status_button.set_tooltip_text(translate("Copy short status"))
        return GLib.SOURCE_REMOVE

    def on_open_proton_web(self, _button: Gtk.Button) -> None:
        try:
            Gio.AppInfo.launch_default_for_uri(PROTON_DRIVE_URL, None)
        except GLib.Error as error:
            self.message("Could not open Proton Drive", str(error), Gtk.MessageType.ERROR)

    def on_documentation(self, _button: Gtk.Button) -> None:
        application = self.get_application()
        if not isinstance(application, PDriveApplication):
            return
        if self.documentation_window is None:
            self.documentation_window = DocumentationWindow(application, self)
            self.documentation_window.connect(
                "destroy",
                lambda _window: setattr(self, "documentation_window", None),
            )
            self.documentation_window.show_all()
        self.documentation_window.present()

    def on_about(self, _button: Gtk.Button) -> None:
        if self.about_dialog is None:
            dialog = Gtk.AboutDialog(transient_for=self, modal=True)
            dialog.set_destroy_with_parent(True)
            add_css(dialog, "pdrive-about")
            dialog.set_title(translate("About PDrive Control Center"))
            dialog.set_program_name("PDrive Control Center")
            dialog.set_version(VERSION)
            dialog.set_logo_icon_name(APP_ID)
            dialog.set_website(PROJECT_URL)
            dialog.set_website_label(translate("GitHub project"))
            dialog.set_license_type(Gtk.License.GPL_3_0)
            dialog.set_authors([translate(description) + "\n" + url for description, url in ABOUT_CREDITS])
            dialog.set_comments(
                translate(
                    "We — Claudiu & Codex — loved turning a stubborn real-world mount into something observable, "
                    "careful and genuinely pleasant to use.\n\nMade with love for people on this beautiful world who "
                    "want Linux to feel like home. 💜"
                )
            )
            dialog.connect("response", lambda about, _response: about.destroy())
            dialog.connect(
                "destroy",
                lambda _dialog: setattr(self, "about_dialog", None),
            )
            self.about_dialog = dialog
            dialog.show_all()
            license_labels = {"license", "lizenz", translate("License").casefold()}
            license_buttons = [
                widget
                for widget in widget_descendants(dialog)
                if isinstance(widget, Gtk.Button)
                and (widget.get_label() or "").replace("_", "").casefold() in license_labels
            ]
            if len(license_buttons) == 1:
                license_buttons[0].connect("clicked", self.on_about_license)
            credits_labels = {"credits", "mitwirkende"}
            credits_buttons = [
                widget
                for widget in widget_descendants(dialog)
                if isinstance(widget, Gtk.Button)
                and (widget.get_label() or "").replace("_", "").casefold() in credits_labels
            ]
            if len(credits_buttons) == 1:
                credits_buttons[0].connect_after("clicked", self.on_about_credits)
        self.about_dialog.present()

    def on_about_credits(self, _button: Gtk.Button) -> None:
        GLib.idle_add(self.replace_about_credit_links)

    def replace_about_credit_links(self) -> bool:
        dialog = self.about_dialog
        if dialog is None:
            return GLib.SOURCE_REMOVE
        credits_by_url = {url: translate(description) for description, url in ABOUT_CREDITS}
        for widget in tuple(widget_descendants(dialog)):
            if not isinstance(widget, Gtk.Label) or not widget.get_use_markup():
                continue
            markup = widget.get_label()
            url = next(
                (candidate for candidate in credits_by_url if f'href="{candidate}"' in markup),
                None,
            )
            parent = widget.get_parent()
            if url is None or not isinstance(parent, Gtk.Grid):
                continue
            placement = {
                name: parent.child_get_property(widget, name)
                for name in ("left-attach", "top-attach", "width", "height")
            }
            credit = Gtk.Button(label=credits_by_url[url])
            credit.set_relief(Gtk.ReliefStyle.NONE)
            credit.set_halign(Gtk.Align.START)
            credit.set_tooltip_text(url)
            add_css(credit, "pdrive-about-credit")
            set_pointer_on_hover(credit)
            credit.connect("clicked", lambda _credit, target=url: self.open_about_credit(target))
            parent.remove(widget)
            parent.attach(
                credit,
                placement["left-attach"],
                placement["top-attach"],
                placement["width"],
                placement["height"],
            )
            credit.show_all()
        return GLib.SOURCE_REMOVE

    def open_about_credit(self, url: str) -> None:
        try:
            Gio.AppInfo.launch_default_for_uri(url, None)
        except GLib.Error as error:
            self.message("Could not open project link", str(error), Gtk.MessageType.ERROR)

    def on_about_license(self, _button: Gtk.Button) -> None:
        if self.about_dialog is not None:
            self.about_dialog.destroy()
        self.open_documentation_page("license")

    def open_documentation_page(self, page_name: str) -> None:
        self.on_documentation(None)
        if self.documentation_window is not None:
            self.documentation_window.stack.set_visible_child_name(page_name)

    def on_mark_issues_reviewed(self, _button: Gtk.Button) -> None:
        application = self.get_application()
        if not isinstance(application, PDriveApplication) or self.demo:
            return
        error = application.mark_issues_reviewed(self.current_state)
        if error:
            self.message(
                "Could not update issue review state",
                error,
                Gtk.MessageType.ERROR,
            )
            return
        issues = self.current_state.get("issues", {})
        self.update_issue_card(issues)
        self.update_issues(issues)

    def on_preferences(self, _button: Gtk.Button) -> None:
        application = self.get_application()
        if not isinstance(application, PDriveApplication):
            return
        dialog = Gtk.Dialog(
            title=translate("Preferences"),
            transient_for=None if self.demo else self,
            modal=True,
        )
        dialog.add_buttons(
            translate("Cancel"),
            Gtk.ResponseType.CANCEL,
            translate("Save"),
            Gtk.ResponseType.OK,
        )
        content = dialog.get_content_area()
        content.set_spacing(11)
        content.set_margin_top(16)
        content.set_margin_bottom(16)
        content.set_margin_start(16)
        content.set_margin_end(16)
        content.set_size_request(430, -1)
        content.pack_start(label("Behavior", "section-title"), False, False, 0)
        close_toggle = Gtk.CheckButton(label=translate("Keep running in the tray when the window closes"))
        close_toggle.set_active(application.preferences["close_to_tray"])
        content.pack_start(close_toggle, False, False, 0)
        start_toggle = Gtk.CheckButton(label=translate("Start hidden in the tray with the desktop session"))
        start_toggle.set_active(application.preferences["start_in_tray"])
        content.pack_start(start_toggle, False, False, 0)
        background_poll_toggle = Gtk.CheckButton(label=translate("Keep live metrics updating while hidden in the tray"))
        background_poll_toggle.set_active(application.preferences["poll_in_background"])
        content.pack_start(background_poll_toggle, False, False, 0)
        background_poll_note = label(
            "When disabled, live polling pauses while hidden. "
            "The independent 90-minute watchdog keeps monitoring health.",
            "section-subtitle",
        )
        background_poll_note.set_line_wrap(True)
        content.pack_start(background_poll_note, False, False, 0)
        notification_row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        notification_row.pack_start(label("Desktop notifications"), True, True, 0)
        notification_combo = Gtk.ComboBoxText()
        for policy_id, policy_label in NOTIFICATION_POLICIES.items():
            notification_combo.append(policy_id, translate(policy_label))
        notification_combo.set_active_id(str(application.preferences["notification_policy"]))
        notification_row.pack_end(notification_combo, False, False, 0)
        content.pack_start(notification_row, False, False, 0)
        notification_note = label(
            "The independent watchdog applies this policy even while the Control Center is closed.",
            "section-subtitle",
        )
        notification_note.set_line_wrap(True)
        content.pack_start(notification_note, False, False, 0)
        interval_row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        interval_row.pack_start(label("Live metrics interval"), True, True, 0)
        interval_combo = Gtk.ComboBoxText()
        for seconds in REFRESH_INTERVAL_OPTIONS:
            interval_combo.append(
                str(seconds),
                translate_format("{seconds} seconds", seconds=seconds),
            )
        interval_combo.set_active_id(str(application.preferences["refresh_interval_seconds"]))
        interval_row.pack_end(interval_combo, False, False, 0)
        content.pack_start(interval_row, False, False, 0)
        language_row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        language_row.pack_start(label("Language"), True, True, 0)
        language_combo = Gtk.ComboBoxText()
        for language_id, language_name in SUPPORTED_LANGUAGES.items():
            language_combo.append(language_id, language_name)
        language_combo.set_active_id(str(application.preferences["language"]))
        language_row.pack_end(language_combo, False, False, 0)
        content.pack_start(language_row, False, False, 0)
        language_note = label(
            "Language changes take effect after restarting PDrive Control Center.",
            "section-subtitle",
        )
        language_note.set_line_wrap(True)
        content.pack_start(language_note, False, False, 0)
        account_separator = Gtk.Separator(orientation=Gtk.Orientation.HORIZONTAL)
        account_separator.set_margin_top(3)
        account_separator.set_margin_bottom(3)
        content.pack_start(account_separator, False, False, 0)
        content.pack_start(label("Account", "section-title"), False, False, 0)
        account_note = label(
            "Move the managed /pdrive mount to another Proton account. Active transfers and protected pending data block the change.",
            "section-subtitle",
        )
        account_note.set_line_wrap(True)
        content.pack_start(account_note, False, False, 0)
        account_switch_button = Gtk.Button(label=translate("Change Proton account …"))
        account_switch_button.set_tooltip_text(translate("Change Proton account …"))
        account_switch_button.set_halign(Gtk.Align.START)
        add_css(account_switch_button, "reauth-attention")
        set_pointer_on_hover(account_switch_button)
        account_switch_button.connect(
            "clicked",
            lambda _button: dialog.response(Gtk.ResponseType.APPLY),
        )
        content.pack_start(account_switch_button, False, False, 0)
        explanation = label(
            "Session startup uses ~/.config/autostart. A manual launch from the application "
            "menu still opens the window visibly.",
            "section-subtitle",
        )
        explanation.set_line_wrap(True)
        content.pack_start(explanation, False, False, 0)

        initial_preferences = (
            close_toggle.get_active(),
            start_toggle.get_active(),
            background_poll_toggle.get_active(),
            int(interval_combo.get_active_id() or REFRESH_INTERVAL_SECONDS),
            notification_combo.get_active_id() or "important",
            language_combo.get_active_id() or "en",
        )
        save_button = dialog.get_widget_for_response(Gtk.ResponseType.OK)

        def update_save_sensitivity(*_args: Any) -> None:
            current_preferences = (
                close_toggle.get_active(),
                start_toggle.get_active(),
                background_poll_toggle.get_active(),
                int(interval_combo.get_active_id() or REFRESH_INTERVAL_SECONDS),
                notification_combo.get_active_id() or "important",
                language_combo.get_active_id() or "en",
            )
            save_button.set_sensitive(current_preferences != initial_preferences)

        def enforce_close(toggle: Gtk.CheckButton) -> None:
            if toggle.get_active():
                close_toggle.set_active(True)

        start_toggle.connect("toggled", enforce_close)
        for toggle in (close_toggle, start_toggle, background_poll_toggle):
            toggle.connect("toggled", update_save_sensitivity)
        language_combo.connect("changed", update_save_sensitivity)
        interval_combo.connect("changed", update_save_sensitivity)
        notification_combo.connect("changed", update_save_sensitivity)
        save_button.set_sensitive(False)
        dialog.show_all()
        if self.demo and application.demo_dialog == "preferences-account":
            self.hide()
        response = dialog.run()
        close_to_tray = close_toggle.get_active()
        start_in_tray = start_toggle.get_active()
        poll_in_background = background_poll_toggle.get_active()
        refresh_interval_seconds = int(interval_combo.get_active_id() or REFRESH_INTERVAL_SECONDS)
        notification_policy = notification_combo.get_active_id() or "important"
        selected_language = language_combo.get_active_id() or "en"
        previous_language = str(application.preferences["language"])
        dialog.destroy()
        if response == Gtk.ResponseType.APPLY:
            self.on_account_switch(account_switch_button)
            return
        if response != Gtk.ResponseType.OK:
            return
        error = application.update_preferences(
            close_to_tray,
            start_in_tray,
            poll_in_background,
            refresh_interval_seconds,
            notification_policy,
            selected_language,
        )
        if error:
            self.message("Could not save preferences", error, Gtk.MessageType.ERROR)
        elif selected_language != previous_language:
            self.message(
                "Restart required",
                "Quit and reopen PDrive Control Center to apply the selected language.",
                Gtk.MessageType.INFO,
            )

    def on_bandwidth(self, _button: Gtk.Button) -> None:
        dialog = Gtk.Dialog(title=translate("Bandwidth limit"), transient_for=self, modal=True)
        dialog.add_buttons(
            translate("Cancel"),
            Gtk.ResponseType.CANCEL,
            translate("Apply"),
            Gtk.ResponseType.OK,
        )
        content = dialog.get_content_area()
        content.set_spacing(10)
        content.set_margin_top(15)
        content.set_margin_bottom(15)
        content.set_margin_start(15)
        content.set_margin_end(15)
        current = str(self.current_state.get("bandwidth", {}).get("configured", "off"))
        initial_upload = bandwidth_slider_position(current, "upload")
        initial_download = bandwidth_slider_position(current, "download")

        def add_scale(title: str, initial_position: float) -> Gtk.Scale:
            content.pack_start(label(title, "section-title"), False, False, 0)
            scale = create_bandwidth_scale(initial_position)
            content.pack_start(scale, False, False, 0)
            return scale

        upload_scale = add_scale("Upload limit in MiB/s", initial_upload)
        download_scale = add_scale("Download limit in MiB/s", initial_download)
        help_label = label(
            "Near pause throttles that direction to 0.02 MiB/s; rclone has no true VFS pause. Full right removes its limit. Changes apply live without interrupting active transfers.",
            "section-subtitle",
        )
        help_label.set_line_wrap(True)
        content.pack_start(help_label, False, False, 0)
        advanced_label = label(
            "The logarithmic sliders give low everyday limits more precision. Leaving connection headroom can keep browsing and calls responsive; use pdrive-bwlimit for values above 100 MiB/s.",
            "section-subtitle",
        )
        advanced_label.set_line_wrap(True)
        content.pack_start(advanced_label, False, False, 0)
        apply_button = dialog.get_widget_for_response(Gtk.ResponseType.OK)
        apply_button.set_sensitive(False)

        def update_apply(_scale: Gtk.Scale) -> None:
            changed = (
                abs(upload_scale.get_value() - initial_upload) >= 0.05
                or abs(download_scale.get_value() - initial_download) >= 0.05
            )
            apply_button.set_sensitive(changed)

        upload_scale.connect("value-changed", update_apply)
        download_scale.connect("value-changed", update_apply)
        dialog.show_all()
        response = dialog.run()
        value = bandwidth_slider_command(upload_scale.get_value(), download_scale.get_value())
        dialog.destroy()
        if response == Gtk.ResponseType.OK:
            self.run_helper(["pdrive-bwlimit", value], "Bandwidth limit")

    def on_transfers(self, _button: Gtk.Button) -> None:
        dialog = Gtk.Dialog(title=translate("Upload slots"), transient_for=self, modal=True)
        dialog.add_buttons(
            translate("Cancel"),
            Gtk.ResponseType.CANCEL,
            translate("Save"),
            Gtk.ResponseType.OK,
        )
        content = dialog.get_content_area()
        content.set_spacing(10)
        content.set_margin_top(15)
        content.set_margin_bottom(15)
        content.set_margin_start(15)
        content.set_margin_end(15)
        content.pack_start(label("Parallel file uploads", "section-title"), False, False, 0)
        current = int(self.current_state.get("configuration", {}).get("transfers", 4))
        adjustment = Gtk.Adjustment(
            value=current,
            lower=1,
            upper=8,
            step_increment=1,
            page_increment=1,
            page_size=0,
        )
        scale = Gtk.Scale(orientation=Gtk.Orientation.HORIZONTAL, adjustment=adjustment)
        scale.set_digits(0)
        scale.set_value_pos(Gtk.PositionType.TOP)
        scale.set_hexpand(True)
        for slots in range(1, 9):
            scale.add_mark(slots, Gtk.PositionType.BOTTOM, str(slots))
        content.pack_start(scale, False, False, 0)
        note = label(
            "The saved value takes effect after the next controlled service start.",
            "section-subtitle",
        )
        note.set_line_wrap(True)
        content.pack_start(note, False, False, 0)
        save_button = dialog.get_widget_for_response(Gtk.ResponseType.OK)
        save_button.set_sensitive(False)
        scale.connect(
            "value-changed",
            lambda current_scale: save_button.set_sensitive(round(current_scale.get_value()) != current),
        )
        dialog.show_all()
        response = dialog.run()
        value = round(scale.get_value())
        dialog.destroy()
        if response == Gtk.ResponseType.OK:
            self.run_helper(["pdrive-transfers", str(value)], "Upload slots")

