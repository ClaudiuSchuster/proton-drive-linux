        text_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=3)
        self.status_title = label("Loading status …", "status-title")
        self.status_summary = label("Connecting to the local RC socket.", "status-detail")
        self.status_summary.set_line_wrap(True)
        text_box.pack_start(self.status_title, False, False, 0)
        text_box.pack_start(self.status_summary, False, False, 0)
        self.status_box.pack_start(text_box, True, True, 0)
        right = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=3)
        right.set_halign(Gtk.Align.END)
        live_row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=5)
        live_row.pack_start(label("●", "live-dot"), False, False, 0)
        live_row.pack_start(label("LIVE", "card-title"), False, False, 0)
        self.updated_label = label("–", "status-detail", 1.0)
        right.pack_start(live_row, False, False, 0)
        right.pack_start(self.updated_label, False, False, 0)
        self.status_box.pack_end(right, False, False, 0)
        self.status_frame = card(self.status_box, "status-card", "status-unknown")
        return self.status_frame

    def graph_with_axes(self, graph: SpeedGraph) -> Gtk.Widget:
        overlay = Gtk.Overlay()
        overlay.add(graph)
        axis_labels = []
        for alignment in (Gtk.Align.START, Gtk.Align.CENTER, Gtk.Align.END):
            value = label("0 B/s", "axis-label", 1.0)
            value.set_halign(Gtk.Align.END)
            value.set_valign(alignment)
            value.set_margin_end(4)
            overlay.add_overlay(value)
            overlay.set_overlay_pass_through(value, True)
            axis_labels.append(value)
        timeline = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL)
        timeline_start = label("–", "section-subtitle")
        timeline_end = label("now", "section-subtitle", 1.0)
        timeline.pack_start(timeline_start, True, True, 0)
        timeline.pack_end(timeline_end, False, False, 0)
        container = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        container.pack_start(overlay, True, True, 0)
        container.pack_start(timeline, False, False, 0)
        graph.axis_labels = axis_labels
        graph.timeline_start = timeline_start
        return container

    def update_graph_axis(self, graph: SpeedGraph) -> None:
        values = list(graph.samples)
        peak = max(values, default=0.0)
        graph.axis_labels[0].set_text(human_rate(peak))
        graph.axis_labels[1].set_text(human_rate(peak / 2))
        graph.axis_labels[2].set_text("0 B/s")
        seconds = max(0, (graph.samples.maxlen - 1) * self.refresh_interval_seconds())
        graph.timeline_start.set_text(approximate_duration(seconds))

