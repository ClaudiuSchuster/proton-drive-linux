    def on_cooldown(self, _button: Gtk.Button) -> None:
        dialog = Gtk.Dialog(title=translate("Restart cooldown"), transient_for=self, modal=True)
        dialog.add_buttons(
            translate("Cancel"),
            Gtk.ResponseType.CANCEL,
            translate("Save"),
            Gtk.ResponseType.OK,
        )
        content = dialog.get_content_area()
        content.set_spacing(10)
        content.set_margin_top(15)
        content.set_margin_bottom(15)
        content.set_margin_start(15)
        content.set_margin_end(15)
        content.set_size_request(440, -1)
        content.pack_start(label("Automatic recovery cooldown", "section-title"), False, False, 0)
        current_seconds = int(self.current_state.get("configuration", {}).get("cooldown_seconds") or 43200)
        current_hours = max(1, min(168, round(current_seconds / 3600)))
        row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=9)
        spinner = Gtk.SpinButton.new_with_range(1, 168, 1)
        spinner.set_value(current_hours)
        row.pack_start(spinner, False, False, 0)
        row.pack_start(label("hours"), False, False, 0)
        content.pack_start(row, False, False, 0)
        content.pack_start(label("Choose 1 to 168 hours.", "section-subtitle"), False, False, 0)
        note = label(
            "This changes the watchdog policy immediately without restarting rclone.",
            "section-subtitle",
        )
        note.set_line_wrap(True)
        content.pack_start(note, False, False, 0)
        save_button = dialog.get_widget_for_response(Gtk.ResponseType.OK)
        save_button.set_sensitive(False)
        spinner.connect(
            "value-changed",
            lambda current: save_button.set_sensitive(current.get_value_as_int() != current_hours),
        )
        dialog.show_all()
        response = dialog.run()
        value = spinner.get_value_as_int()
        dialog.destroy()
        if response == Gtk.ResponseType.OK:
            self.run_helper(["pdrive-watch", "--set-cooldown", f"{value}h"], "Restart cooldown")

