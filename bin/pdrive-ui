        live_summary_row.pack_start(self.live_summary_icon, False, False, 0)
        live_summary_row.pack_start(self.live_summary, True, True, 0)
        self.live_summary_box.pack_start(live_summary_row, False, False, 0)
        self.live_detail_labels: dict[str, Gtk.Label] = {}
        for key, icon_name in (
            ("upload", "network-transmit-symbolic"),
            ("download", "network-receive-symbolic"),
            ("cache", "drive-harddisk-symbolic"),
            ("cloud", "folder-remote-symbolic"),
            ("service", "system-run-symbolic"),
            ("network", "network-wired-symbolic"),
        ):
