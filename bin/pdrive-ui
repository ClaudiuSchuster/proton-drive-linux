    def configure_dashboard_tabs(self) -> None:
        for tab_button, tooltip in zip(
            self.stack_switcher.get_children(),
            ("Overview", "Transfers", "History"),
        ):
            set_pointer_on_hover(tab_button)
            tab_button.set_tooltip_text(translate(tooltip))

    def build_actions_popover(self) -> Gtk.Popover:
        popover = Gtk.Popover()

        def activate(button: Gtk.Button, callback: Any) -> None:
            popover.hide()
            callback(button)

        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=7)
        box.set_margin_top(12)
        box.set_margin_bottom(12)
        box.set_margin_start(12)
        box.set_margin_end(12)
        box.set_size_request(250, -1)
        box.pack_start(label("CONTROLS", "card-title"), False, False, 2)
        actions = [
            ("speedometer-symbolic", "Bandwidth limit …", self.on_bandwidth),
            ("view-list-symbolic", "Upload slots …", self.on_transfers),
            ("drive-harddisk-symbolic", "Cache retention …", self.on_cache_retention),
            ("folder-remote-symbolic", "Metadata cache …", self.on_metadata_cache),
            ("alarm-symbolic", "Restart cooldown …", self.on_cooldown),
            ("view-refresh-symbolic", "Refresh metadata …", self.on_metadata_refresh),
            ("system-reboot-symbolic", "Safely restart service …", self.on_restart),
            (
                "dialog-password-symbolic",
                "Reauthorize Proton account …",
                self.on_reauthorize,
            ),
        ]
        for icon_name, text, callback in actions:
            button = Gtk.Button()
            add_css(button, "flat-action")
            set_pointer_on_hover(button)
            button.set_tooltip_text(translate(text))
            row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=9)
            row.pack_start(
                Gtk.Image.new_from_icon_name(icon_name, Gtk.IconSize.BUTTON),
                False,
                False,
                0,
            )
            row.pack_start(label(text), True, True, 0)
            button.add(row)
            button.connect("clicked", activate, callback)
            if text == "Reauthorize Proton account …":
                button.set_no_show_all(True)
                button.hide()
                self.reauthorize_menu_button = button
            box.pack_start(button, False, False, 0)
        separator = Gtk.Separator(orientation=Gtk.Orientation.HORIZONTAL)
        separator.set_margin_top(3)
        separator.set_margin_bottom(3)
        box.pack_start(separator, False, False, 0)
        proton_web_button = Gtk.Button()
        add_css(proton_web_button, "flat-action")
        set_pointer_on_hover(proton_web_button)
        proton_web_row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=9)
        proton_web_row.pack_start(
            Gtk.Image.new_from_icon_name("web-browser-symbolic", Gtk.IconSize.BUTTON),
            False,
            False,
            0,
        )
        proton_web_row.pack_start(label("Open Proton Drive on the web"), True, True, 0)
        proton_web_button.add(proton_web_row)
        proton_web_button.set_tooltip_text(translate("Open Proton Drive on the web"))
        proton_web_button.connect("clicked", activate, self.on_open_proton_web)
        box.pack_start(proton_web_button, False, False, 0)
        documentation_button = Gtk.Button()
        add_css(documentation_button, "flat-action")
        set_pointer_on_hover(documentation_button)
        documentation_row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=9)
        documentation_row.pack_start(
            Gtk.Image.new_from_icon_name("help-browser-symbolic", Gtk.IconSize.BUTTON),
            False,
            False,
            0,
        )
        documentation_row.pack_start(label("Documentation …"), True, True, 0)
        documentation_button.add(documentation_row)
        documentation_button.set_tooltip_text(translate("Documentation"))
        documentation_button.connect("clicked", activate, self.on_documentation)
        box.pack_start(documentation_button, False, False, 0)
        preferences_button = Gtk.Button()
        add_css(preferences_button, "flat-action")
        set_pointer_on_hover(preferences_button)
        preferences_row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=9)
        preferences_row.pack_start(
            Gtk.Image.new_from_icon_name("preferences-system-symbolic", Gtk.IconSize.BUTTON),
            False,
            False,
            0,
        )
        preferences_row.pack_start(label("Preferences …"), True, True, 0)
        preferences_button.add(preferences_row)
        preferences_button.set_tooltip_text(translate("Preferences"))
        preferences_button.connect("clicked", activate, self.on_preferences)
        box.pack_start(preferences_button, False, False, 0)
        about_button = Gtk.Button()
        add_css(about_button, "flat-action")
        set_pointer_on_hover(about_button)
        about_row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=9)
        about_row.pack_start(
            Gtk.Image.new_from_icon_name("help-about-symbolic", Gtk.IconSize.BUTTON),
            False,
            False,
            0,
        )
        about_row.pack_start(label("About …"), True, True, 0)
        about_button.add(about_row)
        about_button.set_tooltip_text(translate("About PDrive Control Center"))
        about_button.connect("clicked", activate, self.on_about)
        box.pack_start(about_button, False, False, 0)
        popover.add(box)
        box.show_all()
