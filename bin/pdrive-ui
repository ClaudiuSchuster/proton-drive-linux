    def on_clear_cooldown(self, _button: Gtk.Button) -> None:
        self.run_helper(["pdrive-watch", "--clear-cooldown"], "Restart cooldown")

    def on_metadata_refresh(self, _button: Gtk.Button) -> None:
        if self.confirm(
            "Refresh metadata?",
            "The guarded helper checks the queue and Dirty files first, then asks for confirmation in a terminal.",
        ):
            if self.demo:
                self.message("Metadata refresh", "Action completed.", Gtk.MessageType.INFO)
            else:
                self.launch_terminal("pdrive-refresh --refresh", "Metadata refresh")

    def on_restart(self, _button: Gtk.Button) -> None:
        if self.confirm(
            "Safely restart the service?",
            "An active upload would be interrupted. pdrive-watch checks and validates the new process; final confirmation happens in a terminal.",
        ):
            if self.demo:
                self.message("Safe service restart", "Action completed.", Gtk.MessageType.INFO)
            else:
                self.launch_terminal("pdrive-watch --restart-service", "Safe service restart")

    def run_helper(self, command: list[str], title: str) -> None:
        if self.demo:
            self.message(title, "Action completed.", Gtk.MessageType.INFO)
            return

        def worker() -> None:
            try:
                completed = subprocess.run(command, check=False, capture_output=True, text=True, timeout=30)
                if completed.returncode == 0:
                    output = translate("Action completed.")
                else:
                    output = translate_format(
                        "The helper exited with status {status}. Run {command} in a terminal for its full diagnostic output.",
                        status=completed.returncode,
                        command=" ".join(command),
                    )
                GLib.idle_add(
                    self.helper_finished,
                    title,
                    completed.returncode == 0,
                    output,
                )
            except (OSError, subprocess.TimeoutExpired) as error:
                GLib.idle_add(self.helper_finished, title, False, str(error))

        threading.Thread(target=worker, daemon=True).start()

    def helper_finished(self, title: str, success: bool, output: str) -> bool:
        self.message(title, output, Gtk.MessageType.INFO if success else Gtk.MessageType.ERROR)
        self.request_refresh()
        return GLib.SOURCE_REMOVE

    def launch_terminal(self, command: str, title: str) -> None:
        terminal = shutil.which("x-terminal-emulator") or shutil.which("gnome-terminal")
        if not terminal:
            self.message(title, "No terminal application was found.", Gtk.MessageType.ERROR)
            return
        script = f"{command}; result=$?; printf '\\nPress Enter to close …'; read -r _; exit $result"
        try:
            subprocess.Popen([terminal, "-e", "bash", "-lc", script])
        except OSError as error:
            self.message(title, str(error), Gtk.MessageType.ERROR)

    def confirm(self, title: str, detail: str) -> bool:
        dialog = Gtk.MessageDialog(
            transient_for=self,
            modal=True,
            message_type=Gtk.MessageType.WARNING,
            buttons=Gtk.ButtonsType.CANCEL,
            text=translate(title),
        )
        dialog.format_secondary_text(translate(detail))
        dialog.add_button(translate("Continue"), Gtk.ResponseType.OK)
        response = dialog.run()
        dialog.destroy()
        return response == Gtk.ResponseType.OK

    def message(self, title: str, detail: str, message_type: Gtk.MessageType) -> None:
        dialog = Gtk.MessageDialog(
            transient_for=self,
            modal=True,
            message_type=message_type,
            buttons=Gtk.ButtonsType.OK,
            text=translate(title),
        )
        dialog.format_secondary_text(translate(detail)[:4000])
        dialog.run()
        dialog.destroy()


class PDriveApplication(Gtk.Application):
    def __init__(
        self,
        demo: bool = False,
        background: bool = False,
        demo_page: str = "overview",
    ) -> None:
        global CURRENT_LANGUAGE
        non_unique = demo or os.environ.get("PDRIVE_UI_NON_UNIQUE") == "1"
        flags = Gio.ApplicationFlags.NON_UNIQUE if non_unique else Gio.ApplicationFlags.FLAGS_NONE
        super().__init__(application_id=APP_ID, flags=flags)
        self.demo = demo
        self.demo_page = demo_page
        self.background = background and not demo
        self.preferences = dict(DEFAULT_PREFERENCES) if demo else load_preferences()
        if demo:
            self.preferences.update(
                {
                    "issues_reviewed_errors": 10,
                    "issues_reviewed_notices": 5,
                    "issues_reviewed_at": "demo",
                }
            )
        CURRENT_LANGUAGE = str(self.preferences["language"])
        self.window: PDriveWindow | None = None
        self.initial_activation = True
        self.force_quit = False
        self.indicator: Any = None
        self.status_icon: Gtk.StatusIcon | None = None
        self.tray_held = False

    def do_startup(self) -> None:
        Gtk.Application.do_startup(self)
        GLib.set_application_name("PDrive Control Center")
        Gtk.Window.set_default_icon_name(APP_ID)
        settings = Gtk.Settings.get_default()
        if settings:
            settings.set_property("gtk-application-prefer-dark-theme", True)
        provider = Gtk.CssProvider()
        provider.load_from_data(CSS)
        screen = Gdk.Screen.get_default()
        if screen:
            Gtk.StyleContext.add_provider_for_screen(screen, provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
        self.configure_tray()

    def do_activate(self) -> None:
        was_initial_activation = self.initial_activation
        background_activation = self.initial_activation and self.background
        if self.window is None:
            self.window = PDriveWindow(self, demo=self.demo)
            self.window.show_all()
            if self.demo:
                self.window.stack.set_visible_child_name(self.demo_page)
        if background_activation:
            self.window.hide()
        else:
            self.show_window()
        self.initial_activation = False
        if not was_initial_activation and self.background:
            self.background = False
            self.configure_tray()

    def show_window(self, *_args: Any) -> None:
        if self.window is None:
            self.activate()
            return
        self.window.show_all()
        self.window.present()
        self.window.request_refresh()

    def on_window_delete(self, window: Gtk.Window, _event: Gdk.Event) -> bool:
        if not self.force_quit and self.preferences["close_to_tray"] and not self.demo:
            window.hide()
            return True
        return False

    def tray_menu(self) -> Gtk.Menu:
        menu = Gtk.Menu()
        open_item = Gtk.MenuItem(label=translate("Open PDrive Control Center"))
        open_item.connect("activate", self.show_window)
        menu.append(open_item)
        mount_item = Gtk.MenuItem(label=translate("Open /pdrive"))
        mount_item.connect("activate", self.open_mount_from_tray)
        menu.append(mount_item)
        menu.append(Gtk.SeparatorMenuItem())
        quit_item = Gtk.MenuItem(label=translate("Quit"))
        quit_item.connect("activate", self.quit_from_tray)
        menu.append(quit_item)
        menu.show_all()
        return menu

    def configure_tray(self) -> None:
        wanted = not self.demo and (self.preferences["close_to_tray"] or self.background)
        if wanted and self.indicator is None and self.status_icon is None:
            menu = self.tray_menu()
            if tray_supports_distinct_clicks() or AyatanaAppIndicator3 is None:
                self.status_icon = Gtk.StatusIcon.new_from_icon_name(APP_ID)
                self.status_icon.set_title("PDrive Control Center")
                self.status_icon.connect("activate", self.show_window)
                self.status_icon.connect("popup-menu", self.popup_status_menu, menu)
            else:
                self.indicator = AyatanaAppIndicator3.Indicator.new(
                    APP_ID,
                    APP_ID,
                    AyatanaAppIndicator3.IndicatorCategory.APPLICATION_STATUS,
                )
                self.indicator.set_title("PDrive Control Center")
                self.indicator.set_menu(menu)
        if self.indicator is not None:
            status = (
                AyatanaAppIndicator3.IndicatorStatus.ACTIVE if wanted else AyatanaAppIndicator3.IndicatorStatus.PASSIVE
            )
            self.indicator.set_status(status)
        if self.status_icon is not None:
            self.status_icon.set_visible(wanted)
        if wanted and not self.tray_held:
            self.hold()
            self.tray_held = True
        elif not wanted and self.tray_held:
            self.release()
            self.tray_held = False

    @staticmethod
    def popup_status_menu(
        icon: Gtk.StatusIcon,
        button: int,
        activate_time: int,
        menu: Gtk.Menu,
    ) -> None:
        menu.popup(None, None, Gtk.StatusIcon.position_menu, icon, button, activate_time)

    def update_indicator(self, state: dict[str, Any]) -> None:
        health = state.get("health", {})
        speed = float(state.get("stats", {}).get("speed") or 0)
        status = str(health.get("status", "unknown"))
        tooltip = f"{translate(STATUS_META.get(status, STATUS_META['unknown'])[1])} · {human_rate(speed)}"
        if self.indicator is not None:
            indicator_label = f"↑ {human_rate(speed)}" if speed >= 1024 else ""
            self.indicator.set_label(indicator_label, "↑ 999.9 MiB/s")
            self.indicator.set_title(tooltip)
        if self.status_icon is not None:
            self.status_icon.set_tooltip_text(tooltip)

    def open_mount_from_tray(self, *_args: Any) -> None:
        try:
            Gio.AppInfo.launch_default_for_uri(pathlib.Path("/pdrive").as_uri(), None)
        except GLib.Error as error:
            if self.window is not None:
                self.show_window()
                self.window.message("Could not open mount", str(error), Gtk.MessageType.ERROR)

    def quit_from_tray(self, *_args: Any) -> None:
        self.force_quit = True
        if self.window is not None:
            self.window.closed = True
            self.window.destroy()
            self.window = None
        self.quit()

    def update_preferences(
        self,
        close_to_tray: bool,
        start_in_tray: bool,
        poll_in_background: bool,
        refresh_interval_seconds: int,
        language: str,
    ) -> str | None:
        if self.demo:
            return "Preferences cannot be changed in demo mode."
        new_preferences = dict(self.preferences)
        new_preferences.update(
            {
                "close_to_tray": bool(close_to_tray or start_in_tray),
                "start_in_tray": bool(start_in_tray),
                "poll_in_background": bool(poll_in_background),
                "refresh_interval_seconds": (
                    refresh_interval_seconds
                    if refresh_interval_seconds in REFRESH_INTERVAL_OPTIONS
                    else REFRESH_INTERVAL_SECONDS
                ),
                "language": language if language in SUPPORTED_LANGUAGES else "en",
            }
        )
        old_preferences = dict(self.preferences)
        try:
            self.sync_autostart(new_preferences["start_in_tray"])
            atomic_write(
                preferences_path(),
                json.dumps(new_preferences, indent=2, sort_keys=True) + "\n",
                0o600,
            )
        except OSError as error:
            try:
                self.sync_autostart(old_preferences["start_in_tray"])
            except OSError:
                pass
            return str(error)
        self.preferences = new_preferences
        self.background = False
        self.configure_tray()
        if self.window is not None:
            self.window.schedule_dashboard_timer()
        return None

    def mark_issues_reviewed(self, watchdog: dict[str, Any]) -> str | None:
        if self.demo:
            return "Preferences cannot be changed in demo mode."
        old_preferences = dict(self.preferences)
        new_preferences = dict(self.preferences)
        new_preferences.update(
            {
                "issues_reviewed_errors": max(0, int(watchdog.get("errors") or 0)),
                "issues_reviewed_notices": max(0, int(watchdog.get("notices") or 0)),
                "issues_reviewed_at": str(
                    watchdog.get("generated_at") or dt.datetime.now().astimezone().isoformat(timespec="seconds")
                ),
            }
        )
        try:
            atomic_write(
                preferences_path(),
                json.dumps(new_preferences, indent=2, sort_keys=True) + "\n",
                0o600,
            )
        except OSError as error:
            self.preferences = old_preferences
            return str(error)
        self.preferences = new_preferences
        return None

    @staticmethod
    def sync_autostart(enabled: bool) -> None:
        path = autostart_path()
        if enabled:
            if path.exists():
                try:
                    existing = path.read_text(encoding="utf-8")
                except OSError as error:
                    raise OSError(f"Could not inspect the existing autostart file: {error}") from error
                if AUTOSTART_MARKER not in existing:
                    raise OSError(f"Refusing to overwrite an unmarked autostart file: {path}")
            atomic_write(path, autostart_contents(), 0o600)
            return
        if not path.exists():
            return
        try:
            existing = path.read_text(encoding="utf-8")
        except OSError as error:
            raise OSError(f"Could not inspect the existing autostart file: {error}") from error
        if AUTOSTART_MARKER in existing:
            path.unlink()


def demo_state() -> dict[str, Any]:
    now = dt.datetime.now().astimezone().isoformat(timespec="seconds")
    phase = (dt.datetime.now().timestamp() % 20) / 20
    size = 24_923_023_360
    done = int(size * (0.38 + phase * 0.12))
    speed = 4_404_019 + math.sin(phase * math.pi * 2) * 380_000
    active = {
        "name": "Projects/Linux Mint VM/disks/system.qcow2",
        "size": size,
        "bytes": done,
        "percentage": done * 100 / size,
        "speed": speed,
        "eta_seconds": int((size - done) / speed),
        "error": "",
    }
    queue_items = [
        {"name": active["name"], "size": size, "tries": 1, "uploading": True},
