        manual_note.set_margin_start(24)
        manual_outer.pack_start(manual_note, False, False, 0)
        self.setup_manual_scales = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=5)
        self.setup_manual_scales.set_margin_start(24)
