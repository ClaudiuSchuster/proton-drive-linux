        save_button = dialog.get_widget_for_response(Gtk.ResponseType.OK)
        save_button.set_sensitive(False)
        scale.connect(
            "value-changed",
            lambda current_scale: save_button.set_sensitive(
                round(current_scale.get_value()) != current
            ),
        )
        dialog.show_all()
        response = dialog.run()
        value = round(scale.get_value())
        dialog.destroy()
