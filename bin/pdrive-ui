def translate(text: str) -> str:
    if CURRENT_LANGUAGE == "de":
        return GERMAN_TRANSLATIONS.get(text, text)
    return text


def translate_format(text: str, **values: Any) -> str:
    return translate(text).format(**values)


def xdg_path(environment_name: str, fallback: pathlib.Path) -> pathlib.Path:
    configured = os.environ.get(environment_name)
    return pathlib.Path(configured).expanduser() if configured else fallback


def preferences_path() -> pathlib.Path:
    return xdg_path("XDG_CONFIG_HOME", pathlib.Path.home() / ".config") / "pdrive-ui.json"


def autostart_path() -> pathlib.Path:
    return xdg_path("XDG_CONFIG_HOME", pathlib.Path.home() / ".config") / "autostart" / f"{APP_ID}.desktop"


def setup_config_path() -> pathlib.Path:
    configured = os.environ.get("PDRIVE_RCLONE_CONFIG")
    return pathlib.Path(configured).expanduser() if configured else pathlib.Path.home() / ".config/rclone/rclone.conf"


def reauth_backend_path() -> str:
    configured = os.environ.get("PDRIVE_REAUTH_BACKEND")
    if configured:
        return configured
    installed = pathlib.Path.home() / ".local/libexec/reauth-rclone-proton"
    if installed.is_file() and os.access(installed, os.X_OK):
        return str(installed)
    return str(pathlib.Path(__file__).resolve().parent.parent / "libexec/reauth-rclone-proton")


def account_switch_backend_path() -> str:
    configured = os.environ.get("PDRIVE_ACCOUNT_SWITCH_BACKEND")
    if configured:
        return configured
    installed = pathlib.Path.home() / ".local/libexec/switch-rclone-proton-account"
    if installed.is_file() and os.access(installed, os.X_OK):
        return str(installed)
    return str(pathlib.Path(__file__).resolve().parent.parent / "libexec/switch-rclone-proton-account")


def mount_path() -> pathlib.Path:
    return pathlib.Path(os.environ.get("PDRIVE_MOUNT_DIR", "/pdrive")).expanduser()


def resolve_command(environment_name: str, executable: str) -> str:
    configured = os.environ.get(environment_name)
    if configured:
        return configured
    installed = shutil.which(executable)
    if installed:
        return installed
    return str(pathlib.Path(__file__).with_name(executable))


def automatic_package_install_supported() -> bool:
    if not pathlib.Path("/usr/bin/pkexec").is_file() or not pathlib.Path("/usr/bin/apt-get").is_file():
        return False
    try:
        release = pathlib.Path("/etc/os-release").read_text(encoding="utf-8").lower()
    except OSError:
        return False
    return any(identifier in release for identifier in ("debian", "ubuntu", "linuxmint"))


def setup_readiness() -> dict[str, Any]:
    missing_commands = [command for command in REQUIRED_RUNTIME_COMMANDS if shutil.which(command) is None]
    real_rclone = pathlib.Path(
        os.environ.get("PDRIVE_REAL_RCLONE", pathlib.Path.home() / ".local/libexec/rclone-bin")
    ).expanduser()
    rclone_present = real_rclone.is_file() and os.access(real_rclone, os.X_OK)
    rclone_ready = False
    if rclone_present:
        try:
            rclone_ready = (
                subprocess.run(
                    [
                        resolve_command("PDRIVE_PREREQUISITES_BIN", "pdrive-prerequisites"),
                        "--check",
                    ],
                    check=False,
                    stdout=subprocess.DEVNULL,
                    stderr=subprocess.DEVNULL,
                    timeout=8,
                ).returncode
                == 0
            )
        except (OSError, subprocess.TimeoutExpired):
            pass
    mount = mount_path()
    try:
        mount_ready = mount.is_dir() and not mount.is_symlink() and mount.stat().st_uid == os.getuid()
    except OSError:
        mount_ready = False
    return {
        "commands_ready": not missing_commands,
        "missing_commands": missing_commands,
        "rclone_present": rclone_present,
        "rclone_ready": rclone_ready,
        "real_rclone": str(real_rclone),
        "mount_ready": mount_ready,
        "mount": str(mount),
        "ready": not missing_commands and rclone_ready and mount_ready,
        "automatic": automatic_package_install_supported(),
    }


def documentation_path(installed_name: str, repository_relative: str) -> pathlib.Path | None:
    data_home = xdg_path("XDG_DATA_HOME", pathlib.Path.home() / ".local" / "share")
    source_candidate = pathlib.Path(__file__).resolve().parent.parent / repository_relative
    candidates = (
        source_candidate,
        data_home / "doc" / "proton-drive-linux" / installed_name,
        pathlib.Path("/usr/share/doc/proton-drive-linux") / installed_name,
    )
    for candidate in candidates:
        if candidate.is_file():
            return candidate
    return None


def tray_supports_distinct_clicks() -> bool:
    display = Gdk.Display.get_default()
    return display is not None and type(display).__name__ == "X11Display"


def atomic_write(path: pathlib.Path, content: str, mode: int) -> None:
    path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    descriptor, temporary_name = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    temporary = pathlib.Path(temporary_name)
    try:
        with os.fdopen(descriptor, "w", encoding="utf-8") as stream:
            stream.write(content)
            stream.flush()
            os.fsync(stream.fileno())
        temporary.chmod(mode)
        os.replace(temporary, path)
    finally:
        temporary.unlink(missing_ok=True)


def load_preferences() -> dict[str, Any]:
    preferences = dict(DEFAULT_PREFERENCES)
    try:
        payload = json.loads(preferences_path().read_text(encoding="utf-8"))
        for key in ("close_to_tray", "start_in_tray", "poll_in_background"):
            if isinstance(payload.get(key), bool):
                preferences[key] = payload[key]
        if payload.get("refresh_interval_seconds") in REFRESH_INTERVAL_OPTIONS:
            preferences["refresh_interval_seconds"] = payload["refresh_interval_seconds"]
        if payload.get("notification_policy") in NOTIFICATION_POLICIES:
            preferences["notification_policy"] = payload["notification_policy"]
        if payload.get("language") in SUPPORTED_LANGUAGES:
            preferences["language"] = payload["language"]
        for key in ("issues_reviewed_errors", "issues_reviewed_notices"):
            if isinstance(payload.get(key), int) and not isinstance(payload.get(key), bool):
                preferences[key] = max(-1, payload[key])
        if isinstance(payload.get("issues_reviewed_at"), str):
            preferences["issues_reviewed_at"] = payload["issues_reviewed_at"]
    except (FileNotFoundError, OSError, json.JSONDecodeError, AttributeError):
        pass
    if preferences["start_in_tray"]:
        preferences["close_to_tray"] = True
    return preferences


def issue_event_time(
    event: dict[str, Any],
    timestamp_keys: tuple[str, ...],
) -> dt.datetime:
    """Return the first usable event timestamp for filtering and ordering."""

    event_timestamp = next((str(event.get(key) or "") for key in timestamp_keys if event.get(key)), "")
    try:
        event_time = dt.datetime.fromisoformat(event_timestamp)
    except ValueError:
        return dt.datetime.min.replace(tzinfo=dt.timezone.utc)
    if event_time.tzinfo is None:
        event_time = event_time.replace(tzinfo=dt.timezone.utc)
    return event_time


def sort_issue_events(events: list[dict[str, Any]]) -> list[dict[str, Any]]:
    """Order issue rows by their visible timestamp, newest first."""

    return sorted(
        events,
        key=lambda event: issue_event_time(event, ("resolved_at", "last_seen", "timestamp")),
        reverse=True,
    )


def event_is_after_review(
    preferences: dict[str, Any],
    event: dict[str, Any],
    timestamp_keys: tuple[str, ...],
) -> bool:
    """Return whether the event timestamp is newer than the review watermark."""

    reviewed_at = str(preferences.get("issues_reviewed_at") or "")
    if not reviewed_at:
        return False
    try:
        reviewed_time = dt.datetime.fromisoformat(reviewed_at)
    except ValueError:
        reviewed_time = dt.datetime.min.replace(tzinfo=dt.timezone.utc)
    event_time = issue_event_time(event, timestamp_keys)
    if reviewed_time.tzinfo is None:
        reviewed_time = reviewed_time.replace(tzinfo=dt.timezone.utc)
    return event_time > reviewed_time


def unreviewed_events(preferences: dict[str, Any], issues: dict[str, Any]) -> list[dict[str, Any]]:
    """Return consolidated incidents observed after the review watermark."""

    raw_events = issues.get("events", [])
    if not isinstance(raw_events, list):
        return []
    selected = []
    for event in raw_events:
        if not isinstance(event, dict):
            continue
        if str(event.get("lifecycle") or "active") == "resolved":
            continue
        if event_is_after_review(preferences, event, ("last_seen", "timestamp")):
            selected.append(event)
    return sort_issue_events(selected)


def resolved_events(issues: dict[str, Any], limit: int = 5) -> list[dict[str, Any]]:
    raw_events = issues.get("events", [])
    if not isinstance(raw_events, list):
        return []
    return sort_issue_events(
        [event for event in raw_events if isinstance(event, dict) and str(event.get("lifecycle") or "") == "resolved"]
    )[:limit]


def unreviewed_recovery_events(
    preferences: dict[str, Any],
    issues: dict[str, Any],
    limit: int = 5,
) -> list[dict[str, Any]]:
    """Return resolved incidents whose recovery has not been reviewed yet."""

    raw_events = issues.get("events", [])
    if not isinstance(raw_events, list):
        return []
    return sort_issue_events(
        [
            event
            for event in raw_events
            if isinstance(event, dict)
            and str(event.get("lifecycle") or "") == "resolved"
            and event_is_after_review(preferences, event, ("resolved_at", "last_seen", "timestamp"))
        ]
    )[:limit]


def issues_since_review(preferences: dict[str, Any], issues: dict[str, Any]) -> tuple[int, int]:
    events = unreviewed_events(preferences, issues)
    errors = sum(1 for event in events if str(event.get("level") or "").lower() in {"error", "critical"})
    notices = sum(1 for event in events if str(event.get("level") or "").lower() == "notice")
    return errors, notices


def unreviewed_issue_events(
    preferences: dict[str, Any],
    issues: dict[str, Any],
) -> tuple[list[dict[str, Any]], int]:
    """Select consolidated issue details newer than the review watermark."""

    return unreviewed_events(preferences, issues), 0


def network_counter_rate(
    previous: tuple[int, int, float] | None,
    network_io: dict[str, Any],
    pid: int,
    now: float,
    counter_name: str,
    fixture_speed_name: str,
) -> tuple[float, tuple[int, int, float] | None]:
    """Derive honest process traffic from cumulative Linux TCP counters."""

    if fixture_speed_name in network_io:
        return max(0.0, float(network_io.get(fixture_speed_name) or 0)), previous
    if not network_io.get("available") or pid <= 0:
        return 0.0, None
    counter = max(0, int(network_io.get(counter_name) or 0))
    current = (pid, counter, now)
    if previous is None:
        return 0.0, current
    previous_pid, previous_counter, previous_time = previous
    elapsed = now - previous_time
    if previous_pid != pid or counter < previous_counter or elapsed < 0.25 or elapsed > 10:
        return 0.0, current
    return (counter - previous_counter) / elapsed, current


def network_send_rate(
    previous: tuple[int, int, float] | None,
    network_io: dict[str, Any],
    pid: int,
    now: float,
) -> tuple[float, tuple[int, int, float] | None]:
    """Derive PDrive upload bytes/second from process-owned TCP counters."""

    return network_counter_rate(previous, network_io, pid, now, "sent_bytes", "send_speed")


def network_receive_rate(
    previous: tuple[int, int, float] | None,
    network_io: dict[str, Any],
    pid: int,
    now: float,
) -> tuple[float, tuple[int, int, float] | None]:
    """Derive PDrive receive bytes/second from process-owned TCP counters."""

    return network_counter_rate(previous, network_io, pid, now, "received_bytes", "receive_speed")


def upload_eta_ready(
    samples: int,
    rate: float,
    last_progress: float,
    sample_time: float,
    refresh_interval: int,
) -> bool:
    stale_after = max(30, refresh_interval * 3)
    return samples >= 3 and rate > 0 and sample_time - last_progress <= stale_after


def backend_transfer_metrics(item: dict[str, Any]) -> tuple[float, int]:
    """Return rclone's estimate only when its speed and ETA agree."""

    size = max(0, int(item.get("size") or 0))
    done = min(size, max(0, int(item.get("bytes") or 0)))
    remaining = max(0, size - done)
    speed = max(0.0, float(item.get("speed") or 0))
    eta = int(item.get("eta_seconds") or -1)
    if remaining <= 0 or speed < 1024 or eta <= 0:
        return 0.0, -1
    calculated = remaining / speed
    if calculated <= 0 or max(calculated, eta) / min(calculated, eta) > 4:
        return 0.0, -1
    return speed, eta


def verified_single_transfer_metrics(
    transfers: dict[str, Any],
    queue: dict[str, Any],
    current_speed: float,
    smoothed_rate: float,
    estimate_ready: bool,
) -> dict[str, Any] | None:
    """Share one validated estimator when exactly one queued transfer matches."""

    active_items = transfers.get("active", [])
    queue_items = queue.get("items", [])
    if not isinstance(active_items, list) or not isinstance(queue_items, list):
        return None
    if int(queue.get("count") or 0) != 1 or len(active_items) != 1 or len(queue_items) != 1:
        return None
    active = active_items[0]
    queued = queue_items[0]
    if not isinstance(active, dict) or not isinstance(queued, dict) or not queued.get("uploading"):
        return None
    if str(active.get("name") or "") != str(queued.get("name") or ""):
        return None
    remaining = max(0, int(queue.get("remaining_bytes", queue.get("bytes", 0)) or 0))
    return {
        "speed": max(0.0, current_speed),
        "eta_seconds": int(remaining / smoothed_rate) if estimate_ready and smoothed_rate > 0 else -1,
        "estimate_ready": estimate_ready,
    }


def bandwidth_rate_components(rate: str) -> tuple[str, str]:
    normalized = rate.strip()
    if normalized.lower() in {"", "off", "0"}:
        return "off", "off"
    if ":" in normalized:
        upload, download = normalized.split(":", 1)
        return upload.strip(), download.strip()
    return normalized, normalized


def bandwidth_slider_position(rate: str, direction: str = "upload") -> float:
    upload, download = bandwidth_rate_components(rate)
    component = download if direction == "download" else upload
    if component.lower() in {"", "off", "0"}:
        return BANDWIDTH_SLIDER_UNLIMITED
    match = re.fullmatch(r"([0-9]+(?:\.[0-9]+)?)([bkmgtp]?)(?:i?b?)?", component, re.IGNORECASE)
    if match is None:
        return BANDWIDTH_SLIDER_UNLIMITED
    value = float(match.group(1))
    unit = match.group(2).upper()
    factors = {
        "": 1.0,
        "B": 1 / (1024 * 1024),
        "K": 1 / 1024,
        "M": 1.0,
        "G": 1024.0,
        "T": 1024.0 * 1024.0,
        "P": 1024.0 * 1024.0 * 1024.0,
    }
    value *= factors.get(unit, 1.0)
    if value <= BANDWIDTH_NEAR_PAUSE_MIB:
        return 0.0
    value = min(BANDWIDTH_SLIDER_MAX_RATE, value)
    return (
        100.0
        * math.log(value / BANDWIDTH_NEAR_PAUSE_MIB)
        / math.log(BANDWIDTH_SLIDER_MAX_RATE / BANDWIDTH_NEAR_PAUSE_MIB)
    )


def bandwidth_slider_rate(position: float) -> float:
    position = max(0.0, min(100.0, position))
    return BANDWIDTH_NEAR_PAUSE_MIB * (BANDWIDTH_SLIDER_MAX_RATE / BANDWIDTH_NEAR_PAUSE_MIB) ** (position / 100.0)


def bandwidth_slider_label(position: float) -> str:
    if position >= BANDWIDTH_SLIDER_UNLIMITED - 0.05:
        return f"{translate('Unlimited')} (off/0)"
    if position <= 0.05:
        return "⏸ ≈0 · 0.02 MiB/s"
    rate = bandwidth_slider_rate(position)
    digits = 2 if rate < 1 else 1
    return f"{rate:.{digits}f} MiB/s"


def bandwidth_slider_component(position: float) -> str:
    if position >= BANDWIDTH_SLIDER_UNLIMITED - 0.05:
        return "off"
    if position <= 0.05:
        return f"{BANDWIDTH_NEAR_PAUSE_MIB:.2f}"
    rate = bandwidth_slider_rate(position)
    digits = 2 if rate < 1 else 1
    return f"{rate:.{digits}f}".rstrip("0").rstrip(".")


def bandwidth_slider_command(position: float, download_position: float | None = None) -> str:
    upload = bandwidth_slider_component(position)
    if download_position is None:
        return upload
    download = bandwidth_slider_component(download_position)
    if upload == "off" and download == "off":
        return "off"
    return f"{upload}:{download}"


def autostart_contents() -> str:
    return "\n".join(
        (
            "[Desktop Entry]",
            "Type=Application",
            "Name=PDrive Control Center",
            "Comment=Proton Drive health, queue and transfers",
            "Exec=pdrive-ui --background",
            "TryExec=pdrive-ui",
            f"Icon={APP_ID}",
            "Terminal=false",
            "StartupNotify=false",
            "X-GNOME-Autostart-enabled=true",
            AUTOSTART_MARKER,
            "",
        )
    )


