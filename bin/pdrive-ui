        add_css(self.copy_short_status_button, "flat-action", "card-action")
        live_heading.pack_end(self.copy_short_status_button, False, False, 0)
        self.live_summary_box.pack_start(live_heading, False, False, 0)
        self.live_summary = label("No live data yet.", "section-subtitle")
        self.live_summary.set_line_wrap(True)
        self.live_summary.set_selectable(True)
