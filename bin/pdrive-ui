def argument_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="pdrive-ui",
        description="Native local interface for the existing proton-drive-linux service.",
    )
    parser.add_argument(
        "--demo",
        action="store_true",
        help="open the interface with synthetic sample data",
    )
    parser.add_argument(
        "--demo-page",
        choices=("overview", "transfers", "history"),
        default="overview",
        help="select the initial page for --demo",
    )
    parser.add_argument(
        "--demo-dialog",
        choices=("preferences-account", "account-switch"),
        default="",
        help="open one deterministic documentation dialog for --demo",
    )
    parser.add_argument(
        "--background",
        action="store_true",
        help="keep the window hidden in the tray during desktop-session startup",
    )
    parser.add_argument(
        "--check",
        action="store_true",
        help="check GTK and the state helper without opening a window",
    )
    parser.add_argument("--version", action="version", version=f"%(prog)s {VERSION}")
    return parser


def main() -> int:
    parser = argument_parser()
    args = parser.parse_args()
    if args.demo and args.background:
        parser.error("--demo and --background cannot be combined")
    if not args.demo and args.demo_page != "overview":
        parser.error("--demo-page requires --demo")
    if not args.demo and args.demo_dialog:
        parser.error("--demo-dialog requires --demo")
    if args.check:
        state_command = PDriveWindow.find_state_command()
        if not pathlib.Path(state_command).is_file() and not shutil.which(state_command):
            print(f"pdrive-state not found: {state_command}", file=sys.stderr)
            return 69
        if tray_supports_distinct_clicks():
            tray_backend = "GTK StatusIcon (left-click open, right-click menu)"
        elif AyatanaAppIndicator3 is not None:
            tray_backend = "Ayatana AppIndicator"
        else:
            tray_backend = "GTK StatusIcon fallback"
        print(
            f"GTK {Gtk.get_major_version()}.{Gtk.get_minor_version()}.{Gtk.get_micro_version()}; "
            f"tray {tray_backend}; pdrive-state {state_command}"
        )
        return 0
    application = PDriveApplication(
        demo=args.demo,
        background=args.background,
        demo_page=args.demo_page,
        demo_dialog=args.demo_dialog,
    )
    try:
        return application.run([])
    except KeyboardInterrupt:
        return 130


if __name__ == "__main__":
    raise SystemExit(main())
