        self.bandwidth_progress = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=9)
        self.bandwidth_progress.set_no_show_all(True)
        self.bandwidth_spinner = Gtk.Spinner()
        self.bandwidth_progress.pack_start(self.bandwidth_spinner, False, False, 0)
        self.bandwidth_progress_label = label("Measuring upload and download …", "section-subtitle")
        self.bandwidth_progress.pack_start(self.bandwidth_progress_label, False, False, 0)
        page.pack_start(self.bandwidth_progress, False, False, 0)
