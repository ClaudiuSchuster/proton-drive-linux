def human_bytes(value: Any) -> str:
    try:
        amount = float(value)
    except (TypeError, ValueError):
        return "–"
    units = ("B", "KiB", "MiB", "GiB", "TiB")
    for unit in units:
        if abs(amount) < 1024.0 or unit == units[-1]:
            digits = 0 if unit == "B" else 1
            return f"{amount:.{digits}f} {unit}"
        amount /= 1024.0
    return "–"


def human_rate(value: Any) -> str:
    try:
        amount = float(value)
    except (TypeError, ValueError):
        return "–"
    return f"{human_bytes(amount)}/s"


def human_duration(value: Any) -> str:
    try:
        seconds = int(value)
    except (TypeError, ValueError):
        return "–"
    if seconds < 0:
        return "–"
    if seconds < 60:
        return f"{seconds}s"
    if seconds < 3600:
        return f"{seconds // 60}m {seconds % 60}s"
    if seconds < 86400:
        return f"{seconds // 3600}h {(seconds % 3600) // 60}m"
    return f"{seconds // 86400}d {(seconds % 86400) // 3600}h"


def approximate_duration(value: Any) -> str:
    try:
        seconds = max(0, int(value))
    except (TypeError, ValueError):
        return "–"
    if seconds < 90:
        return f"~{seconds}s"
    if seconds < 5400:
        return f"~{round(seconds / 60)}m"
    return f"~{round(seconds / 3600)}h"


def short_name(path: str, limit: int = 72) -> str:
    if len(path) <= limit:
        return path
    parts = pathlib.PurePosixPath(path).parts
    tail = "/".join(parts[-2:]) if len(parts) >= 2 else path[-limit:]
    return f"…/{tail}" if len(tail) < limit else f"…{tail[-limit + 1 :]}"


def local_time(value: str) -> str:
    if not value:
        return "–"
    try:
        parsed = dt.datetime.fromisoformat(value.replace("Z", "+00:00"))
        time_format = "%d.%m. %H:%M" if CURRENT_LANGUAGE == "de" else "%b %d, %H:%M"
        return parsed.astimezone().strftime(time_format)
    except ValueError:
        return value


def label(text: str = "", css: str | None = None, xalign: float = 0.0) -> Gtk.Label:
    widget = Gtk.Label(label=translate(text), xalign=xalign)
    if css:
        widget.get_style_context().add_class(css)
    return widget


def add_css(widget: Gtk.Widget, *classes: str) -> Gtk.Widget:
    context = widget.get_style_context()
    for css_class in classes:
        context.add_class(css_class)
    return widget


def set_pointer_on_hover(widget: Gtk.Widget) -> None:
    """Give an ordinary GTK control an explicit link-style pointer cursor."""

    def update_cursor(control: Gtk.Widget, active: bool) -> bool:
        event_window = control.get_window()
        if event_window is None:
            return False
        if not active:
            event_window.set_cursor(None)
            return False
        display = event_window.get_display()
        cursor = Gdk.Cursor.new_from_name(display, "pointer")
        if cursor is None:
            cursor = Gdk.Cursor.new_for_display(display, Gdk.CursorType.HAND2)
        event_window.set_cursor(cursor)
        return False

    widget.add_events(Gdk.EventMask.ENTER_NOTIFY_MASK | Gdk.EventMask.LEAVE_NOTIFY_MASK)
    widget.connect("enter-notify-event", lambda control, _event: update_cursor(control, True))
    widget.connect("leave-notify-event", lambda control, _event: update_cursor(control, False))


def card(child: Gtk.Widget, *classes: str) -> Gtk.Frame:
    frame = Gtk.Frame()
    frame.set_shadow_type(Gtk.ShadowType.NONE)
    add_css(frame, "card", *classes)
    frame.add(child)
    return frame


class StatCard(Gtk.EventBox):
    def __init__(self, title: str, icon_name: str) -> None:
        super().__init__()
        self.set_visible_window(False)
        self.frame = Gtk.Frame()
        self.frame.set_shadow_type(Gtk.ShadowType.NONE)
        add_css(self.frame, "card", "card-surface")
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        title_row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=7)
        icon = Gtk.Image.new_from_icon_name(icon_name, Gtk.IconSize.MENU)
        icon.get_style_context().add_class("accent")
        title_row.pack_start(icon, False, False, 0)
        self.title_label = label(title.upper(), "card-title")
        self.title_label.set_ellipsize(Pango.EllipsizeMode.END)
        title_row.pack_start(self.title_label, True, True, 0)
        self.title_row = title_row
        self.action_button: Gtk.Button | None = None
        self.navigation_callback: Any | None = None
        self.value = label("–", "card-value")
        self.detail = label("", "card-detail")
        self.detail.set_ellipsize(3)
        box.pack_start(title_row, False, False, 0)
        box.pack_start(self.value, False, False, 0)
        box.pack_start(self.detail, False, False, 0)
        self.frame.add(box)
        self.add(self.frame)

    def make_navigable(self, tooltip: str, callback: Any) -> None:
        self.navigation_callback = callback
        self.set_above_child(True)
        self.set_can_focus(True)
        self.set_tooltip_text(translate(tooltip))
        self.add_events(
            Gdk.EventMask.BUTTON_PRESS_MASK
            | Gdk.EventMask.BUTTON_RELEASE_MASK
            | Gdk.EventMask.ENTER_NOTIFY_MASK
            | Gdk.EventMask.LEAVE_NOTIFY_MASK
            | Gdk.EventMask.FOCUS_CHANGE_MASK
        )
        self.connect("enter-notify-event", self.on_pointer_enter)
        self.connect("leave-notify-event", self.on_pointer_leave)
        self.connect("button-press-event", self.on_button_press)
        self.connect("button-release-event", self.on_button_release)
        self.connect("focus-in-event", self.on_focus_in)
        self.connect("focus-out-event", self.on_focus_out)
        self.connect("key-release-event", self.on_key_release)
        add_css(self, "interactive-card")
        chevron = Gtk.Image.new_from_icon_name("go-next-symbolic", Gtk.IconSize.MENU)
        add_css(chevron, "card-link-icon")
        self.title_row.pack_end(chevron, False, False, 0)

    def activate_navigation(self) -> bool:
        if self.navigation_callback is None:
            return False
        self.navigation_callback()
        return True

    def set_frame_state(self, css_class: str, active: bool) -> None:
        context = self.frame.get_style_context()
        if active:
            context.add_class(css_class)
        else:
            context.remove_class(css_class)

    def set_pointer_cursor(self, active: bool) -> None:
        event_window = self.get_window()
        if event_window is None:
            return
        if not active:
            event_window.set_cursor(None)
            return
        display = event_window.get_display()
        cursor = Gdk.Cursor.new_from_name(display, "pointer")
        if cursor is None:
            cursor = Gdk.Cursor.new_for_display(display, Gdk.CursorType.HAND2)
        event_window.set_cursor(cursor)

    def on_pointer_enter(self, _widget: Gtk.Widget, _event: Gdk.EventCrossing) -> bool:
        self.set_frame_state("card-hover", True)
        self.set_pointer_cursor(True)
        return False

    def on_pointer_leave(self, _widget: Gtk.Widget, _event: Gdk.EventCrossing) -> bool:
        self.set_frame_state("card-hover", False)
        self.set_frame_state("card-pressed", False)
        self.set_pointer_cursor(False)
        return False

    def on_button_press(self, _widget: Gtk.Widget, event: Gdk.EventButton) -> bool:
        self.set_frame_state("card-pressed", event.button == 1)
        return False

    def on_button_release(self, _widget: Gtk.Widget, event: Gdk.EventButton) -> bool:
        self.set_frame_state("card-pressed", False)
        return bool(event.button == 1 and self.activate_navigation())

    def on_focus_in(self, _widget: Gtk.Widget, _event: Gdk.EventFocus) -> bool:
        self.set_frame_state("card-keyboard-focus", True)
        return False

    def on_focus_out(self, _widget: Gtk.Widget, _event: Gdk.EventFocus) -> bool:
        self.set_frame_state("card-keyboard-focus", False)
        self.set_frame_state("card-pressed", False)
        return False

    def on_key_release(self, _widget: Gtk.Widget, event: Gdk.EventKey) -> bool:
        if event.keyval in (Gdk.KEY_Return, Gdk.KEY_KP_Enter, Gdk.KEY_space):
            return self.activate_navigation()
        return False

    def update(self, value: str, detail: str = "") -> None:
        self.value.set_text(value)
        self.detail.set_text(detail)

    def make_compact(self) -> None:
        add_css(self.frame, "compact-card")
        self.title_label.set_max_width_chars(7)
        self.detail.set_max_width_chars(11)

    def add_action(
        self,
        icon_name: str,
        tooltip: str,
        callback: Any,
    ) -> Gtk.Button:
        button = Gtk.Button.new_from_icon_name(icon_name, Gtk.IconSize.MENU)
        button.set_relief(Gtk.ReliefStyle.NONE)
        button.set_tooltip_text(translate(tooltip))
        button.connect("clicked", callback)
        add_css(button, "flat-action", "card-action")
        self.title_row.pack_end(button, False, False, 0)
        self.action_button = button
        return button


class StorageCard(Gtk.EventBox):
    def __init__(self) -> None:
        super().__init__()
        self.set_visible_window(False)
        frame = Gtk.Frame()
        frame.set_shadow_type(Gtk.ShadowType.NONE)
        add_css(frame, "card", "card-surface")
        self.frame = frame
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=7)
        title_row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=7)
        icon = Gtk.Image.new_from_icon_name("drive-harddisk-symbolic", Gtk.IconSize.MENU)
        add_css(icon, "accent")
        title_row.pack_start(icon, False, False, 0)
        title_row.pack_start(label("CAPACITY", "card-title"), True, True, 0)
        box.pack_start(title_row, False, False, 0)

        metrics = Gtk.Grid(column_spacing=16)
        metrics.set_column_homogeneous(True)
        remote_box, self.remote_value, self.remote_detail = self.metric("PROTON CLOUD")
        local_box, self.local_value, self.local_detail = self.metric("LOCAL CACHE DISK")
        metrics.attach(remote_box, 0, 0, 1, 1)
        metrics.attach(local_box, 1, 0, 1, 1)
        box.pack_start(metrics, False, False, 0)
        frame.add(box)
        self.add(frame)

    @staticmethod
    def metric(title: str) -> tuple[Gtk.Box, Gtk.Label, Gtk.Label]:
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        box.pack_start(label(title, "card-title"), False, False, 0)
        value = label("–", "storage-value")
        detail = label("", "card-detail")
        detail.set_ellipsize(Pango.EllipsizeMode.END)
        box.pack_start(value, False, False, 0)
        box.pack_start(detail, False, False, 0)
        return box, value, detail

    def update(
        self,
        remote: dict[str, Any],
        local_free: int,
        cache_used: int,
    ) -> None:
        if remote.get("available"):
            self.remote_value.set_text(translate_format("{free} free", free=human_bytes(remote.get("free_bytes", 0))))
            self.remote_detail.set_text(
                translate_format(
                    "{used} used / {total} total",
                    used=human_bytes(remote.get("used_bytes", 0)),
                    total=human_bytes(remote.get("total_bytes", 0)),
                )
            )
        else:
            self.remote_value.set_text("–")
            self.remote_detail.set_text(translate("Refreshing cloud capacity …"))
        self.local_value.set_text(translate_format("{free} free", free=human_bytes(local_free)))
        self.local_detail.set_text(translate_format("{cache} VFS cache used", cache=human_bytes(cache_used)))


class SpeedGraph(Gtk.DrawingArea):
    def __init__(self, color: tuple[float, float, float] = (0.31, 0.80, 0.97)) -> None:
        super().__init__()
        self.set_size_request(-1, 112)
        self.color = color
        self.samples: collections.deque[float] = collections.deque(maxlen=150)
        self.connect("draw", self.on_draw)

    def push(self, value: float) -> None:
        self.samples.append(max(0.0, value))
        self.queue_draw()

    def on_draw(self, _widget: Gtk.Widget, cr: Any) -> bool:
        allocation = self.get_allocation()
        width, height = allocation.width, allocation.height
        cr.set_source_rgba(1, 1, 1, 0.045)
        cr.set_line_width(1)
        for fraction in (0.25, 0.5, 0.75):
            y = height * fraction
            cr.move_to(0, y)
            cr.line_to(width, y)
            cr.stroke()
        values = list(self.samples)
        if len(values) < 2:
            return False
        peak = max(max(values), 1024.0)
        step = width / max(1, len(values) - 1)
        points = [(index * step, height - (value / peak) * (height - 10) - 5) for index, value in enumerate(values)]
        cr.move_to(points[0][0], height)
        for x, y in points:
            cr.line_to(x, y)
        cr.line_to(points[-1][0], height)
        cr.close_path()
        cr.set_source_rgba(*self.color, 0.16)
        cr.fill()
        cr.move_to(*points[0])
        for x, y in points[1:]:
            cr.line_to(x, y)
        cr.set_source_rgb(*self.color)
        cr.set_line_width(2.2)
        cr.stroke()
        return False


class EmptyState(Gtk.Box):
    def __init__(self, icon_name: str, title: str, detail: str) -> None:
        super().__init__(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        self.set_valign(Gtk.Align.CENTER)
        self.set_halign(Gtk.Align.CENTER)
        self.set_margin_top(34)
        self.set_margin_bottom(34)
        icon = Gtk.Image.new_from_icon_name(icon_name, Gtk.IconSize.DIALOG)
        icon.set_opacity(0.55)
        self.pack_start(icon, False, False, 0)
        self.pack_start(label(title, "empty-title", 0.5), False, False, 0)
        detail_label = label(detail, "empty-detail", 0.5)
        detail_label.set_line_wrap(True)
        self.pack_start(detail_label, False, False, 0)


def markdown_blocks(markdown: str) -> list[tuple[str, str]]:
    """Parse the deliberately small Markdown subset used by the manuals."""

    def replace_html_image(match: re.Match[str]) -> str:
        element = match.group(0)
        source_match = re.search(r"\bsrc\s*=\s*(['\"])(.*?)\1", element, re.IGNORECASE | re.DOTALL)
        if source_match is None:
            return ""
        source = html.unescape(source_match.group(2).strip())
        if source.startswith(("http://", "https://", "//", "data:")):
            return ""
        width_match = re.search(r"\bwidth\s*=\s*(['\"])(.*?)\1", element, re.IGNORECASE | re.DOTALL)
        alt_match = re.search(r"\balt\s*=\s*(['\"])(.*?)\1", element, re.IGNORECASE | re.DOTALL)
        image = {
            "src": source,
            "width": width_match.group(2).strip() if width_match else "",
            "alt": html.unescape(alt_match.group(2).strip()) if alt_match else "",
        }
        return f"\nPDRIVE_NATIVE_IMAGE:{json.dumps(image, ensure_ascii=True)}\n"

    # Convert complete elements before splitting lines so multiline HTML
    # attributes can never leak into the rendered text. Local project artwork
    # becomes a native image block; remote badges are intentionally not fetched.
    markdown = re.sub(
        r"<img\b[^>]*>",
        replace_html_image,
        markdown,
        flags=re.IGNORECASE | re.DOTALL,
    )
    blocks: list[tuple[str, str]] = []
    paragraph: list[str] = []
    code: list[str] = []
    in_code = False
    alert_kind = ""
    alert_lines: list[str] = []

    def flush_paragraph() -> None:
        if paragraph:
            blocks.append(("paragraph", " ".join(paragraph)))
            paragraph.clear()

    def flush_alert() -> None:
        nonlocal alert_kind
        if alert_kind:
            blocks.append((f"admonition-{alert_kind}", " ".join(alert_lines)))
            alert_kind = ""
            alert_lines.clear()

    for raw_line in markdown.splitlines():
        line = raw_line.rstrip()
        if line.lstrip().startswith("```"):
            flush_paragraph()
            if in_code:
                blocks.append(("code", "\n".join(code)))
                code.clear()
            in_code = not in_code
            continue
        if in_code:
            code.append(line)
            continue

        native_image = re.match(r"^PDRIVE_NATIVE_IMAGE:(\{.*\})$", line.strip())
        if native_image:
            flush_paragraph()
            flush_alert()
            blocks.append(("image", native_image.group(1)))
            continue

        html_heading = re.match(r"^<h([1-6])[^>]*>(.*?)</h\1>$", line.strip())
        if html_heading:
            flush_paragraph()
            heading_text = html.unescape(re.sub(r"<[^>]+>", "", html_heading.group(2))).strip()
            if heading_text:
                blocks.append((f"heading-{html_heading.group(1)}", heading_text))
            continue
        cleaned = html.unescape(re.sub(r"<[^>]+>", "", line)).strip()
        if not cleaned:
            flush_paragraph()
            flush_alert()
            continue
        quoted = re.match(r"^>\s?(.*)$", cleaned)
        if quoted:
            flush_paragraph()
            quote_text = quoted.group(1)
            alert = re.match(
                r"^\[!(NOTE|TIP|IMPORTANT|WARNING|CAUTION)\]\s*$",
                quote_text,
                re.IGNORECASE,
            )
            if alert:
                flush_alert()
                alert_kind = alert.group(1).lower()
            elif alert_kind:
                alert_lines.append(quote_text)
            else:
                blocks.append(("quote", quote_text))
            continue
        flush_alert()
        heading = re.match(r"^(#{1,6})\s+(.+)$", cleaned)
        if heading:
            flush_paragraph()
            blocks.append((f"heading-{len(heading.group(1))}", heading.group(2)))
            continue
        if re.match(r"^\|?\s*:?-{3,}", cleaned):
            continue
        if cleaned.startswith("|") and cleaned.endswith("|"):
            flush_paragraph()
            cells = [cell.strip() for cell in cleaned.strip("|").split("|")]
            blocks.append(("table", "  │  ".join(cells)))
            continue
        bullet = re.match(r"^[-*]\s+(.+)$", cleaned)
        if bullet:
            flush_paragraph()
            blocks.append(("bullet", bullet.group(1)))
            continue
        numbered = re.match(r"^(\d+)\.\s+(.+)$", cleaned)
        if numbered:
            flush_paragraph()
            blocks.append(("numbered", f"{numbered.group(1)}.\t{numbered.group(2)}"))
            continue
        paragraph.append(cleaned)

    flush_paragraph()
    flush_alert()
    if code:
        blocks.append(("code", "\n".join(code)))
    return blocks


class MarkdownView(Gtk.ScrolledWindow):
    INLINE_PATTERN = re.compile(r"(`[^`]+`|\*\*[^*]+\*\*|\[[^]]+\]\([^)]+\))")

    def __init__(self, markdown: str, activate_link: Any, base_dir: pathlib.Path | None = None) -> None:
        super().__init__()
        self.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        self.set_shadow_type(Gtk.ShadowType.NONE)
        self.activate_link = activate_link
        self.base_dir = base_dir.resolve() if base_dir is not None else None
        self.link_tags: list[tuple[Gtk.TextTag, str]] = []
        self.rendered_images: list[pathlib.Path] = []
        self.text_view = Gtk.TextView()
        self.text_view.set_editable(False)
        self.text_view.set_cursor_visible(False)
        self.text_view.set_wrap_mode(Gtk.WrapMode.WORD_CHAR)
        self.text_view.set_left_margin(28)
        self.text_view.set_right_margin(28)
        self.text_view.set_top_margin(22)
        self.text_view.set_bottom_margin(28)
        self.text_view.connect("button-release-event", self.on_button_release)
        self.add(self.text_view)
        self.buffer = self.text_view.get_buffer()
        self.tags = {
            "heading-1": self.buffer.create_tag(
                None,
                weight=Pango.Weight.BOLD,
                scale=1.65,
                foreground="#ffffff",
                pixels_above_lines=16,
                pixels_below_lines=8,
            ),
            "heading-2": self.buffer.create_tag(
                None,
                weight=Pango.Weight.BOLD,
                scale=1.35,
                foreground="#f7f9fc",
                pixels_above_lines=14,
                pixels_below_lines=6,
            ),
            "heading-3": self.buffer.create_tag(
                None,
                weight=Pango.Weight.BOLD,
                scale=1.15,
                foreground="#eef2f7",
                pixels_above_lines=10,
                pixels_below_lines=4,
            ),
            "body": self.buffer.create_tag(None, foreground="#c9d2df", pixels_below_lines=4),
            "bullet": self.buffer.create_tag(
                None,
                foreground="#c9d2df",
                left_margin=14,
                indent=-12,
                pixels_below_lines=3,
            ),
            "quote": self.buffer.create_tag(
                None,
                foreground="#a9bed2",
                style=Pango.Style.ITALIC,
                left_margin=16,
                pixels_below_lines=5,
            ),
            "admonition": self.buffer.create_tag(
                None,
                foreground="#d7e2ed",
                paragraph_background="#17222d",
                left_margin=18,
                right_margin=14,
                pixels_above_lines=5,
                pixels_below_lines=7,
            ),
            "admonition-note": self.buffer.create_tag(None, foreground="#69d7ff", weight=Pango.Weight.BOLD),
            "admonition-tip": self.buffer.create_tag(None, foreground="#70e1aa", weight=Pango.Weight.BOLD),
            "admonition-important": self.buffer.create_tag(None, foreground="#bca7ff", weight=Pango.Weight.BOLD),
            "admonition-warning": self.buffer.create_tag(None, foreground="#ffc66d", weight=Pango.Weight.BOLD),
            "admonition-caution": self.buffer.create_tag(None, foreground="#ff8993", weight=Pango.Weight.BOLD),
            "code": self.buffer.create_tag(
                None,
                family="monospace",
                foreground="#d8e8f5",
                background="#202631",
                left_margin=14,
                right_margin=14,
                pixels_above_lines=5,
                pixels_below_lines=7,
            ),
            "table": self.buffer.create_tag(None, family="monospace", foreground="#cbd8e6", pixels_below_lines=3),
            "bold": self.buffer.create_tag(None, weight=Pango.Weight.BOLD, foreground="#ffffff"),
            "inline-code": self.buffer.create_tag(None, family="monospace", foreground="#8fe1ff", background="#202631"),
            "image": self.buffer.create_tag(
                None,
                justification=Gtk.Justification.CENTER,
                pixels_above_lines=6,
                pixels_below_lines=10,
            ),
        }
        self.render(markdown)

    def insert_image(self, specification: str) -> None:
        try:
            image = json.loads(specification)
            source = str(image["src"])
            relative = pathlib.PurePosixPath(source)
            if self.base_dir is None or relative.is_absolute() or ".." in relative.parts:
                return
            path = (self.base_dir / pathlib.Path(*relative.parts)).resolve()
            path.relative_to(self.base_dir)
            if not path.is_file() or path.stat().st_size > 25 * 1024 * 1024:
                return
            requested_width = str(image.get("width", ""))
            width = int(requested_width) if requested_width.isdigit() else 700
            width = max(32, min(700, width))
            pixbuf = GdkPixbuf.Pixbuf.new_from_file_at_scale(str(path), width, -1, True)
        except (
            GLib.Error,
            KeyError,
            OSError,
            ValueError,
            TypeError,
            json.JSONDecodeError,
        ):
            return
        start_offset = self.buffer.get_end_iter().get_offset()
        self.buffer.insert_pixbuf(self.buffer.get_end_iter(), pixbuf)
        self.buffer.apply_tag(
            self.tags["image"],
            self.buffer.get_iter_at_offset(start_offset),
            self.buffer.get_end_iter(),
        )
        self.buffer.insert(self.buffer.get_end_iter(), "\n\n")
        self.rendered_images.append(path)

    def insert_inline(self, text: str, base_tag: Gtk.TextTag) -> None:
        position = 0
        for match in self.INLINE_PATTERN.finditer(text):
            if match.start() > position:
                self.buffer.insert_with_tags(
                    self.buffer.get_end_iter(),
                    text[position : match.start()],
                    base_tag,
                )
            token = match.group(0)
            if token.startswith("**"):
                self.buffer.insert_with_tags(self.buffer.get_end_iter(), token[2:-2], base_tag, self.tags["bold"])
            elif token.startswith("`"):
                self.buffer.insert_with_tags(
                    self.buffer.get_end_iter(),
                    token[1:-1],
                    base_tag,
                    self.tags["inline-code"],
                )
            else:
                link = re.match(r"^\[([^]]+)\]\(([^)]+)\)$", token)
                if link:
                    tag = self.buffer.create_tag(
                        None,
                        foreground="#69d7ff",
                        underline=Pango.Underline.SINGLE,
                    )
                    self.link_tags.append((tag, link.group(2)))
                    self.buffer.insert_with_tags(self.buffer.get_end_iter(), link.group(1), base_tag, tag)
            position = match.end()
        if position < len(text):
            self.buffer.insert_with_tags(self.buffer.get_end_iter(), text[position:], base_tag)

    def render(self, markdown: str) -> None:
        for kind, text in markdown_blocks(markdown):
            if kind.startswith("heading-"):
                self.insert_inline(text, self.tags.get(kind, self.tags["heading-3"]))
                self.buffer.insert(self.buffer.get_end_iter(), "\n")
            elif kind == "code":
                self.buffer.insert_with_tags(self.buffer.get_end_iter(), f"{text}\n", self.tags["code"])
            elif kind == "table":
                self.insert_inline(text, self.tags["table"])
                self.buffer.insert(self.buffer.get_end_iter(), "\n")
            elif kind == "quote":
                self.buffer.insert_with_tags(self.buffer.get_end_iter(), "▌ ", self.tags["quote"])
                self.insert_inline(text, self.tags["quote"])
                self.buffer.insert(self.buffer.get_end_iter(), "\n")
            elif kind.startswith("admonition-"):
                alert_kind = kind.removeprefix("admonition-")
                title_tag = self.tags.get(kind, self.tags["admonition-note"])
                self.buffer.insert_with_tags(
                    self.buffer.get_end_iter(),
                    f"●  {alert_kind.upper()}\n",
                    self.tags["admonition"],
                    title_tag,
                )
                if text:
                    self.insert_inline(text, self.tags["admonition"])
                self.buffer.insert(self.buffer.get_end_iter(), "\n\n")
            elif kind == "image":
                self.insert_image(text)
            elif kind == "bullet":
                self.buffer.insert_with_tags(self.buffer.get_end_iter(), "• ", self.tags["bullet"])
                self.insert_inline(text, self.tags["bullet"])
                self.buffer.insert(self.buffer.get_end_iter(), "\n")
            elif kind == "numbered":
                self.insert_inline(text, self.tags["bullet"])
                self.buffer.insert(self.buffer.get_end_iter(), "\n")
            else:
                self.insert_inline(text, self.tags["body"])
                self.buffer.insert(self.buffer.get_end_iter(), "\n\n")

    def on_button_release(self, _widget: Gtk.Widget, event: Gdk.EventButton) -> bool:
        if event.button != 1:
            return False
        x, y = self.text_view.window_to_buffer_coords(
            Gtk.TextWindowType.WIDGET,
            int(event.x),
            int(event.y),
        )
        located = self.text_view.get_iter_at_location(x, y)
        iterator = located[-1] if isinstance(located, tuple) else located
        for active_tag in iterator.get_tags():
            for link_tag, target in self.link_tags:
                if active_tag == link_tag:
                    self.activate_link(target)
                    return True
        return False


class DocumentationWindow(Gtk.Window):
    def __init__(self, application: Gtk.Application, parent: Gtk.Window) -> None:
        super().__init__(application=application, title=translate("Documentation"))
        self.set_transient_for(parent)
        self.parent_window = parent
        self.set_destroy_with_parent(True)
        self.set_default_size(820, 720)
        self.set_size_request(620, 480)
        add_css(self, "documentation-window")

        header = Gtk.HeaderBar()
        header.set_show_close_button(True)
        header.set_title(translate("Documentation"))
        header.set_subtitle("proton-drive-linux")
        self.set_titlebar(header)

        root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        self.add(root)
        self.stack = Gtk.Stack()
        self.stack.set_transition_type(Gtk.StackTransitionType.CROSSFADE)
        self.stack.set_transition_duration(160)
        switcher_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL)
        add_css(switcher_box, "documentation-switcher")
        switcher = Gtk.StackSwitcher(stack=self.stack)
        switcher.set_halign(Gtk.Align.CENTER)
        add_css(switcher, "pdrive-tabs")
        self.stack_switcher = switcher
        switcher_box.pack_start(switcher, True, True, 0)
        root.pack_start(switcher_box, False, False, 0)
        root.pack_start(self.stack, True, True, 0)

        self.page_names: dict[str, str] = {}
        for (
            page_name,
            title,
            installed_name,
            repository_relative,
        ) in DOCUMENTATION_PAGES:
            path = documentation_path(installed_name, repository_relative)
            if path is None:
                markdown = (
                    f"# {translate('Documentation unavailable')}\n\n"
                    f"{translate('The local documentation files could not be found.')}\n\n"
                    f"[{translate('Open the project documentation online')}]({DOCUMENTATION_URL})"
                )
            else:
                try:
                    markdown = path.read_text(encoding="utf-8")
                except OSError:
                    markdown = (
                        f"# {translate('Documentation unavailable')}\n\n"
                        f"[{translate('Open the project documentation online')}]({DOCUMENTATION_URL})"
                    )
            view = MarkdownView(
                markdown,
                lambda target, current=repository_relative: self.on_link(target, current),
                path.resolve().parent if path is not None else None,
            )
            self.stack.add_titled(view, page_name, translate(title))
            self.page_names[pathlib.PurePosixPath(repository_relative).name.lower()] = page_name

    def on_link(self, target: str, current_relative: str) -> None:
        if target.startswith(("https://", "http://")):
            self.open_external_uri(target)
            return
        path_part = target.split("#", 1)[0]
        if not path_part:
            return
        normalized = posixpath.normpath(posixpath.join(posixpath.dirname(current_relative), path_part))
        page_name = self.page_names.get(pathlib.PurePosixPath(normalized).name.lower())
        if page_name:
            self.stack.set_visible_child_name(page_name)
            return
        online = f"https://github.com/ClaudiuSchuster/proton-drive-linux/blob/main/{normalized}"
        self.open_external_uri(online)

    def open_external_uri(self, uri: str) -> None:
        try:
            Gio.AppInfo.launch_default_for_uri(uri, None)
        except GLib.Error as error:
            if isinstance(self.parent_window, PDriveWindow):
                self.parent_window.message(
                    "Could not open documentation",
                    str(error),
                    Gtk.MessageType.ERROR,
                )


class SetupWizard(Gtk.Box):
    """Transactional first-run setup embedded in the main application window."""

    def __init__(self, window: "PDriveWindow") -> None:
        super().__init__(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        self.window = window
        self.preparing = False
        self.connecting = False
        self.readiness: dict[str, Any] = {}
        self.stack = Gtk.Stack()
        self.stack.set_transition_type(Gtk.StackTransitionType.SLIDE_LEFT_RIGHT)
        self.stack.set_transition_duration(220)
        self.pack_start(self.stack, True, True, 0)
        self.build_readiness_page()
        self.build_account_page()
        self.build_progress_page()
        self.build_success_page()
        self.refresh_readiness()

    @staticmethod
    def page_box(step: str, title: str, subtitle: str) -> Gtk.Box:
        page = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=16)
        add_css(page, "setup-page")
        page.pack_start(label(step.upper(), "setup-step"), False, False, 0)
        page.pack_start(label(title, "setup-hero"), False, False, 0)
        lead = label(subtitle, "setup-lead")
        lead.set_line_wrap(True)
        page.pack_start(lead, False, False, 0)
        return page

    @staticmethod
    def action_button(text: str, primary: bool = False) -> Gtk.Button:
        button = Gtk.Button(label=translate(text))
        add_css(button, "setup-primary" if primary else "flat-action")
        button.set_tooltip_text(translate(text))
        return button

    def build_readiness_page(self) -> None:
        page = self.page_box(
            "Step 1 of 2",
            "Welcome to PDrive",
            "This guided setup checks the local tools, prepares a private mount and connects your Proton account.",
        )
        page.pack_start(label("System readiness", "section-title"), False, False, 2)
        self.readiness_rows: dict[str, tuple[Gtk.Image, Gtk.Label]] = {}
        for key, title in (
            ("commands", "Required command-line tools"),
            ("rclone", "Latest Proton-capable rclone"),
            ("mount", "Private /pdrive mountpoint"),
        ):
            row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=11)
            add_css(row, "setup-check-row")
            icon = Gtk.Image.new_from_icon_name("content-loading-symbolic", Gtk.IconSize.BUTTON)
            row.pack_start(icon, False, False, 0)
            row.pack_start(label(title), True, True, 0)
            status = label("…", "section-subtitle", 1.0)
            row.pack_end(status, False, False, 0)
            page.pack_start(row, False, False, 0)
            self.readiness_rows[key] = (icon, status)

        self.readiness_summary = label("", "section-subtitle")
        self.readiness_summary.set_line_wrap(True)
        page.pack_start(self.readiness_summary, False, False, 0)

        self.manual_expander = Gtk.Expander(label=translate("Manual setup for advanced users"))
        manual_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=9)
        manual_box.set_margin_top(8)
        manual_note = label(
            "Install the listed packages yourself, create /pdrive as an owner-only directory, "
            "then install a current rclone with Proton Drive support.",
            "section-subtitle",
        )
        manual_note.set_line_wrap(True)
        manual_box.pack_start(manual_note, False, False, 0)
        manual_command = Gtk.Label(
            label=(
                "sudo apt install "
                + " ".join(SYSTEM_PACKAGES)
                + '\nsudo install -d -m 0700 -o "$USER" -g "$(id -gn)" /pdrive'
                + "\npdrive-prerequisites --install-rclone"
            ),
            xalign=0.0,
        )
        manual_command.set_selectable(True)
        manual_command.set_line_wrap(True)
        add_css(manual_command, "setup-code")
        manual_box.pack_start(manual_command, False, False, 0)
        self.manual_expander.add(manual_box)
        page.pack_start(self.manual_expander, False, False, 0)

        self.preparation_progress = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=9)
        self.preparation_progress.set_no_show_all(True)
        self.preparation_spinner = Gtk.Spinner()
        self.preparation_progress.pack_start(self.preparation_spinner, False, False, 0)
        self.preparation_progress.pack_start(label("Preparing your system …"), False, False, 0)
        page.pack_start(self.preparation_progress, False, False, 0)
        self.preparation_progress.hide()

        actions = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=9)
        self.prepare_button = self.action_button("Install and prepare automatically")
        self.prepare_button.set_no_show_all(True)
        self.prepare_button.connect("clicked", self.on_prepare)
        actions.pack_start(self.prepare_button, False, False, 0)
        check_button = self.action_button("Check again")
        check_button.connect("clicked", lambda _button: self.refresh_readiness())
        actions.pack_start(check_button, False, False, 0)
        self.continue_button = self.action_button("Continue", primary=True)
        self.continue_button.connect("clicked", lambda _button: self.stack.set_visible_child_name("account"))
        actions.pack_end(self.continue_button, False, False, 0)
        page.pack_end(actions, False, False, 0)
        self.stack.add_named(page, "readiness")

    def build_account_page(self) -> None:
        page = self.page_box(
            "Step 2 of 2",
            "Proton account",
            "Credentials are sent through a private anonymous pipe, never through process arguments, environment variables or logs.",
        )
        form = Gtk.Grid(column_spacing=16, row_spacing=12)
        form.set_column_homogeneous(False)
        self.username_entry = Gtk.Entry()
        self.username_entry.set_input_purpose(Gtk.InputPurpose.EMAIL)
        self.password_entry = Gtk.Entry()
        self.password_confirm_entry = Gtk.Entry()
        self.two_factor_entry = Gtk.Entry()
        for entry in (
            self.password_entry,
            self.password_confirm_entry,
            self.two_factor_entry,
        ):
            entry.set_visibility(False)
            entry.set_invisible_char("●")
        self.two_factor_entry.set_input_purpose(Gtk.InputPurpose.DIGITS)
        self.two_factor_entry.set_max_length(6)
        for row_index, (title, entry) in enumerate(
            (
                ("Username or email", self.username_entry),
                ("Password", self.password_entry),
                ("Repeat password", self.password_confirm_entry),
                ("Current 2FA code (optional)", self.two_factor_entry),
            )
        ):
            form.attach(label(title), 0, row_index, 1, 1)
            entry.set_hexpand(True)
            form.attach(entry, 1, row_index, 1, 1)
        page.pack_start(card(form), False, False, 0)
        two_factor_note = label(
            "Use a fresh six-digit code. Leave this empty when two-factor authentication is disabled.",
            "section-subtitle",
        )
        two_factor_note.set_line_wrap(True)
        page.pack_start(two_factor_note, False, False, 0)
        show_passwords = Gtk.CheckButton(label=translate("Show passwords"))
        show_passwords.set_tooltip_text(translate("Show passwords"))
        show_passwords.connect("toggled", self.on_show_passwords)
        page.pack_start(show_passwords, False, False, 0)
        self.account_error = label("", "setup-error")
        self.account_error.set_no_show_all(True)
        self.account_error.set_line_wrap(True)
        page.pack_start(self.account_error, False, False, 0)
        self.account_error.hide()
        actions = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=9)
        back_button = self.action_button("Back")
        back_button.connect("clicked", lambda _button: self.stack.set_visible_child_name("readiness"))
        actions.pack_start(back_button, False, False, 0)
        connect_button = self.action_button("Connect securely", primary=True)
        connect_button.connect("clicked", self.on_connect)
        actions.pack_end(connect_button, False, False, 0)
        page.pack_end(actions, False, False, 0)
        self.stack.add_named(page, "account")

    def build_progress_page(self) -> None:
        page = self.page_box(
            "Secure setup",
            "Connecting to Proton Drive",
            "One bounded login attempt is running. Please do not submit another code while it is active.",
        )
        spinner = Gtk.Spinner()
        spinner.set_size_request(64, 64)
        spinner.set_halign(Gtk.Align.CENTER)
        spinner.start()
        page.pack_start(spinner, True, True, 20)
        self.stack.add_named(page, "progress")

    def build_success_page(self) -> None:
        page = self.page_box(
            "Ready",
            "Setup complete",
            "Your encrypted configuration is stored in GNOME Keyring and Proton Drive is starting at /pdrive.",
        )
        self.success_detail = next(
            child
            for child in page.get_children()
            if isinstance(child, Gtk.Label) and child.get_style_context().has_class("setup-lead")
        )
        icon = Gtk.Image.new_from_icon_name("emblem-ok-symbolic", Gtk.IconSize.DIALOG)
        add_css(icon, "good")
        icon.set_pixel_size(72)
        page.pack_start(icon, True, True, 24)
        open_button = self.action_button("Open Control Center", primary=True)
        open_button.set_halign(Gtk.Align.END)
        open_button.connect("clicked", lambda _button: self.window.enter_dashboard())
        page.pack_end(open_button, False, False, 0)
        self.stack.add_named(page, "success")

    def refresh_readiness(self) -> None:
        self.readiness = setup_readiness()
        values = {
            "commands": self.readiness["commands_ready"],
            "rclone": self.readiness["rclone_ready"],
            "mount": self.readiness["mount_ready"],
        }
        for key, ready in values.items():
            icon, status = self.readiness_rows[key]
            icon.set_from_icon_name(
                "emblem-ok-symbolic" if ready else "dialog-warning-symbolic",
                Gtk.IconSize.BUTTON,
            )
            add_css(icon, "good" if ready else "warning")
            status.set_text(translate("Ready" if ready else "Needs attention"))
        if self.readiness["ready"]:
            self.readiness_summary.set_text(translate("All prerequisites are ready."))
            add_css(self.readiness_summary, "setup-ready")
        else:
            missing = ", ".join(self.readiness["missing_commands"])
            detail = translate("Some prerequisites still need attention.")
            if missing:
                detail += f" {translate('Missing')}: {missing}."
            self.readiness_summary.set_text(detail)
            add_css(self.readiness_summary, "setup-attention")
        self.continue_button.set_sensitive(bool(self.readiness["ready"]) and not self.preparing)
        self.prepare_button.set_visible(not self.readiness["ready"])
        self.prepare_button.set_sensitive(bool(self.readiness["automatic"]) and not self.preparing)
        if not self.readiness["automatic"] and not self.readiness["ready"]:
            self.prepare_button.set_tooltip_text(
                translate(
                    "Automatic package installation is available on Debian, Ubuntu and Linux Mint systems with Polkit."
                )
            )

    def on_prepare(self, _button: Gtk.Button) -> None:
        if self.preparing or not self.readiness.get("automatic"):
            return
        self.preparing = True
        self.prepare_button.set_sensitive(False)
        self.continue_button.set_sensitive(False)
        self.preparation_progress.show_all()
        self.preparation_spinner.start()
        threading.Thread(target=self.prepare_worker, daemon=True).start()

    def prepare_worker(self) -> None:
        success = True
        try:
            readiness = setup_readiness()
            system_rclone = pathlib.Path("/usr/bin/rclone").is_file() or pathlib.Path("/usr/local/bin/rclone").is_file()
            if readiness["missing_commands"] or not system_rclone:
                subprocess.run(
                    [
                        "/usr/bin/pkexec",
                        "/usr/bin/apt-get",
                        "install",
                        "-y",
                        *SYSTEM_PACKAGES,
                    ],
                    check=True,
                    stdout=subprocess.DEVNULL,
                    stderr=subprocess.DEVNULL,
                    timeout=900,
                )
            mount = mount_path()
            if not readiness["mount_ready"]:
                if str(mount) != "/pdrive":
                    raise RuntimeError("automatic preparation only creates /pdrive")
                subprocess.run(
                    [
                        "/usr/bin/pkexec",
                        "/usr/bin/install",
                        "-d",
                        "-m",
                        "0700",
                        "-o",
                        str(os.getuid()),
                        "-g",
                        str(os.getgid()),
                        "/pdrive",
                    ],
                    check=True,
                    stdout=subprocess.DEVNULL,
                    stderr=subprocess.DEVNULL,
                    timeout=120,
                )
            prerequisite_command = resolve_command("PDRIVE_PREREQUISITES_BIN", "pdrive-prerequisites")
            subprocess.run(
                [prerequisite_command, "--install-rclone"],
                check=True,
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                timeout=300,
            )
        except (
            OSError,
            RuntimeError,
            subprocess.CalledProcessError,
            subprocess.TimeoutExpired,
        ):
            success = False
        GLib.idle_add(self.preparation_finished, success)

    def preparation_finished(self, success: bool) -> bool:
        self.preparing = False
        self.preparation_spinner.stop()
        self.preparation_progress.hide()
        self.refresh_readiness()
        if not success or not self.readiness["ready"]:
            self.window.message(
                "Preparation failed",
                "The prerequisites could not be prepared automatically. You can retry or use the manual instructions.",
                Gtk.MessageType.ERROR,
            )
        return GLib.SOURCE_REMOVE

    def on_show_passwords(self, button: Gtk.CheckButton) -> None:
        visible = button.get_active()
        self.password_entry.set_visibility(visible)
        self.password_confirm_entry.set_visibility(visible)

    def show_account_error(self, message: str) -> None:
        self.account_error.set_text(translate(message))
        self.account_error.show()

    def on_connect(self, _button: Gtk.Button) -> None:
        if self.connecting:
            return
        username = self.username_entry.get_text().strip()
        password = self.password_entry.get_text()
        confirmation = self.password_confirm_entry.get_text()
        two_factor = self.two_factor_entry.get_text().strip()
        if not username:
            self.show_account_error("Enter your Proton username or email address.")
            return
        if not password or password != confirmation:
            self.show_account_error("Passwords are empty or do not match.")
            return
        if two_factor and not re.fullmatch(r"[0-9]{6}", two_factor):
            self.show_account_error("The 2FA code must be empty or exactly six digits.")
            return
        payload = bytearray()
        for value in (username, password, two_factor):
            payload.extend(value.encode("utf-8"))
            payload.append(0)
        self.password_entry.set_text("")
        self.password_confirm_entry.set_text("")
        self.two_factor_entry.set_text("")
        self.account_error.hide()
        self.connecting = True
        self.stack.set_visible_child_name("progress")
        del password, confirmation, two_factor
        threading.Thread(target=self.connect_worker, args=(payload,), daemon=True).start()

    def connect_worker(self, payload: bytearray) -> None:
        returncode = 127
        error_text = ""
        try:
            command = resolve_command("PDRIVE_SETUP_BIN", "pdrive-setup")
            process = subprocess.Popen(
                [command, "--setup-from-stdin"],
                stdin=subprocess.PIPE,
                stdout=subprocess.DEVNULL,
                stderr=subprocess.PIPE,
            )
            try:
                _stdout, stderr = process.communicate(bytes(payload), timeout=SETUP_TIMEOUT_SECONDS)
            except subprocess.TimeoutExpired:
                process.kill()
                _stdout, stderr = process.communicate()
                returncode = 124
            else:
                returncode = process.returncode
            error_text = stderr.decode("utf-8", errors="replace")[-4096:]
        except OSError:
            error_text = "helper-unavailable"
        finally:
            for index in range(len(payload)):
                payload[index] = 0
            payload.clear()
        GLib.idle_add(self.connect_finished, returncode, error_text)

    def connect_finished(self, returncode: int, error_text: str) -> bool:
        self.connecting = False
        if returncode == 0:
            self.stack.set_visible_child_name("success")
            return GLib.SOURCE_REMOVE
        if setup_config_path().is_file():
            self.success_detail.set_text(
                translate(
                    "Your account is connected, but service activation needs attention. "
                    "Open the Control Center and run pdrive-doctor."
                )
            )
            self.stack.set_visible_child_name("success")
            return GLib.SOURCE_REMOVE
        if error_text == "helper-unavailable":
            message = "Could not start the setup helper."
        elif returncode == 124:
            message = "The login attempt timed out. Check the network and try again with a fresh 2FA code."
        elif "429" in error_text or "rate" in error_text.lower():
            message = (
                "Proton temporarily rate-limited login attempts. Wait for the complete backoff before trying again."
            )
        else:
            message = "Proton did not accept the login. Check the credentials and retry once with a fresh 2FA code."
        self.account_error.set_text(
            translate(message)
            + " "
            + translate("No configuration was installed, so it is safe to retry after correcting the problem.")
        )
        self.account_error.show()
        self.stack.set_visible_child_name("account")
        return GLib.SOURCE_REMOVE


class PDriveWindow(Gtk.ApplicationWindow):
    def __init__(self, application: Gtk.Application, demo: bool = False) -> None:
        super().__init__(application=application)
        self.demo = demo
        self.refreshing = False
        self.closed = False
        self.content_fit_source = 0
        self.content_fit_attempts = 0
        self.documentation_window: DocumentationWindow | None = None
        self.setup_wizard: SetupWizard | None = None
        self.setup_required = not demo and not setup_config_path().is_file()
        self.dashboard_timer_id = 0
        self.speed_samples: collections.deque[float] = collections.deque(maxlen=150)
        self.download_samples: collections.deque[float] = collections.deque(maxlen=150)
        self.network_receive_baseline: tuple[int, int, float] | None = None
        self.capacity_refresh_due = 0.0
        self.remote_capacity: dict[str, Any] = {}
        self.current_state: dict[str, Any] = {}
        self.history_signature: tuple[Any, ...] = ()
        self.issue_signature: tuple[Any, ...] = ()
        self.set_title("PDrive Control Center")
        self.set_icon_name(APP_ID)
        self.set_position(Gtk.WindowPosition.CENTER)
        self.set_default_size(
            DEFAULT_WINDOW_WIDTH,
            SETUP_WINDOW_HEIGHT if self.setup_required else DEFAULT_WINDOW_HEIGHT,
        )
        self.set_size_request(820, 620)
        add_css(self, "pdrive-window")
        self.connect("destroy", self.on_destroy)
        self.connect("delete-event", application.on_window_delete)
        self.state_command = self.find_state_command()
        if self.setup_required:
            self.build_setup_ui()
        else:
            self.enter_dashboard()

    @staticmethod
    def find_state_command() -> str:
        configured = os.environ.get("PDRIVE_STATE_BIN")
        if configured:
            return configured
        installed = shutil.which("pdrive-state")
        if installed:
            return installed
        sibling = pathlib.Path(__file__).with_name("pdrive-state")
        return str(sibling)

    def build_setup_ui(self) -> None:
        header = Gtk.HeaderBar()
        header.set_show_close_button(True)
        header.set_title("PDrive Control Center")
        header.set_subtitle(translate("First-run setup"))
        documentation_button = Gtk.Button.new_from_icon_name("help-browser-symbolic", Gtk.IconSize.BUTTON)
        documentation_button.set_tooltip_text(translate("Documentation"))
        documentation_button.connect("clicked", self.on_documentation)
        header.pack_end(documentation_button)
        self.set_titlebar(header)
        self.setup_wizard = SetupWizard(self)
        self.root = self.setup_wizard
        self.add(self.root)
        self.schedule_content_fit()

    def enter_dashboard(self) -> None:
        current_child = self.get_child()
        if current_child is not None:
            self.remove(current_child)
            current_child.destroy()
        self.setup_required = False
        self.setup_wizard = None
        self.build_ui()
        self.set_empty_lists()
        self.show_all()
        self.configure_dashboard_tabs()
        self.request_refresh()
        self.schedule_dashboard_timer()
        self.schedule_content_fit()

