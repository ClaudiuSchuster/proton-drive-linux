    @staticmethod
    def clear_list(listing: Gtk.ListBox) -> None:
        for child in listing.get_children():
            listing.remove(child)

    def set_empty_lists(self) -> None:
        self.clear_list(self.active_list)
        self.clear_list(self.queue_list)
        self.clear_list(self.recent_list)
        self.active_list.add(
            EmptyState(
                "media-playback-pause-symbolic",
                "No active transfers",
                "rclone is not using the connection right now.",
            )
        )
        self.queue_list.add(
            EmptyState(
                "emblem-ok-symbolic",
                "Queue is empty",
                "All local changes have been uploaded.",
            )
        )
        self.recent_list.add(
            EmptyState(
                "document-open-recent-symbolic",
                "No transfers yet",
                "The current rclone process has not completed a transfer yet.",
            )
        )
        self.clear_list(self.issue_list)
        self.issue_list.add(
            EmptyState(
                "emblem-ok-symbolic",
                "No unreviewed issues",
                "There are no new rclone errors or notices since your last review.",
            )
        )

    def on_destroy(self, _widget: Gtk.Widget) -> None:
        if self.content_fit_source:
            GLib.source_remove(self.content_fit_source)
            self.content_fit_source = 0
        if self.dashboard_timer_id:
            GLib.source_remove(self.dashboard_timer_id)
            self.dashboard_timer_id = 0
        self.closed = True

    def refresh_interval_seconds(self) -> int:
        application = self.get_application()
        if isinstance(application, PDriveApplication):
            interval = application.preferences.get(
                "refresh_interval_seconds",
                REFRESH_INTERVAL_SECONDS,
            )
            if interval in REFRESH_INTERVAL_OPTIONS:
                return int(interval)
        return REFRESH_INTERVAL_SECONDS

    def schedule_dashboard_timer(self) -> None:
        if self.dashboard_timer_id:
            GLib.source_remove(self.dashboard_timer_id)
        self.dashboard_timer_id = GLib.timeout_add_seconds(
            self.refresh_interval_seconds(),
            self.on_refresh_timer,
        )
        self.update_graph_refresh_details()

    def update_graph_refresh_details(self) -> None:
        if not hasattr(self, "upload_graph_detail"):
            return
        detail = translate_format(
            "rclone process traffic · refreshed every {seconds}s",
            seconds=self.refresh_interval_seconds(),
        )
        self.upload_graph_detail.set_text(detail)
        self.download_graph_detail.set_text(detail)
        self.update_graph_axis(self.speed_graph)
        self.update_graph_axis(self.download_graph)

    def schedule_content_fit(self) -> None:
        if self.closed or self.content_fit_source:
            return
        self.content_fit_attempts = 0
        self.content_fit_source = GLib.timeout_add(80, self.fit_content_height)

    def fit_content_height(self) -> bool:
        if self.closed:
            self.content_fit_source = 0
            return GLib.SOURCE_REMOVE
        self.content_fit_attempts += 1
        overflow = 0.0
        if not self.setup_required and hasattr(self, "overview_scroller"):
            adjustment = self.overview_scroller.get_vadjustment()
            overflow = max(0.0, adjustment.get_upper() - adjustment.get_page_size())
        elif self.root is not None:
            _minimum, natural = self.root.get_preferred_height()
            overflow = max(0.0, natural - self.root.get_allocated_height())
        if overflow > 0.5:
            width, height = self.get_size()
            maximum_height = MAX_WINDOW_DIMENSION
            gdk_window = self.get_window()
            display = Gdk.Display.get_default()
            if gdk_window is not None and display is not None:
                monitor = display.get_monitor_at_window(gdk_window)
                if monitor is not None:
                    maximum_height = max(MIN_WINDOW_HEIGHT, monitor.get_workarea().height - 8)
            target_height = min(maximum_height, height + math.ceil(overflow) + 4)
            if target_height > height:
                self.resize(width, target_height)
        if self.content_fit_attempts < 4 and overflow > 0.5:
            return GLib.SOURCE_CONTINUE
        self.content_fit_source = 0
        return GLib.SOURCE_REMOVE

    def on_refresh_timer(self) -> bool:
        if self.closed:
            self.dashboard_timer_id = 0
            return GLib.SOURCE_REMOVE
        application = self.get_application()
        poll_in_background = isinstance(application, PDriveApplication) and bool(
            application.preferences.get("poll_in_background", False)
        )
        if self.demo or self.get_visible() or poll_in_background:
            self.request_refresh()
        return GLib.SOURCE_CONTINUE

    def request_refresh(self, force_capacity: bool = False) -> None:
        if self.setup_required or self.refreshing or self.closed:
            return
        self.refreshing = True
        include_capacity = force_capacity or time.monotonic() >= self.capacity_refresh_due
        if include_capacity and not self.demo:
            self.capacity_refresh_due = time.monotonic() + 15 * 60
        thread = threading.Thread(target=self.load_state, args=(include_capacity,), daemon=True)
        thread.start()

    def load_state(self, include_capacity: bool = False) -> None:
        if self.demo:
            GLib.usleep(120000)
            GLib.idle_add(self.apply_state, demo_state())
            return
        try:
            command = [self.state_command, "--compact"]
            if include_capacity:
                command.append("--include-capacity")
            completed = subprocess.run(
                command,
                check=False,
                capture_output=True,
                text=True,
                timeout=8,
            )
            if completed.returncode != 0:
                raise RuntimeError(completed.stderr.strip() or f"pdrive-state exited with {completed.returncode}")
            payload = json.loads(completed.stdout)
            GLib.idle_add(self.apply_state, payload)
        except (
            OSError,
            subprocess.TimeoutExpired,
            json.JSONDecodeError,
            RuntimeError,
        ) as error:
            if include_capacity:
                self.capacity_refresh_due = min(self.capacity_refresh_due, time.monotonic() + 30)
            GLib.idle_add(self.apply_error, str(error))

    def apply_error(self, message: str) -> bool:
        self.refreshing = False
        self.update_status("critical", "Status unavailable", message)
        return GLib.SOURCE_REMOVE

    def apply_state(self, state: dict[str, Any]) -> bool:
        self.refreshing = False
        self.current_state = state
        health = state.get("health", {})
        stats = state.get("stats", {})
        queue = state.get("queue", {})
        transfers = state.get("transfers", {})
        watchdog = state.get("watchdog", {})
        vfs = state.get("vfs", {})
        service = state.get("service", {})
        config = state.get("configuration", {})
        bandwidth = state.get("bandwidth", {})
        network_io = state.get("network_io", {})
        remote_capacity = state.get("remote_capacity", {})
        if isinstance(remote_capacity, dict) and remote_capacity.get("available"):
            self.remote_capacity = remote_capacity

        status = str(health.get("status", "unknown"))
        self.update_status(
            status,
            translate(STATUS_META.get(status, STATUS_META["unknown"])[1]),
            self.localized_health_summary(state),
        )
        self.updated_label.set_text(dt.datetime.now().strftime("%H:%M:%S"))

        speed = float(stats.get("speed") or 0)
        self.speed_samples.append(speed)
        self.speed_graph.push(speed)
        self.update_graph_axis(self.speed_graph)
        download_speed, self.network_receive_baseline = network_receive_rate(
            self.network_receive_baseline,
            network_io if isinstance(network_io, dict) else {},
            int(service.get("pid") or 0),
            time.monotonic(),
        )
        self.download_samples.append(download_speed)
        self.download_graph.push(download_speed)
        self.update_graph_axis(self.download_graph)
        self.speed_card.update(human_rate(speed), f"Limit {bandwidth.get('live', '–')}")
        self.download_speed_card.update(
            human_rate(download_speed),
            translate("Includes Proton API replies"),
        )
        active = len(transfers.get("active", [])) or int(queue.get("active") or 0)
        slots = int(config.get("running_transfers") or config.get("transfers") or 0)
        self.active_card.update(str(active), translate_format("of {slots} upload slots in use", slots=slots))
        self.queue_card.update(str(queue.get("count", 0)), human_bytes(queue.get("bytes", 0)))
        application = self.get_application()
        if (
            isinstance(application, PDriveApplication)
            and not self.demo
            and (
                application.preferences["issues_reviewed_errors"] < 0
                or application.preferences["issues_reviewed_notices"] < 0
            )
        ):
            application.mark_issues_reviewed(watchdog)
        self.update_issue_card(watchdog)
        self.update_issues(watchdog, state.get("issues", {}))
        cache_card_detail = translate_format(
            "{pending} pending upload · {files} cache file(s)",
            pending=human_bytes(vfs.get("pending_bytes", 0)),
            files=vfs.get("cache_files", 0),
        )
        self.cache_card.update(human_bytes(vfs.get("cache_bytes", 0)), cache_card_detail)
        self.capacity_card.update(
            self.remote_capacity,
            int(vfs.get("free_bytes") or 0),
            int(vfs.get("cache_bytes") or 0),
        )
        self.upload_graph_peak.set_text(
            translate_format("Peak {speed}", speed=human_rate(max(self.speed_samples, default=0)))
        )
        self.download_graph_peak.set_text(
            translate_format("Peak {speed}", speed=human_rate(max(self.download_samples, default=0)))
        )

        if active:
            summary = translate_format(
                "{active} active transfer(s) · {count} file(s) queued · {speed}",
                active=active,
                count=queue.get("count", 0),
                speed=human_rate(speed),
            )
        elif queue.get("count", 0):
            summary = translate_format(
                "{count} file(s) are queued; rclone is preparing the next upload.",
                count=queue.get("count"),
            )
        else:
            summary = translate(
                "Everything is in sync. The service keeps its fast metadata cache warm and waits for changes."
            )
        self.live_summary.set_text(summary)
        if status in {"warning", "critical"}:
            summary_icon, _summary_title, summary_color = STATUS_META[status]
        elif active or queue.get("count", 0):
            summary_icon, summary_color = "emblem-synchronizing-symbolic", "accent"
        else:
            summary_icon, _summary_title, summary_color = STATUS_META.get(
                status,
                STATUS_META["unknown"],
            )
        self.live_summary_icon.set_from_icon_name(summary_icon, Gtk.IconSize.MENU)
        summary_context = self.live_summary_icon.get_style_context()
        for color_class in ("good", "warning", "danger", "muted", "accent"):
            summary_context.remove_class(color_class)
        summary_context.add_class(summary_color)
        self.live_detail_labels["upload"].set_text(
            translate_format(
                "Upload · {active} active · {count} queued ({bytes}) · {speed}",
                active=active,
                count=queue.get("count", 0),
                bytes=human_bytes(queue.get("bytes", 0)),
                speed=human_rate(speed),
            )
        )
        self.live_detail_labels["download"].set_text(
            translate_format(
                "Download · {speed} · rclone process receive traffic",
                speed=human_rate(download_speed),
            )
        )
        self.live_detail_labels["cache"].set_text(
            translate_format(
                "Cache · {pending} pending upload · {clean} synced read cache",
                pending=human_bytes(vfs.get("pending_bytes", 0)),
                clean=human_bytes(vfs.get("clean_bytes", 0)),
            )
        )
        if self.remote_capacity.get("available"):
            cloud_detail = translate_format(
                "Proton cloud · {free} free of {total}",
                free=human_bytes(self.remote_capacity.get("free_bytes", 0)),
                total=human_bytes(self.remote_capacity.get("total_bytes", 0)),
            )
        else:
            cloud_detail = translate("Proton cloud capacity unavailable")
        self.live_detail_labels["cloud"].set_text(cloud_detail)
        service_state = f"{service.get('active_state', '–')}/{service.get('sub_state', '–')}"
        self.live_detail_labels["service"].set_text(
            translate_format(
                "Service · {state} · {uptime} uptime · {restarts} restart(s)",
                state=service_state,
                uptime=human_duration(service.get("uptime_seconds", -1)),
                restarts=int(service.get("restarts") or 0),
            )
        )
        self.live_detail_labels["network"].set_text(
            translate_format(
                "Network · DNS {dns} · TCP {tcp} · watchdog {time}",
                dns=state.get("network", {}).get("dns", "–"),
                tcp=state.get("network", {}).get("tcp", "–"),
                time=local_time(str(watchdog.get("generated_at") or "")),
            )
        )
        mount = state.get("mount", {})
        self.service_detail_values["state"].set_text(service_state)
        self.service_detail_values["process"].set_text(
            translate_format(
                "PID {pid} · result {result} · exit {exit_status}",
                pid=int(service.get("pid") or 0),
                result=service.get("result", "–"),
                exit_status=service.get("exit_status", "–"),
            )
        )
        self.service_detail_values["uptime"].set_text(
            human_duration(service.get("uptime_seconds", -1))
        )
        self.service_detail_values["restarts"].set_text(str(int(service.get("restarts") or 0)))
        self.service_detail_values["mount"].set_text(
            translate_format(
                "{state} · {filesystem}",
                state="ready" if mount.get("ready") else "not ready",
                filesystem=mount.get("filesystem", "–"),
            )
        )
        self.service_detail_values["watchdog"].set_text(
            translate_format(
                "{status} · {confirmations} stall confirmation(s) · checked {time}",
                status=watchdog.get("status", "–"),
                confirmations=int(watchdog.get("stall_confirmations") or 0),
                time=local_time(str(watchdog.get("generated_at") or "")),
            )
        )
        self.config_labels["bandwidth"].set_text(str(bandwidth.get("live", "–")))
        self.config_labels["slots"].set_text(f"{slots} parallel")
        self.config_labels["metadata"].set_text(translate("enabled" if config.get("metadata_cache") else "disabled"))
        self.config_labels["cooldown"].set_text(human_duration(config.get("cooldown_seconds", -1)))
        self.short_status_text = "\n".join(
            (
                f"PDrive Control Center — {self.status_title.get_text()}",
                self.live_detail_labels["upload"].get_text(),
                self.live_detail_labels["download"].get_text(),
                self.live_detail_labels["cache"].get_text(),
                self.live_detail_labels["cloud"].get_text(),
                self.live_detail_labels["service"].get_text(),
                self.live_detail_labels["network"].get_text(),
                (
                    f"{translate('Configuration')}: "
                    f"{translate('Bandwidth')} {self.config_labels['bandwidth'].get_text()} · "
                    f"{translate('Upload slots')} {self.config_labels['slots'].get_text()} · "
                    f"{translate('Metadata cache')} {self.config_labels['metadata'].get_text()}"
                ),
                translate_format("Updated {time}", time=self.updated_label.get_text()),
            )
        )

        self.update_transfers(transfers, queue)
        self.update_cache_details(vfs, config)
        self.update_history(state.get("history", []))
        self.status_title.set_tooltip_text(
            translate_format(
                "Service {active}/{sub} · PID {pid}",
                active=service.get("active_state", "–"),
                sub=service.get("sub_state", "–"),
                pid=service.get("pid", 0),
            )
        )
        application = self.get_application()
        if isinstance(application, PDriveApplication):
            application.update_indicator(state)
        return GLib.SOURCE_REMOVE

    def update_issue_card(self, watchdog: dict[str, Any]) -> None:
        application = self.get_application()
        preferences = application.preferences if isinstance(application, PDriveApplication) else DEFAULT_PREFERENCES
        errors, notices = issues_since_review(preferences, watchdog)
        total = errors + notices
        self.problem_card.update(
            str(total),
            translate_format(
                "{errors} errors · {notices} notices · since reviewed",
                errors=errors,
                notices=notices,
            ),
        )
        self.mark_issues_reviewed_button.set_sensitive(total > 0 and not self.demo)

    def issue_row(self, event: dict[str, Any]) -> Gtk.ListBoxRow:
        row = Gtk.ListBoxRow()
        add_css(row, "transfer-row")
        outer = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=11)
        level = str(event.get("level", "error")).lower()
        icon_name = "dialog-warning-symbolic" if level == "notice" else "dialog-error-symbolic"
        icon = Gtk.Image.new_from_icon_name(icon_name, Gtk.IconSize.BUTTON)
        add_css(icon, "warning" if level == "notice" else "danger")
        icon.set_valign(Gtk.Align.START)
        outer.pack_start(icon, False, False, 2)

        content = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=5)
        top = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        title = label(str(event.get("title") or "rclone reported an error"), "transfer-name")
        title.set_line_wrap(True)
        top.pack_start(title, True, True, 0)
        top.pack_end(
            label(local_time(str(event.get("timestamp", ""))), "pill", 1.0),
            False,
            False,
            0,
        )
        content.pack_start(top, False, False, 0)

        subject = str(event.get("subject") or "")
        if subject:
            subject_label = label(short_name(subject, 110), "transfer-meta")
            subject_label.set_tooltip_text(subject)
            subject_label.set_selectable(True)
            subject_label.set_line_wrap(True)
            content.pack_start(subject_label, False, False, 0)
        message = label(str(event.get("message") or ""), "issue-message")
        message.set_line_wrap(True)
        message.set_selectable(True)
        content.pack_start(message, False, False, 0)
        guidance = label(
            translate_format(
                "{label}: {guidance}",
                label=translate("Suggested next step"),
                guidance=translate(str(event.get("guidance") or "")),
            ),
            "issue-guidance",
        )
        guidance.set_line_wrap(True)
        content.pack_start(guidance, False, False, 0)
        outer.pack_start(content, True, True, 0)
        row.add(outer)
        return row

    def update_issues(self, watchdog: dict[str, Any], issues: dict[str, Any]) -> None:
        application = self.get_application()
        preferences = application.preferences if isinstance(application, PDriveApplication) else DEFAULT_PREFERENCES
        events, missing = unreviewed_issue_events(preferences, watchdog, issues)
        errors, notices = issues_since_review(preferences, watchdog)
        signature = (
            errors,
            notices,
            missing,
            tuple(
                (
                    event.get("timestamp"),
                    event.get("level"),
                    event.get("category"),
                    event.get("subject"),
                    event.get("message"),
                )
                for event in events
            ),
        )
        if signature == self.issue_signature:
            return
        self.issue_signature = signature
        self.clear_list(self.issue_list)
        total = errors + notices
        if not total:
            self.issue_summary.set_text(translate("There are no new rclone errors or notices since your last review."))
            self.issue_list.add(
                EmptyState(
                    "emblem-ok-symbolic",
                    "No unreviewed issues",
                    "There are no new rclone errors or notices since your last review.",
                )
            )
        else:
            if missing:
                self.issue_summary.set_text(
                    translate_format(
                        "Showing {shown} of {total} unreviewed event(s); "
                        "{missing} older detail(s) are outside the retained log tail.",
                        shown=len(events),
                        total=total,
                        missing=missing,
                    )
                )
            else:
                self.issue_summary.set_text(
                    translate_format(
                        "{errors} error(s) and {notices} notice(s) await review.",
                        errors=errors,
                        notices=notices,
                    )
                )
            for event in reversed(events):
                self.issue_list.add(self.issue_row(event))
            if not events:
                self.issue_list.add(
                    EmptyState(
                        "dialog-warning-symbolic",
                        "Issue details unavailable",
                        "The counters report new events, but their sanitized log details are no longer available.",
                    )
                )
        self.issue_list.show_all()

    @staticmethod
    def localized_health_summary(state: dict[str, Any]) -> str:
        health = state.get("health", {})
        summary = str(health.get("summary", ""))
        if CURRENT_LANGUAGE != "de":
            return summary
        reason = str(health.get("reason_code", "unknown"))
        if reason == "mounted":
            queue = state.get("queue", {})
            active = int(queue.get("active") or 0)
            count = int(queue.get("count") or 0)
            if active:
                return GERMAN_HEALTH_SUMMARIES["mounted-active"].format(active=active)
            if count:
                return GERMAN_HEALTH_SUMMARIES["mounted-queued"].format(count=count)
            return GERMAN_HEALTH_SUMMARIES["mounted"]
        return GERMAN_HEALTH_SUMMARIES.get(reason, summary)

    def update_status(self, status: str, title_text: str, summary: str) -> None:
        for css_class in (
            "status-ready",
            "status-warning",
            "status-critical",
            "status-unknown",
        ):
            self.status_frame.get_style_context().remove_class(css_class)
        selected = status if status in STATUS_META else "unknown"
        self.status_frame.get_style_context().add_class(f"status-{selected}")
        icon_name, fallback_title, _color = STATUS_META[selected]
        self.status_icon.set_from_icon_name(icon_name, Gtk.IconSize.DIALOG)
        self.status_title.set_text(translate(title_text or fallback_title))
        self.status_summary.set_text(summary or translate("No details available."))

    def transfer_row(self, item: dict[str, Any], queue: bool = False, recent: bool = False) -> Gtk.ListBoxRow:
        row = Gtk.ListBoxRow()
        add_css(row, "transfer-row")
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        top = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        name = label(short_name(str(item.get("name", "Unknown file"))), "transfer-name")
        name.set_ellipsize(3)
        name.set_tooltip_text(str(item.get("name", "")))
        top.pack_start(name, True, True, 0)
        if queue:
            status = "Uploading" if item.get("uploading") else "Waiting"
            if int(item.get("tries") or 0) >= 2:
                status = translate_format("Attempt {tries}", tries=item.get("tries"))
            top.pack_end(label(status, "pill"), False, False, 0)
        elif recent:
            text = "Failed" if item.get("error") else "Completed"
            top.pack_end(label(text, "pill"), False, False, 0)
        else:
            top.pack_end(label(human_rate(item.get("speed", 0)), "pill"), False, False, 0)
        box.pack_start(top, False, False, 0)

        if not queue and not recent:
            size = int(item.get("size") or 0)
            done = int(item.get("bytes") or 0)
            fraction = min(1.0, done / size) if size > 0 else 0.0
            progress = Gtk.ProgressBar(fraction=fraction)
            box.pack_start(progress, False, False, 0)
            detail = f"{human_bytes(done)} / {human_bytes(size)}"
            eta = human_duration(item.get("eta_seconds", -1))
            if eta != "–":
                detail += f" · ETA {eta}"
        elif queue:
            detail = f"{human_bytes(item.get('size', 0))} · " + translate_format(
                "{tries} attempt(s)", tries=item.get("tries", 0)
            )
        else:
            detail = f"{human_bytes(item.get('bytes') or item.get('size', 0))} · {local_time(str(item.get('completed_at', '')))}"
        box.pack_start(label(detail, "transfer-meta"), False, False, 0)
        row.add(box)
        return row

    def update_transfers(self, transfers: dict[str, Any], queue: dict[str, Any]) -> None:
        self.clear_list(self.active_list)
        self.clear_list(self.queue_list)
        self.clear_list(self.recent_list)
        active_items = transfers.get("active", [])
        queue_items = queue.get("items", [])
        recent_items = transfers.get("recent", [])
        if active_items:
            for item in active_items:
                self.active_list.add(self.transfer_row(item))
        else:
            uploading = [item for item in queue_items if item.get("uploading")]
            if uploading:
                for item in uploading:
                    self.active_list.add(self.transfer_row(item, queue=True))
            else:
                self.active_list.add(
                    EmptyState(
                        "media-playback-pause-symbolic",
                        "No active transfers",
                        "rclone is not using the connection right now.",
                    )
                )
        if queue_items:
            for item in queue_items:
                self.queue_list.add(self.transfer_row(item, queue=True))
        else:
            self.queue_list.add(
                EmptyState(
                    "emblem-ok-symbolic",
                    "Queue is empty",
                    "All local changes have been uploaded.",
                )
            )
        if recent_items:
            for item in reversed(recent_items[-12:]):
                self.recent_list.add(self.transfer_row(item, recent=True))
        else:
            self.recent_list.add(
                EmptyState(
                    "document-open-recent-symbolic",
                    "No transfers yet",
                    "The current rclone process has not completed a transfer yet.",
                )
            )
        self.active_list.show_all()
        self.queue_list.show_all()
        self.recent_list.show_all()

    def update_cache_details(self, vfs: dict[str, Any], config: dict[str, Any]) -> None:
        cache_state = str(vfs.get("cache_state", "unavailable"))
        clean_files = int(vfs.get("clean_files") or 0)
        pending_files = int(vfs.get("pending_files") or 0)
        errored_files = int(vfs.get("errored_files") or 0)
        if cache_state == "clean":
            title = "Cache is fully synced"
            detail = translate_format(
                "{files} local file(s) are already uploaded and kept only to speed up future reads.",
                files=clean_files,
            )
        elif cache_state == "pending":
            title = "Uploads are still pending"
            detail = translate_format(
                "{files} file(s) remain in the protected upload cache.",
                files=pending_files,
            )
        elif cache_state == "error":
            title = "Cache needs attention"
            detail = translate_format(
                "{files} cached file(s) currently report errors.",
                files=errored_files,
            )
        elif cache_state == "empty":
            title = "Local cache is empty"
            detail = translate("The local VFS cache is empty.")
        else:
            title = "Cache details unavailable"
            detail = translate("rclone’s VFS statistics are temporarily unavailable.")
        self.cache_status_title.set_text(translate(title))
        self.cache_status_detail.set_text(detail)
        self.cache_detail_values["clean"].set_text(
            translate_format(
                "{files} clean file(s) · {size}",
                files=clean_files,
                size=human_bytes(vfs.get("clean_bytes", 0)),
            )
        )
        self.cache_detail_values["pending"].set_text(
            translate_format(
                "{files} pending file(s) · {size}",
                files=pending_files,
                size=human_bytes(vfs.get("pending_bytes", 0)),
            )
        )
        configured_age = int(config.get("cache_max_age_seconds") or 0)
        running_age = int(config.get("running_cache_max_age_seconds") or -1)
        self.cache_detail_values["retention"].set_text(
            translate_format(
                "Running {running} · saved {saved}",
                running=human_duration(running_age),
                saved=human_duration(configured_age),
            )
        )

    def update_history(self, entries: list[dict[str, Any]]) -> None:
        signature = tuple(
            (
                entry.get("time"),
                entry.get("status"),
                entry.get("reason"),
                entry.get("errors"),
                entry.get("notices"),
            )
            for entry in entries[-24:]
        )
        if signature == self.history_signature:
            return
        self.history_signature = signature
        self.clear_list(self.history_list)
        if not entries:
            self.history_list.add(
                EmptyState(
                    "document-open-recent-symbolic",
                    "No history yet",
                    "The pdrive-watch timer has not recorded a sample yet.",
                )
            )
            self.history_list.show_all()
            return
        for entry in reversed(entries[-24:]):
            row = Gtk.ListBoxRow()
            add_css(row, "history-row")
            box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
            status = str(entry.get("status", "unknown"))
            icon_name, _title, color = STATUS_META.get(status, STATUS_META["unknown"])
            icon = Gtk.Image.new_from_icon_name(icon_name, Gtk.IconSize.BUTTON)
            add_css(icon, color)
            box.pack_start(icon, False, False, 0)
            text_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
            reason = str(entry.get("reason", "unknown"))
            text_box.pack_start(
                label(
                    REASON_LABELS.get(reason, reason.replace("-", " ").capitalize()),
                    "transfer-name",
                ),
                False,
                False,
                0,
            )
            detail = translate_format(
                "Queue {queue} · active {active} · error counter {errors} · notices {notices}",
                queue=entry.get("vfs_queue", 0),
                active=entry.get("vfs_uploading", 0),
                errors=entry.get("errors", 0),
                notices=entry.get("notices", 0),
            )
            text_box.pack_start(label(detail, "transfer-meta"), False, False, 0)
            box.pack_start(text_box, True, True, 0)
            box.pack_end(
                label(local_time(str(entry.get("time", ""))), "pill", 1.0),
                False,
                False,
                0,
            )
            row.add(box)
            self.history_list.add(row)
        self.history_list.show_all()

    def on_open_mount(self, _button: Gtk.Button) -> None:
        try:
            Gio.AppInfo.launch_default_for_uri(pathlib.Path("/pdrive").as_uri(), None)
        except GLib.Error as error:
            self.message("Could not open mount", str(error), Gtk.MessageType.ERROR)

    def on_copy_short_status(self, _button: Gtk.Button) -> None:
        status = getattr(self, "short_status_text", "")
        if not status:
            return
        clipboard = Gtk.Clipboard.get(Gdk.SELECTION_CLIPBOARD)
        clipboard.set_text(status, -1)
        clipboard.store()
        self.copy_short_status_button.set_tooltip_text(translate("Short status copied"))
        GLib.timeout_add(1800, self.restore_copy_status_tooltip)

    def restore_copy_status_tooltip(self) -> bool:
        self.copy_short_status_button.set_tooltip_text(translate("Copy short status"))
        return GLib.SOURCE_REMOVE

    def on_open_proton_web(self, _button: Gtk.Button) -> None:
        try:
            Gio.AppInfo.launch_default_for_uri(PROTON_DRIVE_URL, None)
        except GLib.Error as error:
            self.message("Could not open Proton Drive", str(error), Gtk.MessageType.ERROR)

    def on_documentation(self, _button: Gtk.Button) -> None:
        application = self.get_application()
        if not isinstance(application, PDriveApplication):
            return
        if self.documentation_window is None:
            self.documentation_window = DocumentationWindow(application, self)
            self.documentation_window.connect(
                "destroy",
                lambda _window: setattr(self, "documentation_window", None),
            )
            self.documentation_window.show_all()
        self.documentation_window.present()

    def open_documentation_page(self, page_name: str) -> None:
        self.on_documentation(None)
        if self.documentation_window is not None:
            self.documentation_window.stack.set_visible_child_name(page_name)

    def on_mark_issues_reviewed(self, _button: Gtk.Button) -> None:
        application = self.get_application()
        if not isinstance(application, PDriveApplication) or self.demo:
            return
        watchdog = self.current_state.get("watchdog", {})
        error = application.mark_issues_reviewed(watchdog)
        if error:
            self.message(
                "Could not update issue review state",
                error,
                Gtk.MessageType.ERROR,
            )
            return
        self.update_issue_card(watchdog)
        self.update_issues(watchdog, self.current_state.get("issues", {}))

    def on_preferences(self, _button: Gtk.Button) -> None:
        application = self.get_application()
        if not isinstance(application, PDriveApplication):
            return
        dialog = Gtk.Dialog(title=translate("Preferences"), transient_for=self, modal=True)
        dialog.add_buttons(
            translate("Cancel"),
            Gtk.ResponseType.CANCEL,
            translate("Save"),
            Gtk.ResponseType.OK,
        )
        content = dialog.get_content_area()
        content.set_spacing(11)
        content.set_margin_top(16)
        content.set_margin_bottom(16)
        content.set_margin_start(16)
        content.set_margin_end(16)
        content.set_size_request(430, -1)
        content.pack_start(label("Behavior", "section-title"), False, False, 0)
        close_toggle = Gtk.CheckButton(label=translate("Keep running in the tray when the window closes"))
        close_toggle.set_active(application.preferences["close_to_tray"])
        content.pack_start(close_toggle, False, False, 0)
        start_toggle = Gtk.CheckButton(label=translate("Start hidden in the tray with the desktop session"))
        start_toggle.set_active(application.preferences["start_in_tray"])
        content.pack_start(start_toggle, False, False, 0)
        background_poll_toggle = Gtk.CheckButton(label=translate("Keep live metrics updating while hidden in the tray"))
        background_poll_toggle.set_active(application.preferences["poll_in_background"])
        content.pack_start(background_poll_toggle, False, False, 0)
        background_poll_note = label(
            "When disabled, live polling pauses while hidden. "
            "The independent 90-minute watchdog keeps monitoring health.",
            "section-subtitle",
        )
        background_poll_note.set_line_wrap(True)
        content.pack_start(background_poll_note, False, False, 0)
        interval_row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        interval_row.pack_start(label("Live metrics interval"), True, True, 0)
        interval_combo = Gtk.ComboBoxText()
        for seconds in REFRESH_INTERVAL_OPTIONS:
            interval_combo.append(
                str(seconds),
                translate_format("{seconds} seconds", seconds=seconds),
            )
        interval_combo.set_active_id(str(application.preferences["refresh_interval_seconds"]))
        interval_row.pack_end(interval_combo, False, False, 0)
        content.pack_start(interval_row, False, False, 0)
        language_row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        language_row.pack_start(label("Language"), True, True, 0)
        language_combo = Gtk.ComboBoxText()
        for language_id, language_name in SUPPORTED_LANGUAGES.items():
            language_combo.append(language_id, language_name)
        language_combo.set_active_id(str(application.preferences["language"]))
        language_row.pack_end(language_combo, False, False, 0)
        content.pack_start(language_row, False, False, 0)
        language_note = label(
            "Language changes take effect after restarting PDrive Control Center.",
            "section-subtitle",
        )
        language_note.set_line_wrap(True)
        content.pack_start(language_note, False, False, 0)
        explanation = label(
            "Session startup uses ~/.config/autostart. A manual launch from the application "
            "menu still opens the window visibly.",
            "section-subtitle",
        )
        explanation.set_line_wrap(True)
        content.pack_start(explanation, False, False, 0)

        initial_preferences = (
            close_toggle.get_active(),
            start_toggle.get_active(),
            background_poll_toggle.get_active(),
            int(interval_combo.get_active_id() or REFRESH_INTERVAL_SECONDS),
            language_combo.get_active_id() or "en",
        )
        save_button = dialog.get_widget_for_response(Gtk.ResponseType.OK)

        def update_save_sensitivity(*_args: Any) -> None:
            current_preferences = (
                close_toggle.get_active(),
                start_toggle.get_active(),
                background_poll_toggle.get_active(),
                int(interval_combo.get_active_id() or REFRESH_INTERVAL_SECONDS),
                language_combo.get_active_id() or "en",
            )
            save_button.set_sensitive(current_preferences != initial_preferences)

        def enforce_close(toggle: Gtk.CheckButton) -> None:
            if toggle.get_active():
                close_toggle.set_active(True)

        start_toggle.connect("toggled", enforce_close)
        for toggle in (close_toggle, start_toggle, background_poll_toggle):
            toggle.connect("toggled", update_save_sensitivity)
        language_combo.connect("changed", update_save_sensitivity)
        interval_combo.connect("changed", update_save_sensitivity)
        save_button.set_sensitive(False)
        dialog.show_all()
        response = dialog.run()
        close_to_tray = close_toggle.get_active()
        start_in_tray = start_toggle.get_active()
        poll_in_background = background_poll_toggle.get_active()
        refresh_interval_seconds = int(interval_combo.get_active_id() or REFRESH_INTERVAL_SECONDS)
        selected_language = language_combo.get_active_id() or "en"
        previous_language = str(application.preferences["language"])
        dialog.destroy()
        if response != Gtk.ResponseType.OK:
            return
        error = application.update_preferences(
            close_to_tray,
            start_in_tray,
            poll_in_background,
            refresh_interval_seconds,
            selected_language,
        )
        if error:
            self.message("Could not save preferences", error, Gtk.MessageType.ERROR)
        elif selected_language != previous_language:
            self.message(
                "Restart required",
                "Quit and reopen PDrive Control Center to apply the selected language.",
                Gtk.MessageType.INFO,
            )

    def on_bandwidth(self, _button: Gtk.Button) -> None:
        dialog = Gtk.Dialog(title=translate("Bandwidth limit"), transient_for=self, modal=True)
        dialog.add_buttons(
            translate("Cancel"),
            Gtk.ResponseType.CANCEL,
            translate("Apply"),
            Gtk.ResponseType.OK,
        )
        content = dialog.get_content_area()
        content.set_spacing(10)
        content.set_margin_top(15)
        content.set_margin_bottom(15)
        content.set_margin_start(15)
        content.set_margin_end(15)
        content.pack_start(label("Upload limit in MiB/s", "section-title"), False, False, 0)
        current = str(self.current_state.get("bandwidth", {}).get("configured", "off"))
        initial_position = bandwidth_slider_position(current)
        adjustment = Gtk.Adjustment(
            value=initial_position,
            lower=0,
            upper=BANDWIDTH_SLIDER_UNLIMITED,
            step_increment=0.1,
            page_increment=1,
            page_size=0,
        )
        scale = Gtk.Scale(orientation=Gtk.Orientation.HORIZONTAL, adjustment=adjustment)
        scale.set_digits(1)
        scale.set_value_pos(Gtk.PositionType.TOP)
        scale.set_hexpand(True)
        scale.connect("format-value", lambda _scale, value: bandwidth_slider_label(value))
        scale.add_mark(0, Gtk.PositionType.BOTTOM, "⏸ ≈0")
        for rate in (0.1, 0.5, 1, 4, 10, 25, 50, 100):
            scale.add_mark(
                bandwidth_slider_position(str(rate)),
                Gtk.PositionType.BOTTOM,
                f"{rate:g}",
            )
        scale.add_mark(BANDWIDTH_SLIDER_UNLIMITED, Gtk.PositionType.BOTTOM, translate("Unlimited"))
        content.pack_start(scale, False, False, 0)
        help_label = label(
            "Near pause throttles uploads to 0.02 MiB/s; rclone has no true VFS pause. Full right removes the limit. Changes apply live without interrupting the active transfer.",
            "section-subtitle",
        )
        help_label.set_line_wrap(True)
        content.pack_start(help_label, False, False, 0)
        advanced_label = label(
            "The logarithmic slider gives low everyday limits more precision and controls uploads up to 100 MiB/s. Use pdrive-bwlimit for separate upload/download values or higher limits.",
            "section-subtitle",
        )
        advanced_label.set_line_wrap(True)
        content.pack_start(advanced_label, False, False, 0)
        apply_button = dialog.get_widget_for_response(Gtk.ResponseType.OK)
        apply_button.set_sensitive(False)
        scale.connect(
            "value-changed",
            lambda current_scale: apply_button.set_sensitive(
                abs(current_scale.get_value() - initial_position) >= 0.05
            ),
        )
        dialog.show_all()
        response = dialog.run()
        value = bandwidth_slider_command(scale.get_value())
        dialog.destroy()
        if response == Gtk.ResponseType.OK:
            self.run_helper(["pdrive-bwlimit", value], "Bandwidth limit")

    def on_transfers(self, _button: Gtk.Button) -> None:
        dialog = Gtk.Dialog(title=translate("Upload slots"), transient_for=self, modal=True)
