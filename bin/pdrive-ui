        scroller.add(page)
        return scroller

    @staticmethod
    def clear_list(listing: Gtk.ListBox) -> None:
        for child in listing.get_children():
            listing.remove(child)

    def set_empty_lists(self) -> None:
        self.clear_list(self.active_list)
        self.clear_list(self.queue_list)
        self.clear_list(self.recent_list)
        self.active_list.add(EmptyState("media-playback-pause-symbolic", "No active transfers", "rclone is not using the connection right now."))
        self.queue_list.add(EmptyState("emblem-ok-symbolic", "Queue is empty", "All local changes have been uploaded."))
        self.recent_list.add(EmptyState("document-open-recent-symbolic", "No transfers yet", "The current rclone process has not completed a transfer yet."))

    def on_destroy(self, _widget: Gtk.Widget) -> None:
        if self.window_size_save_source:
            GLib.source_remove(self.window_size_save_source)
            self.window_size_save_source = 0
            self.persist_window_size()
        self.closed = True

    def on_root_size_allocate(
        self,
        _widget: Gtk.Widget,
        allocation: Gdk.Rectangle,
    ) -> None:
        if self.demo or self.closed:
            return
        gdk_window = self.get_window()
        if gdk_window is not None and gdk_window.get_state() & (
            Gdk.WindowState.MAXIMIZED | Gdk.WindowState.FULLSCREEN
        ):
            return
        if allocation.width < MIN_WINDOW_WIDTH or allocation.height < MIN_WINDOW_HEIGHT:
            return
        self.pending_window_size = (allocation.width, allocation.height)
        if self.window_size_save_source:
            GLib.source_remove(self.window_size_save_source)
        self.window_size_save_source = GLib.timeout_add(
            WINDOW_SIZE_SAVE_DELAY_MS,
            self.persist_window_size,
        )

    def persist_window_size(self) -> bool:
        self.window_size_save_source = 0
        if self.demo or self.closed:
            return GLib.SOURCE_REMOVE
        gdk_window = self.get_window()
        if gdk_window is not None and gdk_window.get_state() & (
            Gdk.WindowState.MAXIMIZED | Gdk.WindowState.FULLSCREEN
        ):
            return GLib.SOURCE_REMOVE
        if self.pending_window_size is None:
            return GLib.SOURCE_REMOVE
        width, height = self.pending_window_size
        if width < MIN_WINDOW_WIDTH or height < MIN_WINDOW_HEIGHT:
            return GLib.SOURCE_REMOVE
        application = self.get_application()
        if isinstance(application, PDriveApplication):
            application.update_window_size(width, height)
        return GLib.SOURCE_REMOVE

    def on_refresh_timer(self) -> bool:
        if self.closed:
            return GLib.SOURCE_REMOVE
        self.request_refresh()
        return GLib.SOURCE_CONTINUE

    def request_refresh(self) -> None:
        if self.refreshing or self.closed:
            return
        self.refreshing = True
        thread = threading.Thread(target=self.load_state, daemon=True)
        thread.start()

    def load_state(self) -> None:
        if self.demo:
            GLib.usleep(120000)
            GLib.idle_add(self.apply_state, demo_state())
            return
        try:
            completed = subprocess.run(
                [self.state_command, "--compact"],
                check=False,
                capture_output=True,
                text=True,
                timeout=8,
            )
            if completed.returncode != 0:
                raise RuntimeError(completed.stderr.strip() or f"pdrive-state exited with {completed.returncode}")
            payload = json.loads(completed.stdout)
            GLib.idle_add(self.apply_state, payload)
        except (OSError, subprocess.TimeoutExpired, json.JSONDecodeError, RuntimeError) as error:
            GLib.idle_add(self.apply_error, str(error))

    def apply_error(self, message: str) -> bool:
        self.refreshing = False
        self.update_status("critical", "Status unavailable", message)
        return GLib.SOURCE_REMOVE

    def apply_state(self, state: dict[str, Any]) -> bool:
        self.refreshing = False
        self.current_state = state
        health = state.get("health", {})
        stats = state.get("stats", {})
        queue = state.get("queue", {})
        transfers = state.get("transfers", {})
        watchdog = state.get("watchdog", {})
        vfs = state.get("vfs", {})
        service = state.get("service", {})
        config = state.get("configuration", {})
        bandwidth = state.get("bandwidth", {})

        status = str(health.get("status", "unknown"))
        self.update_status(
            status,
            translate(STATUS_META.get(status, STATUS_META["unknown"])[1]),
            self.localized_health_summary(state),
        )
        self.updated_label.set_text(dt.datetime.now().strftime("%H:%M:%S"))

        speed = float(stats.get("speed") or 0)
        self.speed_samples.append(speed)
        self.speed_graph.push(speed)
        self.speed_card.update(human_rate(speed), f"Limit {bandwidth.get('live', '–')}")
        active = len(transfers.get("active", [])) or int(queue.get("active") or 0)
        slots = int(config.get("running_transfers") or config.get("transfers") or 0)
        self.active_card.update(str(active), translate_format("of {slots} upload slots in use", slots=slots))
        self.queue_card.update(str(queue.get("count", 0)), human_bytes(queue.get("bytes", 0)))
        application = self.get_application()
        if (
            isinstance(application, PDriveApplication)
            and not self.demo
            and (
                application.preferences["issues_reviewed_errors"] < 0
                or application.preferences["issues_reviewed_notices"] < 0
            )
        ):
            application.mark_issues_reviewed(watchdog)
        self.update_issue_card(watchdog)
        self.cache_card.update(
            human_bytes(vfs.get("cache_bytes", 0)),
            translate_format("{files} local cache files", files=vfs.get("cache_files", 0)),
        )
        self.free_card.update(human_bytes(vfs.get("free_bytes", 0)), translate("on the cache filesystem"))
        self.graph_peak.set_text(f"Peak {human_rate(max(self.speed_samples, default=0))}")

        if active:
            summary = translate_format(
                "{active} active transfer(s) · {count} file(s) queued · {speed}",
                active=active,
                count=queue.get("count", 0),
                speed=human_rate(speed),
            )
        elif queue.get("count", 0):
            summary = translate_format(
                "{count} file(s) are queued; rclone is preparing the next upload.",
                count=queue.get("count"),
            )
        else:
            summary = translate("Everything is in sync. The service keeps its fast metadata cache warm and waits for changes.")
        self.live_summary.set_text(summary)
        self.config_labels["bandwidth"].set_text(str(bandwidth.get("live", "–")))
        self.config_labels["slots"].set_text(f"{slots} parallel")
        self.config_labels["metadata"].set_text(translate("enabled" if config.get("metadata_cache") else "disabled"))
        self.config_labels["cooldown"].set_text(human_duration(config.get("cooldown_seconds", -1)))

        self.update_transfers(transfers, queue)
        self.update_history(state.get("history", []))
        self.status_title.set_tooltip_text(
            translate_format(
                "Service {active}/{sub} · PID {pid}",
                active=service.get("active_state", "–"),
                sub=service.get("sub_state", "–"),
                pid=service.get("pid", 0),
            )
        )
        application = self.get_application()
        if isinstance(application, PDriveApplication):
            application.update_indicator(state)
        return GLib.SOURCE_REMOVE

    def update_issue_card(self, watchdog: dict[str, Any]) -> None:
        application = self.get_application()
        preferences = (
            application.preferences
            if isinstance(application, PDriveApplication)
            else DEFAULT_PREFERENCES
        )
        errors, notices = issues_since_review(preferences, watchdog)
        total = errors + notices
        self.problem_card.update(
            str(total),
            translate_format(
                "{errors} errors · {notices} notices · since reviewed",
                errors=errors,
                notices=notices,
            ),
        )
        self.issue_review_button.set_sensitive(total > 0 and not self.demo)

    @staticmethod
    def localized_health_summary(state: dict[str, Any]) -> str:
        health = state.get("health", {})
        summary = str(health.get("summary", ""))
        if CURRENT_LANGUAGE != "de":
            return summary
        reason = str(health.get("reason_code", "unknown"))
        if reason == "mounted":
            queue = state.get("queue", {})
            active = int(queue.get("active") or 0)
            count = int(queue.get("count") or 0)
            if active:
                return GERMAN_HEALTH_SUMMARIES["mounted-active"].format(active=active)
            if count:
                return GERMAN_HEALTH_SUMMARIES["mounted-queued"].format(count=count)
            return GERMAN_HEALTH_SUMMARIES["mounted"]
        return GERMAN_HEALTH_SUMMARIES.get(reason, summary)

    def update_status(self, status: str, title_text: str, summary: str) -> None:
        for css_class in ("status-ready", "status-warning", "status-critical", "status-unknown"):
            self.status_frame.get_style_context().remove_class(css_class)
        selected = status if status in STATUS_META else "unknown"
        self.status_frame.get_style_context().add_class(f"status-{selected}")
        icon_name, fallback_title, _color = STATUS_META[selected]
        self.status_icon.set_from_icon_name(icon_name, Gtk.IconSize.DIALOG)
        self.status_title.set_text(translate(title_text or fallback_title))
        self.status_summary.set_text(summary or translate("No details available."))

    def transfer_row(self, item: dict[str, Any], queue: bool = False, recent: bool = False) -> Gtk.ListBoxRow:
        row = Gtk.ListBoxRow()
        add_css(row, "transfer-row")
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        top = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        name = label(short_name(str(item.get("name", "Unknown file"))), "transfer-name")
        name.set_ellipsize(3)
        name.set_tooltip_text(str(item.get("name", "")))
        top.pack_start(name, True, True, 0)
        if queue:
            status = "Uploading" if item.get("uploading") else "Waiting"
            if int(item.get("tries") or 0) >= 2:
                status = translate_format("Attempt {tries}", tries=item.get("tries"))
            top.pack_end(label(status, "pill"), False, False, 0)
        elif recent:
            text = "Failed" if item.get("error") else "Completed"
            top.pack_end(label(text, "pill"), False, False, 0)
        else:
            top.pack_end(label(human_rate(item.get("speed", 0)), "pill"), False, False, 0)
        box.pack_start(top, False, False, 0)

        if not queue and not recent:
            size = int(item.get("size") or 0)
            done = int(item.get("bytes") or 0)
            fraction = min(1.0, done / size) if size > 0 else 0.0
            progress = Gtk.ProgressBar(fraction=fraction)
            box.pack_start(progress, False, False, 0)
            detail = f"{human_bytes(done)} / {human_bytes(size)}"
            eta = human_duration(item.get("eta_seconds", -1))
            if eta != "–":
                detail += f" · ETA {eta}"
        elif queue:
            detail = (
                f"{human_bytes(item.get('size', 0))} · "
                + translate_format("{tries} attempt(s)", tries=item.get("tries", 0))
            )
        else:
            detail = f"{human_bytes(item.get('bytes') or item.get('size', 0))} · {local_time(str(item.get('completed_at', '')))}"
        box.pack_start(label(detail, "transfer-meta"), False, False, 0)
        row.add(box)
        return row

    def update_transfers(self, transfers: dict[str, Any], queue: dict[str, Any]) -> None:
        self.clear_list(self.active_list)
        self.clear_list(self.queue_list)
        self.clear_list(self.recent_list)
        active_items = transfers.get("active", [])
        queue_items = queue.get("items", [])
        recent_items = transfers.get("recent", [])
        if active_items:
            for item in active_items:
                self.active_list.add(self.transfer_row(item))
        else:
            uploading = [item for item in queue_items if item.get("uploading")]
            if uploading:
                for item in uploading:
                    self.active_list.add(self.transfer_row(item, queue=True))
            else:
                self.active_list.add(EmptyState("media-playback-pause-symbolic", "No active transfers", "rclone is not using the connection right now."))
        if queue_items:
            for item in queue_items:
                self.queue_list.add(self.transfer_row(item, queue=True))
        else:
            self.queue_list.add(EmptyState("emblem-ok-symbolic", "Queue is empty", "All local changes have been uploaded."))
        if recent_items:
            for item in reversed(recent_items[-12:]):
                self.recent_list.add(self.transfer_row(item, recent=True))
        else:
            self.recent_list.add(EmptyState("document-open-recent-symbolic", "No transfers yet", "The current rclone process has not completed a transfer yet."))
        self.active_list.show_all()
        self.queue_list.show_all()
        self.recent_list.show_all()

    def update_history(self, entries: list[dict[str, Any]]) -> None:
        signature = tuple(
            (entry.get("time"), entry.get("status"), entry.get("reason"), entry.get("errors"), entry.get("notices"))
            for entry in entries[-24:]
        )
        if signature == self.history_signature:
            return
        self.history_signature = signature
        self.clear_list(self.history_list)
        if not entries:
            self.history_list.add(EmptyState("document-open-recent-symbolic", "No history yet", "The pdrive-watch timer has not recorded a sample yet."))
            self.history_list.show_all()
            return
        for entry in reversed(entries[-24:]):
            row = Gtk.ListBoxRow()
            add_css(row, "history-row")
            box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
            status = str(entry.get("status", "unknown"))
            icon_name, _title, color = STATUS_META.get(status, STATUS_META["unknown"])
            icon = Gtk.Image.new_from_icon_name(icon_name, Gtk.IconSize.BUTTON)
            add_css(icon, color)
            box.pack_start(icon, False, False, 0)
            text_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
            reason = str(entry.get("reason", "unknown"))
            text_box.pack_start(label(REASON_LABELS.get(reason, reason.replace("-", " ").capitalize()), "transfer-name"), False, False, 0)
            detail = (
                translate_format(
                    "Queue {queue} · active {active} · error counter {errors} · notices {notices}",
                    queue=entry.get("vfs_queue", 0),
                    active=entry.get("vfs_uploading", 0),
                    errors=entry.get("errors", 0),
                    notices=entry.get("notices", 0),
                )
            )
            text_box.pack_start(label(detail, "transfer-meta"), False, False, 0)
            box.pack_start(text_box, True, True, 0)
            box.pack_end(label(local_time(str(entry.get("time", ""))), "pill", 1.0), False, False, 0)
            row.add(box)
            self.history_list.add(row)
        self.history_list.show_all()

    def on_open_mount(self, _button: Gtk.Button) -> None:
        try:
            Gio.AppInfo.launch_default_for_uri(pathlib.Path("/pdrive").as_uri(), None)
        except GLib.Error as error:
            self.message("Could not open mount", str(error), Gtk.MessageType.ERROR)

    def on_documentation(self, _button: Gtk.Button) -> None:
        application = self.get_application()
        if not isinstance(application, PDriveApplication):
            return
        if self.documentation_window is None:
            self.documentation_window = DocumentationWindow(application, self)
            self.documentation_window.connect(
                "destroy",
                lambda _window: setattr(self, "documentation_window", None),
            )
            self.documentation_window.show_all()
        self.documentation_window.present()

    def on_mark_issues_reviewed(self, _button: Gtk.Button) -> None:
        application = self.get_application()
        if not isinstance(application, PDriveApplication) or self.demo:
            return
        watchdog = self.current_state.get("watchdog", {})
        error = application.mark_issues_reviewed(watchdog)
        if error:
            self.message(
                "Could not update issue review state",
                error,
                Gtk.MessageType.ERROR,
            )
            return
        self.update_issue_card(watchdog)

    def on_preferences(self, _button: Gtk.Button) -> None:
        application = self.get_application()
        if not isinstance(application, PDriveApplication):
            return
        dialog = Gtk.Dialog(title=translate("Preferences"), transient_for=self, modal=True)
        dialog.add_buttons(translate("Cancel"), Gtk.ResponseType.CANCEL, translate("Save"), Gtk.ResponseType.OK)
        content = dialog.get_content_area()
        content.set_spacing(11)
        content.set_margin_top(16)
        content.set_margin_bottom(16)
        content.set_margin_start(16)
        content.set_margin_end(16)
        content.set_size_request(430, -1)
        content.pack_start(label("Behavior", "section-title"), False, False, 0)
        close_toggle = Gtk.CheckButton(label=translate("Keep running in the tray when the window closes"))
        close_toggle.set_active(application.preferences["close_to_tray"])
        content.pack_start(close_toggle, False, False, 0)
        start_toggle = Gtk.CheckButton(label=translate("Start hidden in the tray with the desktop session"))
        start_toggle.set_active(application.preferences["start_in_tray"])
        content.pack_start(start_toggle, False, False, 0)
        language_row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        language_row.pack_start(label("Language"), True, True, 0)
        language_combo = Gtk.ComboBoxText()
        for language_id, language_name in SUPPORTED_LANGUAGES.items():
            language_combo.append(language_id, language_name)
        language_combo.set_active_id(str(application.preferences["language"]))
        language_row.pack_end(language_combo, False, False, 0)
        content.pack_start(language_row, False, False, 0)
        language_note = label(
            "Language changes take effect after restarting PDrive Control Center.",
            "section-subtitle",
        )
        language_note.set_line_wrap(True)
        content.pack_start(language_note, False, False, 0)
        explanation = label(
            "Session startup uses ~/.config/autostart. A manual launch from the application "
            "menu still opens the window visibly.",
            "section-subtitle",
        )
        explanation.set_line_wrap(True)
        content.pack_start(explanation, False, False, 0)

        def enforce_close(toggle: Gtk.CheckButton) -> None:
            if toggle.get_active():
                close_toggle.set_active(True)

        start_toggle.connect("toggled", enforce_close)
        dialog.show_all()
        response = dialog.run()
        close_to_tray = close_toggle.get_active()
        start_in_tray = start_toggle.get_active()
        selected_language = language_combo.get_active_id() or "en"
        previous_language = str(application.preferences["language"])
        dialog.destroy()
        if response != Gtk.ResponseType.OK:
            return
        error = application.update_preferences(close_to_tray, start_in_tray, selected_language)
        if error:
            self.message("Could not save preferences", error, Gtk.MessageType.ERROR)
        elif selected_language != previous_language:
            self.message(
                "Restart required",
                "Quit and reopen PDrive Control Center to apply the selected language.",
                Gtk.MessageType.INFO,
            )

    def on_bandwidth(self, _button: Gtk.Button) -> None:
        dialog = Gtk.Dialog(title=translate("Bandwidth limit"), transient_for=self, modal=True)
        dialog.add_buttons(translate("Cancel"), Gtk.ResponseType.CANCEL, translate("Apply"), Gtk.ResponseType.OK)
        content = dialog.get_content_area()
        content.set_spacing(10)
        content.set_margin_top(15)
        content.set_margin_bottom(15)
        content.set_margin_start(15)
        content.set_margin_end(15)
        content.pack_start(label("Upload limit in MiB/s", "section-title"), False, False, 0)
        entry = Gtk.Entry()
        current = str(self.current_state.get("bandwidth", {}).get("configured", "off"))
        entry.set_text("off" if current == "off" else current.split(":", 1)[0].replace("Mi", "").replace("M", ""))
        entry.set_placeholder_text(translate("for example 4.2 or off"))
        content.pack_start(entry, False, False, 0)
        help_label = label("Unitless numbers are interpreted as MiB/s. This does not interrupt an active transfer.", "section-subtitle")
        help_label.set_line_wrap(True)
        content.pack_start(help_label, False, False, 0)
        dialog.show_all()
        response = dialog.run()
        value = entry.get_text().strip()
        dialog.destroy()
        if response == Gtk.ResponseType.OK and value:
            self.run_helper(["pdrive-bwlimit", value], "Bandwidth limit")

    def on_transfers(self, _button: Gtk.Button) -> None:
        dialog = Gtk.Dialog(title=translate("Upload slots"), transient_for=self, modal=True)
        dialog.add_buttons(translate("Cancel"), Gtk.ResponseType.CANCEL, translate("Save"), Gtk.ResponseType.OK)
        content = dialog.get_content_area()
        content.set_spacing(10)
        content.set_margin_top(15)
        content.set_margin_bottom(15)
        content.set_margin_start(15)
        content.set_margin_end(15)
        content.pack_start(label("Parallel file uploads", "section-title"), False, False, 0)
        current = int(self.current_state.get("configuration", {}).get("transfers", 4))
        spinner = Gtk.SpinButton.new_with_range(1, 8, 1)
        spinner.set_value(current)
        content.pack_start(spinner, False, False, 0)
        note = label("The saved value takes effect after the next controlled service start.", "section-subtitle")
        note.set_line_wrap(True)
        content.pack_start(note, False, False, 0)
        dialog.show_all()
        response = dialog.run()
        value = spinner.get_value_as_int()
        dialog.destroy()
        if response == Gtk.ResponseType.OK:
            self.run_helper(["pdrive-transfers", str(value)], "Upload slots")

    def on_clear_cooldown(self, _button: Gtk.Button) -> None:
        self.run_helper(["pdrive-watch", "--clear-cooldown"], "Restart cooldown")

    def on_metadata_refresh(self, _button: Gtk.Button) -> None:
        if self.confirm(
            "Refresh metadata?",
            "The guarded helper checks the queue and Dirty files first, then asks for confirmation in a terminal.",
        ):
            self.launch_terminal("pdrive-refresh --refresh", "Metadata refresh")

    def on_restart(self, _button: Gtk.Button) -> None:
        if self.confirm(
            "Safely restart the service?",
            "An active upload would be interrupted. pdrive-watch checks and validates the new process; final confirmation happens in a terminal.",
        ):
            self.launch_terminal("pdrive-watch --restart-service", "Safe service restart")

    def run_helper(self, command: list[str], title: str) -> None:
        def worker() -> None:
            try:
                completed = subprocess.run(command, check=False, capture_output=True, text=True, timeout=30)
                if completed.returncode == 0:
                    output = translate("Action completed.")
                else:
                    output = translate_format(
                        "The helper exited with status {status}. Run {command} in a terminal for its full diagnostic output.",
                        status=completed.returncode,
                        command=" ".join(command),
                    )
                GLib.idle_add(
                    self.helper_finished,
                    title,
                    completed.returncode == 0,
                    output,
                )
            except (OSError, subprocess.TimeoutExpired) as error:
                GLib.idle_add(self.helper_finished, title, False, str(error))

        threading.Thread(target=worker, daemon=True).start()

    def helper_finished(self, title: str, success: bool, output: str) -> bool:
        self.message(title, output, Gtk.MessageType.INFO if success else Gtk.MessageType.ERROR)
        self.request_refresh()
        return GLib.SOURCE_REMOVE

    def launch_terminal(self, command: str, title: str) -> None:
        terminal = shutil.which("x-terminal-emulator") or shutil.which("gnome-terminal")
        if not terminal:
            self.message(title, "No terminal application was found.", Gtk.MessageType.ERROR)
            return
        script = f"{command}; result=$?; printf '\\nPress Enter to close …'; read -r _; exit $result"
        try:
            subprocess.Popen([terminal, "-e", "bash", "-lc", script])
        except OSError as error:
            self.message(title, str(error), Gtk.MessageType.ERROR)

    def confirm(self, title: str, detail: str) -> bool:
        dialog = Gtk.MessageDialog(
            transient_for=self,
            modal=True,
            message_type=Gtk.MessageType.WARNING,
            buttons=Gtk.ButtonsType.CANCEL,
            text=translate(title),
        )
        dialog.format_secondary_text(translate(detail))
        dialog.add_button(translate("Continue"), Gtk.ResponseType.OK)
        response = dialog.run()
        dialog.destroy()
        return response == Gtk.ResponseType.OK

    def message(self, title: str, detail: str, message_type: Gtk.MessageType) -> None:
        dialog = Gtk.MessageDialog(
            transient_for=self,
            modal=True,
            message_type=message_type,
            buttons=Gtk.ButtonsType.OK,
            text=translate(title),
        )
        dialog.format_secondary_text(translate(detail)[:4000])
        dialog.run()
        dialog.destroy()


class PDriveApplication(Gtk.Application):
    def __init__(self, demo: bool = False, background: bool = False) -> None:
        global CURRENT_LANGUAGE
        flags = Gio.ApplicationFlags.NON_UNIQUE if demo else Gio.ApplicationFlags.FLAGS_NONE
        super().__init__(application_id=APP_ID, flags=flags)
        self.demo = demo
        self.background = background and not demo
        self.preferences = dict(DEFAULT_PREFERENCES) if demo else load_preferences()
        if demo:
            self.preferences.update(
                {
                    "issues_reviewed_errors": 10,
                    "issues_reviewed_notices": 5,
                    "issues_reviewed_at": "demo",
                }
            )
        CURRENT_LANGUAGE = str(self.preferences["language"])
        self.window: PDriveWindow | None = None
        self.initial_activation = True
        self.force_quit = False
        self.indicator: Any = None
        self.status_icon: Gtk.StatusIcon | None = None
        self.tray_held = False

    def do_startup(self) -> None:
        Gtk.Application.do_startup(self)
        GLib.set_application_name("PDrive Control Center")
        Gtk.Window.set_default_icon_name(APP_ID)
        settings = Gtk.Settings.get_default()
        if settings:
            settings.set_property("gtk-application-prefer-dark-theme", True)
        provider = Gtk.CssProvider()
        provider.load_from_data(CSS)
        screen = Gdk.Screen.get_default()
        if screen:
            Gtk.StyleContext.add_provider_for_screen(screen, provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
        self.configure_tray()

    def do_activate(self) -> None:
        was_initial_activation = self.initial_activation
        background_activation = self.initial_activation and self.background
        if self.window is None:
            self.window = PDriveWindow(self, demo=self.demo)
            self.window.show_all()
        if background_activation:
            self.window.hide()
        else:
            self.show_window()
        self.initial_activation = False
        if not was_initial_activation and self.background:
            self.background = False
            self.configure_tray()

    def show_window(self, *_args: Any) -> None:
        if self.window is None:
            self.activate()
            return
        self.window.show_all()
        self.window.present()

    def on_window_delete(self, window: Gtk.Window, _event: Gdk.Event) -> bool:
        if not self.force_quit and self.preferences["close_to_tray"] and not self.demo:
            window.hide()
            return True
        return False

    def tray_menu(self) -> Gtk.Menu:
        menu = Gtk.Menu()
        open_item = Gtk.MenuItem(label=translate("Open PDrive Control Center"))
        open_item.connect("activate", self.show_window)
        menu.append(open_item)
        mount_item = Gtk.MenuItem(label=translate("Open /pdrive"))
        mount_item.connect("activate", self.open_mount_from_tray)
        menu.append(mount_item)
        menu.append(Gtk.SeparatorMenuItem())
        quit_item = Gtk.MenuItem(label=translate("Quit"))
        quit_item.connect("activate", self.quit_from_tray)
        menu.append(quit_item)
        menu.show_all()
        return menu

    def configure_tray(self) -> None:
        wanted = not self.demo and (self.preferences["close_to_tray"] or self.background)
        if wanted and self.indicator is None and self.status_icon is None:
            menu = self.tray_menu()
            if tray_supports_distinct_clicks() or AyatanaAppIndicator3 is None:
                self.status_icon = Gtk.StatusIcon.new_from_icon_name(APP_ID)
                self.status_icon.set_title("PDrive Control Center")
                self.status_icon.connect("activate", self.show_window)
                self.status_icon.connect("popup-menu", self.popup_status_menu, menu)
            else:
                self.indicator = AyatanaAppIndicator3.Indicator.new(
                    APP_ID,
                    APP_ID,
                    AyatanaAppIndicator3.IndicatorCategory.APPLICATION_STATUS,
                )
                self.indicator.set_title("PDrive Control Center")
                self.indicator.set_menu(menu)
        if self.indicator is not None:
            status = (
                AyatanaAppIndicator3.IndicatorStatus.ACTIVE
                if wanted
                else AyatanaAppIndicator3.IndicatorStatus.PASSIVE
            )
            self.indicator.set_status(status)
        if self.status_icon is not None:
            self.status_icon.set_visible(wanted)
        if wanted and not self.tray_held:
            self.hold()
            self.tray_held = True
        elif not wanted and self.tray_held:
            self.release()
            self.tray_held = False

    @staticmethod
    def popup_status_menu(
        icon: Gtk.StatusIcon,
        button: int,
        activate_time: int,
        menu: Gtk.Menu,
    ) -> None:
        menu.popup(None, None, Gtk.StatusIcon.position_menu, icon, button, activate_time)

    def update_indicator(self, state: dict[str, Any]) -> None:
        health = state.get("health", {})
        speed = float(state.get("stats", {}).get("speed") or 0)
        status = str(health.get("status", "unknown"))
        tooltip = f"{translate(STATUS_META.get(status, STATUS_META['unknown'])[1])} · {human_rate(speed)}"
        if self.indicator is not None:
            indicator_label = f"↑ {human_rate(speed)}" if speed >= 1024 else ""
            self.indicator.set_label(indicator_label, "↑ 999.9 MiB/s")
            self.indicator.set_title(tooltip)
        if self.status_icon is not None:
            self.status_icon.set_tooltip_text(tooltip)

    def open_mount_from_tray(self, *_args: Any) -> None:
        try:
            Gio.AppInfo.launch_default_for_uri(pathlib.Path("/pdrive").as_uri(), None)
        except GLib.Error as error:
            if self.window is not None:
                self.show_window()
                self.window.message("Could not open mount", str(error), Gtk.MessageType.ERROR)

    def quit_from_tray(self, *_args: Any) -> None:
        self.force_quit = True
        if self.window is not None:
            self.window.closed = True
            self.window.destroy()
            self.window = None
        self.quit()

    def update_preferences(
        self,
        close_to_tray: bool,
        start_in_tray: bool,
        language: str,
    ) -> str | None:
        if self.demo:
            return "Preferences cannot be changed in demo mode."
        new_preferences = dict(self.preferences)
        new_preferences.update(
            {
                "close_to_tray": bool(close_to_tray or start_in_tray),
                "start_in_tray": bool(start_in_tray),
                "language": language if language in SUPPORTED_LANGUAGES else "en",
            }
        )
        old_preferences = dict(self.preferences)
        try:
            self.sync_autostart(new_preferences["start_in_tray"])
            atomic_write(
                preferences_path(),
                json.dumps(new_preferences, indent=2, sort_keys=True) + "\n",
                0o600,
            )
        except OSError as error:
            try:
                self.sync_autostart(old_preferences["start_in_tray"])
            except OSError:
                pass
            return str(error)
        self.preferences = new_preferences
        self.background = False
        self.configure_tray()
        return None

    def update_window_size(self, width: int, height: int) -> str | None:
        if self.demo:
            return None
        width = max(MIN_WINDOW_WIDTH, min(MAX_WINDOW_DIMENSION, int(width)))
        height = max(MIN_WINDOW_HEIGHT, min(MAX_WINDOW_DIMENSION, int(height)))
        if (
            self.preferences.get("window_width") == width
            and self.preferences.get("window_height") == height
        ):
            return None
        new_preferences = dict(self.preferences)
        new_preferences.update({"window_width": width, "window_height": height})
        try:
            atomic_write(
                preferences_path(),
                json.dumps(new_preferences, indent=2, sort_keys=True) + "\n",
                0o600,
            )
        except OSError as error:
            return str(error)
        self.preferences = new_preferences
        return None

    def mark_issues_reviewed(self, watchdog: dict[str, Any]) -> str | None:
        if self.demo:
            return "Preferences cannot be changed in demo mode."
        old_preferences = dict(self.preferences)
        new_preferences = dict(self.preferences)
        new_preferences.update(
            {
                "issues_reviewed_errors": max(0, int(watchdog.get("errors") or 0)),
                "issues_reviewed_notices": max(0, int(watchdog.get("notices") or 0)),
                "issues_reviewed_at": str(
                    watchdog.get("generated_at")
                    or dt.datetime.now().astimezone().isoformat(timespec="seconds")
                ),
            }
        )
        try:
            atomic_write(
                preferences_path(),
                json.dumps(new_preferences, indent=2, sort_keys=True) + "\n",
                0o600,
            )
        except OSError as error:
            self.preferences = old_preferences
            return str(error)
        self.preferences = new_preferences
        return None

    @staticmethod
    def sync_autostart(enabled: bool) -> None:
        path = autostart_path()
        if enabled:
            if path.exists():
                try:
                    existing = path.read_text(encoding="utf-8")
                except OSError as error:
                    raise OSError(f"Could not inspect the existing autostart file: {error}") from error
                if AUTOSTART_MARKER not in existing:
                    raise OSError(f"Refusing to overwrite an unmarked autostart file: {path}")
            atomic_write(path, autostart_contents(), 0o600)
            return
        if not path.exists():
            return
        try:
            existing = path.read_text(encoding="utf-8")
        except OSError as error:
            raise OSError(f"Could not inspect the existing autostart file: {error}") from error
        if AUTOSTART_MARKER in existing:
            path.unlink()


def demo_state() -> dict[str, Any]:
    now = dt.datetime.now().astimezone().isoformat(timespec="seconds")
    phase = (dt.datetime.now().timestamp() % 20) / 20
    size = 24_923_023_360
    done = int(size * (0.38 + phase * 0.12))
    speed = 4_404_019 + math.sin(phase * math.pi * 2) * 380_000
    active = {
        "name": "Projects/Linux Mint VM/disks/system.qcow2",
        "size": size,
        "bytes": done,
        "percentage": done * 100 / size,
        "speed": speed,
        "eta_seconds": int((size - done) / speed),
        "error": "",
    }
    queue_items = [
        {"name": active["name"], "size": size, "tries": 1, "uploading": True},
        {"name": "Backups/ISO/Linux-Mint-22.3.iso", "size": 6_700_000_000, "tries": 0, "uploading": False},
        {"name": "Media/Project/final-render.mkv", "size": 2_900_000_000, "tries": 0, "uploading": False},
    ]
    history = []
    for index in range(12):
        moment = dt.datetime.now().astimezone() - dt.timedelta(minutes=90 * index)
        history.append(
            {
                "time": moment.isoformat(timespec="seconds"),
                "status": "warning" if index == 5 else "ready",
                "reason": "persistent-upload-failure" if index == 5 else "mounted",
                "vfs_queue": max(0, 3 + index),
                "vfs_uploading": 1,
                "errors": 433 - index * 2,
                "notices": 173 - index,
            }
        )
    return {
        "generated_at": now,
        "health": {"status": "ready", "summary": "Upload is running smoothly through the existing Proton Drive service."},
        "service": {"active_state": "active", "sub_state": "running", "pid": 4242},
        "stats": {"speed": speed},
        "transfers": {"active": [active], "recent": []},
        "queue": {"count": 3, "bytes": sum(item["size"] for item in queue_items), "active": 1, "items": queue_items},
        "vfs": {"cache_bytes": size + 9_600_000_000, "cache_files": 3, "free_bytes": 758_000_000_000},
        "bandwidth": {"configured": "4.200Mi:off", "live": "4.200Mi:off"},
        "configuration": {"transfers": 4, "running_transfers": 4, "metadata_cache": True, "cooldown_seconds": 43200},
        "watchdog": {
            "generated_at": now,
            "errors": 12,
            "notices": 8,
            "delta_errors": "+0",
            "delta_notices": "+0",
        },
        "history": list(reversed(history)),
    }


def argument_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="pdrive-ui",
        description="Native local interface for the existing proton-drive-linux service.",
    )
    parser.add_argument("--demo", action="store_true", help="open the interface with synthetic sample data")
    parser.add_argument(
        "--background",
        action="store_true",
        help="keep the window hidden in the tray during desktop-session startup",
    )
    parser.add_argument(
        "--check",
        action="store_true",
        help="check GTK and the state helper without opening a window",
    )
    parser.add_argument("--version", action="version", version=f"%(prog)s {VERSION}")
    return parser


def main() -> int:
    parser = argument_parser()
    args = parser.parse_args()
    if args.demo and args.background:
        parser.error("--demo and --background cannot be combined")
    if args.check:
        state_command = PDriveWindow.find_state_command()
        if not pathlib.Path(state_command).is_file() and not shutil.which(state_command):
            print(f"pdrive-state not found: {state_command}", file=sys.stderr)
            return 69
        if tray_supports_distinct_clicks():
            tray_backend = "GTK StatusIcon (left-click open, right-click menu)"
        elif AyatanaAppIndicator3 is not None:
            tray_backend = "Ayatana AppIndicator"
        else:
            tray_backend = "GTK StatusIcon fallback"
        print(
            f"GTK {Gtk.get_major_version()}.{Gtk.get_minor_version()}.{Gtk.get_micro_version()}; "
            f"tray {tray_backend}; pdrive-state {state_command}"
        )
        return 0
    application = PDriveApplication(demo=args.demo, background=args.background)
    try:
        return application.run([])
    except KeyboardInterrupt:
        return 130


if __name__ == "__main__":
    raise SystemExit(main())
