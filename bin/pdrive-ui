    def build_list_section(self, title: str, subtitle: str) -> tuple[Gtk.Frame, Gtk.ListBox]:
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        box.pack_start(label(title, "section-title"), False, False, 0)
        box.pack_start(label(subtitle, "section-subtitle"), False, False, 0)
        listing = Gtk.ListBox()
        listing.set_selection_mode(Gtk.SelectionMode.NONE)
        add_css(listing, "transparent")
        box.pack_start(listing, True, True, 0)
        return card(box), listing

    def build_cache_section(self) -> Gtk.Frame:
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        heading = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        heading_text = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=3)
        heading_text.pack_start(label("Local VFS cache", "section-title"), False, False, 0)
        heading_text.pack_start(
            label(
                "Synced local copies are reusable read cache, not unfinished uploads",
                "section-subtitle",
            ),
            False,
            False,
            0,
        )
        heading.pack_start(heading_text, True, True, 0)
        retention_button = Gtk.Button(label=translate("Cache retention …"))
        retention_button.set_tooltip_text(translate("Change cache retention"))
        add_css(retention_button, "flat-action")
        set_pointer_on_hover(retention_button)
        retention_button.connect("clicked", self.on_cache_retention)
        self.retention_button = retention_button
        heading.pack_end(retention_button, False, False, 0)
        box.pack_start(heading, False, False, 0)

        self.cache_status_title = label("Cache details unavailable", "transfer-name")
        self.cache_status_detail = label(
            "rclone’s VFS statistics are temporarily unavailable.",
            "transfer-meta",
        )
        self.cache_status_detail.set_line_wrap(True)
        box.pack_start(self.cache_status_title, False, False, 2)
        box.pack_start(self.cache_status_detail, False, False, 0)

        details = Gtk.Grid(column_spacing=16, row_spacing=9)
        self.cache_detail_values: dict[str, Gtk.Label] = {}
        for row_index, (key, title) in enumerate(
            (
                ("clean", "Synced read cache"),
                ("pending", "Pending upload data"),
                ("retention", "Retention"),
            )
        ):
            details.attach(label(title, "section-subtitle"), 0, row_index, 1, 1)
            value = label("–", "pill", 1.0)
            value.set_halign(Gtk.Align.END)
            details.attach(value, 1, row_index, 1, 1)
            self.cache_detail_values[key] = value
        details.set_column_homogeneous(False)
        box.pack_start(details, False, False, 2)
        note = label(
            "Clean files are removed after the retention period without local access. Dirty files remain protected until upload succeeds.",
            "section-subtitle",
        )
        note.set_line_wrap(True)
        box.pack_start(note, False, False, 0)
        return card(box)

    def build_transfers_page(self) -> Gtk.Widget:
        self.transfers_scroller = Gtk.ScrolledWindow()
        self.transfers_scroller.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        self.transfers_page = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14)
        add_css(self.transfers_page, "page")
        self.active_transfer_section, self.active_list = self.build_list_section(
            "Active transfers",
            "Progress from rclone; single-file speed and ETA use verified process traffic",
        )
        self.queue_transfer_section, self.queue_list = self.build_list_section(
            "VFS queue",
            "Pending uploads remain safe in the existing VFS cache across restarts",
        )
        self.cache_transfer_section = self.build_cache_section()
        self.recent_transfer_section, self.recent_list = self.build_list_section(
            "Recently completed",
            "Successful uploads from the last 24 hours, plus current-process transfers",
        )
        self.transfers_page.pack_start(self.active_transfer_section, False, False, 0)
        self.transfers_page.pack_start(self.queue_transfer_section, False, False, 0)
        self.transfers_page.pack_start(self.cache_transfer_section, False, False, 0)
        self.transfers_page.pack_start(self.recent_transfer_section, False, False, 0)
        self.transfers_scroller.add(self.transfers_page)
        return self.transfers_scroller

    def show_transfer_section(self, section: str) -> None:
        self.stack.set_visible_child_name("transfers")
        GLib.timeout_add(220, self.scroll_to_transfer_section, section)

    def scroll_to_transfer_section(self, section: str) -> bool:
        targets = {
            "active": self.active_transfer_section,
            "queue": self.queue_transfer_section,
            "cache": self.cache_transfer_section,
        }
        target = targets.get(section, self.active_transfer_section)
        coordinates = target.translate_coordinates(self.transfers_page, 0, 0)
        target_y = float(coordinates[1] if coordinates is not None else 0)
        adjustment = self.transfers_scroller.get_vadjustment()
        maximum = max(adjustment.get_lower(), adjustment.get_upper() - adjustment.get_page_size())
        adjustment.set_value(min(maximum, max(adjustment.get_lower(), target_y - 12)))
        target.grab_focus()
        return GLib.SOURCE_REMOVE

