def translate(text: str) -> str:
    if CURRENT_LANGUAGE == "de":
        return GERMAN_TRANSLATIONS.get(text, text)
    return text


def translate_format(text: str, **values: Any) -> str:
    return translate(text).format(**values)


def xdg_path(environment_name: str, fallback: pathlib.Path) -> pathlib.Path:
    configured = os.environ.get(environment_name)
    return pathlib.Path(configured).expanduser() if configured else fallback


def preferences_path() -> pathlib.Path:
    return xdg_path("XDG_CONFIG_HOME", pathlib.Path.home() / ".config") / "pdrive-ui.json"


def autostart_path() -> pathlib.Path:
    return xdg_path("XDG_CONFIG_HOME", pathlib.Path.home() / ".config") / "autostart" / f"{APP_ID}.desktop"


def setup_config_path() -> pathlib.Path:
    configured = os.environ.get("PDRIVE_RCLONE_CONFIG")
    return pathlib.Path(configured).expanduser() if configured else pathlib.Path.home() / ".config/rclone/rclone.conf"


def mount_path() -> pathlib.Path:
    return pathlib.Path(os.environ.get("PDRIVE_MOUNT_DIR", "/pdrive")).expanduser()


def resolve_command(environment_name: str, executable: str) -> str:
    configured = os.environ.get(environment_name)
    if configured:
        return configured
    installed = shutil.which(executable)
    if installed:
        return installed
    return str(pathlib.Path(__file__).with_name(executable))


def automatic_package_install_supported() -> bool:
    if not pathlib.Path("/usr/bin/pkexec").is_file() or not pathlib.Path("/usr/bin/apt-get").is_file():
        return False
    try:
        release = pathlib.Path("/etc/os-release").read_text(encoding="utf-8").lower()
    except OSError:
        return False
    return any(identifier in release for identifier in ("debian", "ubuntu", "linuxmint"))


def setup_readiness() -> dict[str, Any]:
    missing_commands = [command for command in REQUIRED_RUNTIME_COMMANDS if shutil.which(command) is None]
    real_rclone = pathlib.Path(
        os.environ.get("PDRIVE_REAL_RCLONE", pathlib.Path.home() / ".local/libexec/rclone-bin")
    ).expanduser()
    rclone_ready = False
    if real_rclone.is_file() and os.access(real_rclone, os.X_OK):
        try:
            rclone_ready = (
                subprocess.run(
                    [str(real_rclone), "help", "backend", "protondrive"],
                    check=False,
                    stdout=subprocess.DEVNULL,
                    stderr=subprocess.DEVNULL,
                    timeout=8,
                ).returncode
                == 0
            )
        except (OSError, subprocess.TimeoutExpired):
            pass
    mount = mount_path()
    try:
        mount_ready = mount.is_dir() and not mount.is_symlink() and mount.stat().st_uid == os.getuid()
    except OSError:
        mount_ready = False
    return {
        "commands_ready": not missing_commands,
        "missing_commands": missing_commands,
        "rclone_ready": rclone_ready,
        "real_rclone": str(real_rclone),
        "mount_ready": mount_ready,
        "mount": str(mount),
        "ready": not missing_commands and rclone_ready and mount_ready,
        "automatic": automatic_package_install_supported(),
    }


def documentation_path(installed_name: str, repository_relative: str) -> pathlib.Path | None:
    data_home = xdg_path("XDG_DATA_HOME", pathlib.Path.home() / ".local" / "share")
    candidates = (
        data_home / "doc" / "proton-drive-linux" / installed_name,
        pathlib.Path("/usr/share/doc/proton-drive-linux") / installed_name,
        pathlib.Path(__file__).resolve().parent.parent / repository_relative,
    )
    for candidate in candidates:
        if candidate.is_file():
            return candidate
    return None


def tray_supports_distinct_clicks() -> bool:
    display = Gdk.Display.get_default()
    return display is not None and type(display).__name__ == "X11Display"


def atomic_write(path: pathlib.Path, content: str, mode: int) -> None:
    path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    descriptor, temporary_name = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    temporary = pathlib.Path(temporary_name)
    try:
        with os.fdopen(descriptor, "w", encoding="utf-8") as stream:
            stream.write(content)
            stream.flush()
            os.fsync(stream.fileno())
        temporary.chmod(mode)
        os.replace(temporary, path)
    finally:
        temporary.unlink(missing_ok=True)


def load_preferences() -> dict[str, Any]:
    preferences = dict(DEFAULT_PREFERENCES)
    try:
        payload = json.loads(preferences_path().read_text(encoding="utf-8"))
        for key in ("close_to_tray", "start_in_tray", "poll_in_background"):
            if isinstance(payload.get(key), bool):
                preferences[key] = payload[key]
        if payload.get("refresh_interval_seconds") in REFRESH_INTERVAL_OPTIONS:
            preferences["refresh_interval_seconds"] = payload["refresh_interval_seconds"]
        if payload.get("language") in SUPPORTED_LANGUAGES:
            preferences["language"] = payload["language"]
        for key in ("issues_reviewed_errors", "issues_reviewed_notices"):
            if isinstance(payload.get(key), int) and not isinstance(payload.get(key), bool):
                preferences[key] = max(-1, payload[key])
        if isinstance(payload.get("issues_reviewed_at"), str):
            preferences["issues_reviewed_at"] = payload["issues_reviewed_at"]
    except (FileNotFoundError, OSError, json.JSONDecodeError, AttributeError):
        pass
    if preferences["start_in_tray"]:
        preferences["close_to_tray"] = True
    return preferences


def issues_since_review(preferences: dict[str, Any], watchdog: dict[str, Any]) -> tuple[int, int]:
    """Return cumulative log events after the user's review watermark.

    rclone's current log counters can return to zero after a log rotation or a
    service restart. A lower current value is therefore the new-log count,
    rather than a negative delta.
    """

    current_errors = max(0, int(watchdog.get("errors") or 0))
    current_notices = max(0, int(watchdog.get("notices") or 0))
    reviewed_errors = int(preferences.get("issues_reviewed_errors", -1))
    reviewed_notices = int(preferences.get("issues_reviewed_notices", -1))
    if reviewed_errors < 0 or reviewed_notices < 0:
        return 0, 0
    new_errors = current_errors - reviewed_errors if current_errors >= reviewed_errors else current_errors
    new_notices = current_notices - reviewed_notices if current_notices >= reviewed_notices else current_notices
    return new_errors, new_notices


def unreviewed_issue_events(
    preferences: dict[str, Any],
    watchdog: dict[str, Any],
    issues: dict[str, Any],
) -> tuple[list[dict[str, Any]], int]:
    """Select the newest issue details that correspond to cumulative deltas."""

    new_errors, new_notices = issues_since_review(preferences, watchdog)
    raw_events = issues.get("events", [])
    if not isinstance(raw_events, list):
        raw_events = []
    events = [event for event in raw_events if isinstance(event, dict)]
    all_error_indices = [
        index for index, event in enumerate(events) if str(event.get("level", "")).lower() in {"error", "critical"}
    ]
    all_notice_indices = [
        index for index, event in enumerate(events) if str(event.get("level", "")).lower() == "notice"
    ]
    error_indices = all_error_indices[-new_errors:] if new_errors else []
    notice_indices = all_notice_indices[-new_notices:] if new_notices else []
    selected_indices = set(error_indices + notice_indices)
    selected = [event for index, event in enumerate(events) if index in selected_indices]
    missing = max(0, new_errors + new_notices - len(selected))
    return selected, missing


def network_receive_rate(
    previous: tuple[int, int, float] | None,
    network_io: dict[str, Any],
    pid: int,
    now: float,
) -> tuple[float, tuple[int, int, float] | None]:
    """Derive PDrive receive bytes/second from process-owned TCP counters."""

    if "receive_speed" in network_io:
        return max(0.0, float(network_io.get("receive_speed") or 0)), previous
    if not network_io.get("available") or pid <= 0:
        return 0.0, None
    received = max(0, int(network_io.get("received_bytes") or 0))
    current = (pid, received, now)
    if previous is None:
        return 0.0, current
    previous_pid, previous_received, previous_time = previous
    elapsed = now - previous_time
    if previous_pid != pid or received < previous_received or elapsed < 0.25 or elapsed > 10:
        return 0.0, current
    return (received - previous_received) / elapsed, current


def bandwidth_slider_position(rate: str) -> float:
    component = rate.split(":", 1)[0].strip()
    if component.lower() in {"", "off", "0"}:
        return BANDWIDTH_SLIDER_UNLIMITED
    match = re.fullmatch(r"([0-9]+(?:\.[0-9]+)?)([bkmgtp]?)(?:i?b?)?", component, re.IGNORECASE)
    if match is None:
        return BANDWIDTH_SLIDER_UNLIMITED
    value = float(match.group(1))
    unit = match.group(2).upper()
    factors = {
        "": 1.0,
        "B": 1 / (1024 * 1024),
        "K": 1 / 1024,
        "M": 1.0,
        "G": 1024.0,
        "T": 1024.0 * 1024.0,
        "P": 1024.0 * 1024.0 * 1024.0,
    }
    value *= factors.get(unit, 1.0)
    if value <= BANDWIDTH_NEAR_PAUSE_MIB:
        return 0.0
    value = min(BANDWIDTH_SLIDER_MAX_RATE, value)
    return 100.0 * math.log(value / BANDWIDTH_NEAR_PAUSE_MIB) / math.log(
        BANDWIDTH_SLIDER_MAX_RATE / BANDWIDTH_NEAR_PAUSE_MIB
    )


def bandwidth_slider_rate(position: float) -> float:
    position = max(0.0, min(100.0, position))
    return BANDWIDTH_NEAR_PAUSE_MIB * (
        BANDWIDTH_SLIDER_MAX_RATE / BANDWIDTH_NEAR_PAUSE_MIB
    ) ** (position / 100.0)


def bandwidth_slider_label(position: float) -> str:
    if position >= BANDWIDTH_SLIDER_UNLIMITED - 0.05:
        return f"{translate('Unlimited')} (off/0)"
    if position <= 0.05:
        return "⏸ ≈0 · 0.02 MiB/s"
    rate = bandwidth_slider_rate(position)
    digits = 2 if rate < 1 else 1
    return f"{rate:.{digits}f} MiB/s"


def bandwidth_slider_command(position: float) -> str:
    if position >= BANDWIDTH_SLIDER_UNLIMITED - 0.05:
        return "off"
    if position <= 0.05:
        return f"{BANDWIDTH_NEAR_PAUSE_MIB:.2f}"
    rate = bandwidth_slider_rate(position)
    digits = 2 if rate < 1 else 1
    return f"{rate:.{digits}f}".rstrip("0").rstrip(".")


def autostart_contents() -> str:
    return "\n".join(
        (
            "[Desktop Entry]",
            "Type=Application",
            "Name=PDrive Control Center",
            "Comment=Proton Drive health, queue and transfers",
            "Exec=pdrive-ui --background",
            "TryExec=pdrive-ui",
            f"Icon={APP_ID}",
            "Terminal=false",
            "StartupNotify=false",
            "X-GNOME-Autostart-enabled=true",
            AUTOSTART_MARKER,
            "",
        )
    )


