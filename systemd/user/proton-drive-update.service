[Unit]
Description=Update Proton Drive CLI from the official Proton release channel
Documentation=https://github.com/oss-singularity/proton-drive-linux/blob/main/docs/OPERATIONS.md https://proton.me/support/drive-cli
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
UMask=0077
Environment=PATH=/usr/local/bin:/usr/bin:%h/.local/bin
ExecStart=/usr/bin/env pdrive-service proton-drive-update
TimeoutStartSec=10min
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=read-only
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ReadWritePaths=%h/.local/bin %h/.local/state
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictRealtime=true
RestrictSUIDSGID=true
SystemCallArchitectures=native
