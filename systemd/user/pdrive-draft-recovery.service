[Unit]
Description=Guarded one-shot recovery for persistent Proton upload draft conflicts
Documentation=https://github.com/oss-singularity/proton-drive-linux/blob/main/docs/TROUBLESHOOTING.md
After=rclone-proton-drive.service

[Service]
Type=oneshot
UMask=0077
Environment=PATH=/usr/local/bin:/usr/bin:%h/.local/bin
ExecStart=/usr/bin/env pdrive-service draft-recovery-auto
TimeoutStartSec=5min
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=full
LockPersonality=true
RestrictRealtime=true
RestrictSUIDSGID=true
SystemCallArchitectures=native
