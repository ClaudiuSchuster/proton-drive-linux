[Unit]
Description=Mount Proton Drive directly at /pdrive using rclone
Documentation=https://github.com/oss-singularity/proton-drive-linux/blob/main/docs/OPERATIONS.md https://rclone.org/protondrive/ https://rclone.org/commands/rclone_mount/
Wants=network-online.target gnome-keyring-daemon.socket
After=network-online.target gnome-keyring-daemon.socket
ConditionPathExists=%h/.config/rclone/rclone.conf

[Service]
Type=notify
UMask=0077
Environment=PATH=/usr/local/bin:/usr/bin:%h/.local/bin
ExecCondition=/usr/bin/env pdrive-service auth-start-allowed
ExecStartPre=/usr/bin/env pdrive-service auth-begin-start
ExecStart=/usr/bin/env pdrive-service mount
ExecStartPost=/usr/bin/env pdrive-service bandwidth-startup
ExecStartPost=/usr/bin/env pdrive-service auth-mark-healthy
ExecStop=-/usr/bin/env pdrive-service unmount
ExecStopPost=/usr/bin/env pdrive-service auth-after-exit
Restart=on-failure
RestartSec=1h
TimeoutStartSec=infinity
TimeoutStopSec=30s

[Install]
WantedBy=default.target
